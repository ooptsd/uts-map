// ═══ v1.3.0 新增：定位 ═══
// 显示/隐藏用户位置蓝点（Android 需 LocationComponent 权限，iOS 需 NSLocationWhenInUseUsageDescription，鸿蒙使用 ohos.permission.LOCATION）
export declare function showUserLocation(enabled: boolean): void
// 获取当前 GPS 位置，异步回调返回经纬度。失败时调用 onError
export declare function getUserLocation(callback: (detail: MapClickDetail) => void, onError?: (err: MapErrorDetail) => void): void

// ═══ v1.3.0 新增：信息窗口 ═══
// 显示/隐藏指定标记的信息窗口（需标记创建时设置了 snippet）
export declare function showMarkerInfo(id: number): void
export declare function hideMarkerInfo(id: number): void

// ═══ v1.3.0 新增：自定义瓦片图层 ═══
// 添加自定义 XYZ 瓦片图层（如天气、交通、专题图），tileUrl 需包含 {x}{y}{z} 占位符；options 可选，缺省与 v1.7.x 行为一致
export declare function addCustomTileLayer(id: string, tileUrl: string, options?: TileLayerOptions): void
// 移除指定 ID 的自定义瓦片图层
export declare function removeCustomTileLayer(id: string): void

// ═══ v1.4.0 新增：地图交互增强 ═══
// 地图长按事件：用户长按地图时触发，返回经纬度坐标
export declare function setMapLongClickCallback(callback: MapLongClickCallback): void
// 地图旋转：设置 bearing（0=正北，顺时针增加，范围 0~360）
export declare function setBearing(bearing: number): void
// 地图倾斜：设置 tilt/pitch（0=垂直俯瞰，范围 0~60，值越大越倾斜）
export declare function setTilt(tilt: number): void
// 获取当前旋转角度
export declare function getBearing(): number
// 获取当前倾斜角度
export declare function getTilt(): number
// 旋转手势开关：控制双指旋转地图手势
export declare function enableRotate(enabled: boolean): void
// 倾斜手势开关：控制双指倾斜地图手势（鸿蒙端不支持时通过 onError 上报）
export declare function enableTilt(enabled: boolean): void
// 相机移动事件：地图视野变化完成时触发，返回当前中心点坐标
export declare function setCameraChangeCallback(callback: CameraChangeCallback): void

// ═══ v1.7.0 新增：数据可视化（标记聚合 + 热力图）═══

// 聚合选项：clusterRadius=聚合半径(像素,默认50)；clusterMaxZoom=最大聚合缩放级别(默认14，
// 超过该级别聚合解散显示全部原始点。⚠️ 鸿蒙端官方聚合忽略 clusterRadius/clusterMaxZoom
// （distance 固定 100vp，无最大缩放级别概念）
export type ClusterOptions = {
    clusterRadius?: number
    clusterMaxZoom?: number
}

// 热力点：weight 为权重（默认 1，越大热度越高）
export type HeatmapItem = {
    lat: number
    lng: number
    weight?: number
}

// 热力选项：radius=热力辐射半径(像素,默认30)；opacity=整体透明度(0~1,默认0.6)。
// ⚠️ 鸿蒙端忽略 opacity（透明度由官方 intensity 渐变控制），radius 生效
export type HeatmapOptions = {
    radius?: number
    opacity?: number
}

// 添加/更新标记聚合：海量 POI 场景下按缩放级别自动聚合显示（聚合簇显示数量徽标，点击聚合簇自动放大展开）。
// 重复调用会先移除旧聚合层再重建（规避 MapLibre Android 已知 issue #3519 setGeoJson 竞态崩溃）。
// 与 addMarker 互不影响（聚合使用独立 GeoJSON 图层，不占用 marker 体系）
export declare function addMarkerCluster(points: Array<MapClickDetail>, options?: ClusterOptions): void
// 移除标记聚合层
export declare function removeMarkerCluster(): void
// 添加/更新热力图：密度数据可视化。重复调用先移除旧热力层再重建
export declare function addHeatmap(points: Array<HeatmapItem>, options?: HeatmapOptions): void
// 移除热力层
export declare function removeHeatmap(): void

// ═══════════════════════════════════════════════════════════
// v1.8.0 新增：图层增强
// ═══════════════════════════════════════════════════════════

// 瓦片图层选项（自定义瓦片/WMS 共用，全部可选）
// zIndex：仅支持 0（插到底图注记层之下）与 undefined（默认追加最上层）
// opacity：0~1 透明度（默认 1）
// minZoom/maxZoom：图层显示缩放范围（默认 1~18）
export type TileLayerOptions = {
    zIndex?: number
    opacity?: number
    minZoom?: number
    maxZoom?: number
}

// 运行时替换地图样式（MapLibre Style Spec JSON，须含 version 字段）
// Android/iOS/Web：切换后自动重建此前添加的用户图层（自定义瓦片/WMS/聚合/热力），天底图由样式自带
// 鸿蒙：华为样式 schema 不兼容，通过 onError 上报 code=5
export declare function setStyle(styleJson: string): void

// 还原天地图默认样式（恢复底图并重建用户图层）；未调用过 setStyle 时为幂等 no-op
export declare function removeStyle(): void

// 叠加 WMS 服务图层（自动拼装 GetMap 请求模板；移除仍用 removeCustomTileLayer(id)）
// Android/iOS/Web 支持；鸿蒙 TileOverlay 不支持 bbox 寻址，上报 code=5
export declare function addWMSTileLayer(id: string, wmsUrl: string, layers: string, options?: TileLayerOptions): void

// 当前平台是否支持 canvas 标注（Web=true；Android/iOS/鸿蒙=false）
export declare function isSupportCanvas(): boolean

// ═══════════════════════════════════════════════════════════
// v1.9.0 新增：图片覆盖物（ImageOverlay）
// ═══════════════════════════════════════════════════════════

// 图片覆盖物参数（对齐鸿蒙 mapCommon.ImageOverlayParams）
// image：http(s) 远程图片 URL 或本机缓存文件绝对路径（缓存由调用方维护，插件仅按地址加载）
// ⚠️ Web 端仅支持 http(s)/data: URL（浏览器无法读本机路径），传本机路径上报 code=4
// transparency：0~1 透明度，0=不透明（默认），1=全透明（MapLibre 端换算 raster-opacity=1-transparency）
// zIndex：0=插到注记层之下 / 缺省=置顶 / 正整数=图片覆盖物之间按值排序
//   （仅图片层内部相对层序，不改变与 marker 的相对关系；对齐 TileLayerOptions.zIndex 三档约定）
// bearing：0~360 顺时针旋转，绕 bounds 中心（MapLibre 端通过四角坐标在 Web Mercator 平面旋转等效实现）
// anchorU/anchorV（鸿蒙特有，默认 0.5/0.5）不纳入跨端 API：MapLibre 图片恒铺满四角范围，无锚点语义
export type ImageOverlayOptions = {
    southwest: MapClickDetail
    northeast: MapClickDetail
    image: string
    transparency?: number
    zIndex?: number
    bearing?: number
    visible?: boolean
    clickable?: boolean
}

// 运行时更新（全可选，未传字段保持不变）
export type ImageOverlayUpdateOptions = {
    southwest?: MapClickDetail
    northeast?: MapClickDetail
    image?: string
    transparency?: number
    zIndex?: number
    bearing?: number
    visible?: boolean
    clickable?: boolean
}

// 点击详情：MapLibre 三端 lat/lng=实际点击点；鸿蒙=覆盖物 bounds 中心
export type ImageOverlayClickDetail = {
    id: number
    lat: number
    lng: number
}
export type ImageOverlayClickCallback = (detail: ImageOverlayClickDetail) => void

// 添加图片覆盖物：图片拉伸填满 bounds（bearing≠0 时绕中心旋转）；立即返回 overlay ID（图片异步加载，
// 失败时 onError 上报 code=2（网络）/code=4（解码或参数非法）且该 ID 失效）；
// 立即校验失败（如 Web 传本机路径）返回 0。与 removeOverlay/showOverlay/hideOverlay/clearOverlays 统一管理
export declare function addImageOverlay(params: ImageOverlayOptions): number
// 运行时更新指定 ID 的图片覆盖物（ID 不变；更新项未传字段保持不变）
export declare function updateImageOverlay(id: number, changes: ImageOverlayUpdateOptions): void
// 点击回调（clickable=true 且可见时触发，互斥消费 mapClick；对齐 setMarkerClickCallback 模式）
export declare function setImageOverlayClickCallback(callback: ImageOverlayClickCallback | null): void

// ═══════════════════════════════════════════════════════════
// v1.9.0 新增：GeoJSON 图层（E0，组件层编排）
// ═══════════════════════════════════════════════════════════

// GeoJSON 图层标注样式：field=properties 取地名文本的字段名；positionField=properties 取锚点
// [lng,lat] 的字段名（缺失回退外环质心）；haloColor 支持 #rrggbb / #rrggbbaa（半透明，alpha 在后）
export type GeoJsonLabelStyle = {
    field: string
    fontSize: number
    color: string
    haloColor: string | null
    haloWidth: number
    positionField: string
}

// GeoJSON 图层选项：边界描边（lineColor/lineWidth/lineDash，lineDash=null 实线）+ 填充
// （fillColor=null 不填充；填充仅作用于外环，颜色为插件既有 #rrggbb/#aarrggbb 约定）+ 可选标注
export type GeoJsonLayerOptions = {
    lineColor: string
    lineWidth: number
    lineDash: Array<number> | null
    fillColor: string | null
    label: GeoJsonLabelStyle | null
}

// GeoJSON 层重放通知回调：Android/iOS/Web 样式重建（setStyle/removeStyle/switchMapType 等）完成后触发，
// 组件层据此按快照重放已注册的 GeoJSON 层（防样式切换后图层静默丢失）；鸿蒙无样式重建不触发
export type GeoJsonReplayCallback = () => void
export declare function setGeoJsonReplayCallback(callback: GeoJsonReplayCallback | null): void

// 添加 styled 折线（E0.3a）：dash=null 实线 / 如 [4,4] 虚线；opacity 0~1（缺省 1.0）。
// 与 legacy addPolyline 并行的新原语（legacy Android 注记路径无虚线、Web 硬编码 line-opacity 0.8——均保持零变化）。
// Android 走 LineLayer+GeoJsonSource；iOS 在 legacy source+layer 结构上加 lineDashpattern/lineOpacity；
// Web 参数化 line-dasharray/line-opacity；鸿蒙 MapKit 折线无 dash 参数，忽略 dash 降级实线（console 警告），
// opacity 并入颜色 alpha 通道。返回 overlay ID（0=失败），与 removeOverlay/showOverlay/hideOverlay 统一管理
export declare function addStyledPolyline(points: Array<MapClickDetail>, color: string, width: number, dash: Array<number> | null, opacity?: number): number
