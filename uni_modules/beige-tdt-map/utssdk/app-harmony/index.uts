import { map, mapCommon } from '@kit.MapKit'
import { AsyncCallback, BusinessError } from '@kit.BasicServicesKit'
import { BuilderNode } from '@kit.ArkUI'
import { http } from '@kit.NetworkKit'
import { geoLocationManager } from '@kit.LocationKit'
// v1.9.0: 图片覆盖物 PixelMap 管线（华为官方 FAQ：ImageOverlayParams.image 仅支持 ResourceStr/PixelMap，不支持网络 URL）
import { image } from '@kit.ImageKit'
// 导入混编实现的声明式 UI 构建函数
import { buildMapComponent, TDTMapBuilderOptions } from './builder.ets'
import {
    TDMapOptions, MapClickDetail, MapBoundsDetail, MapErrorDetail, MapSizeDetail, MapViewportDetail,
    MapClickCallback, MapReadyCallback, MapErrorCallback, MarkerClickCallback, GeocodeCallback, SearchOptions,
    MapLongClickCallback, CameraChangeCallback, ClusterOptions, HeatmapItem, HeatmapOptions, TileLayerOptions,
    ImageOverlayOptions, ImageOverlayUpdateOptions, ImageOverlayClickCallback
} from '../interface.uts'

// ⚠️ 天地图 Key 类型说明（自新系统升级后严格区分，混用会导致瓦片不显示）:
//   - "浏览器端" key：校验 Referer 头 + 域名白名单 → 原生 App 不发送 Referer → 被拒
//   - "服务端" key：校验 IP 白名单（留空则不限制）→ 三端通用推荐
//   - "Android平台" key：仅 Android 可用
//   🔧 鸿蒙/iOS/Android 统一使用"服务端"类型 key（IP 白名单留空）

let mapController: map.MapComponentController | null = null
let builderNode: BuilderNode<[TDTMapBuilderOptions]> | null = null
let tileOverlay: map.TileOverlay | null = null
let labelOverlay: map.TileOverlay | null = null
let onClickCallback: MapClickCallback | null = null
let onReadyCallback: MapReadyCallback | null = null
let onErrorCallback: MapErrorCallback | null = null
let currentApiKey: string = ''
let currentMapType: string = 'vec'

// Camera state tracking（鸿蒙 MapKit 不提供 getCameraPosition，需手动跟踪）
let currentLat: number = 0
let currentLng: number = 0
let currentZoom: number = 0
let currentBearing: number = 0
let currentTilt: number = 0

// Polygon storage
let polygons: Array<map.MapPolygon> = []
let polylines: Array<map.MapPolyline> = []
let circles: Array<map.MapCircle> = []
let rectangles: Array<map.MapPolygon> = []
// Marker tracking（Android/iOS 模式：逐个管理，避免 mapController.clear() 连带清除非标记覆盖物）
let markerList: Array<map.Marker> = []

// ── 覆盖物 ID 追踪系统 ──
// 为每个添加的覆盖物分配唯一 ID，支持 removeOverlay/showOverlay/hideOverlay 单个操作
let overlayIdCounter: number = 0
let overlayMap = new Map<number, OverlayEntry>()

type OverlayEntry = {
    id: number
    type: string  // 'marker' | 'polygon' | 'polyline' | 'circle' | 'rectangle' | 'label' | 'image'
    nativeRef: map.BaseOverlay | null  // 鸿蒙原生覆盖物（Marker/MapPolygon/MapPolyline/MapCircle/ImageOverlay/TileOverlay 均继承 BaseOverlay）
    isVisible: boolean
}

// ── v1.9.0: 图片覆盖物状态 ──
// http(s) 走「http 下载 ArrayBuffer → image.createImageSource → createPixelMap（>4096 下采样）」管线；
// 本机缓存路径直接 createImageSource(path)；PixelMap 由插件持有并在移除/清理时 release
type ImageOverlayExt = {
    params: ImageOverlayOptions
    pixelMap: image.PixelMap | null
    pendingUpdate: ImageOverlayUpdateOptions | null   // 图片加载期间收到的更新累积器（挂载完成后统一重放）
}
let imageOverlayExt = new Map<number, ImageOverlayExt>()
let imageOverlayIds: Array<number> = []
let imageOverlayClickCallback: ImageOverlayClickCallback | null = null
// 华为 ImageOverlay.getId() → 插件 overlay ID 反查表（imageOverlayClick 回调映射；真机验证 getId 返回类型）
let imageOverlayNativeIdMap = new Map<string, number>()
// 大图下采样目标（防 OOM，GPU 纹理安全边界）
const IMAGE_OVERLAY_MAX_DIM: number = 4096

let markerClickCallback: MarkerClickCallback | null = null
let mapLongClickCallback: MapLongClickCallback | null = null
let cameraChangeCallback: CameraChangeCallback | null = null

// 分配 overlay ID 并存入追踪表
function allocateOverlayId(type: string, nativeRef: any): number {
    overlayIdCounter++
    const id = overlayIdCounter
    const entry: OverlayEntry = { id: id, type: type, nativeRef: nativeRef, isVisible: true }
    overlayMap.set(id, entry)
    return id
}

// ══════════════════════════════════════════════
// v1.9.0 新增：E0 GeoJSON 层重放通知（鸿蒙无样式 JSON 重建，回调仅存储永不触发）
// ══════════════════════════════════════════════
type GeoJsonReplayCallback = () => void
let geoJsonReplayCallback: GeoJsonReplayCallback | null = null

export function setGeoJsonReplayCallback(callback: GeoJsonReplayCallback | null): void {
    geoJsonReplayCallback = callback
}

// v1.9.0: mapType='blank' 白底降级——华为 MapKit 无样式 JSON，无法实现白底样式，
// 按子模块既有平台差异惯例显式上报（console.warn + onErrorCallback code=5）并回退 vec 底图
function resolveEffectiveMapType(mapType: string): string {
    if (mapType == 'blank') {
        console.warn("TDTMap: 鸿蒙 MapKit 不支持白底样式（无样式 JSON），已回退 vec 底图")
        if (onErrorCallback != null) {
            onErrorCallback({ code: 5, message: '平台不支持：鸿蒙 MapKit 无样式 JSON，mapType=blank 已回退 vec 底图' })
        }
        return 'vec'
    }
    return mapType
}

// 从 overlayMap 中清除指定类型的所有条目
function clearOverlayType(type: string): void {
    const keysToRemove: Array<number> = []
    overlayMap.forEach((entry: OverlayEntry, key: number) => {
        if (entry.type == type) {
            keysToRemove.push(key)
        }
    })
    for (let i = 0; i < keysToRemove.length; i++) {
        overlayMap.delete(keysToRemove[i])
    }
}

// 天地图 DataServer XYZ 格式瓦片 URL
// 鸿蒙 MapKit 官方约束：tileUrl 必须以 http/https 开头且包含 {x}、{y}、{z} 占位符。
// 注意：MapKit TileOverlay 单图层只允许一个 URL，且最多 10 个图层，无法像 Android/iOS 那样并行多子域名加载。
// 鸿蒙端性能依赖 MapKit 自身 HTTP 连接池，实测通常够用。
// ArkTS 禁止 Record 类型标注的对象字面量初始化，改用 Map + 显式 set
const TDT_TILE_URLS = new Map<string, string>()
TDT_TILE_URLS.set('vec', 'https://t0.tianditu.gov.cn/DataServer?T=vec_w&x={x}&y={y}&l={z}&tk=')
TDT_TILE_URLS.set('cva', 'https://t0.tianditu.gov.cn/DataServer?T=cva_w&x={x}&y={y}&l={z}&tk=')
TDT_TILE_URLS.set('img', 'https://t0.tianditu.gov.cn/DataServer?T=img_w&x={x}&y={y}&l={z}&tk=')
TDT_TILE_URLS.set('cia', 'https://t0.tianditu.gov.cn/DataServer?T=cia_w&x={x}&y={y}&l={z}&tk=')
TDT_TILE_URLS.set('ter', 'https://t0.tianditu.gov.cn/DataServer?T=ter_w&x={x}&y={y}&l={z}&tk=')
TDT_TILE_URLS.set('cta', 'https://t0.tianditu.gov.cn/DataServer?T=cta_w&x={x}&y={y}&l={z}&tk=')

// 地图类型与图层映射（对象字面量需经工厂函数以显式类型承接，规避 as 断言）
type TileLayerIds = { base: string, label: string }
function makeTileLayerIds(base: string, label: string): TileLayerIds {
    const ids: TileLayerIds = { base: base, label: label }
    return ids
}
const TYPE_LAYER_MAP = new Map<string, TileLayerIds>()
TYPE_LAYER_MAP.set('vec', makeTileLayerIds('vec', 'cva'))
TYPE_LAYER_MAP.set('img', makeTileLayerIds('img', 'cia'))
TYPE_LAYER_MAP.set('ter', makeTileLayerIds('ter', 'cta'))

// 预创建的所有瓦片图层 [vec:0, img:1, ter:2]
// 存储所有图层引用以便切换时直接 toggle，无需移除重建
type TileOverlayPair = { base: map.TileOverlay | null, label: map.TileOverlay | null }
let allTileOverlays: Array<TileOverlayPair> = [
    { base: null, label: null },
    { base: null, label: null },
    { base: null, label: null }
]

// 辅助函数：根据地图类型获取数组索引
function getTypeIndex(type: string): number {
    switch (type) {
        case 'vec': return 0
        case 'img': return 1
        case 'ter': return 2
        default: return 0
    }
}

// 辅助函数：将十六进制颜色字符串转换为 ARGB 数值
function parseColorHex(hexColor: string): number {
    let hex = hexColor
    if (hex.startsWith('#')) {
        hex = hex.substring(1)
    }
    if (hex.length == 6) {
        hex = 'FF' + hex
    }
    return Number('0x' + hex)
}

// context7 验证：addTileOverlay 返回 TileOverlay（同步），与 addMarker/addPolygon（返回 Promise）不同。
// await 对同步返回值安全透传，此处使用 await 仅为与代码风格保持一致。
async function createTileLayerPair(mapType: string, apiKey: string): Promise<TileOverlayPair> {
    const layers = TYPE_LAYER_MAP.get(mapType)
    if (layers == null) {
        return { base: null, label: null }
    }

    // TileOverlayParams 自 5.0.3(15) 支持；TileOverlayOptions 及 diskCacheEnabled/diskCacheSize
    // 磁盘缓存参数需 6.0.0(20)+，为兼容低版本此处不使用
    let baseOptions: mapCommon.TileOverlayParams = {
        tileUrl: (TDT_TILE_URLS.get(layers.base) ?? '') + apiKey,
        transparency: 0,
        fadeIn: true
    }
    let baseOverlay = await mapController?.addTileOverlay(baseOptions) ?? null

    let labelOptions: mapCommon.TileOverlayParams = {
        tileUrl: (TDT_TILE_URLS.get(layers.label) ?? '') + apiKey,
        transparency: 0,
        fadeIn: true
    }
    let labelOverlay = await mapController?.addTileOverlay(labelOptions) ?? null

    return { base: baseOverlay, label: labelOverlay }
}

// 预创建所有 3 类地图瓦片图层对，非活跃类型立即移除（后续切换时重建）
async function preCreateAllTileLayers(apiKey: string, activeType: string): Promise<void> {
    const types = ['vec', 'img', 'ter']
    for (let i = 0; i < 3; i++) {
        const type = types[i]
        try {
            const pair = await createTileLayerPair(type, apiKey)
            allTileOverlays[i] = pair
            if (type == activeType) {
                tileOverlay = pair.base
                labelOverlay = pair.label
            } else {
                pair.base?.remove()
                pair.label?.remove()
                allTileOverlays[i] = { base: null, label: null }
            }
        } catch (e) {
            console.error("TDTMap: Failed to pre-create tile layer for " + type, (e as Error).message ?? e)
            if (onErrorCallback != null) {
                onErrorCallback({ code: 3, message: 'Tile layer pre-creation failed for ' + type + ': ' + ((e as Error).message ?? String(e)) })
            }
        }
    }
}

@UTSJS.keepAlive
export function initMap(
    container: UniNativeViewElement,
    options: TDMapOptions,
    onClick: MapClickCallback,
    onReady: MapReadyCallback,
    onError: MapErrorCallback
): void {
    onClickCallback = onClick
    onReadyCallback = onReady
    onErrorCallback = onError
    currentApiKey = options.apiKey
    // v1.9.0: blank 白底降级 vec（回退时机在日志/console 与 mapError 双通道提示）
    currentMapType = resolveEffectiveMapType(options.mapType)

    console.log("TDTMap: initMap key=" + (options.apiKey.length > 0 ? "***" : "空") + " type=" + options.mapType)

    // 诊断日志：输出瓦片 URL（复制到浏览器验证 key 是否有效）
    const diagUrl = (TDT_TILE_URLS.get('vec') ?? '') + options.apiKey
    console.log("TDTMap: 诊断URL(浏览器验证)= " + diagUrl.replace("{x}", "537").replace("{y}", "389").replace("{z}", "10"))

    // 记录初始相机状态
    currentLat = options.latitude
    currentLng = options.longitude
    currentZoom = options.zoom
    currentBearing = 0
    currentTilt = 0

    // 检查 API Key
    if (options.apiKey == null || options.apiKey.length == 0) {
        if (onErrorCallback != null) {
            onErrorCallback({ code: 1, message: 'API Key is empty' })
        }
        return
    }

    // 鸿蒙官方模式：MapComponent 通过 WrappedBuilder 绑定进 native-view，
    // 控制器通过 MapComponent 构造回调 mapCallback 获取；初始视角通过 mapOptions 设置
    // v1.6.0: 控件显隐 —— context7 验证华为官方文档（developer.huawei.com/consumer/cn/doc/
    // harmonyos-guides/map-controls-and-interaction）：zoomControlsEnabled 默认 true、
    // scaleControlsEnabled 默认 false，均需按插件 props（默认 true）显式设置
    const mapOptions: mapCommon.MapOptions = {
        position: {
            target: { latitude: options.latitude, longitude: options.longitude },
            zoom: options.zoom
        },
        zoomControlsEnabled: options.showZoomControl !== false,
        scaleControlsEnabled: options.showScaleControl !== false
    }
    const mapCallback: AsyncCallback<map.MapComponentController> = (err, controller) => {
        if (err != null) {
            console.error("TDTMap: MapKit initialization failed", err.message)
            if (onErrorCallback != null) {
                onErrorCallback({ code: 4, message: 'MapKit controller init failed: ' + err.message })
            }
            return
        }
        mapController = controller

        // v1.6.0: 华为 logo 不可移除/遮挡（官方政策），移位右下角避让左下角 uvue 版权条；
        // 选择 BOTTOM_END 而非 TOP_END：华为指南针控件默认位于右上角（地图旋转/倾斜时
        // 出现），logo 放右上会与之重叠；BOTTOM_END 为华为官方文档示例位置，与缩放
        // 控件共存由官方控件系统自动避让。
        // 审图号为华为地图内容与天地图无关，显式关闭（setApproveNumberEnabled 自 6.1.0(23) 支持），
        // 版权由 uvue 版权条统一承担
        // 来源：developer.huawei.com/consumer/cn/doc/harmonyos-guides/map-controls-and-interaction
        // 低版本 MapKit 方法不存在会抛异常，此处 try/catch 降级——控件配置失败不应阻断瓦片创建
        try {
            controller.setLogoAlignment(mapCommon.LogoAlignment.BOTTOM_END)
            controller.setApproveNumberEnabled(false)
        } catch (e) {
            console.warn("TDTMap: 控件配置失败（低版本 MapKit 不支持）", (e as Error).message ?? String(e))
        }

        // 预创建所有 3 类瓦片图层对（异步，addTileOverlay 返回 Promise）
        // 注意：HarmonyOS AsyncCallback 不能标记为 async，使用 .then() 处理
        // v1.9.0: currentMapType 已含 blank→vec 降级，勿回退用 options.mapType
        preCreateAllTileLayers(options.apiKey, currentMapType).then(() => {
            // 地图点击事件 — HarmonyOS MapKit LatLng 使用 latitude/longitude
            const evtMgr = controller.getEventManager()
            evtMgr.on('mapClick', (latLng: mapCommon.LatLng) => {
                if (onClickCallback != null) {
                    onClickCallback({
                        lat: latLng.latitude,
                        lng: latLng.longitude
                    })
                }
            })

            // 标记点击事件 — HarmonyOS MapKit markerClick 事件
            evtMgr.on('markerClick', (marker: map.Marker) => {
                const cb = markerClickCallback
                if (cb != null) {
                    const position = marker.getPosition()
                    if (position != null) {
                        cb({ lat: position.latitude, lng: position.longitude })
                    }
                }
            })

            // v1.9.0: 图片覆盖物点击 — 华为 MapKit imageOverlayClick 事件（官方文档验证）
            // 回调参数为 map.ImageOverlay，getId() 反查插件 overlay ID；坐标取 bounds 中心（华为不提供点击点）
            evtMgr.on('imageOverlayClick', (overlay: map.ImageOverlay) => {
                const imgCb = imageOverlayClickCallback
                if (imgCb != null && overlay != null) {
                    let pluginId = 0
                    const mappedId = imageOverlayNativeIdMap.get(String(overlay.getId()))
                    if (mappedId != null) {
                        pluginId = mappedId
                    }
                    if (pluginId > 0) {
                        const extClick = imageOverlayExt.get(pluginId)
                        if (extClick != null) {
                            imgCb({
                                id: pluginId,
                                lat: (extClick.params.southwest.lat + extClick.params.northeast.lat) / 2.0,
                                lng: (extClick.params.southwest.lng + extClick.params.northeast.lng) / 2.0
                            })
                        }
                    }
                }
            })

            // v1.4.0: 长按事件 — context7 验证：HarmonyOS MapKit mapLongClick 事件
            evtMgr.on('mapLongClick', (latLng: mapCommon.LatLng) => {
                const cb = mapLongClickCallback
                if (cb != null) {
                    cb({ lat: latLng.latitude, lng: latLng.longitude })
                }
            })

            // v1.4.0: 相机变化事件 — WebSearch 验证：华为官方 MapEventManager 无 cameraChange 事件
            // 实际存在的事件为：cameraMoveStart / cameraMove / cameraIdle（均为 Callback<void>）
            // cameraMove：相机移动中持续触发，静默更新状态跟踪变量（不回调用户，避免 60fps 洪水）
            // cameraIdle：相机停止时触发，执行用户 cameraChangeCallback
            // 参考：developer.huawei.com/consumer/cn/doc/harmonyos-guides/map-listening-V5
            evtMgr.on('cameraMove', () => {
                const camPos = controller.getCameraPosition()
                if (camPos != null) {
                    const tgt = camPos.target
                    if (tgt != null) {
                        currentLat = tgt.latitude
                        currentLng = tgt.longitude
                    }
                    if (camPos.bearing != null) currentBearing = camPos.bearing
                    if (camPos.tilt != null) currentTilt = camPos.tilt
                    if (camPos.zoom != null) currentZoom = camPos.zoom
                }
            })
            evtMgr.on('cameraIdle', () => {
                const cb = cameraChangeCallback
                if (cb != null) {
                    cb({ lat: currentLat, lng: currentLng })
                }
            })

            if (onReadyCallback != null) {
                onReadyCallback()
            }
        })
    }

    // 将声明式组件绑定到 native-view（uni-app x 官方 API）
    builderNode = container.bindHarmonyWrappedBuilder(
        wrapBuilder<[TDTMapBuilderOptions]>(buildMapComponent),
        { mapOptions: mapOptions, mapCallback: mapCallback }
    )
}

// context7 验证：addTileOverlay (createTileLayerPair) 返回 Promise，fire-and-forget 重建不阻塞返回
export function switchMapType(mapType: string): void {
    if (mapController == null) return
    // v1.9.0: blank 白底降级 vec（与 initMap 同款回退）
    const effectiveType = resolveEffectiveMapType(mapType)
    const oldType = currentMapType
    currentMapType = effectiveType

    // 移除旧活跃图层
    const oldIndex = getTypeIndex(oldType)
    allTileOverlays[oldIndex].base?.remove()
    allTileOverlays[oldIndex].label?.remove()
    allTileOverlays[oldIndex] = { base: null, label: null }

    // 重建目标类型图层（fire-and-forget）
    const layers = TYPE_LAYER_MAP.get(effectiveType)
    if (layers == null) return
    addTiandituTileLayer(effectiveType, currentApiKey).then(() => {
        const newIndex = getTypeIndex(effectiveType)
        allTileOverlays[newIndex] = { base: tileOverlay, label: labelOverlay }
    }).catch((e: Error) => {
        console.error("TDTMap: switchMapType 瓦片切换失败: " + ((e as Error).message ?? String(e)))
        if (onErrorCallback != null) {
            onErrorCallback({ code: 3, message: 'Tile layer switch failed for ' + effectiveType + ': ' + ((e as Error).message ?? String(e)) })
        }
    })
}

async function addTiandituTileLayer(mapType: string, apiKey: string): Promise<void> {
    try {
        const pair = await createTileLayerPair(mapType, apiKey)
        tileOverlay = pair.base
        labelOverlay = pair.label
    } catch (e) {
        console.error("TDTMap: Failed to add tile layer", (e as Error).message ?? e)
        if (onErrorCallback != null) {
            onErrorCallback({ code: 3, message: 'Tile layer loading failed: ' + ((e as Error).message ?? String(e)) })
        }
    }
}

export function setCenter(lat: number, lng: number): void {
    if (mapController != null) {
        currentLat = lat
        currentLng = lng
        // context7 验证：CameraPosition 必须包含 zoom 避免字段缺失时 reset 为默认值
        const cameraPos: mapCommon.CameraPosition = {
            target: { latitude: lat, longitude: lng },
            zoom: currentZoom,
            bearing: currentBearing,
            tilt: currentTilt
        }
        mapController.moveCamera(map.newCameraPosition(cameraPos))
    }
}

export function setZoom(zoom: number): void {
    if (mapController != null) {
        currentZoom = zoom
        // context7 验证：CameraPosition 必须包含 target 避免字段缺失时重置为 (0,0)
        const cameraPos: mapCommon.CameraPosition = {
            target: { latitude: currentLat, longitude: currentLng },
            zoom: zoom,
            bearing: currentBearing,
            tilt: currentTilt
        }
        mapController.moveCamera(map.newCameraPosition(cameraPos))
    }
}

export function getCenter(): MapClickDetail {
    return { lat: currentLat, lng: currentLng }
}

export function getZoom(): number {
    return currentZoom
}

export function fitBounds(minLat: number, minLng: number, maxLat: number, maxLng: number, padding: number): void {
    if (mapController == null) return

    // 计算边界中心点和合适缩放级别
    const centerLat = (minLat + maxLat) / 2
    const centerLng = (minLng + maxLng) / 2
    const latSpan = maxLat - minLat
    const lngSpan = maxLng - minLng
    const maxSpan = Math.max(latSpan, lngSpan)

    let zoom = Math.log(360 / maxSpan) / Math.log(2)
    if (padding > 0) zoom -= padding / 50
    if (zoom < 1) zoom = 1
    if (zoom > 20) zoom = 20
    zoom = Math.floor(zoom)

    const fitPos: mapCommon.CameraPosition = {
        target: { latitude: centerLat, longitude: centerLng },
        zoom: zoom,
        bearing: currentBearing,
        tilt: currentTilt
    }
    mapController.moveCamera(map.newCameraPosition(fitPos))

    currentLat = centerLat
    currentLng = centerLng
    currentZoom = zoom
}

export function addMarker(lat: number, lng: number, title: string, snippet?: string): number {
    if (mapController != null) {
        // 预分配 ID（同步），异步完成后更新 nativeRef
        overlayIdCounter++
        const id = overlayIdCounter
        const entry: OverlayEntry = { id: id, type: 'marker', nativeRef: null, isVisible: true }
        overlayMap.set(id, entry)
        // context7 验证：addMarker 返回 Promise 且可能 reject（错误码 401/1002601001），需要错误处理
        const markerOpts: mapCommon.MarkerOptions = {
            position: { latitude: lat, longitude: lng },
            title: title
        }
        // v1.3.0: 设置 snippet 以支持信息窗口
        if (snippet != null && snippet.length > 0) {
            markerOpts.snippet = snippet
        }
        mapController.addMarker(markerOpts).then((marker: map.Marker) => {
            markerList.push(marker)
            // 更新 nativeRef
            const entry = overlayMap.get(id)
            if (entry != null) {
                entry.nativeRef = marker
            }
        }).catch((e: Error) => {
            console.error("TDTMap: addMarker 失败: " + ((e as Error).message ?? String(e)))
            overlayMap.delete(id)
        })
        return id
    }
    return 0
}

export function clearMarkers(): void {
    if (mapController == null) {
        clearOverlayType('marker')
        clearOverlayType('label')
        markerList = []
        return
    }
    // context7 验证：HarmonyOS clear() 会清除所有覆盖物（含多边形/折线/圆），
    // 改为逐个 remove() 仅清除标记，避免连带清除非标记覆盖物
    for (let i = 0; i < markerList.length; i++) {
        markerList[i].remove()
    }
    markerList = []
    clearOverlayType('marker')
    clearOverlayType('label')
}

// context7 验证：addPolygon 官方文档标注返回 Promise<MapPolygon>，但接口层要求同步返回 number
// 采用预分配 ID + .then() 异步填 nativeRef 模式（与 addMarker 一致），确保三端返回类型一致
// 避免 async 函数导致的 Promise<number> 类型断裂（组件层拿到 Promise 而非 number，overlay ID 追踪失效）
export function addPolygon(points: Array<MapClickDetail>, color: string, fillColor: string): number {
    if (mapController == null) return 0
    // 预分配 ID（同步），异步完成后更新 nativeRef
    overlayIdCounter++
    const id = overlayIdCounter
    const entry: OverlayEntry = { id: id, type: 'polygon', nativeRef: null, isVisible: true }
    overlayMap.set(id, entry)
    const latLngs: Array<mapCommon.LatLng> = []
    for (let i = 0; i < points.length; i++) {
        const ll: mapCommon.LatLng = { latitude: points[i].lat, longitude: points[i].lng }
        latLngs.push(ll)
    }
    const strokeColorNum = parseColorHex(color)
    const fillColorNum = parseColorHex(fillColor)
    const polygonOpts: mapCommon.MapPolygonOptions = {
        points: latLngs,
        strokeColor: strokeColorNum,
        fillColor: fillColorNum
    }
    mapController.addPolygon(polygonOpts).then((polygon: map.MapPolygon) => {
        if (polygon != null) {
            polygons.push(polygon)
            const entry = overlayMap.get(id)
            if (entry != null) {
                entry.nativeRef = polygon
            }
        }
    }).catch((e: Error) => {
        console.error("TDTMap: 添加多边形失败: " + ((e as Error).message ?? String(e)))
        overlayMap.delete(id)
        if (onErrorCallback != null) {
            onErrorCallback({ code: 4, message: "添加多边形失败: " + ((e as Error).message ?? String(e)) })
        }
    })
    return id
}

export function clearPolygons(): void {
    if (mapController == null) {
        clearOverlayType('polygon')
        polygons = []
        return
    }
    for (let i = 0; i < polygons.length; i++) {
        polygons[i].remove()
    }
    clearOverlayType('polygon')
    polygons = []
}

// ==================== 覆盖物：折线 ====================

// context7 验证：addPolyline 返回 Promise<MapPolyline>，改用预分配 ID + .then() 同步返回 number
export function addPolyline(points: Array<MapClickDetail>, color: string, width: number): number {
    if (mapController == null || points.length < 2) return 0
    // 预分配 ID（同步）
    overlayIdCounter++
    const id = overlayIdCounter
    const entry: OverlayEntry = { id: id, type: 'polyline', nativeRef: null, isVisible: true }
    overlayMap.set(id, entry)
    const latLngs: Array<mapCommon.LatLng> = []
    for (let i = 0; i < points.length; i++) {
        const ll: mapCommon.LatLng = { latitude: points[i].lat, longitude: points[i].lng }
        latLngs.push(ll)
    }
    const colorNum = parseColorHex(color)
    const polylineOpts: mapCommon.MapPolylineOptions = {
        points: latLngs,
        color: colorNum,
        width: width,
        visible: true
    }
    mapController.addPolyline(polylineOpts).then((polyline: map.MapPolyline) => {
        if (polyline != null) {
            polylines.push(polyline)
            const entry = overlayMap.get(id)
            if (entry != null) {
                entry.nativeRef = polyline
            }
        }
    }).catch((e: Error) => {
        console.error("TDTMap: 添加折线失败: " + ((e as Error).message ?? String(e)))
        overlayMap.delete(id)
        if (onErrorCallback != null) {
            onErrorCallback({ code: 4, message: "添加折线失败: " + ((e as Error).message ?? String(e)) })
        }
    })
    return id
}

// ══════════════════════════════════════════════
// v1.9.0 新增：E0.3a styled 折线
// ══════════════════════════════════════════════
// 华为 MapKit MapPolylineOptions 无 dash 数组参数（与 legacy addPolyline 同为实线），
// 按任务约定降级：忽略 dash 并 console 警告（模块级 flag 仅提示一次防刷屏）；
// opacity 并入颜色 alpha 通道（MapKit 无独立透明度参数）。
// 遗留验证项：若后续 DevEco SDK 验证 MapPolylineOptions 存在 dotted 字段，可低成本接入虚线
let styledDashWarned: boolean = false

// 颜色数值（ARGB）的 alpha 通道替换为 opacity（0~1）
function applyOpacityToColor(colorNum: number, opacity: number): number {
    if (opacity >= 1) return colorNum
    if (opacity < 0) return (0 as number) * 16777216 + (colorNum % 16777216)
    const alpha = Math.round(opacity * 255)
    return alpha * 16777216 + (colorNum % 16777216)
}

export function addStyledPolyline(points: Array<MapClickDetail>, color: string, width: number, dash: Array<number> | null, opacity?: number): number {
    if (mapController == null || points.length < 2) return 0
    if (dash != null && dash.length > 0 && !styledDashWarned) {
        styledDashWarned = true
        console.warn("TDTMap: 鸿蒙 MapKit 折线不支持虚线（MapPolylineOptions 无 dash 参数），已降级实线")
    }
    // 预分配 ID（同步）
    overlayIdCounter++
    const id = overlayIdCounter
    const entry: OverlayEntry = { id: id, type: 'styledPolyline', nativeRef: null, isVisible: true }
    overlayMap.set(id, entry)
    const latLngs: Array<mapCommon.LatLng> = []
    for (let i = 0; i < points.length; i++) {
        const ll: mapCommon.LatLng = { latitude: points[i].lat, longitude: points[i].lng }
        latLngs.push(ll)
    }
    const colorNum = applyOpacityToColor(parseColorHex(color), opacity ?? 1)
    const polylineOpts: mapCommon.MapPolylineOptions = {
        points: latLngs,
        color: colorNum,
        width: width,
        visible: true
    }
    mapController.addPolyline(polylineOpts).then((polyline: map.MapPolyline) => {
        if (polyline != null) {
            polylines.push(polyline)
            const entry = overlayMap.get(id)
            if (entry != null) {
                entry.nativeRef = polyline
            }
        }
    }).catch((e: Error) => {
        console.error("TDTMap: 添加 styled 折线失败: " + ((e as Error).message ?? String(e)))
        overlayMap.delete(id)
        if (onErrorCallback != null) {
            onErrorCallback({ code: 4, message: "添加 styled 折线失败: " + ((e as Error).message ?? String(e)) })
        }
    })
    return id
}

// v1.9.2: 批量 styled 折线——鸿蒙 MapKit 无多段线几何，原语内部逐线 addPolyline
// （省 N 次跨端桥接与 ID 分配；样式参数与单线版一致，dash 仍降级实线）。
// 单个 overlay ID 管整批：type='styledPolylineBatch'，nativeRef=线数组（remove/show/hide 有独立分支）；
// 各线同时入全局 polylines 数组（clearOverlays 横扫兜底，逐条 remove 后再过滤）
export function addStyledPolylineBatch(points: Array<MapClickDetail>, ringLengths: Array<number>, color: string, width: number, dash: Array<number> | null, opacity?: number): number {
    if (mapController == null || points.length == 0 || ringLengths.length == 0) return 0
    if (dash != null && dash.length > 0 && !styledDashWarned) {
        styledDashWarned = true
        console.warn("TDTMap: 鸿蒙 MapKit 折线不支持虚线（MapPolylineOptions 无 dash 参数），已降级实线")
    }
    overlayIdCounter++
    const id = overlayIdCounter
    const refs: Array<map.MapPolyline> = []
    const entry: OverlayEntry = { id: id, type: 'styledPolylineBatch', nativeRef: refs as any | null, isVisible: true }
    overlayMap.set(id, entry)
    const colorNum = applyOpacityToColor(parseColorHex(color), opacity ?? 1)
    let added = 0
    let offset = 0
    for (let i = 0; i < ringLengths.length; i++) {
        const len = ringLengths[i].toInt()
        if (len < 2 || offset + len > points.length) {
            offset += len
            continue
        }
        const latLngs: Array<mapCommon.LatLng> = []
        for (let j = 0; j < len; j++) {
            const ll: mapCommon.LatLng = { latitude: points[offset + j].lat, longitude: points[offset + j].lng }
            latLngs.push(ll)
        }
        const polylineOpts: mapCommon.MapPolylineOptions = {
            points: latLngs,
            color: colorNum,
            width: width,
            visible: true
        }
        added++
        mapController.addPolyline(polylineOpts).then((polyline: map.MapPolyline) => {
            if (polyline != null) {
                refs.push(polyline)
                polylines.push(polyline)
            }
        }).catch((e: Error) => {
            console.error("TDTMap: 批量 styled 折线单线失败: " + ((e as Error).message ?? String(e)))
        })
        offset += len
    }
    if (added == 0) {
        overlayMap.delete(id)
        return 0
    }
    return id
}

// v1.9.0: E0.3b styled 文本——鸿蒙降级档：MapKit 无离屏文字位图管线（UTS 侧无已验证的
// drawing/render 通道），且 MapKit 注记 title 非常显文本（与 Android 同需交互触发）。
// 按子模块平台差异惯例显式上报（console.warn + code=5）并返回 0（无地名降级档，登记偏差）；
// 遗留项：后续接入 @ohos.graphics.drawing 离屏绘制 → PixelMap → 既有图片覆盖物通路
type StyledTextOptions = {
    fontSize: number
    color: string
    haloColor: string | null
    haloWidth: number
}

let styledTextWarned: boolean = false

export function addStyledText(lat: number, lng: number, text: string, options: StyledTextOptions): number {
    if (!styledTextWarned) {
        styledTextWarned = true
        console.warn("TDTMap: 鸿蒙端暂不支持 styled 文本标注（无离屏文字位图管线），已跳过: " + text)
    }
    if (onErrorCallback != null) {
        onErrorCallback({ code: 5, message: '平台不支持：鸿蒙端 styled 文本标注暂未实现（无地名降级档）' })
    }
    return 0
}

// ==================== 覆盖物：圆（鸿蒙原生支持） ====================

// context7 验证：addCircle 返回 Promise<MapCircle>，改用预分配 ID + .then() 同步返回 number
export function addCircle(lat: number, lng: number, radius: number, color: string, fillColor: string): number {
    if (mapController == null) return 0
    // 预分配 ID（同步）
    overlayIdCounter++
    const id = overlayIdCounter
    const entry: OverlayEntry = { id: id, type: 'circle', nativeRef: null, isVisible: true }
    overlayMap.set(id, entry)
    const strokeColorNum = parseColorHex(color)
    const fillColorNum = parseColorHex(fillColor)
    const circleOpts: mapCommon.MapCircleOptions = {
        center: { latitude: lat, longitude: lng },
        radius: radius,
        strokeColor: strokeColorNum,
        fillColor: fillColorNum,
        strokeWidth: 2,
        visible: true
    }
    mapController.addCircle(circleOpts).then((circle: map.MapCircle) => {
        if (circle != null) {
            circles.push(circle)
            const entry = overlayMap.get(id)
            if (entry != null) {
                entry.nativeRef = circle
            }
        }
    }).catch((e: Error) => {
        console.error("TDTMap: 添加圆失败: " + ((e as Error).message ?? String(e)))
        overlayMap.delete(id)
        if (onErrorCallback != null) {
            onErrorCallback({ code: 4, message: "添加圆失败: " + ((e as Error).message ?? String(e)) })
        }
    })
    return id
}

// ==================== 覆盖物：矩形 ====================

// context7 验证：addPolygon 返回 Promise<MapPolygon>，改用预分配 ID + .then() 同步返回 number（与 addPolygon 一致）
export function addRectangle(minLat: number, minLng: number, maxLat: number, maxLng: number, color: string, fillColor: string): number {
    if (mapController == null) return 0
    // 预分配 ID（同步），异步完成后更新 nativeRef
    overlayIdCounter++
    const id = overlayIdCounter
    const entry: OverlayEntry = { id: id, type: 'rectangle', nativeRef: null, isVisible: true }
    overlayMap.set(id, entry)
    const latLngs: Array<mapCommon.LatLng> = [
        { latitude: minLat, longitude: minLng },
        { latitude: maxLat, longitude: minLng },
        { latitude: maxLat, longitude: maxLng },
        { latitude: minLat, longitude: maxLng }
    ]
    const strokeColorNum = parseColorHex(color)
    const fillColorNum = parseColorHex(fillColor)
    const polygonOpts: mapCommon.MapPolygonOptions = {
        points: latLngs,
        strokeColor: strokeColorNum,
        fillColor: fillColorNum
    }
    mapController.addPolygon(polygonOpts).then((polygon: map.MapPolygon) => {
        if (polygon != null) {
            rectangles.push(polygon)
            const entry = overlayMap.get(id)
            if (entry != null) {
                entry.nativeRef = polygon
            }
        }
    }).catch((e: Error) => {
        console.error("TDTMap: 添加矩形失败: " + ((e as Error).message ?? String(e)))
        overlayMap.delete(id)
        if (onErrorCallback != null) {
            onErrorCallback({ code: 4, message: "添加矩形失败: " + ((e as Error).message ?? String(e)) })
        }
    })
    return id
}

// ==================== 覆盖物：文字标注 ====================

export function addLabel(lat: number, lng: number, text: string): number {
    if (mapController != null) {
        // 预分配 ID（同步），异步完成后更新 nativeRef
        overlayIdCounter++
        const id = overlayIdCounter
        const entry: OverlayEntry = { id: id, type: 'label', nativeRef: null, isVisible: true }
        overlayMap.set(id, entry)
        // context7 验证：addMarker 可能 reject，统一错误处理
        const markerOpts: mapCommon.MarkerOptions = {
            position: { latitude: lat, longitude: lng },
            title: text
        }
        mapController.addMarker(markerOpts).then((marker: map.Marker) => {
            markerList.push(marker)
            const entry = overlayMap.get(id)
            if (entry != null) {
                entry.nativeRef = marker
            }
        }).catch((e: Error) => {
            console.error("TDTMap: addLabel 失败: " + ((e as Error).message ?? String(e)))
            overlayMap.delete(id)
        })
        return id
    }
    return 0
}

// ==================== 覆盖物：批量标记 ====================

// context7 验证：addMarker 返回 Promise<Marker>，改用预分配 ID + .then() 同步返回 Array<number>
export function setMarkers(markers: Array<MapClickDetail>): Array<number> {
    // 逐个移除旧标记（不用 clearMarkers() 的 for 循环是为了内联执行，避免 unnecessary async）
    if (mapController != null) {
        for (let i = 0; i < markerList.length; i++) {
            markerList[i].remove()
        }
    }
    markerList = []
    clearOverlayType('marker')
    const ids: Array<number> = []
    if (mapController == null || markers.length == 0) return ids
    // 预分配 ID（同步返回），异步完成后更新 nativeRef
    for (let i = 0; i < markers.length; i++) {
        const pt = markers[i]
        overlayIdCounter++
        const id = overlayIdCounter
        const entry: OverlayEntry = { id: id, type: 'marker', nativeRef: null, isVisible: true }
        overlayMap.set(id, entry)
        ids.push(id)
        const markerIndex = i  // 捕获循环变量供异步回调使用
        const markerOpts: mapCommon.MarkerOptions = {
            position: { latitude: pt.lat, longitude: pt.lng }
        }
        mapController.addMarker(markerOpts).then((mk: map.Marker) => {
            markerList.push(mk)
            const entry = overlayMap.get(id)
            if (entry != null) {
                entry.nativeRef = mk
            }
        }).catch((e: Error) => {
            console.error("TDTMap: setMarkers[" + markerIndex + "] 失败: " + ((e as Error).message ?? String(e)))
            overlayMap.delete(id)
        })
    }
    return ids
}

// ==================== 覆盖物：清除全部 ====================

export function clearOverlays(): void {
    if (mapController == null) {
        clearOverlayType('marker')
        clearOverlayType('label')
        clearOverlayType('polygon')
        clearOverlayType('polyline')
        clearOverlayType('circle')
        clearOverlayType('rectangle')
        markerList = []
        polygons = []
        polylines = []
        circles = []
        rectangles = []
        return
    }
    // 逐个移除标记
    for (let i = 0; i < markerList.length; i++) {
        markerList[i].remove()
    }
    markerList = []
    clearOverlayType('marker')
    clearOverlayType('label')
    // 鸿蒙 MapKit clear() 清除覆盖物；TileOverlay 在 mapCommon 模块，
    // 先显式移除旧瓦片防止重复叠加，clear() 后重建瓦片（瓦片不属于覆盖物语义）
    tileOverlay?.remove()
    labelOverlay?.remove()
    mapController.clear()
    // context7 验证：MapKit clear() 清除所有覆盖物（含 TileOverlay），customTileOverlays 需同步清空
    // 否则残留引用指向已移除的瓦片图层，后续 removeCustomTileLayer 调用 .remove() 会 double-free
    customTileOverlays.clear()
    // 同步重置所有内部状态
    clearOverlayType('polygon')
    clearOverlayType('polyline')
    clearOverlayType('circle')
    clearOverlayType('rectangle')
    polygons = []
    polylines = []
    circles = []
    rectangles = []
    // v1.9.0: clear() 已连带清除图片覆盖物，同步清理状态与 PixelMap
    clearImageOverlayStateInternal()
    // 瓦片重建 fire-and-forget（不阻塞返回，接口签名 void 要求同步返回）
    createTileLayerPair(currentMapType, currentApiKey).then((pair: TileOverlayPair) => {
        tileOverlay = pair.base
        labelOverlay = pair.label
        const idx = getTypeIndex(currentMapType)
        for (let i = 0; i < 3; i++) {
            if (i == idx) {
                allTileOverlays[i] = { base: pair.base, label: pair.label }
            } else {
                allTileOverlays[i] = { base: null, label: null }
            }
        }
    }).catch((e: Error) => {
        console.error("TDTMap: clearOverlays 瓦片重建失败: " + ((e as Error).message ?? String(e)))
    })
}

export function snapshot(callback: (data: ArrayBuffer) => void): void {
    // HarmonyOS MapKit 无快照 API，上报错误并回调空 ArrayBuffer（平台差异显式上报，禁止静默失败）
    if (onErrorCallback != null) {
        onErrorCallback({ code: 4, message: 'Snapshot not supported on HarmonyOS MapKit' })
    }
    callback(new ArrayBuffer(0))
}

export function onResume(): void { /* MapKit 自动管理 */ }
export function onPause(): void { /* MapKit 自动管理 */ }

export function destroyMap(): void {
    // 移除所有预创建的瓦片图层
    for (let i = 0; i < 3; i++) {
        allTileOverlays[i].base?.remove()
        allTileOverlays[i].label?.remove()
    }
    allTileOverlays = [
        { base: null, label: null },
        { base: null, label: null },
        { base: null, label: null }
    ]
    tileOverlay = null
    labelOverlay = null

    // 清除所有标记
    for (let i = 0; i < markerList.length; i++) {
        markerList[i].remove()
    }
    markerList = []

    // 清除所有多边形
    for (let i = 0; i < polygons.length; i++) {
        polygons[i].remove()
    }
    polygons = []
    // 清除所有其他覆盖物
    for (let i = 0; i < polylines.length; i++) {
        polylines[i].remove()
    }
    polylines = []
    for (let i = 0; i < circles.length; i++) {
        circles[i].remove()
    }
    circles = []
    for (let i = 0; i < rectangles.length; i++) {
        rectangles[i].remove()
    }
    rectangles = []

    // v1.9.0: 清除所有图片覆盖物（含 PixelMap 释放，须在 mapController 置空前调用）
    for (let i = 0; i < imageOverlayIds.length; i++) {
        const oid = imageOverlayIds[i]
        const entryImg = overlayMap.get(oid)
        if (entryImg != null && entryImg.nativeRef != null) {
            try { entryImg.nativeRef.remove() } catch (e) { /* 容忍 */ }
        }
        const extImg = imageOverlayExt.get(oid)
        if (extImg != null && extImg.pixelMap != null) {
            try { (extImg.pixelMap as image.PixelMap).release() } catch (e2) { /* 容忍 */ }
        }
        imageOverlayExt.delete(oid)
    }
    imageOverlayIds = []
    imageOverlayNativeIdMap.clear()
    imageOverlayClickCallback = null

    mapController = null
    builderNode = null
    // v1.7.0: 清理聚合/热力覆盖物引用（remove 函数不依赖 mapController，内部有 try/catch）
    removeMarkerCluster()
    removeHeatmap()
    onClickCallback = null
    onReadyCallback = null
    onErrorCallback = null
    markerClickCallback = null
    mapLongClickCallback = null
    cameraChangeCallback = null
    overlayMap.clear()
    overlayIdCounter = 0
    currentApiKey = ''
    currentMapType = 'vec'
    currentLat = 0
    currentLng = 0
    currentZoom = 0
    currentBearing = 0
    currentTilt = 0
    customTileOverlays.clear()
}

// ==================== 缩放控制 ====================

export function zoomIn(): void {
    if (mapController != null) {
        currentZoom = currentZoom + 1
        // context7 验证：完整 CameraPosition 包含 target
        const cameraPos: mapCommon.CameraPosition = {
            target: { latitude: currentLat, longitude: currentLng },
            zoom: currentZoom,
            bearing: currentBearing,
            tilt: currentTilt
        }
        mapController.moveCamera(map.newCameraPosition(cameraPos))
    }
}

export function zoomOut(): void {
    if (mapController != null) {
        currentZoom = currentZoom - 1
        // context7 验证：完整 CameraPosition 包含 target
        const cameraPos: mapCommon.CameraPosition = {
            target: { latitude: currentLat, longitude: currentLng },
            zoom: currentZoom,
            bearing: currentBearing,
            tilt: currentTilt
        }
        mapController.moveCamera(map.newCameraPosition(cameraPos))
    }
}

export function setMinZoom(zoom: number): void {
    if (mapController != null) {
        mapController.setMinZoom(zoom)
    }
}

export function setMaxZoom(zoom: number): void {
    if (mapController != null) {
        mapController.setMaxZoom(zoom)
    }
}

// ==================== 视野移动 ====================

export function panTo(lat: number, lng: number, zoom?: number): void {
    if (mapController == null) return
    currentLat = lat
    currentLng = lng
    // context7 验证：CameraPosition 始终包含 target + zoom，zoom 未传时使用当前值
    const pos: mapCommon.CameraPosition = {
        target: { latitude: lat, longitude: lng },
        zoom: zoom != null ? zoom : currentZoom,
        bearing: currentBearing,
        tilt: currentTilt
    }
    if (zoom != null) {
        currentZoom = zoom
    }
    mapController.moveCamera(map.newCameraPosition(pos))
}

export function centerAndZoom(lat: number, lng: number, zoom: number): void {
    if (mapController == null) return
    currentLat = lat
    currentLng = lng
    currentZoom = zoom
    const cameraPos: mapCommon.CameraPosition = {
        target: { latitude: lat, longitude: lng },
        zoom: zoom,
        bearing: currentBearing,
        tilt: currentTilt
    }
    mapController.moveCamera(map.newCameraPosition(cameraPos))
}

// ==================== 手势控制 ====================
// context7 验证：HarmonyOS MapKit 提供 setZoomGesturesEnabled / setScrollGesturesEnabled 运行时手势开关

export function enableZoom(enabled: boolean): void {
    if (mapController != null) {
        mapController.setZoomGesturesEnabled(enabled)
    }
}

export function enableDrag(enabled: boolean): void {
    if (mapController != null) {
        mapController.setScrollGesturesEnabled(enabled)
    }
}

// ==================== 范围限制 ====================

export function setMaxBounds(minLat: number | null, minLng: number | null, maxLat: number | null, maxLng: number | null): void {
    if (mapController == null) return
    if (minLat == null || minLng == null || maxLat == null || maxLng == null) {
        // v1.8.0: 可空签名清除。context7: 华为文档未确认 setLatLngBounds(null) 行为 →
        // 保守方案：全球 Web Mercator 范围等效清除（不依赖未验证 API）
        const world: mapCommon.LatLngBounds = {
            southwest: { latitude: -85.05112878, longitude: -180 },
            northeast: { latitude: 85.05112878, longitude: 180 }
        }
        mapController.setLatLngBounds(world)
        return
    }
    const bounds: mapCommon.LatLngBounds = {
        southwest: { latitude: minLat, longitude: minLng },
        northeast: { latitude: maxLat, longitude: maxLng }
    }
    mapController.setLatLngBounds(bounds)
}

// ==================== 信息获取 ====================
// 鸿蒙 MapKit 无 getVisibleRegion API，按规则上报不支持

export function getBounds(): MapBoundsDetail {
    if (onErrorCallback != null) {
        onErrorCallback({ code: 4, message: 'getBounds not supported on HarmonyOS MapKit' })
    }
    return { minLat: 0, minLng: 0, maxLat: 0, maxLng: 0 }
}

// ==================== 坐标转换（纯数学，三端通用） ====================
// 算法来源：Wikipedia GCJ-02 article + eviltransform (GitHub)
// 注意：禁止在天地图插件中引入 WGS84→GCJ02 转换（会反向引入偏差），仅提供 GCJ02→WGS84

const GCJ_PI = 3.14159265358979323846
const GCJ_A = 6378245.0
const GCJ_EE = 0.00669342162296594323

function isOutOfChina(lat: number, lng: number): boolean {
    return lng < 72.004 || lng > 137.8347 || lat < 0.8293 || lat > 55.8271
}

function gcjTransformLat(x: number, y: number): number {
    let ret = -100.0 + 2.0 * x + 3.0 * y + 0.2 * y * y + 0.1 * x * y + 0.2 * Math.sqrt(Math.abs(x))
    ret += (20.0 * Math.sin(6.0 * x * GCJ_PI) + 20.0 * Math.sin(2.0 * x * GCJ_PI)) * 2.0 / 3.0
    ret += (20.0 * Math.sin(y * GCJ_PI) + 40.0 * Math.sin(y / 3.0 * GCJ_PI)) * 2.0 / 3.0
    ret += (160.0 * Math.sin(y / 12.0 * GCJ_PI) + 320.0 * Math.sin(y * GCJ_PI / 30.0)) * 2.0 / 3.0
    return ret
}

function gcjTransformLng(x: number, y: number): number {
    let ret = 300.0 + x + 2.0 * y + 0.1 * x * x + 0.1 * x * y + 0.1 * Math.sqrt(Math.abs(x))
    ret += (20.0 * Math.sin(6.0 * x * GCJ_PI) + 20.0 * Math.sin(2.0 * x * GCJ_PI)) * 2.0 / 3.0
    ret += (20.0 * Math.sin(x * GCJ_PI) + 40.0 * Math.sin(x / 3.0 * GCJ_PI)) * 2.0 / 3.0
    ret += (150.0 * Math.sin(x / 12.0 * GCJ_PI) + 300.0 * Math.sin(x / 30.0 * GCJ_PI)) * 2.0 / 3.0
    return ret
}

type Gcj02Delta = { dLat: number, dLng: number }
function wgs84ToGcj02Delta(lat: number, lng: number): Gcj02Delta {
    const dLat = gcjTransformLat(lng - 105.0, lat - 35.0)
    const dLng = gcjTransformLng(lng - 105.0, lat - 35.0)
    const radLat = lat / 180.0 * GCJ_PI
    let magic = Math.sin(radLat)
    magic = 1 - GCJ_EE * magic * magic
    const sqrtMagic = Math.sqrt(magic)
    const dLatFinal = (dLat * 180.0) / ((GCJ_A * (1 - GCJ_EE)) / (magic * sqrtMagic) * GCJ_PI)
    const dLngFinal = (dLng * 180.0) / (GCJ_A / sqrtMagic * Math.cos(radLat) * GCJ_PI)
    return { dLat: dLatFinal, dLng: dLngFinal }
}

export function gcj02ToWgs84(lat: number, lng: number): MapClickDetail {
    if (isOutOfChina(lat, lng)) {
        return { lat: lat, lng: lng }
    }
    let wgsLat = lat
    let wgsLng = lng
    for (let i = 0; i < 3; i++) {
        const delta = wgs84ToGcj02Delta(wgsLat, wgsLng)
        const gcjLat = wgsLat + delta.dLat
        const gcjLng = wgsLng + delta.dLng
        wgsLat -= (gcjLat - lat)
        wgsLng -= (gcjLng - lng)
    }
    return { lat: wgsLat, lng: wgsLng }
}

// ══════════════════════════════════════════════
// 覆盖物管理：单个操作
// ══════════════════════════════════════════════

// context7 验证：HarmonyOS 所有覆盖物均支持 remove() 和 setVisible()
export function removeOverlay(id: number): void {
    const entry = overlayMap.get(id)
    if (entry == null) {
        overlayMap.delete(id)
        return
    }
    const ref = entry.nativeRef
    if (ref == null) {
        overlayMap.delete(id)
        // v1.9.0: 图片加载中即被移除——清理扩展状态，加载回调将因 entry 缺失而丢弃
        const ext0 = imageOverlayExt.get(id)
        if (ext0 != null && ext0.pixelMap != null) {
            try { (ext0.pixelMap as image.PixelMap).release() } catch (e4) { /* 容忍 */ }
        }
        imageOverlayExt.delete(id)
        imageOverlayIds = imageOverlayIds.filter(x => x != id)
        return
    }
    // v1.9.2: 批量 styled 折线——nativeRef 为线数组，逐条 remove 后过滤全局 polylines
    if (entry.type == 'styledPolylineBatch') {
        const refs = ref as Array<map.MapPolyline>
        try {
            for (let i = 0; i < refs.length; i++) {
                refs[i].remove()
            }
        } catch (e) {
            console.error("TDTMap: removeOverlay 失败: " + ((e as Error).message ?? String(e)))
        }
        polylines = polylines.filter(p => refs.indexOf(p) < 0)
        overlayMap.delete(id)
        return
    }
    try {
        ref.remove()
    } catch (e) {
        console.error("TDTMap: removeOverlay 失败: " + ((e as Error).message ?? String(e)))
    }
    // 同步清理类型数组
    if (entry.type == 'marker' || entry.type == 'label') {
        markerList = markerList.filter(m => m !== ref)
    } else if (entry.type == 'polygon') {
        polygons = polygons.filter(p => p !== ref)
    } else if (entry.type == 'polyline' || entry.type == 'styledPolyline') {
        // v1.9.0: styled 折线同样存于 polylines 数组（同为 MapPolyline 原生对象）
        polylines = polylines.filter(p => p !== ref)
    } else if (entry.type == 'circle') {
        circles = circles.filter(c => c !== ref)
    } else if (entry.type == 'rectangle') {
        rectangles = rectangles.filter(r => r !== ref)
    }
    overlayMap.delete(id)
    // v1.9.0: 图片覆盖物状态清理（PixelMap 释放 + 反查表清理；非图片 ID 时为无害 no-op）
    if (entry.type == 'image') {
        const ext = imageOverlayExt.get(id)
        if (ext != null) {
            if (ext.pixelMap != null) {
                try { (ext.pixelMap as image.PixelMap).release() } catch (e5) { /* 容忍 */ }
            }
            imageOverlayExt.delete(id)
        }
        imageOverlayIds = imageOverlayIds.filter(x => x != id)
        imageOverlayNativeIdMap.delete(String(ref.getId()))
    }
}

// context7 验证：HarmonyOS BaseOverlay.setVisible(boolean) 控制可见性
export function showOverlay(id: number): void {
    const entry = overlayMap.get(id)
    if (entry == null) return
    const ref = entry.nativeRef
    if (ref == null || entry.isVisible) return
    // v1.9.2: 批量 styled 折线——nativeRef 为线数组，逐线 setVisible
    if (entry.type == 'styledPolylineBatch') {
        const refs = ref as Array<map.MapPolyline>
        try {
            for (let i = 0; i < refs.length; i++) {
                refs[i].setVisible(true)
            }
            entry.isVisible = true
        } catch (e) {
            console.error("TDTMap: showOverlay 失败: " + ((e as Error).message ?? String(e)))
        }
        return
    }
    try {
        ref.setVisible(true)
        entry.isVisible = true
    } catch (e) {
        console.error("TDTMap: showOverlay 失败: " + ((e as Error).message ?? String(e)))
    }
}

export function hideOverlay(id: number): void {
    const entry = overlayMap.get(id)
    if (entry == null) return
    const ref = entry.nativeRef
    if (ref == null || !entry.isVisible) return
    // v1.9.2: 批量 styled 折线——nativeRef 为线数组，逐线 setVisible
    if (entry.type == 'styledPolylineBatch') {
        const refs = ref as Array<map.MapPolyline>
        try {
            for (let i = 0; i < refs.length; i++) {
                refs[i].setVisible(false)
            }
            entry.isVisible = false
        } catch (e) {
            console.error("TDTMap: hideOverlay 失败: " + ((e as Error).message ?? String(e)))
        }
        return
    }
    try {
        ref.setVisible(false)
        entry.isVisible = false
    } catch (e) {
        console.error("TDTMap: hideOverlay 失败: " + ((e as Error).message ?? String(e)))
    }
}

// ══════════════════════════════════════════════
// 标记点击事件
// ══════════════════════════════════════════════

// context7 验证：HarmonyOS MapKit 使用 getEventManager().on('markerClick') 实现标记点击
// ⚠️ 监听器已在 initMap 的 .then() 中统一注册，此处仅更新回调引用，
// 禁止重复注册 evtMgr.on('markerClick') 否则会双重触发 emit('markertap')
@UTSJS.keepAlive
export function setMarkerClickCallback(callback: MarkerClickCallback): void {
    markerClickCallback = callback
    // 不再重复注册监听器：initMap 中注册的监听器通过闭包引用 markerClickCallback 模块变量，
    // 变量更新后监听器自动读取最新值（JavaScript 闭包按引用捕获变量）
}

// ══════════════════════════════════════════════
// 地图工具
// ══════════════════════════════════════════════

// context7 验证：HarmonyOS MapKit 暂无 resize API，no-op
export function checkResize(): void {
    // HarmonyOS MapKit 自动响应布局变化，无需手动触发
}

// context7 验证：HarmonyOS MapKit scrollBy 是 CameraUpdate 工厂（非 controller 方法），配合 moveCamera 实现像素级平移
export function planBy(x: number, y: number): void {
    if (mapController != null) {
        mapController.moveCamera(map.scrollBy(x, y))
    }
}

// context7 验证：通过 LatLngBounds 计算 + setCameraPosition 实现视野适配
export function setViewport(points: Array<MapClickDetail>): void {
    if (mapController == null || points.length == 0) return
    let minLat = points[0].lat, maxLat = points[0].lat
    let minLng = points[0].lng, maxLng = points[0].lng
    for (let i = 1; i < points.length; i++) {
        if (points[i].lat < minLat) minLat = points[i].lat
        if (points[i].lat > maxLat) maxLat = points[i].lat
        if (points[i].lng < minLng) minLng = points[i].lng
        if (points[i].lng > maxLng) maxLng = points[i].lng
    }
    const centerLat = (minLat + maxLat) / 2
    const centerLng = (minLng + maxLng) / 2
    const latSpan = maxLat - minLat
    const lngSpan = maxLng - minLng
    const maxSpan = Math.max(latSpan, lngSpan)
    let zoom = Math.log(360 / maxSpan) / Math.log(2)
    if (zoom < 1) zoom = 1
    if (zoom > 20) zoom = 20
    currentLat = centerLat
    currentLng = centerLng
    currentZoom = zoom
    const fitPos2: mapCommon.CameraPosition = {
        target: { latitude: centerLat, longitude: centerLng },
        zoom: zoom
    }
    mapController.moveCamera(map.newCameraPosition(fitPos2))
}

// context7 验证：HarmonyOS 容器尺寸需从 UniNativeViewElement 获取，此处返回 0
export function getSize(): MapSizeDetail {
    // HarmonyOS MapKit 暂无直接获取容器像素尺寸的 API
    return { width: 0, height: 0 }
}

// ══════════════════════════════════════════════
// 信息计算（纯数学，三端通用）
// ══════════════════════════════════════════════

const HAV_EARTH_RADIUS = 6371000.0

function toRadians(deg: number): number {
    return deg * Math.PI / 180.0
}

export function getDistance(start: MapClickDetail, end: MapClickDetail): number {
    const dLat = toRadians(end.lat - start.lat)
    const dLng = toRadians(end.lng - start.lng)
    const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
        Math.cos(toRadians(start.lat)) * Math.cos(toRadians(end.lat)) *
        Math.sin(dLng / 2) * Math.sin(dLng / 2)
    const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a))
    return HAV_EARTH_RADIUS * c
}

export function getViewport(points: Array<MapClickDetail>): MapViewportDetail {
    if (points.length == 0) {
        return { center: { lat: 0, lng: 0 }, zoom: 10 }
    }
    let minLat = points[0].lat, maxLat = points[0].lat
    let minLng = points[0].lng, maxLng = points[0].lng
    for (let i = 1; i < points.length; i++) {
        if (points[i].lat < minLat) minLat = points[i].lat
        if (points[i].lat > maxLat) maxLat = points[i].lat
        if (points[i].lng < minLng) minLng = points[i].lng
        if (points[i].lng > maxLng) maxLng = points[i].lng
    }
    const centerLat = (minLat + maxLat) / 2
    const centerLng = (minLng + maxLng) / 2
    const latSpan = maxLat - minLat
    const lngSpan = maxLng - minLng
    const maxSpan = Math.max(latSpan, lngSpan)
    let zoom = Math.log(360 / maxSpan) / Math.log(2)
    if (zoom < 1) zoom = 1
    if (zoom > 20) zoom = 20
    return { center: { lat: centerLat, lng: centerLng }, zoom: zoom }
}

export function getCode(): string {
    return 'EPSG:4326'
}

// ══════════════════════════════════════════════
// 天地图 Web API（搜索/地理编码）
// ══════════════════════════════════════════════

// context7 验证：天地图官方同时支持 HTTP/HTTPS，使用 HTTPS 避免各平台明文流量限制
const TDT_API_BASE = 'https://api.tianditu.gov.cn'

function tiandituHttpRequest(urlStr: string, callback: GeocodeCallback): void {
    const httpRequest = http.createHttp()
    const reqOpts: http.HttpRequestOptions = {
        method: http.RequestMethod.GET,
        connectTimeout: 10000,
        readTimeout: 10000
    }
    httpRequest.request(urlStr, reqOpts, (err: BusinessError, data: http.HttpResponse) => {
        if (err != null) {
            console.error("TDTMap: HTTP 请求失败: " + (err.message ?? String(err)))
            callback({ status: '404', msg: err.message ?? 'Network error' } as UTSJSONObject)
        } else {
            try {
                const resultStr = data.result as string
                // v1.5.4: JSON.parse 对非法 JSON 返回 null（如接口返回 HTML 错误页），直接 as 会抛崩溃
                const parsed = JSON.parse(resultStr)
                if (parsed == null) {
                    callback({ status: '404', msg: 'Invalid JSON response' } as UTSJSONObject)
                    return
                }
                callback(parsed as UTSJSONObject)
            } catch (e) {
                callback({ status: '404', msg: (e as Error).message ?? 'Parse error' } as UTSJSONObject)
            }
        }
        httpRequest.destroy()
    })
}

// context7 验证：ArkTS 原生支持 encodeURIComponent，使用 UTF-8 编码，比手动 charCodeAt (UCS-2) 实现更正确
function urlEncode(str: string): string {
    return encodeURIComponent(str)
}

@UTSJS.keepAlive
export function geocode_getLocation(lnglat: MapClickDetail, callback: GeocodeCallback): void {
    const key = currentApiKey
    if (key.length == 0) {
        callback({ status: '1', msg: 'No API Key' } as UTSJSONObject)
        return
    }
    const postStr = "{'lon':" + lnglat.lng.toString() + ",'lat':" + lnglat.lat.toString() + ",'ver':1}"
    const urlStr = TDT_API_BASE + '/geocoder?postStr=' + urlEncode(postStr) + '&type=geocode&tk=' + key
    tiandituHttpRequest(urlStr, callback)
}

@UTSJS.keepAlive
export function geocode_getPoint(address: string, callback: GeocodeCallback): void {
    const key = currentApiKey
    if (key.length == 0) {
        callback({ status: '1', msg: 'No API Key' } as UTSJSONObject)
        return
    }
    const postStr = '{"keyWord":"' + address + '"}'
    const urlStr = TDT_API_BASE + '/geocoder?ds=' + urlEncode(postStr) + '&tk=' + key
    tiandituHttpRequest(urlStr, callback)
}

// v1.7.1: context7 实测（2026-08 服务器端 Key 直测）：v2/search 现支持多 queryType——
// 12=行政区划(specify 必填)、3=周边(pointLonlat+queryRadius，无需 level)、
// 2=视野内(mapBound+level 必填)、1=普通(level+mapBound 必填)。
// v1.5.4 "仅 queryType=12 可用"结论已过时，周边/视野搜索恢复为专用 queryType；
// 缺关键参数时回退 queryType=12 保持可用（向后兼容）
function buildSearchUrl(params: SearchOptions, mode: string): string {
    const key = currentApiKey
    let postJson: string
    if (mode === 'nearby' && params.pointLonlat != null && params.pointLonlat.length > 0) {
        postJson = '{"keyWord":"' + params.keyWord + '","queryType":"3","pointLonlat":"' + params.pointLonlat + '"'
        if (params.queryRadius != null && params.queryRadius.length > 0) {
            postJson += ',"queryRadius":"' + params.queryRadius + '"'
        }
    } else if (mode === 'bounds' && params.mapBound != null && params.mapBound.length > 0) {
        const level = params.level != null && params.level.length > 0 ? params.level : '12'
        postJson = '{"keyWord":"' + params.keyWord + '","queryType":"2","mapBound":"' + params.mapBound + '","level":"' + level + '"'
    } else {
        const specify = params.specifyAdminCode != null && params.specifyAdminCode.length > 0 ? params.specifyAdminCode : '156000000'
        postJson = '{"keyWord":"' + params.keyWord + '","queryType":"12","specify":"' + specify + '"'
    }
    if (params.start != null && params.start.length > 0) {
        postJson += ',"start":"' + params.start + '"'
    }
    if (params.count != null && params.count.length > 0) {
        postJson += ',"count":"' + params.count + '"'
    }
    postJson += '}'
    return TDT_API_BASE + '/v2/search?postStr=' + urlEncode(postJson) + '&type=query&tk=' + key
}

@UTSJS.keepAlive
export function search(params: SearchOptions, callback: GeocodeCallback): void {
    if (currentApiKey.length == 0) {
        callback({ status: '1', msg: 'No API Key' } as UTSJSONObject)
        return
    }
    tiandituHttpRequest(buildSearchUrl(params, 'search'), callback)
}

@UTSJS.keepAlive
export function searchInBounds(params: SearchOptions, callback: GeocodeCallback): void {
    if (currentApiKey.length == 0) {
        callback({ status: '1', msg: 'No API Key' } as UTSJSONObject)
        return
    }
    tiandituHttpRequest(buildSearchUrl(params, 'bounds'), callback)
}

@UTSJS.keepAlive
export function searchNearby(params: SearchOptions, callback: GeocodeCallback): void {
    if (currentApiKey.length == 0) {
        callback({ status: '1', msg: 'No API Key' } as UTSJSONObject)
        return
    }
    tiandituHttpRequest(buildSearchUrl(params, 'nearby'), callback)
}

// ══════════════════════════════════════════════
// v1.3.0 新增：定位
// ══════════════════════════════════════════════

// context7 验证：HarmonyOS MapKit setMyLocationEnabled 显示用户位置蓝点
// 需在 module.json5 中声明 ohos.permission.LOCATION 和 ohos.permission.APPROXIMATELY_LOCATION
export function showUserLocation(enabled: boolean): void {
    if (mapController == null) {
        if (onErrorCallback != null) {
            onErrorCallback({ code: 4, message: "地图未初始化，无法显示定位" })
        }
        return
    }
    try {
        mapController.setMyLocationEnabled(enabled)
    } catch (e) {
        console.error("TDTMap: showUserLocation 失败: " + ((e as Error).message ?? String(e)))
        if (onErrorCallback != null) {
            onErrorCallback({ code: 4, message: "定位显示失败: " + ((e as Error).message ?? String(e)) })
        }
    }
}

// context7 验证：HarmonyOS geoLocationManager.getCurrentLocation 获取单次定位
@UTSJS.keepAlive
export function getUserLocation(callback: (detail: MapClickDetail) => void, onError?: (err: MapErrorDetail) => void): void {
    try {
        geoLocationManager.getCurrentLocation((err: BusinessError, location: geoLocationManager.Location) => {
            if (err != null) {
                console.error("TDTMap: getUserLocation 失败: " + (err.message ?? String(err)))
                if (onError != null) {
                    onError({ code: 4, message: "获取定位失败: " + (err.message ?? String(err)) })
                } else if (onErrorCallback != null) {
                    onErrorCallback({ code: 4, message: "获取定位失败: " + (err.message ?? String(err)) })
                }
                return
            }
            if (location != null) {
                callback({ lat: location.latitude, lng: location.longitude })
            } else {
                if (onError != null) {
                    onError({ code: 4, message: "定位返回空，请检查定位权限" })
                }
            }
        })
    } catch (e) {
        console.error("TDTMap: getUserLocation 异常: " + ((e as Error).message ?? String(e)))
        if (onError != null) {
            onError({ code: 4, message: "获取定位异常: " + ((e as Error).message ?? String(e)) })
        }
    }
}

// ══════════════════════════════════════════════
// v1.3.0 新增：信息窗口
// ══════════════════════════════════════════════

// context7 验证：HarmonyOS MapKit Marker 支持 showInfoWindow() / hideInfoWindow()
export function showMarkerInfo(id: number): void {
    const entry = overlayMap.get(id)
    if (entry == null) return
    if (entry.type == 'marker' || entry.type == 'label') {
        const mk = entry.nativeRef as map.Marker
        if (mk == null) {
            console.warn("TDTMap: showMarkerInfo - marker 尚未异步创建完成 (nativeRef=null)")
            return
        }
        try {
            // 华为 MapKit Marker 无 showInfoWindow/hideInfoWindow，等价 API 为 setInfoWindowVisible
            mk.setInfoWindowVisible(true)
        } catch (e) {
            console.error("TDTMap: showMarkerInfo 失败: " + ((e as Error).message ?? String(e)))
        }
    }
}

export function hideMarkerInfo(id: number): void {
    const entry = overlayMap.get(id)
    if (entry == null) return
    if (entry.type == 'marker' || entry.type == 'label') {
        const mk = entry.nativeRef as map.Marker
        if (mk == null) return
        try {
            mk.setInfoWindowVisible(false)
        } catch (e) {
            console.error("TDTMap: hideMarkerInfo 失败: " + ((e as Error).message ?? String(e)))
        }
    }
}

// ══════════════════════════════════════════════
// v1.3.0 新增：自定义瓦片图层
// ══════════════════════════════════════════════

// context7 验证：HarmonyOS MapKit addTileOverlay 最多支持 10 个瓦片图层
let customTileOverlays = new Map<string, map.TileOverlay>()

export function addCustomTileLayer(id: string, tileUrl: string, options?: TileLayerOptions): void {
    if (mapController == null) {
        if (onErrorCallback != null) {
            onErrorCallback({ code: 4, message: "地图未初始化，无法添加瓦片图层" })
        }
        return
    }
    // 若已存在同 ID 图层，先移除旧层
    removeCustomTileLayer(id)
    try {
        // v1.8.0: options 映射——仅 transparency 官方支持（华为 Map Kit 文档确认，
        // transparency=0 不透明、1 全透明，与 opacity 互补）；其余能力 warn 忽略
        const transparencyValue = options != null && options.opacity != null ? 1 - options.opacity : 0
        const tileOptions: mapCommon.TileOverlayParams = {
            tileUrl: tileUrl,
            transparency: transparencyValue,
            fadeIn: true
        }
        // context7 验证：addTileOverlay 返回 TileOverlay（同步，非 Promise），直接赋值即可
        const overlay = mapController.addTileOverlay(tileOptions)
        customTileOverlays.set(id, overlay)
        if (options != null && options.zIndex != null) {
            console.warn("TDTMap: 鸿蒙 TileOverlay 不支持 zIndex，已忽略")
        }
        if (options != null && (options.minZoom != null || options.maxZoom != null)) {
            console.warn("TDTMap: 鸿蒙 TileOverlay 不支持 minZoom/maxZoom，已忽略")
        }
    } catch (e) {
        console.error("TDTMap: addCustomTileLayer 异常: " + ((e as Error).message ?? String(e)))
        if (onErrorCallback != null) {
            onErrorCallback({ code: 4, message: "添加瓦片图层失败: " + ((e as Error).message ?? String(e)) })
        }
    }
}

export function removeCustomTileLayer(id: string): void {
    const overlay = customTileOverlays.get(id)
    if (overlay == null) return
    try {
        overlay.remove()
    } catch (e) {
        console.error("TDTMap: removeCustomTileLayer 失败: " + ((e as Error).message ?? String(e)))
    }
    customTileOverlays.delete(id)
}

// ══════════════════════════════════════════════
// v1.8.0 新增：样式切换 / WMS / canvas 探测（图层增强，鸿蒙降级）
// ══════════════════════════════════════════════

// context7: 华为开发者文档——MapKit 样式自定义仅支持 styleId（Petal Maps Studio 产物），
// 样式 JSON 为华为自有 schema，与 MapLibre style spec 不兼容，显式降级上报
// （规则要求：平台差异能力必须通过错误回调显式上报，禁止静默失败）
export function setStyle(styleJson: string): void {
    console.warn("TDTMap: 鸿蒙 MapKit 不支持 MapLibre 样式 JSON（华为样式 schema 不兼容，请使用 styleId）")
    if (onErrorCallback != null) {
        onErrorCallback({ code: 5, message: "平台不支持：鸿蒙 MapKit 样式 JSON 为华为自有 schema，与 MapLibre style spec 不兼容" })
    }
}

export function removeStyle(): void {
    // 鸿蒙从未支持 setStyle，无自定义样式状态，幂等 no-op（与三端语义一致）
}

// context7: 华为 Map Kit 官方文档——TileOverlay tileUrl 仅支持 {x}{y}{z} 占位符，无法 WMS bbox 寻址
export function addWMSTileLayer(id: string, wmsUrl: string, layers: string, options?: TileLayerOptions): void {
    console.warn("TDTMap: 鸿蒙 TileOverlay 仅支持 {x}{y}{z} 模板，不支持 WMS")
    if (onErrorCallback != null) {
        onErrorCallback({ code: 5, message: "平台不支持：鸿蒙 TileOverlay 仅支持 {x}{y}{z} 占位符，无法加载 WMS 图层" })
    }
}

export function isSupportCanvas(): boolean {
    return false
}

// ══════════════════════════════════════════════
// v1.4.0 新增：地图交互增强
// ══════════════════════════════════════════════

// context7 验证：setMapLongClickCallback 存储回调（实际监听在 initMap 中注册）
@UTSJS.keepAlive
export function setMapLongClickCallback(callback: MapLongClickCallback): void {
    mapLongClickCallback = callback
}

// context7 验证：HarmonyOS CameraPosition.bearing 设置旋转角度（0=正北，顺时针）
export function setBearing(bearing: number): void {
    if (mapController == null) return
    currentBearing = bearing
    const cameraPos: mapCommon.CameraPosition = {
        target: { latitude: currentLat, longitude: currentLng },
        zoom: currentZoom,
        bearing: bearing,
        tilt: currentTilt
    }
    mapController.moveCamera(map.newCameraPosition(cameraPos))
}

// context7 验证：HarmonyOS CameraPosition.tilt 设置倾斜角度（0=垂直俯瞰，范围 0~75）
export function setTilt(tilt: number): void {
    if (mapController == null) return
    currentTilt = tilt
    const cameraPos: mapCommon.CameraPosition = {
        target: { latitude: currentLat, longitude: currentLng },
        zoom: currentZoom,
        bearing: currentBearing,
        tilt: tilt
    }
    mapController.moveCamera(map.newCameraPosition(cameraPos))
}

// context7 验证：getCameraPosition().bearing 读取当前旋转角度
export function getBearing(): number {
    if (mapController != null) {
        const pos = mapController.getCameraPosition()
        if (pos != null && pos.bearing != null) return pos.bearing
    }
    return currentBearing
}

// context7 验证：getCameraPosition().tilt 读取当前倾斜角度
export function getTilt(): number {
    if (mapController != null) {
        const pos = mapController.getCameraPosition()
        if (pos != null && pos.tilt != null) return pos.tilt
    }
    return currentTilt
}

// context7 验证：setRotateGesturesEnabled 控制双指旋转手势
export function enableRotate(enabled: boolean): void {
    if (mapController != null) {
        mapController.setRotateGesturesEnabled(enabled)
    }
}

// context7 验证：setTiltGesturesEnabled 控制双指倾斜手势（鸿蒙 4.1.0(11)+ 支持）
export function enableTilt(enabled: boolean): void {
    if (mapController != null) {
        mapController.setTiltGesturesEnabled(enabled)
    }
}

// context7 验证：setCameraChangeCallback 存储回调（实际监听在 initMap 中注册）
@UTSJS.keepAlive
export function setCameraChangeCallback(callback: CameraChangeCallback): void {
    cameraChangeCallback = callback
}

// ══════════════════════════════════════════════
// v1.7.0 新增：标记聚合 + 热力图（数据可视化）
// context7: 华为官方指南 map-aggregate（完整示例代码）：
// mapController.addClusterOverlay(mapCommon.ClusterOverlayParams { distance, clusterItems })
// 返回 Promise<ClusterOverlay>；官方聚合自带"点击放大"（点击聚合簇自动放大展开，无需自实现）
// distance 单位 vp（官方示例 100），ClusterItem = { position: { latitude, longitude } }
// ══════════════════════════════════════════════
let clusterOverlayRef: map.ClusterOverlay | null = null
let heatmapRef: map.Heatmap | null = null

// 华为 MapKit ClusterItem 为 abstract class，定义插件内子类用于实例化聚合点
class TDTClusterItem extends mapCommon.ClusterItem {
    constructor(lat: number, lng: number) {
        super()
        const pos: mapCommon.LatLng = { latitude: lat, longitude: lng }
        this.position = pos
    }
}

export function addMarkerCluster(points: Array<MapClickDetail>, options?: ClusterOptions): void {
    const ctrl = mapController
    if (ctrl == null) {
        if (onErrorCallback != null) onErrorCallback({ code: 4, message: "地图未初始化，无法添加聚合图层" })
        return
    }
    removeMarkerCluster()
    if (points.length == 0) return
    // 华为 ClusterItem 为 abstract class，须以子类实例构造（字面量会被包装为 UTSJSONObject 拒收）
    const items: Array<mapCommon.ClusterItem> = []
    for (let i = 0; i < points.length; i++) {
        const item: TDTClusterItem = new TDTClusterItem(points[i].lat, points[i].lng)
        items.push(item)
    }
    const params: mapCommon.ClusterOverlayParams = {
        distance: 100,
        clusterItems: items
    }
    ctrl.addClusterOverlay(params).then((overlay: map.ClusterOverlay) => {
        clusterOverlayRef = overlay
    }).catch((e: Error) => {
        console.error("TDTMap: 添加聚合图层失败: " + ((e as Error).message ?? String(e)))
        if (onErrorCallback != null) {
            onErrorCallback({ code: 4, message: "添加聚合图层失败: " + ((e as Error).message ?? String(e)) })
        }
    })
}

export function removeMarkerCluster(): void {
    if (clusterOverlayRef != null) {
        try { clusterOverlayRef.remove() } catch (e) { /* ignore */ }
    }
    clusterOverlayRef = null
}

// context7: 华为官方指南 map-heat（完整示例代码）：
// ctrl.addHeatmap(mapCommon.HeatmapParams { id, data: WeightedLatLng[], radius, intensity })
// 返回 Promise<Heatmap>；WeightedLatLng = { point: { latitude, longitude }, intensity }
// ⚠️ 热力图起始 6.0.0(20)（HarmonyOS 6.0）：低版本 MapKit 无 addHeatmap 方法会抛异常，
// try/catch 捕获后通过 mapError 显式上报（规则第 7 条：平台差异能力不得静默失败）
export function addHeatmap(points: Array<HeatmapItem>, options?: HeatmapOptions): void {
    const ctrl = mapController
    if (ctrl == null) {
        if (onErrorCallback != null) onErrorCallback({ code: 4, message: "地图未初始化，无法添加热力图层" })
        return
    }
    removeHeatmap()
    if (points.length == 0) return
    const data: Array<mapCommon.WeightedLatLng> = []
    for (let i = 0; i < points.length; i++) {
        const wll: mapCommon.WeightedLatLng = {
            point: { latitude: points[i].lat, longitude: points[i].lng },
            intensity: points[i].weight ?? 1
        }
        data.push(wll)
    }
    const params: mapCommon.HeatmapParams = {
        id: 'tdt-heatmap',
        data: data,
        radius: options?.radius ?? 30,
        intensity: { 1: 1, 5: 5, 8: 10 }
    }
    try {
        ctrl.addHeatmap(params).then((heatmap: map.Heatmap) => {
            heatmapRef = heatmap
        }).catch((e: Error) => {
            console.error("TDTMap: 添加热力图失败: " + ((e as Error).message ?? String(e)))
            if (onErrorCallback != null) {
                onErrorCallback({ code: 4, message: "添加热力图失败: " + ((e as Error).message ?? String(e)) })
            }
        })
    } catch (e) {
        // 低版本 MapKit（< 6.0.0(20)）无 addHeatmap 方法：显式上报能力不支持
        console.error("TDTMap: 当前 MapKit 版本不支持热力图（需 HarmonyOS 6.0+）: " + ((e as Error).message ?? String(e)))
        if (onErrorCallback != null) {
            onErrorCallback({ code: 4, message: "当前 MapKit 版本不支持热力图（需 HarmonyOS 6.0 / API 20+）" })
        }
    }
}

export function removeHeatmap(): void {
    if (heatmapRef != null) {
        try { heatmapRef.remove() } catch (e) { /* ignore */ }
    }
    heatmapRef = null
}

// ════════════════════════════════════════════
// v1.9.0 新增：图片覆盖物（ImageOverlay）
// 华为 MapKit 原生 addImageOverlay 全参数直通｜PixelMap 管线｜预分配 ID + Promise 回填（addPolygon 同款）
// ════════════════════════════════════════════

// 清理全部图片覆盖物状态（不含原生对象——由调用方负责 remove/clear；PixelMap 释放）
function clearImageOverlayStateInternal(): void {
    for (let i = 0; i < imageOverlayIds.length; i++) {
        const ext = imageOverlayExt.get(imageOverlayIds[i])
        if (ext != null && ext.pixelMap != null) {
            try { (ext.pixelMap as image.PixelMap).release() } catch (e) { /* 容忍 */ }
        }
        imageOverlayExt.delete(imageOverlayIds[i])
    }
    imageOverlayIds = []
    imageOverlayNativeIdMap.clear()
}

// 失败上报：释放 PixelMap、清理状态并删除 entry（ID 失效，与 addMarker reject 行为对齐）
function reportImageOverlayFailure(id: number, code: number, message: string): void {
    const ext = imageOverlayExt.get(id)
    if (ext != null && ext.pixelMap != null) {
        try { (ext.pixelMap as image.PixelMap).release() } catch (e) { /* 容忍 */ }
    }
    imageOverlayExt.delete(id)
    imageOverlayIds = imageOverlayIds.filter(x => x != id)
    overlayMap.delete(id)
    if (onErrorCallback != null) {
        onErrorCallback({ code: code, message: message })
    }
}

// PixelMap 加载管线：http(s) 下载 ArrayBuffer（expectDataType 官方枚举）→ createImageSource；
// 本机路径直接 createImageSource(path)。回调均校验 entry 仍在 overlayMap（remove/clear/destroy 竞态防护）
function loadPixelMapForOverlay(id: number, imageSrc: string): void {
    const isHttp = imageSrc.indexOf('http://') == 0 || imageSrc.indexOf('https://') == 0
    if (isHttp) {
        const httpRequest = http.createHttp()
        const reqOpts: http.HttpRequestOptions = {
            method: http.RequestMethod.GET,
            connectTimeout: 15000,
            readTimeout: 15000,
            // 华为官方 FAQ：image 参数仅支持 ResourceStr/PixelMap，网络图必须下载转 PixelMap
            expectDataType: http.HttpDataType.ARRAY_BUFFER
        }
        httpRequest.request(imageSrc, reqOpts, (err: BusinessError, data: http.HttpResponse) => {
            httpRequest.destroy()
            if (overlayMap.get(id) == null) return  // 加载期间被移除/清空
            if (err != null) {
                reportImageOverlayFailure(id, 2, "图片下载失败: " + (err.message ?? String(err)))
                return
            }
            try {
                const buf = data.result as ArrayBuffer
                const imgSource = image.createImageSource(buf)
                createOverlayPixelMap(id, imgSource)
            } catch (e) {
                reportImageOverlayFailure(id, 4, "图片解码失败: " + ((e as Error).message ?? String(e)))
            }
        })
    } else {
        try {
            const imgSource = image.createImageSource(imageSrc)
            createOverlayPixelMap(id, imgSource)
        } catch (e) {
            reportImageOverlayFailure(id, 4, "图片加载失败（路径不存在或非图片）: " + ((e as Error).message ?? String(e)))
        }
    }
}

// 由 ImageSource 创建 PixelMap（最长边>4096 时 desiredSize 等比下采样防 OOM）并挂载原生 ImageOverlay
function createOverlayPixelMap(id: number, imgSource: any): void {
    const src = imgSource as image.ImageSource
    src.getImageInfo().then((info: image.ImageInfo) => {
        let opts: image.DecodingOptions = {}
        const w = info.size.width as number
        const h = info.size.height as number
        const maxDim = Math.max(w, h)
        if (maxDim > IMAGE_OVERLAY_MAX_DIM) {
            const scale = IMAGE_OVERLAY_MAX_DIM / maxDim
            opts = { desiredSize: { width: Math.floor(w * scale), height: Math.floor(h * scale) } }
        }
        return src.createPixelMap(opts)
    }).then((pixelMap: image.PixelMap) => {
        try { src.release() } catch (e) { /* 容忍 */ }
        if (overlayMap.get(id) == null) {
            // 加载期间被移除：丢弃结果
            try { (pixelMap as image.PixelMap).release() } catch (e2) { /* 容忍 */ }
            return
        }
        const ext = imageOverlayExt.get(id)
        if (ext != null) {
            ext.pixelMap = pixelMap
        }
        applyImageOverlayNative(id, pixelMap)
    }).catch((e: Error) => {
        try { src.release() } catch (e3) { /* 容忍 */ }
        reportImageOverlayFailure(id, 4, "图片解码失败: " + ((e as Error).message ?? String(e)))
    })
}

// 组装 ImageOverlayParams（华为 schema：bounds/image/transparency/zIndex/anchorU/anchorV/clickable/visible/bearing）
// 并调用原生 addImageOverlay；完成后回填 nativeRef + 反查表，并应用加载期间的 pendingUpdate
// ⚠️ 真机验证项：ImageOverlayParams 字段名以华为官方文档为准；对象字面量直传（addPolygon 同款先例）
function applyImageOverlayNative(id: number, pixelMap: image.PixelMap): void {
    const ctrl = mapController
    const ext = imageOverlayExt.get(id)
    if (ctrl == null || ext == null) return
    const p = ext.params
    const imgBounds: mapCommon.LatLngBounds = {
        southwest: { latitude: p.southwest.lat, longitude: p.southwest.lng },
        northeast: { latitude: p.northeast.lat, longitude: p.northeast.lng }
    }
    const imgParams: mapCommon.ImageOverlayParams = {
        bounds: imgBounds,
        image: pixelMap,
        transparency: p.transparency ?? 0,
        zIndex: p.zIndex ?? 0,
        anchorU: 0.5,
        anchorV: 0.5,
        clickable: p.clickable ?? true,
        visible: p.visible ?? true,
        bearing: p.bearing ?? 0
    }
    ctrl.addImageOverlay(imgParams).then((overlay: map.ImageOverlay) => {
        const entry = overlayMap.get(id)
        if (entry == null) {
            // 挂载完成前已被移除：清理原生对象与 PixelMap
            try { overlay.remove() } catch (e) { /* 容忍 */ }
            try { (pixelMap as image.PixelMap).release() } catch (e2) { /* 容忍 */ }
            return
        }
        entry.nativeRef = overlay
        imageOverlayNativeIdMap.set(String(overlay.getId()), id)
        // 应用加载期间的 pendingUpdate（image 变更已通过重新加载体现，此处重放剩余项）
        const pending = ext.pendingUpdate
        ext.pendingUpdate = null
        if (pending != null) {
            updateImageOverlay(id, pending)
        }
    }).catch((e: Error) => {
        console.error("TDTMap: addImageOverlay 失败: " + ((e as Error).message ?? String(e)))
        reportImageOverlayFailure(id, 4, "添加图片覆盖物失败: " + ((e as Error).message ?? String(e)))
    })
}

// 预分配 ID + 异步回填（addPolygon L481 同款模式，确保四端同步返回 number）
export function addImageOverlay(params: ImageOverlayOptions): number {
    if (mapController == null) return 0
    overlayIdCounter++
    const id = overlayIdCounter
    const entry: OverlayEntry = { id: id, type: 'image', nativeRef: null, isVisible: params.visible ?? true }
    overlayMap.set(id, entry)
    imageOverlayExt.set(id, { params: params, pixelMap: null, pendingUpdate: null })
    imageOverlayIds.push(id)
    loadPixelMapForOverlay(id, params.image)
    return id
}

export function updateImageOverlay(id: number, changes: ImageOverlayUpdateOptions): void {
    const entry = overlayMap.get(id)
    const ext = imageOverlayExt.get(id)
    if (entry == null || ext == null) return
    // 图片仍在加载：全部累积进 pendingUpdate，挂载完成后统一重放（换图项会经正常换图路径重新加载，
    // 语义与 Android/Web/iOS "加载中合并"一致——最终状态正确，代价是新图多一次加载）
    if (entry.nativeRef == null) {
        // 以 changes 为基准合并（等价于原"空对象起步逐项覆盖"语义，且规避空字面量断言）
        let merged: ImageOverlayUpdateOptions = changes
        if (ext.pendingUpdate != null) {
            merged = ext.pendingUpdate
        }
        if (changes.southwest != null) merged.southwest = changes.southwest
        if (changes.northeast != null) merged.northeast = changes.northeast
        if (changes.image != null) merged.image = changes.image
        if (changes.transparency != null) merged.transparency = changes.transparency
        if (changes.zIndex != null) merged.zIndex = changes.zIndex
        if (changes.bearing != null) merged.bearing = changes.bearing
        if (changes.visible != null) merged.visible = changes.visible
        if (changes.clickable != null) merged.clickable = changes.clickable
        ext.pendingUpdate = merged
        return
    }
    const p = ext.params
    const ref = entry.nativeRef as map.ImageOverlay
    // 合并变更（未传字段保持不变）
    if (changes.southwest != null) p.southwest = changes.southwest
    if (changes.northeast != null) p.northeast = changes.northeast
    if (changes.image != null) p.image = changes.image
    if (changes.transparency != null) p.transparency = changes.transparency
    if (changes.zIndex != null) p.zIndex = changes.zIndex
    if (changes.bearing != null) p.bearing = changes.bearing
    if (changes.visible != null) p.visible = changes.visible
    if (changes.clickable != null) p.clickable = changes.clickable
    // 换图：需重新走加载管线（新地址可能是网络图），完成后重新挂载（同 ID）
    if (changes.image != null) {
        try { ref.remove() } catch (e) { /* 容忍 */ }
        imageOverlayNativeIdMap.delete(String(ref.getId()))
        entry.nativeRef = null
        if (ext.pixelMap != null) {
            try { (ext.pixelMap as image.PixelMap).release() } catch (e2) { /* 容忍 */ }
            ext.pixelMap = null
        }
        loadPixelMapForOverlay(id, p.image)
        return
    }
    try {
        // 优先原生 setter（⚠️ 真机验证项：setTransparency/setVisible/setZIndex/setBearing/setBounds 方法名清单）
        if (changes.transparency != null) {
            ref.setTransparency(p.transparency ?? 0)
        }
        if (changes.zIndex != null) {
            ref.setZIndex(p.zIndex ?? 0)
        }
        if (changes.visible != null) {
            ref.setVisible(p.visible != false)
            entry.isVisible = p.visible != false
        }
        if (changes.bearing != null) {
            ref.setBearing(p.bearing ?? 0)
        }
        if (changes.southwest != null || changes.northeast != null) {
            const newBounds: mapCommon.LatLngBounds = {
                southwest: { latitude: p.southwest.lat, longitude: p.southwest.lng },
                northeast: { latitude: p.northeast.lat, longitude: p.northeast.lng }
            }
            ref.setBounds(newBounds)
        }
        if (changes.clickable != null) {
            // ImageOverlay 无 clickable setter（params 型，仅重建生效）——文档说明的已知限制
            console.warn("TDTMap: 鸿蒙端 clickable 更新需重建覆盖物，当前版本暂不生效")
        }
    } catch (e) {
        // setter 不可用回退：remove + 以已有 PixelMap 重挂（保 ID，不重新下载）
        console.warn("TDTMap: ImageOverlay setter 不可用，回退 remove+重挂载: " + ((e as Error).message ?? String(e)))
        try { ref.remove() } catch (e3) { /* 容忍 */ }
        imageOverlayNativeIdMap.delete(String(ref.getId()))
        entry.nativeRef = null
        if (ext.pixelMap != null) {
            applyImageOverlayNative(id, ext.pixelMap)
        }
    }
}

@UTSJS.keepAlive
export function setImageOverlayClickCallback(callback: ImageOverlayClickCallback | null): void {
    // 仅更新回调引用；imageOverlayClick 监听在 initMap 的 evtMgr 统一注册（禁止重复注册，与 markerClick 同款）
    imageOverlayClickCallback = callback
}
