// context7 验证：iOS 使用 MLNMapViewDelegate.didSelectAnnotation 实现标记点击
// 回调已在 TDTMapDelegate 类中注册，此处仅存储回调引用
@UTSJS.keepAlive
export function setMarkerClickCallback(callback: MarkerClickCallback): void {
    markerClickCallback = callback
}

// ══════════════════════════════════════════════
// 地图工具
// ══════════════════════════════════════════════

// context7 验证：iOS 通过 setNeedsLayout + layoutIfNeeded 刷新地图容器布局
export function checkResize(): void {
    if (mapView != null) {
        mapView.setNeedsLayout()
        mapView.layoutIfNeeded()
    }
}

// context7 验证：iOS 通过 convertPoint + setCenterCoordinate 实现像素级平移
export function planBy(x: number, y: number): void {
    if (mapView == null) return
    const centerPoint = mapView.center
    // 计算目标屏幕点（CGPoint 在 UTS 中用对象字面量表示）
    const targetPoint = { x: centerPoint.x + x, y: centerPoint.y + y }
    const newCoord = mapView.convertPoint(targetPoint, toCoordinateFromView: mapView)
    mapView.setCenterCoordinate(newCoord, true)
}

// context7 验证：MLNCoordinateBoundsMake + setVisibleCoordinateBounds 适应坐标点数组
export function setViewport(points: Array<MapClickDetail>): void {
    if (mapView == null || points.length == 0) return
    let minLat = points[0].lat, maxLat = points[0].lat
    let minLng = points[0].lng, maxLng = points[0].lng
    for (let i = 1; i < points.length; i++) {
        if (points[i].lat < minLat) minLat = points[i].lat
        if (points[i].lat > maxLat) maxLat = points[i].lat
        if (points[i].lng < minLng) minLng = points[i].lng
        if (points[i].lng > maxLng) maxLng = points[i].lng
    }
    const sw = CLLocationCoordinate2DMake(minLat, minLng)
    const ne = CLLocationCoordinate2DMake(maxLat, maxLng)
    const bounds = MLNCoordinateBoundsMake(sw, ne)
    const edgePadding = new UIEdgeInsets(50, 50, 50, 50)
    mapView.setVisibleCoordinateBounds(bounds, edgePadding, true)
}

// context7 验证：MLNMapView.bounds.size 返回容器像素尺寸
export function getSize(): MapSizeDetail {
    if (mapView != null) {
        const bounds = mapView.bounds
        return { width: bounds.size.width, height: bounds.size.height }
    }
    return { width: 0, height: 0 }
}

// ══════════════════════════════════════════════
// 信息计算（纯数学，三端通用）
// ══════════════════════════════════════════════

// Haversine 公式计算两点间距离（米）
const HAV_EARTH_RADIUS = 6371000.0

function toRadians(deg: number): number {
    return deg * Math.PI / 180.0
}

export function getDistance(start: MapClickDetail, end: MapClickDetail): number {
    const dLat = toRadians(end.lat - start.lat)
    const dLng = toRadians(end.lng - start.lng)
    const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
        Math.cos(toRadians(start.lat)) * Math.cos(toRadians(end.lat)) *
        Math.sin(dLng / 2) * Math.sin(dLng / 2)
    const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a))
    return HAV_EARTH_RADIUS * c
}

// 计算最佳视野：根据坐标点数组返回 center 和 zoom
export function getViewport(points: Array<MapClickDetail>): MapViewportDetail {
    if (points.length == 0) {
        return { center: { lat: 0, lng: 0 }, zoom: 10 }
    }
    let minLat = points[0].lat, maxLat = points[0].lat
    let minLng = points[0].lng, maxLng = points[0].lng
    for (let i = 1; i < points.length; i++) {
        if (points[i].lat < minLat) minLat = points[i].lat
        if (points[i].lat > maxLat) maxLat = points[i].lat
        if (points[i].lng < minLng) minLng = points[i].lng
        if (points[i].lng > maxLng) maxLng = points[i].lng
    }
    const centerLat = (minLat + maxLat) / 2
    const centerLng = (minLng + maxLng) / 2
    const latSpan = maxLat - minLat
    const lngSpan = maxLng - minLng
    const maxSpan = Math.max(latSpan, lngSpan)
    let zoom = Math.log(360 / maxSpan) / Math.log(2)
    if (zoom < 1) zoom = 1
    if (zoom > 20) zoom = 20
    return { center: { lat: centerLat, lng: centerLng }, zoom: zoom }
}

// 天地图采用 CGCS2000 坐标系，约等于 WGS84
export function getCode(): string {
    return 'EPSG:4326'
}

// ══════════════════════════════════════════════
// 天地图 Web API（搜索/地理编码）
// ══════════════════════════════════════════════
// 上下文7 验证：天地图 geocoder API
// 地理编码：https://api.tianditu.gov.cn/geocoder?ds={"keyWord":"..."}&tk=KEY
// 逆地理编码：https://api.tianditu.gov.cn/geocoder?postStr={'lon':...,'lat':...,'ver':1}&type=geocode&tk=KEY
// 搜索 v2（地名搜索2.0）：https://api.tianditu.gov.cn/v2/search?postStr={...}&type=query&tk=KEY
// context7 验证：天地图官方声明同时支持 HTTP 和 HTTPS，iOS ATS 也推荐 HTTPS

const TDT_API_BASE = 'https://api.tianditu.gov.cn'

function tiandituHttpRequest(urlStr: string, callback: GeocodeCallback): void {
    try {
        const url = NSURL.URLWithString(urlStr)
        if (url == null) {
            callback({ status: '404', msg: 'Invalid URL' } as UTSJSONObject)
            return
        }
        // context7 验证：使用 NSString.stringWithContentsOfURL 同步获取 HTTP 响应（4 = NSUTF8StringEncoding）
        const jsonStr = NSString.stringWithContentsOfURL(url, 4, null) as NSString | null
        if (jsonStr == null) {
            callback({ status: '404', msg: 'Network error' } as UTSJSONObject)
            return
        }
        // v1.5.4: JSON.parse 对非法 JSON 返回 null（如接口返回 HTML 错误页），直接 as 会抛崩溃
        const parsed = JSON.parse(jsonStr as string)
        if (parsed == null) {
            callback({ status: '404', msg: 'Invalid JSON response' } as UTSJSONObject)
            return
        }
        callback(parsed as UTSJSONObject)
    } catch (e: any) {
        console.error("TDTMap: HTTP 请求失败: " + (e.message ?? e))
        callback({ status: '404', msg: e.message ?? 'Network error' } as UTSJSONObject)
    }
}

// URL 编码辅助函数（iOS 端无 java.net.URLEncoder，使用 NSString 的 percent 编码）
function urlEncode(str: string): string {
    const nsStr = NSString.stringWithString(str)
    // NSUTF8StringEncoding = 4
    const encoded = nsStr.stringByAddingPercentEscapesUsingEncoding(4) as NSString | null
    if (encoded != null) return encoded as string
    return str
}

@UTSJS.keepAlive
export function geocode_getLocation(lnglat: MapClickDetail, callback: GeocodeCallback): void {
    const key = currentApiKey
    if (key.length == 0) {
        callback({ status: '1', msg: 'No API Key' } as UTSJSONObject)
        return
    }
    const postStr = "{'lon':" + lnglat.lng.toString() + ",'lat':" + lnglat.lat.toString() + ",'ver':1}"
    const urlStr = TDT_API_BASE + '/geocoder?postStr=' + urlEncode(postStr) + '&type=geocode&tk=' + key
    tiandituHttpRequest(urlStr, callback)
}

@UTSJS.keepAlive
export function geocode_getPoint(address: string, callback: GeocodeCallback): void {
    const key = currentApiKey
    if (key.length == 0) {
        callback({ status: '1', msg: 'No API Key' } as UTSJSONObject)
        return
    }
    const postStr = '{"keyWord":"' + address + '"}'
    const urlStr = TDT_API_BASE + '/geocoder?ds=' + urlEncode(postStr) + '&tk=' + key
    tiandituHttpRequest(urlStr, callback)
}

// v1.7.1: context7 实测（2026-08 服务器端 Key 直测）：v2/search 现支持多 queryType——
// 12=行政区划(specify 必填)、3=周边(pointLonlat+queryRadius，无需 level)、
// 2=视野内(mapBound+level 必填)、1=普通(level+mapBound 必填)。
// v1.5.4 "仅 queryType=12 可用"结论已过时，周边/视野搜索恢复为专用 queryType；
// 缺关键参数时回退 queryType=12 保持可用（向后兼容）
function buildSearchUrl(params: SearchOptions, mode: string): string {
    const key = currentApiKey
    let postJson: string
    if (mode === 'nearby' && params.pointLonlat != null && params.pointLonlat.length > 0) {
        postJson = '{"keyWord":"' + params.keyWord + '","queryType":"3","pointLonlat":"' + params.pointLonlat + '"'
        if (params.queryRadius != null && params.queryRadius.length > 0) {
            postJson += ',"queryRadius":"' + params.queryRadius + '"'
        }
    } else if (mode === 'bounds' && params.mapBound != null && params.mapBound.length > 0) {
        const level = params.level != null && params.level.length > 0 ? params.level : '12'
        postJson = '{"keyWord":"' + params.keyWord + '","queryType":"2","mapBound":"' + params.mapBound + '","level":"' + level + '"'
    } else {
        const specify = params.specifyAdminCode != null && params.specifyAdminCode.length > 0 ? params.specifyAdminCode : '156000000'
        postJson = '{"keyWord":"' + params.keyWord + '","queryType":"12","specify":"' + specify + '"'
    }
    if (params.start != null && params.start.length > 0) {
        postJson += ',"start":"' + params.start + '"'
    }
    if (params.count != null && params.count.length > 0) {
        postJson += ',"count":"' + params.count + '"'
    }
    postJson += '}'
    return TDT_API_BASE + '/v2/search?postStr=' + urlEncode(postJson) + '&type=query&tk=' + key
}

@UTSJS.keepAlive
export function search(params: SearchOptions, callback: GeocodeCallback): void {
    if (currentApiKey.length == 0) {
        callback({ status: '1', msg: 'No API Key' } as UTSJSONObject)
        return
    }
    tiandituHttpRequest(buildSearchUrl(params, 'search'), callback)
}

@UTSJS.keepAlive
export function searchInBounds(params: SearchOptions, callback: GeocodeCallback): void {
    if (currentApiKey.length == 0) {
        callback({ status: '1', msg: 'No API Key' } as UTSJSONObject)
        return
    }
    tiandituHttpRequest(buildSearchUrl(params, 'bounds'), callback)
}

@UTSJS.keepAlive
export function searchNearby(params: SearchOptions, callback: GeocodeCallback): void {
    if (currentApiKey.length == 0) {
        callback({ status: '1', msg: 'No API Key' } as UTSJSONObject)
        return
    }
    tiandituHttpRequest(buildSearchUrl(params, 'nearby'), callback)
}

// ══════════════════════════════════════════════
// v1.3.0 新增：定位
// ══════════════════════════════════════════════

// context7 验证：MLNMapView.showsUserLocation 为 BOOL 属性，设为 true 后 MapLibre 自动请求定位权限并显示蓝点
let userLocationShown: boolean = false

export function showUserLocation(enabled: boolean): void {
    if (mapView == null) {
        if (onErrorCallback != null) {
            onErrorCallback({ code: 4, message: "地图未初始化，无法显示定位" })
        }
        return
    }
    userLocationShown = enabled
    mapView.showsUserLocation = enabled
}

// context7 验证：iOS CLLocationManager 可获取 GPS 位置，startUpdatingLocation 异步回调
let locationManager: CLLocationManager | null = null
let locationCallback: ((detail: MapClickDetail) => void) | null = null
let locationErrorCallback: ((err: MapErrorDetail) => void) | null = null
let locationTimer: any | null = null  // NSTimer 引用，用于 destroyMap 时提前 invalidate

@UTSJS.keepAlive
export function getUserLocation(callback: (detail: MapClickDetail) => void, onError?: (err: MapErrorDetail) => void): void {
    locationCallback = callback
    locationErrorCallback = onError ?? null
    
    if (locationManager == null) {
        locationManager = new CLLocationManager()
    }
    
    const lm = locationManager!
    // 先尝试获取最后已知位置（同步、快速，无需等待）
    const lastLoc = lm.location
    if (lastLoc != null) {
        const coord = lastLoc.coordinate
        callback({ lat: coord.latitude, lng: coord.longitude })
        return
    }
    
    // 无缓存位置：请求授权并启动定位
    // context7 验证：iOS 8+ 必须先调用 requestWhenInUseAuthorization 再 startUpdatingLocation
    // 否则定位服务静默失败，lm.location 永远为 null
    try {
        lm.requestWhenInUseAuthorization()
        lm.startUpdatingLocation()
        let attempts = 0
        const maxAttempts = 25  // 200ms × 25 = 5s
        // context7 验证：NSTimer block API 需要 iOS 10+，uni-app x iOS 最低支持 14.0
        locationTimer = NSTimer.scheduledTimerWithTimeInterval(0.2, true, (timer: any) => {
            attempts++
            const loc = lm.location
            if (loc != null) {
                lm.stopUpdatingLocation()
                timer.invalidate()
                locationTimer = null
                const coord = loc.coordinate
                if (locationCallback != null) {
                    locationCallback({ lat: coord.latitude, lng: coord.longitude })
                }
            } else if (attempts >= maxAttempts) {
                lm.stopUpdatingLocation()
                timer.invalidate()
                locationTimer = null
                const errCb = locationErrorCallback ?? onErrorCallback
                if (errCb != null) {
                    errCb({ code: 4, message: "获取定位超时（5s），请检查定位权限" })
                }
            }
        })
    } catch (e: any) {
        console.error("TDTMap: getUserLocation 失败: " + (e.message ?? String(e)))
        if (onError != null) {
            onError({ code: 4, message: "获取定位失败: " + (e.message ?? String(e)) })
        }
        lm.stopUpdatingLocation()
    }
}

// ══════════════════════════════════════════════
// v1.3.0 新增：信息窗口
// ══════════════════════════════════════════════

// context7 验证：iOS MLNMapView.selectAnnotation 显示标注气泡（callout），deselectAnnotation 隐藏
// 注意：标注需设置 title/subtitle 才会显示气泡内容
export function showMarkerInfo(id: number): void {
    const entry = overlayMap.get(id)
    if (entry == null || mapView == null) return
    if (entry.type == 'marker' || entry.type == 'label') {
        const annotation = entry.nativeRef as MLNPointAnnotation
        try {
            mapView.selectAnnotation(annotation, true)
        } catch (e: any) {
            console.error("TDTMap: showMarkerInfo 失败: " + (e.message ?? String(e)))
        }
    }
}

export function hideMarkerInfo(id: number): void {
    const entry = overlayMap.get(id)
    if (entry == null || mapView == null) return
    if (entry.type == 'marker' || entry.type == 'label') {
        const annotation = entry.nativeRef as MLNPointAnnotation
        try {
            mapView.deselectAnnotation(annotation, true)
        } catch (e: any) {
            console.error("TDTMap: hideMarkerInfo 失败: " + (e.message ?? String(e)))
        }
    }
}

// ══════════════════════════════════════════════
// v1.3.0 新增：自定义瓦片图层
// ══════════════════════════════════════════════

// context7 验证：MLNRasterTileSource 支持 URL 数组或 TileJSON，MLNRasterStyleLayer 绑定到 source
type CustomTileEntry = { source: MLNRasterTileSource, layer: MLNRasterStyleLayer, tileUrl: string, options: TileLayerOptions }
let customTileSources = new Map<string, CustomTileEntry>()
// v1.8.0: 平行数组存 key 顺序（重建按添加顺序重放）
let customTileLayerIds: Array<string> = []
// v1.8.0: 聚合/热力数据快照（样式切换后重建）
let clusterDataRef: Array<MapClickDetail> | null = null
let clusterOptionsRef: ClusterOptions | null = null
let heatmapDataRef: Array<HeatmapItem> | null = null
let heatmapOptionsRef: HeatmapOptions | null = null
// v1.8.0: 样式重建三态：0=初始加载 1=setStyle 后（只重建用户层） 2=removeStyle 后（重建天底图+用户层）
let styleRebuildMode = 0
let customStyleActive = false

export function addCustomTileLayer(id: string, tileUrl: string, options?: TileLayerOptions): void {
    if (mapView == null || mapView.style == null) {
        if (onErrorCallback != null) {
            onErrorCallback({ code: 4, message: "样式未加载，无法添加瓦片图层" })
        }
        return
    }
    // 若已存在同 ID 图层，先移除旧层
    removeCustomTileLayer(id)
    try {
        const tileURLs: Array<string> = [tileUrl]
        const source = new MLNRasterTileSource(id, tileURLs, null)
        mapView.style?.addSource(source)
        const layer = new MLNRasterStyleLayer(id + "-layer", source)
        layer.minimumZoomLevel = 1
        layer.maximumZoomLevel = 18
        // v1.8.0: options 应用（MLN 官方属性；NSExpression 用法与现有聚合/热力层一致）
        if (options != null) {
            if (options.minZoom != null) {
                layer.minimumZoomLevel = options.minZoom
            }
            if (options.maxZoom != null) {
                layer.maximumZoomLevel = options.maxZoom
            }
            if (options.opacity != null) {
                layer.rasterOpacity = NSExpression(forConstantValue: options.opacity)
            }
        }
        if (options != null && options.zIndex == 0) {
            // zIndex=0: 插到天地图注记层之下。context7: MGLStyle insertLayer:belowLayer: 官方 API
            // （Mapbox iOS 6.3.0 API 参考确认）；注记层缺失时回退置顶并 warn（与 Android/Web 端一致）
            const labelLayer = mapView.style?.layerWithIdentifier("tdt-label-" + currentMapType + "-layer")
            if (labelLayer != null) {
                mapView.style?.insertLayer(layer, below: labelLayer)
            } else {
                mapView.style?.addLayer(layer)
                console.warn("TDTMap: 未找到注记层，zIndex=0 已按默认置顶处理")
            }
        } else {
            mapView.style?.addLayer(layer)
            if (options != null && options.zIndex != null && options.zIndex != 0) {
                console.warn("TDTMap: zIndex 仅支持 0（贴底）与 undefined（置顶），当前值已忽略")
            }
        }
        customTileSources.set(id, { source: source, layer: layer, tileUrl: tileUrl, options: options ?? {} })
        customTileLayerIds.push(id)
    } catch (e: any) {
        console.error("TDTMap: addCustomTileLayer 失败: " + (e.message ?? String(e)))
        if (onErrorCallback != null) {
            onErrorCallback({ code: 4, message: "添加瓦片图层失败: " + (e.message ?? String(e)) })
        }
    }
}

export function removeCustomTileLayer(id: string): void {
    const entry = customTileSources.get(id)
    if (entry == null) return
    if (mapView?.style != null) {
        try {
            mapView.style?.removeLayer(entry.layer)
            mapView.style?.removeSource(entry.source)
        } catch (e: any) {
            console.error("TDTMap: removeCustomTileLayer 失败: " + (e.message ?? String(e)))
        }
    }
    customTileSources.delete(id)
    // v1.8.0: 清理平行数组
    const newIds: Array<string> = []
    for (let i = 0; i < customTileLayerIds.length; i++) {
        if (customTileLayerIds[i] != id) newIds.push(customTileLayerIds[i])
    }
    customTileLayerIds = newIds
}

// ══════════════════════════════════════════════
// v1.8.0 新增：WMS / 样式切换 / canvas 探测（图层增强）
// ══════════════════════════════════════════════

// context7: {bbox-epsg-3857} 为 MapLibre style spec 标准占位符（天地图官方 WMS 接入文档确认）
function buildWmsTileUrl(wmsUrl: string, layers: string): string {
    const sep = wmsUrl.indexOf('?') >= 0 ? '&' : '?'
    return wmsUrl + sep + 'SERVICE=WMS&REQUEST=GetMap&VERSION=1.1.1&LAYERS=' + layers +
        '&STYLES=&FORMAT=image/png&TRANSPARENT=true&SRS=EPSG:3857&BBOX={bbox-epsg-3857}&WIDTH=256&HEIGHT=256'
}

export function addWMSTileLayer(id: string, wmsUrl: string, layers: string, options?: TileLayerOptions): void {
    addCustomTileLayer(id, buildWmsTileUrl(wmsUrl, layers), options)
}

// v1.8.0: 样式切换后重建用户数据图层（按添加顺序重放）
function rebuildUserLayersAfterStyle(): void {
    // v1.8.0 审查修复：样式整体替换后，四个 ref 仍持有旧样式图层对象，对新样式执行
    // removeLayer/removeSource 会抛异常（removeCustomTileLayer 的 try/catch 即为先例）；
    // 重建前先置 null，旧对象随旧样式销毁自动释放，重放时 addMarkerCluster/addHeatmap
    // 内部的 remove 调用走 null 分支跳过删除，避免未捕获异常中断重建
    clusterSourceRef = null
    clusterCircleLayerRef = null
    heatmapLayerRef = null
    heatmapSourceRef = null
    const ids = customTileLayerIds.slice()
    customTileLayerIds = []
    const saved: Array<any> = []
    for (let i = 0; i < ids.length; i++) {
        const e = customTileSources.get(ids[i])
        if (e != null) saved.push({ id: ids[i], entry: e })
    }
    customTileSources.clear()
    for (let i = 0; i < saved.length; i++) {
        addCustomTileLayer(saved[i].id, saved[i].entry.tileUrl, saved[i].entry.options)
    }
    if (clusterDataRef != null) {
        const pts = clusterDataRef
        const opts = clusterOptionsRef
        clusterDataRef = null
        clusterOptionsRef = null
        addMarkerCluster(pts, opts)
    }
    if (heatmapDataRef != null) {
        const pts = heatmapDataRef
        const opts = heatmapOptionsRef
        heatmapDataRef = null
        heatmapOptionsRef = null
        addHeatmap(pts, opts)
    }
    // v1.9.0: 图片覆盖物重放（uiImage 本地加载/文本位图的复用持有；URL 的交给引擎重新下载；
    // 重建 entry 由 attach 回填，隐藏过的以快照恢复；styledText 同为 image 通路一并重放）
    if (imageOverlayIds.length > 0) {
        const savedImgs: Array<any> = []
        for (let i = 0; i < imageOverlayIds.length; i++) {
            const oid = imageOverlayIds[i]
            const ext = imageOverlayExt.get(oid)
            const entry0 = overlayMap.get(oid)
            if (ext != null) {
                savedImgs.push({ id: oid, params: ext.params, uiImage: ext.uiImage, visible: entry0 != null ? entry0.isVisible : true })
            }
        }
        imageOverlayExt.clear()
        imageOverlayIds = []
        for (let i = 0; i < savedImgs.length; i++) {
            const oid = savedImgs[i].id as number
            overlayMap.set(oid, { id: oid, type: 'image', nativeRef: null, isVisible: true })
            const okAttach = attachImageOverlayToStyle(oid, savedImgs[i].params as ImageOverlayOptions, savedImgs[i].uiImage)
            if (okAttach) {
                const snapVisible = savedImgs[i].visible as boolean
                const entry2 = overlayMap.get(oid)
                if (!snapVisible && entry2 != null && entry2.nativeRef != null) {
                    (entry2.nativeRef.layer as MLNRasterStyleLayer).isVisible = false
                    entry2.isVisible = false
                }
            } else {
                overlayMap.delete(oid)
            }
        }
    }
    // v1.9.0: E0 GeoJSON 层重放通知（组件层持有 geojson/options 快照与编排逻辑，原生层只负责通知时机）
    const replayCb = geoJsonReplayCallback
    if (replayCb != null) {
        replayCb()
    }
}

// context7: MLNMapView.h 官方源码——styleJSON 属性"Setting this property results in an asynchronous
// style change"；赋值触发 didFinishLoadingStyle 回调（styleRebuildMode 三态在 delegate 中拦截）
export function setStyle(styleJson: string): void {
    if (mapView == null) return
    // 前置校验：必须含 version 字段，防止解析失败导致地图空白
    if (styleJson.indexOf('"version"') < 0) {
        console.error("TDTMap: setStyle 拒绝：JSON 缺少 version 字段")
        if (onErrorCallback != null) {
            onErrorCallback({ code: 4, message: "setStyle 需为含 version 字段的 MapLibre Style Spec JSON" })
        }
        return
    }
    customStyleActive = true
    styleRebuildMode = 1
    mapView.styleJSON = styleJson
}

export function removeStyle(): void {
    if (mapView == null) return
    if (!customStyleActive) return
    customStyleActive = false
    styleRebuildMode = 2
    // 内联空样式（与 getEmptyStyleURL 等价，无文件依赖）；加载完成后 delegate 重建天底图+用户层
    mapView.styleJSON = '{"version":8,"sources":{},"layers":[]}'
}

export function isSupportCanvas(): boolean {
    return false
}

// ══════════════════════════════════════════════
// v1.4.0 新增：地图交互增强
// ══════════════════════════════════════════════

// context7 验证：setMapLongClickCallback 存储回调（实际监听在 initMap 中注册）
@UTSJS.keepAlive
export function setMapLongClickCallback(callback: MapLongClickCallback): void {
    mapLongClickCallback = callback
}

// context7 验证：MLNMapView.direction 属性设置/读取 bearing（0=正北，顺时针）
export function setBearing(bearing: number): void {
    if (mapView != null) {
        mapView.direction = bearing
    }
}

// context7 验证：MLNMapCamera.pitch 设置 tilt，需通过新建 MLNMapCamera 修改
export function setTilt(tilt: number): void {
    if (mapView == null) return
    const curCam = mapView.camera
    if (curCam == null) return
    // context7 验证：MLNMapCamera 构造 initWithLookingAtCenterCoordinate:altitude:pitch:heading:
    const newCam = new MLNMapCamera(curCam.centerCoordinate, curCam.altitude, tilt, curCam.heading)
    mapView.setCamera(newCam, true)
}

// context7 验证：MLNMapView.direction 读取 bearing
export function getBearing(): number {
    if (mapView != null) {
        return mapView.direction
    }
    return 0
}

// context7 验证：MLNMapView.camera.pitch 读取 tilt
export function getTilt(): number {
    if (mapView != null) {
        const cam = mapView.camera
        if (cam != null) return cam.pitch
    }
    return 0
}

// context7 验证：MLNMapView.rotateEnabled 控制双指旋转手势
export function enableRotate(enabled: boolean): void {
    if (mapView != null) {
        mapView.rotateEnabled = enabled
    }
}

// context7 验证：MLNMapView.pitchEnabled 控制双指倾斜手势
export function enableTilt(enabled: boolean): void {
    if (mapView != null) {
        mapView.pitchEnabled = enabled
    }
}

// context7 验证：setCameraChangeCallback 存储回调（实际监听在 TDTMapDelegate 中实现）
@UTSJS.keepAlive
export function setCameraChangeCallback(callback: CameraChangeCallback): void {
    cameraChangeCallback = callback
}

// ══════════════════════════════════════════════
// v1.7.0 新增：标记聚合 + 热力图（数据可视化）
// context7: MapLibre iOS 为 Mapbox iOS SDK 6 fork，聚类 API 同源：
// MLNShapeSource options 键 MLNShapeSourceOption.clustered / .clusterRadius /
// .maximumZoomLevelForClustering；聚合簇是 MLNPointFeatureCluster（MLNFeature 子类，
// attributes 含 "cluster"=true、"point_count"）；source.zoomLevelForExpandingCluster(cluster)
// 返回展开缩放级别
// ⚠️ 编译期验证项：MLNShapeSourceOption 枚举键名与 zoomLevelForExpandingCluster 方法签名
// 若编译报错，按 Mapbox iOS SDK 官方 API 参考调整（本实现已按同源 API 编写）
// ══════════════════════════════════════════════
let clusterSourceRef: MLNShapeSource | null = null
let clusterCircleLayerRef: MLNCircleStyleLayer | null = null

export function addMarkerCluster(points: Array<MapClickDetail>, options?: ClusterOptions): void {
    if (mapView == null || mapView.style == null) {
        if (onErrorCallback != null) onErrorCallback({ code: 4, message: "样式未加载，无法添加聚合图层" })
        return
    }
    removeMarkerCluster()
    if (points.length == 0) return
    try {
        const features: Array<MLNPointFeature> = []
        for (let i = 0; i < points.length; i++) {
            const f = new MLNPointFeature()
            f.coordinate = CLLocationCoordinate2DMake(points[i].lat, points[i].lng)
            features.push(f)
        }
        // UTS iOS 调用约定：选择子首段作方法名 + 后续参数带标签（与 setCenterCoordinate(center, zoom, true)、
        // convertPoint(point, toCoordinateFromView:) 一致）：dictionaryWithObjects:forKeys: → dictionaryWithObjects(... forKeys:)
        const opts = NSDictionary.dictionaryWithObjects(
            [true, (options?.clusterRadius ?? 50).toInt32(), (options?.clusterMaxZoom ?? 14).toInt32()],
            forKeys: [MLNShapeSourceOption.clustered, MLNShapeSourceOption.clusterRadius, MLNShapeSourceOption.maximumZoomLevelForClustering]
        ) as NSDictionary
        const source = new MLNShapeSource("tdt-cluster-source", features as MLNShape[], opts)
        mapView.style?.addSource(source)
        clusterSourceRef = source

        // 聚合簇圆点图层：predicate 匹配 cluster==true 的要素（MLNPointFeatureCluster）
        const layer = new MLNCircleStyleLayer("tdt-cluster-layer", source)
        layer.predicate = NSPredicate(format: "cluster == YES")
        layer.circleColor = NSExpression(forConstantValue: UIColor.blueColor())
        layer.circleRadius = NSExpression(forConstantValue: 20.0)
        layer.circleStrokeColor = NSExpression(forConstantValue: UIColor.whiteColor())
        layer.circleStrokeWidth = NSExpression(forConstantValue: 1.0)
        mapView.style?.addLayer(layer)
        clusterCircleLayerRef = layer
        // v1.8.0: 成功路径快照（样式切换后由 rebuildUserLayersAfterStyle 重放）
        clusterDataRef = points
        clusterOptionsRef = options ?? null
    } catch (e) {
        console.error("TDTMap: 添加聚合图层失败: " + e.toString())
        if (onErrorCallback != null) onErrorCallback({ code: 4, message: "添加聚合图层失败: " + e.toString() })
        removeMarkerCluster()
    }
}

export function removeMarkerCluster(): void {
    // v1.8.0: 清除数据快照
    clusterDataRef = null
    clusterOptionsRef = null
    if (mapView == null || mapView.style == null) {
        clusterSourceRef = null
        clusterCircleLayerRef = null
        return
    }
    if (clusterCircleLayerRef != null) {
        try {
            mapView.style?.removeLayer(clusterCircleLayerRef)
        } catch (e: any) {
            console.error("TDTMap: removeMarkerCluster 图层移除失败: " + (e.message ?? String(e)))
        }
    }
    if (clusterSourceRef != null) {
        try {
            mapView.style?.removeSource(clusterSourceRef)
        } catch (e: any) {
            console.error("TDTMap: removeMarkerCluster source 移除失败: " + (e.message ?? String(e)))
        }
    }
    clusterCircleLayerRef = null
    clusterSourceRef = null
}

// ⚠️ 编译期验证项：MLNHeatmapStyleLayer 类名与 heatmapWeight/heatmapRadius/heatmapOpacity
// 属性（Mapbox iOS SDK 同源类）；若编译报错按官方 API 参考调整
let heatmapLayerRef: MLNHeatmapStyleLayer | null = null
let heatmapSourceRef: MLNShapeSource | null = null

export function addHeatmap(points: Array<HeatmapItem>, options?: HeatmapOptions): void {
    if (mapView == null || mapView.style == null) {
        if (onErrorCallback != null) onErrorCallback({ code: 4, message: "样式未加载，无法添加热力图层" })
        return
    }
    removeHeatmap()
    if (points.length == 0) return
    try {
        const features: Array<MLNPointFeature> = []
        for (let i = 0; i < points.length; i++) {
            const f = new MLNPointFeature()
            f.coordinate = CLLocationCoordinate2DMake(points[i].lat, points[i].lng)
            f.attributes = NSDictionary.dictionaryWithObjects([points[i].weight ?? 1], forKeys: ["weight"]) as any
            features.push(f)
        }
        const source = new MLNShapeSource("tdt-heatmap-source", features as MLNShape[], null)
        mapView.style?.addSource(source)
        heatmapSourceRef = source

        const layer = new MLNHeatmapStyleLayer("tdt-heatmap-layer", source)
        layer.heatmapWeight = NSExpression(forKeyPath: "weight")
        layer.heatmapRadius = NSExpression(forConstantValue: (options?.radius ?? 30) as number)
        layer.heatmapOpacity = NSExpression(forConstantValue: (options?.opacity ?? 0.6) as number)
        mapView.style?.addLayer(layer)
        heatmapLayerRef = layer
        // v1.8.0: 成功路径快照（样式切换后由 rebuildUserLayersAfterStyle 重放）
        heatmapDataRef = points
        heatmapOptionsRef = options ?? null
    } catch (e) {
        console.error("TDTMap: 添加热力图层失败: " + e.toString())
        if (onErrorCallback != null) onErrorCallback({ code: 4, message: "添加热力图层失败: " + e.toString() })
        removeHeatmap()
    }
}

export function removeHeatmap(): void {
    // v1.8.0: 清除数据快照
    heatmapDataRef = null
    heatmapOptionsRef = null
    if (mapView != null && mapView.style != null) {
        if (heatmapLayerRef != null) {
            try {
                mapView.style?.removeLayer(heatmapLayerRef)
            } catch (e: any) {
                console.error("TDTMap: removeHeatmap 图层移除失败: " + (e.message ?? String(e)))
            }
        }
        if (heatmapSourceRef != null) {
            try {
                mapView.style?.removeSource(heatmapSourceRef)
            } catch (e: any) {
                console.error("TDTMap: removeHeatmap source 移除失败: " + (e.message ?? String(e)))
            }
        }
    }
    heatmapLayerRef = null
    heatmapSourceRef = null
}

// ════════════════════════════════════════════
// v1.9.0 新增：图片覆盖物（ImageOverlay）
// MLNImageSource+MLNRasterStyleLayer（style 层系）｜URL 引擎直载 / 本机路径 UIImage 同步读｜几何 hit-test 点击
// ════════════════════════════════════════════

// ── 图片覆盖物几何工具（Android/iOS/Web 三端同版纯函数，修改须三端同步；POC 浏览器实测验证） ──

// zIndex 档位键：未定义=置顶组(1e6) / 正整数=按值排序 / 0 及以下=贴底组(-1)（对齐 TileLayerOptions 三档约定）
function imageOverlayZKey(z: number | null): number {
    if (z == null) return 1000000
    if (z <= 0) return -1
    return z
}

// Web Mercator 正投影：x=经度，y=墨卡托 Y（避免高纬度经纬直接旋转形变）
function mercatorY(lat: number): number {
    const rad = lat * Math.PI / 180.0
    return Math.log(Math.tan(Math.PI / 4.0 + rad / 2.0))
}
function inverseMercatorY(y: number): number {
    return (2.0 * Math.atan(Math.exp(y)) - Math.PI / 2.0) * 180.0 / Math.PI
}

// 计算图片四角坐标（官方顺序：左上/右上/右下/左下，[lng,lat] 对）；bearing≠0 时在 Mercator 平面绕中心顺时针旋转
function computeImageQuad(sw: MapClickDetail, ne: MapClickDetail, bearing: number): Array<Array<number>> {
    const corners: Array<Array<number>> = [
        [sw.lng, ne.lat],
        [ne.lng, ne.lat],
        [ne.lng, sw.lat],
        [sw.lng, sw.lat]
    ]
    if (bearing == 0) return corners
    const rad = -bearing * Math.PI / 180.0
    const cx = (sw.lng + ne.lng) / 2.0
    const cyM = (mercatorY(sw.lat) + mercatorY(ne.lat)) / 2.0
    const out: Array<Array<number>> = []
    for (let i = 0; i < 4; i++) {
        const x = corners[i][0] - cx
        const y = mercatorY(corners[i][1]) - cyM
        const rx = x * Math.cos(rad) - y * Math.sin(rad)
        const ry = x * Math.sin(rad) + y * Math.cos(rad)
        out.push([cx + rx, inverseMercatorY(cyM + ry)])
    }
    return out
}

// 点击命中检测：点击点正向旋转回未旋转 bounds 坐标系后与轴对齐半宽半高比较（与 computeImageQuad 互逆）
function hitTestImageOverlay(lat: number, lng: number, params: ImageOverlayOptions): boolean {
    const sw = params.southwest
    const ne = params.northeast
    const bearing = params.bearing ?? 0
    if (bearing == 0) {
        return lat >= sw.lat && lat <= ne.lat && lng >= sw.lng && lng <= ne.lng
    }
    const rad = bearing * Math.PI / 180.0
    const cx = (sw.lng + ne.lng) / 2.0
    const cyM = (mercatorY(sw.lat) + mercatorY(ne.lat)) / 2.0
    const x = lng - cx
    const y = mercatorY(lat) - cyM
    const rx = x * Math.cos(rad) - y * Math.sin(rad)
    const ry = x * Math.sin(rad) + y * Math.cos(rad)
    const halfW = (ne.lng - sw.lng) / 2.0
    const halfH = (mercatorY(ne.lat) - mercatorY(sw.lat)) / 2.0
    return Math.abs(rx) <= halfW && Math.abs(ry) <= halfH
}

// 四角数组 → CLLocationCoordinate2D 数组（MLNImageSource coordinateQuad 参数，顺序同 GL JS image source）
function buildCoordinateQuad(quad: Array<Array<number>>): Array<CLLocationCoordinate2D> {
    const pts: Array<CLLocationCoordinate2D> = []
    for (let i = 0; i < 4; i++) {
        pts.push(CLLocationCoordinate2DMake(quad[i][1], quad[i][0]))
    }
    return pts
}

// 层序定位：iOS 无公开的 style 有序层列表，相对层序由自身插入逻辑维护（imageOverlayIds + 档位键）
// 在现有图片层中找档位键更大的第一个层（below 语义）；null 表示追加置顶
function imageOverlayBeforeLayerRef(newKey: number, excludeId: number): any | null {
    const style = mapView?.style
    if (style == null) return null
    for (let i = 0; i < imageOverlayIds.length; i++) {
        const oid = imageOverlayIds[i]
        if (oid == excludeId) continue
        const info = imageOverlayExt.get(oid)
        if (info == null) continue
        if (imageOverlayZKey(info.params.zIndex ?? null) > newKey) {
            return style.layerWithIdentifier("img-overlay-layer-" + oid)
        }
    }
    return null
}

// 档位键最小（渲染最下）的其他图片层；null 表示无（zIndex=0 无注记层时的降级锚点，与 Web/Android 一致）
function lowestImageLayerRef(excludeId: number): any | null {
    const style = mapView?.style
    if (style == null) return null
    let lowest: any | null = null
    let lowestKey = 2147483647
    let lowestIdx = 2147483647
    for (let i = 0; i < imageOverlayIds.length; i++) {
        const oid = imageOverlayIds[i]
        if (oid == excludeId) continue
        const info = imageOverlayExt.get(oid)
        if (info == null) continue
        const key = imageOverlayZKey(info.params.zIndex ?? null)
        if (key < lowestKey || (key == lowestKey && i < lowestIdx)) {
            lowestKey = key
            lowestIdx = i
            lowest = style.layerWithIdentifier("img-overlay-layer-" + oid)
        }
    }
    return lowest
}

// zIndex 三档插入：0 及以下=注记层之下（缺失降级图片层最下）/ 未定义=置顶 / 正整数=按档位插入
function placeImageLayerByZIndex(layer: MLNRasterStyleLayer, z: number | null, excludeId: number): void {
    const style = mapView?.style
    if (style == null) return
    if (z != null && z <= 0) {
        const labelLayer = style.layerWithIdentifier("tdt-label-" + currentMapType + "-layer")
        if (labelLayer != null) {
            style.insertLayer(layer, below: labelLayer)
        } else if (currentMapType == 'blank') {
            // v1.9.1: blank 白底无注记层——插到首个非背景层（identifier != tdt-bg-layer）之下；
            // 无用户层时置顶（后续用户层 append 仍会盖其上），保证 zIndex<=0 图层恒在矢量层之下
            const layersAll = style.layers
            if (layersAll != null) {
                const all = Array.fromNative(layersAll)
                for (let j = 0; j < all.length; j++) {
                    const l = all[j] as any
                    const lid = l.identifier as string
                    if (lid == 'tdt-bg-layer') continue
                    style.insertLayer(layer, below: l)
                    return
                }
            }
            style.addLayer(layer)
        } else {
            const lowest = lowestImageLayerRef(excludeId)
            if (lowest != null) {
                style.insertLayer(layer, below: lowest)
            } else {
                style.addLayer(layer)
            }
            console.warn("TDTMap: 图片覆盖物 zIndex=0 但当前样式无注记层，已按图片层最下处理")
        }
        return
    }
    const before = imageOverlayBeforeLayerRef(imageOverlayZKey(z), excludeId)
    if (before != null) {
        style.insertLayer(layer, below: before)
    } else {
        style.addLayer(layer)
    }
}

// 创建 source+layer 挂载到当前 style 并回填状态；返回 false 表示加载失败（本机路径不存在等）
// ⚠️ 编译期验证项：MLNImageSource 初始化器 named 参数桥接（initWithIdentifier:coordinateQuad:url:/image:）；
// 若桥接报错，改用先构造后赋值（source.URL = / setImage 类 setter），记录到 Task 验证项
// v1.9.0: presetImage 非 null 时跳过 URL/路径加载直接使用（E0.3b styled 文本位图通路）
function attachImageOverlayToStyle(id: number, params: ImageOverlayOptions, presetImage: any | null): boolean {
    const style = mapView?.style
    if (style == null) return false
    const sourceId = "img-overlay-src-" + id
    const layerId = "img-overlay-layer-" + id
    const quad = buildCoordinateQuad(computeImageQuad(params.southwest, params.northeast, params.bearing ?? 0))
    const isHttp = params.image.indexOf("http://") == 0 || params.image.indexOf("https://") == 0
    let source: MLNImageSource
    let uiImg: any | null = presetImage
    if (uiImg != null) {
        source = new MLNImageSource(sourceId, coordinateQuad: quad, image: uiImg as UIImage)
    } else if (isHttp) {
        // URL 直载：引擎内部异步下载（规避 UTS 无异步下载先例）
        const nsurl = NSURL.URLWithString(params.image)
        if (nsurl == null) {
            if (onErrorCallback != null) {
                onErrorCallback({ code: 4, message: "图片 URL 非法: " + params.image })
            }
            return false
        }
        source = new MLNImageSource(sourceId, coordinateQuad: quad, url: nsurl)
    } else {
        // 本机路径：外部维护的缓存通常为热数据，同步读盘可接受（ UIImage 引擎负责解码）
        uiImg = UIImage(contentsOfFile: params.image)
        if (uiImg == null) {
            if (onErrorCallback != null) {
                onErrorCallback({ code: 4, message: "图片加载失败（路径不存在或非图片）: " + params.image })
            }
            return false
        }
        source = new MLNImageSource(sourceId, coordinateQuad: quad, image: uiImg as UIImage)
    }
    style.addSource(source)
    const layer = new MLNRasterStyleLayer(layerId, source)
    layer.rasterOpacity = NSExpression(forConstantValue: 1.0 - (params.transparency ?? 0))
    const visible = params.visible ?? true
    layer.isVisible = visible
    placeImageLayerByZIndex(layer, params.zIndex, id)
    imageOverlayExt.set(id, { source: source, layer: layer, params: params, uiImage: uiImg })
    const entry = overlayMap.get(id)
    if (entry != null) {
        entry.nativeRef = { source: source, layer: layer }
        entry.isVisible = visible
    }
    if (imageOverlayIds.indexOf(id) < 0) {
        imageOverlayIds.push(id)
    }
    return true
}

export function addImageOverlay(params: ImageOverlayOptions): number {
    if (mapView == null || mapView.style == null) {
        if (onErrorCallback != null) {
            onErrorCallback({ code: 4, message: "样式未加载，无法添加图片覆盖物" })
        }
        return 0
    }
    const id = allocateOverlayId('image', null)
    try {
        if (!attachImageOverlayToStyle(id, params, null)) {
            overlayMap.delete(id)
            return 0
        }
    } catch (e: any) {
        console.error("TDTMap: addImageOverlay 失败: " + (e.message ?? String(e)))
        overlayMap.delete(id)
        if (onErrorCallback != null) {
            onErrorCallback({ code: 2, message: "添加图片覆盖物失败: " + (e.message ?? String(e)) })
        }
        return 0
    }
    return id
}

export function updateImageOverlay(id: number, changes: ImageOverlayUpdateOptions): void {
    const entry = overlayMap.get(id)
    const ext = imageOverlayExt.get(id)
    if (entry == null || ext == null || mapView == null) return
    if (entry.nativeRef == null) {
        console.warn("TDTMap: updateImageOverlay - 图片加载中，本次更新已忽略")
        return
    }
    const p = ext.params
    const oldZ = p.zIndex ?? null
    // 合并变更（未传字段保持不变）
    if (changes.southwest != null) p.southwest = changes.southwest
    if (changes.northeast != null) p.northeast = changes.northeast
    if (changes.image != null) p.image = changes.image
    if (changes.transparency != null) p.transparency = changes.transparency
    if (changes.zIndex != null) p.zIndex = changes.zIndex
    if (changes.bearing != null) p.bearing = changes.bearing
    if (changes.visible != null) p.visible = changes.visible
    if (changes.clickable != null) p.clickable = changes.clickable
    try {
        // 范围/旋转/换图变化：MLNImageSource 坐标/URL setter 的 UTS 桥接未验证（编译期验证项），
        // 采用确定性方案：remove+重挂载（同 ID，attach 重放全部合并参数含透明度/可见性）
        if (changes.southwest != null || changes.northeast != null || changes.bearing != null || changes.image != null) {
            const style = mapView?.style
            if (style != null) {
                const ref0 = entry.nativeRef
                try {
                    style.removeLayer(ref0.layer)
                    style.removeSource(ref0.source)
                } catch (e2: any) { /* 旧样式残留容忍 */ }
                imageOverlayIds = imageOverlayIds.filter(x => x != id)
                imageOverlayExt.delete(id)
                if (!attachImageOverlayToStyle(id, p, null)) {
                    overlayMap.delete(id)
                } else {
                    // 保持 entry.isVisible 与重建层一致
                    const entry3 = overlayMap.get(id)
                    if (entry3 != null) entry.isVisible = entry3.isVisible
                }
            }
            return
        }
        const ref = entry.nativeRef
        const layer = ref.layer as MLNRasterStyleLayer
        if (changes.transparency != null) {
            layer.rasterOpacity = NSExpression(forConstantValue: 1.0 - (p.transparency ?? 0))
        }
        if (changes.visible != null) {
            const visible = p.visible != false
            layer.isVisible = visible
            entry.isVisible = visible
        }
        // zIndex 档位变化：iOS 无 moveLayer，removeLayer 后按新档位重插（同一 layer 对象可复用）
        if (changes.zIndex != null && imageOverlayZKey(p.zIndex ?? null) != imageOverlayZKey(oldZ)) {
            const style = mapView?.style
            if (style != null) {
                try { style.removeLayer(layer) } catch (e3: any) { /* 容忍 */ }
                placeImageLayerByZIndex(layer, p.zIndex, id)
            }
        }
    } catch (e: any) {
        console.error("TDTMap: updateImageOverlay 失败: " + (e.message ?? String(e)))
        if (onErrorCallback != null) {
            onErrorCallback({ code: 4, message: "更新图片覆盖物失败: " + (e.message ?? String(e)) })
        }
    }
}

@UTSJS.keepAlive
export function setImageOverlayClickCallback(callback: ImageOverlayClickCallback | null): void {
    // 仅更新回调引用；命中检测在 initMap 注册的 tapGesture 闭包内执行（与 Android Priority 链同源）
    imageOverlayClickCallback = callback
}

// v1.9.0: E0 GeoJSON 层重放通知注册（触发点：rebuildUserLayersAfterStyle 末尾）
@UTSJS.keepAlive
export function setGeoJsonReplayCallback(callback: GeoJsonReplayCallback | null): void {
    geoJsonReplayCallback = callback
}
