// ⚠️ 天地图 Key 类型说明（自新系统升级后严格区分，混用会导致瓦片不显示）:
//   - "浏览器端" key：校验 Referer 头 + 域名白名单 → 原生 App 不发送浏览器 Referer → 403 被拒 → 灰白背景
//   - "服务端" key：校验 IP 白名单（留空则不限制）→ 原生 App 推荐使用
//   - "Android平台" key：专用于移动端原生 API
//   🔧 iOS/鸿蒙也需使用"服务端"类型 key（IP 白名单留空），三端通用

let mapView: MLNMapView | null = null
let mapViewDelegate: TDTMapDelegate | null = null
let onClickCallback: MapClickCallback | null = null
let onReadyCallback: MapReadyCallback | null = null
let onErrorCallback: MapErrorCallback | null = null
let currentApiKey: string = ''
let currentMapType: string = 'vec'
let polygons: Array<any> = []
let polylines: Array<any> = []
let circles: Array<any> = []
let rectangles: Array<any> = []

// ── 覆盖物 ID 追踪系统 ──
// 为每个添加的覆盖物分配唯一 ID，支持 removeOverlay/showOverlay/hideOverlay 单个操作
let overlayIdCounter: number = 0
let overlayMap = new Map<number, OverlayEntry>()

type OverlayEntry = {
    id: number
    type: string  // 'marker' | 'polygon' | 'polyline' | 'circle' | 'rectangle' | 'label' | 'image'
    nativeRef: any  // MLNPointAnnotation or { source, layer }（形状与 image 均为 source+layer 包装）
    isVisible: boolean
}

// ── v1.9.0: 图片覆盖物状态 ──
// removeOverlay/showOverlay/hideOverlay 的 else 分支（ref.layer / ref.source）对 {source, layer} 天然适用；
// imageOverlayExt 额外持有 params 快照（update 合并/样式重建重放）与 uiImage（本机路径加载复用）
type ImageOverlayExt = { source: any, layer: any, params: ImageOverlayOptions, uiImage: any | null }
let imageOverlayExt = new Map<number, ImageOverlayExt>()
// 平行数组存添加顺序（zIndex 定位/重建重放；iOS 无公开的 style 有序层列表，层序由自身插入逻辑维护）
let imageOverlayIds: Array<number> = []
let imageOverlayClickCallback: ImageOverlayClickCallback | null = null

// v1.9.0: E0 GeoJSON 层重放通知（快照与编排在组件层，原生层仅负责时机通知）
let geoJsonReplayCallback: GeoJsonReplayCallback | null = null

let markerClickCallback: MarkerClickCallback | null = null
let mapLongClickCallback: MapLongClickCallback | null = null
let cameraChangeCallback: CameraChangeCallback | null = null
let didSelectMarkerFlag: boolean = false

// 分配 overlay ID 并存入追踪表
function allocateOverlayId(type: string, nativeRef: any): number {
    overlayIdCounter++
    const id = overlayIdCounter
    overlayMap.set(id, { id: id, type: type, nativeRef: nativeRef, isVisible: true })
    return id
}

// 从 overlayMap 中清除指定类型的所有条目
function clearOverlayType(type: string): void {
    const keysToRemove: Array<number> = []
    overlayMap.forEach((entry: OverlayEntry, key: number) => {
        if (entry.type == type) {
            keysToRemove.push(key)
        }
    })
    for (let i = 0; i < keysToRemove.length; i++) {
        overlayMap.delete(keysToRemove[i])
    }
}

// 天地图 DataServer XYZ 格式瓦片 URL（与鸿蒙端一致，已验证可用）
function getTileUrl(layerType: string): string {
    return 'https://t0.tianditu.gov.cn/DataServer?T=' + layerType + '_w&x={x}&y={y}&l={z}&tk='
}

// 生成 8 个子域名的瓦片 URL 数组（并行加载，性能提升 6-8 倍）
function buildTileURLsArray(layerType: string, apiKey: string): Array<string> {
    let urls: Array<string> = []
    for (let s = 0; s < 8; s++) {
        urls.push('https://t' + s.toString() + '.tianditu.gov.cn/DataServer?T=' + layerType + '_w&x={x}&y={y}&l={z}&tk=' + apiKey)
    }
    return urls
}

// v1.9.0: mapType='blank' 白底层（E0 配套）。空样式画布非白底，必须显式 background #ffffff。
// 幂等：层已存在时仅恢复可见（blank ↔ vec/img/ter 切换复用）
function ensureBlankBackgroundLayer(mapView: MLNMapView): void {
    const style = mapView.style
    if (style == null) return
    const existing = style.layerWithIdentifier("tdt-bg-layer")
    if (existing != null) {
        existing.isVisible = true
        return
    }
    const layer = new MLNBackgroundStyleLayer("tdt-bg-layer")
    layer.backgroundColor = NSExpression(forConstantValue: UIColor.colorWithRed(1.0, 1.0, 1.0, 1.0))
    style.addLayer(layer)
}

// 隐藏白底层（blank 切回 vec/img/ter 时调用；层不存在时 no-op）
function hideBlankBackgroundLayer(mapView: MLNMapView): void {
    const existing = mapView.style?.layerWithIdentifier("tdt-bg-layer")
    if (existing != null) {
        existing.isVisible = false
    }
}

// 插件内置空白样式（替代 demotiles.maplibre.org，该域名在国内被墙）
// style.json 位于 utssdk/app-ios/Resources/，打包时由 uni-app x 拷入主 Bundle
// 如果 Resources/style.json 被打包工具遗漏，使用 inline data URL 空白样式作为兜底
function getEmptyStyleURL(): NSURL {
    const path = NSBundle.mainBundle.pathForResource("style", "json")
    if (path != null) {
        console.log("TDTMap: 使用内置空白样式")
        return NSURL.fileURLWithPath(path)!
    }
    // 兜底：使用内联空样式 JSON 的 data URL，避免回退被墙域名
    console.warn("TDTMap: style.json 未找到，使用内联空白样式")
    const inlineJson = "{\"version\":8,\"name\":\"tdt-empty\",\"sources\":{},\"layers\":[]}"
    return NSURL.URLWithString("data:application/json," + inlineJson)!
}

// 样式加载完成代理：Source/Layer 必须等样式加载完成后添加（MapLibre iOS 官方约束）
class TDTMapDelegate implements MLNMapViewDelegate {
    private opts: TDMapOptions

    constructor(opts: TDMapOptions) {
        this.opts = opts
    }

    // context7 验证：协议要求 ObjC selector 为 mapView:didFinishLoadingStyle:
    // UTS 中方法名 mapView + 参数名 didFinishLoadingStyle 生成正确 selector
    @objc mapView(mapView: MLNMapView, didFinishLoadingStyle: MLNStyle): void {
        // v1.8.0: 三态拦截。初始路径（mode 0）与 v1.7.x 完全一致；
        // mode 1 不重建天底图（防天地图瓦片盖住用户样式——若不拦截，setStyle 后
        // 本回调会无条件加回天地图三层，用户自定义样式被底图覆盖，属真 bug）
        if (styleRebuildMode == 0) {
            // v1.9.0: blank 白底——不加载天地图瓦片（vec 注记与插件地名叠影问题随之消失）
            if (this.opts.mapType == 'blank') {
                ensureBlankBackgroundLayer(mapView)
            } else {
                // 预创建所有图层对（vec/img/ter），非活跃图层设为不可见
                addTiandituTileLayer(mapView, 'vec', this.opts.apiKey, this.opts.mapType == 'vec' ? 'visible' : 'none')
                addTiandituTileLayer(mapView, 'img', this.opts.apiKey, this.opts.mapType == 'img' ? 'visible' : 'none')
                addTiandituTileLayer(mapView, 'ter', this.opts.apiKey, this.opts.mapType == 'ter' ? 'visible' : 'none')
            }

            // 设置初始视角（CLLocationCoordinate2D 是 C 结构体，必须用 Make 函数构造）
            const center = CLLocationCoordinate2DMake(this.opts.latitude, this.opts.longitude)
            mapView.setCenterCoordinate(center, this.opts.zoom, false)

            if (onReadyCallback != null) {
                onReadyCallback()
            }
            return
        }
        if (styleRebuildMode == 2) {
            // removeStyle：空样式已加载，重建天地图底图三层（仅当前类型可见）
            if (currentMapType == 'blank') {
                // v1.9.0: blank 底图恢复白底层
                ensureBlankBackgroundLayer(mapView)
            } else {
                addTiandituTileLayer(mapView, 'vec', currentApiKey, currentMapType == 'vec' ? 'visible' : 'none')
                addTiandituTileLayer(mapView, 'img', currentApiKey, currentMapType == 'img' ? 'visible' : 'none')
                addTiandituTileLayer(mapView, 'ter', currentApiKey, currentMapType == 'ter' ? 'visible' : 'none')
            }
        }
        // mode 1/2 均重建用户数据层
        rebuildUserLayersAfterStyle()
        styleRebuildMode = 0
    }

    // v1.8.0 审查修复：样式加载失败回调（MGLMapViewDelegate 协议方法，selector 为
    // mapView:didFailLoadingMapWithError:，与 didFinishLoadingStyle 同协议同源）。
    // setStyle 的 styleJSON 赋值是异步解析，非法 JSON 不抛同步异常而是走到此回调；
    // 若不回滚，styleRebuildMode 卡在 1 / customStyleActive 卡在 true（与 Android 端
    // setStyle try/catch 回滚对称）。mode 2 失败（内联空样式，固定合法 JSON，理论不可达）
    // 时恢复 customStyleActive = true，语义与 setStyle 失败相反
    @objc mapView(mapView: MLNMapView, didFailLoadingMapWithError: any): void {
        if (styleRebuildMode != 0) {
            console.error("TDTMap: 样式切换失败: " + String(didFailLoadingMapWithError ?? ""))
            if (styleRebuildMode == 1) {
                customStyleActive = false
            } else if (styleRebuildMode == 2) {
                customStyleActive = true
            }
            styleRebuildMode = 0
            if (onErrorCallback != null) {
                onErrorCallback({ code: 4, message: "样式切换失败: " + String(didFailLoadingMapWithError ?? "") })
            }
        }
    }

    // context7 验证：MLNMapViewDelegate 的标注点击回调，selector 为 mapView:didSelectAnnotation:
    @objc mapView(mapView: MLNMapView, didSelectAnnotation: any): void {
        const cb = markerClickCallback
        if (cb != null) {
            didSelectMarkerFlag = true
            // context7 验证：@objc 方法参数名即变量名，didSelectAnnotation 对应该 selector 的第二个参数
            // 错误使用 annotation（未定义变量）会导致运行时 ReferenceError，标记点击事件完全失效
            const coord = (didSelectAnnotation as MLNPointAnnotation).coordinate
            cb({ lat: coord.latitude, lng: coord.longitude })
        }
    }

    // v1.4.0: 相机变化回调 — context7 验证：MLNMapViewDelegate.mapViewCameraDidChange 在视野变化时触发
    mapViewCameraDidChange(mapView: MLNMapView): void {
        const cb = cameraChangeCallback
        if (cb != null) {
            // 防御：虽然 delegate 触发时 camera 理论上不为 nil，但 ObjC 桥接层偶见 nil 传递
            const cam = mapView.camera
            if (cam != null) {
                const coordinate = cam.centerCoordinate
                cb({ lat: coordinate.latitude, lng: coordinate.longitude })
            }
        }
    }
}

@UTSJS.keepAlive
export function initMap(
    container: UniNativeViewElement,
    options: TDMapOptions,
    onClick: MapClickCallback,
    onReady: MapReadyCallback,
    onError: MapErrorCallback
): void {
    if (options.apiKey == null || options.apiKey.length == 0) {
        onError({ code: 1, message: "API Key 为空" })
        return
    }

    onClickCallback = onClick
    onReadyCallback = onReady
    onErrorCallback = onError
    currentApiKey = options.apiKey
    currentMapType = options.mapType

    console.log("TDTMap: initMap key=" + (options.apiKey.length > 0 ? "***" : "空") + " type=" + options.mapType)

    // 诊断日志：输出瓦片 URL（复制到浏览器验证 key 是否有效）
    const diagUrl = getTileUrl('vec') + options.apiKey
    console.log("TDTMap: 诊断URL(浏览器验证)= " + diagUrl.replace("{x}", "537").replace("{y}", "389").replace("{z}", "10"))

    const frame = container.bounds
    const styleURL = getEmptyStyleURL()
    // 创建时必须指定 styleURL，否则 style 恒为 nil，图层永远无法添加
    mapView = new MLNMapView(frame, styleURL)
    container.bindIOSView(mapView)

    // v1.6.0: 隐藏 MapLibre 原生 logo 与 attribution button —— MapLibre 默认 logo（左下）
    // 与 attribution ℹ（右下）会与 uvue 版权条重叠且版权信息对天地图场景是错误的；
    // MapLibre BSD-3 许可不强制显示 logo，天地图瓦片不含 OSM 数据无 attribution 义务，
    // 版权统一由 uvue 版权条承担。
    // context7 验证（2026-08-16 复核）：Jawg Maps（MapLibre 官方 iOS 集成文档）
    // add-geometry 示例明确使用 mapView.logoView.isHidden = true（Swift 名为 isHidden，
    // UTS 桥接 Objective-C 属性名 hidden，写法一致）；attributionButton 为 Mapbox iOS 6
    // 系公开只读属性，MapLibre iOS（MLN）为同名 fork，编译期若报错按此注释调整
    // UTS 对 `?.` 赋值（Kotlin 规则）支持不明确，改为判空后赋值（与文件既有风格一致）
    const logoView = mapView.logoView
    if (logoView != null) {
        logoView.hidden = true
    }
    const attrBtn = mapView.attributionButton
    if (attrBtn != null) {
        attrBtn.hidden = true
    }

    // context7 验证：mapView.delegate 是 weak 引用，new 返回的临时对象会在语句结束时释放
    // 必须先存入局部变量强引用，再赋值给 delegate，否则 delegate 立即变为 nil
    const d = new TDTMapDelegate(options)
    mapView.delegate = d
    mapViewDelegate = d

    const tapGesture = new UITapGestureRecognizer((gesture: UITapGestureRecognizer) => {
        // 如果刚刚选中了标记（didSelectAnnotation 触发），跳过地图点击回调
        if (didSelectMarkerFlag) {
            didSelectMarkerFlag = false
            return
        }
        // v1.7.0: 聚合簇点击检测（visibleFeatures 查询指定 layer 的要素；
        // attributes["cluster"]==true 时为 MLNPointFeatureCluster，调用 zoomLevelForExpandingCluster 放大展开）
        // ⚠️ 编译验证项：UTS 中 Set 用 new 构造（TS 语义），Swift 签名为 Set<String>?；
        // 若 new Set 语法报错，改用 NSSet(array: ["tdt-cluster-layer"]) 并在 Task 12 记录
        if (mapView != null && clusterSourceRef != null) {
            const clusterPoint = gesture.locationInView(mapView)
            const hitFeatures = mapView.visibleFeatures(at: clusterPoint, inFeatureLayersWithIdentifiers: new Set<string>(["tdt-cluster-layer"]))
            if (hitFeatures != null && hitFeatures.count > 0) {
                const cluster = hitFeatures[0] as MLNPointFeatureCluster
                const zoom = clusterSourceRef?.zoomLevelForExpandingCluster(cluster)
                if (zoom != null && zoom > 0) {
                    mapView.setCenterCoordinate(CLLocationCoordinate2DMake(cluster.coordinate.latitude, cluster.coordinate.longitude), zoom, true)
                    return  // 聚合点击消费事件，不触发 onClick
                }
            }
        }
        // v1.9.0: 图片覆盖物几何命中检测（不用 visibleFeatures——raster 图层无要素；
        // 档位高者优先，同档后添加优先），命中即消费事件不触发 mapClick，与 Android/Web 三端同版算法
        if (mapView != null && imageOverlayClickCallback != null && imageOverlayIds.length > 0) {
            const imgPoint = gesture.locationInView(mapView)
            const imgCoord = mapView.convertPoint(imgPoint, toCoordinateFromView: mapView)
            let hitId = 0
            let hitKey = -2000000
            let hitIdx = -1
            for (let i = 0; i < imageOverlayIds.length; i++) {
                const oid = imageOverlayIds[i]
                const entryImg = overlayMap.get(oid)
                const extImg = imageOverlayExt.get(oid)
                if (entryImg == null || extImg == null) continue
                if (!entryImg.isVisible) continue
                if (extImg.params.clickable == false) continue
                if (!hitTestImageOverlay(imgCoord.latitude, imgCoord.longitude, extImg.params)) continue
                const key = imageOverlayZKey(extImg.params.zIndex ?? null)
                if (key > hitKey || (key == hitKey && i > hitIdx)) {
                    hitId = oid
                    hitKey = key
                    hitIdx = i
                }
            }
            if (hitId > 0) {
                imageOverlayClickCallback({ id: hitId, lat: imgCoord.latitude, lng: imgCoord.longitude })
                return  // 图片点击消费事件，不触发 mapClick
            }
        }
        if (mapView != null && onClickCallback != null) {
            const point = gesture.locationInView(mapView)
            const coordinate = mapView.convertPoint(point, toCoordinateFromView: mapView)
            onClickCallback({
                lat: coordinate.latitude,
                lng: coordinate.longitude
            })
        }
    })
    tapGesture.cancelsTouchesInView = false
    mapView.addGestureRecognizer(tapGesture)

    // v1.4.0: 长按手势 — context7 验证：UILongPressGestureRecognizer 为离散手势，
    // 但 ObjC 运行时会以 .began/.ended 多次触发；必须按 state == 1 (UIGestureRecognizerStateBegan) 过滤，
    // 确保每次长按只回调一次
    const longPress = new UILongPressGestureRecognizer((gesture: UILongPressGestureRecognizer) => {
        if (gesture.state != 1) return  // 1 == UIGestureRecognizerStateBegan，仅首次触发
        const cb = mapLongClickCallback
        if (cb != null && mapView != null) {
            const point = gesture.locationInView(mapView)
            const coordinate = mapView.convertPoint(point, toCoordinateFromView: mapView)
            cb({ lat: coordinate.latitude, lng: coordinate.longitude })
        }
    })
    longPress.cancelsTouchesInView = false
    mapView.addGestureRecognizer(longPress)
}

function addTiandituTileLayer(map: MLNMapView, mapType: string, apiKey: string, visibility: string): void {
    try {
        let baseLayer: string
        let labelLayer: string

        switch (mapType) {
            case 'img':
                baseLayer = 'img'
                labelLayer = 'cia'
                break
            case 'ter':
                baseLayer = 'ter'
                labelLayer = 'cta'
                break
            default:
                baseLayer = 'vec'
                labelLayer = 'cva'
                break
        }

        // 生成 8 个子域名 URL（并行加载，浏览器单域名限制 6 连接）
        const baseTileURLs = buildTileURLsArray(baseLayer, apiKey)
        const labelTileURLs = buildTileURLsArray(labelLayer, apiKey)

        const baseSourceId = "tdt-base-" + mapType
        const baseSource = new MLNRasterTileSource(baseSourceId, baseTileURLs, null)
        map.style?.addSource(baseSource)
        const baseLayerId = "tdt-base-" + mapType + "-layer"
        const baseLayerObj = new MLNRasterStyleLayer(baseLayerId, baseSource)
        baseLayerObj.minimumZoomLevel = 1
        baseLayerObj.maximumZoomLevel = 18
        if (visibility == "none") {
            baseLayerObj.isVisible = false
        }
        map.style?.addLayer(baseLayerObj)

        const labelSourceId = "tdt-label-" + mapType
        const labelSource = new MLNRasterTileSource(labelSourceId, labelTileURLs, null)
        map.style?.addSource(labelSource)
        const labelLayerId = "tdt-label-" + mapType + "-layer"
        const labelLayerObj = new MLNRasterStyleLayer(labelLayerId, labelSource)
        labelLayerObj.minimumZoomLevel = 1
        labelLayerObj.maximumZoomLevel = 18
        if (visibility == "none") {
            labelLayerObj.isVisible = false
        }
        map.style?.addLayer(labelLayerObj)
    } catch (e) {
        if (onErrorCallback != null) {
            onErrorCallback({ code: 3, message: "瓦片加载失败: " + e.toString() })
        }
    }
}

export function setCenter(lat: number, lng: number): void {
    if (mapView != null) {
        const center = CLLocationCoordinate2DMake(lat, lng)
        mapView.setCenterCoordinate(center, true)
    }
}

export function setZoom(zoom: number): void {
    if (mapView != null) {
        mapView.setZoomLevel(zoom, true)
    }
}

export function getCenter(): MapClickDetail {
    if (mapView != null) {
        const coordinate = mapView.centerCoordinate
        return { lat: coordinate.latitude, lng: coordinate.longitude }
    }
    return { lat: 0, lng: 0 }
}

export function getZoom(): number {
    if (mapView != null) {
        return mapView.zoomLevel
    }
    return 0
}

export function fitBounds(minLat: number, minLng: number, maxLat: number, maxLng: number, padding: number): void {
    if (mapView == null) return
    const sw = CLLocationCoordinate2DMake(minLat, minLng)
    const ne = CLLocationCoordinate2DMake(maxLat, maxLng)
    const bounds = MLNCoordinateBoundsMake(sw, ne)
    const edgePadding = new UIEdgeInsets(padding, padding, padding, padding)
    mapView.setVisibleCoordinateBounds(bounds, edgePadding, true)
}

export function addMarker(lat: number, lng: number, title: string, snippet?: string): number {
    if (mapView != null) {
        const annotation = new MLNPointAnnotation()
        annotation.coordinate = CLLocationCoordinate2DMake(lat, lng)
        annotation.title = title
        // v1.3.0: 设置 subtitle 以支持信息窗口
        if (snippet != null && snippet.length > 0) {
            annotation.subtitle = snippet
        }
        mapView.addAnnotation(annotation)
        return allocateOverlayId('marker', annotation)
    }
    return 0
}

export function clearMarkers(): void {
    // 移除所有标记和文字标注（从 overlayMap 追踪的）
    overlayMap.forEach((entry: OverlayEntry, id: number) => {
        if ((entry.type == 'marker' || entry.type == 'label') && entry.nativeRef != null) {
            mapView?.removeAnnotation(entry.nativeRef as MLNPointAnnotation)
        }
    })
    clearOverlayType('marker')
    clearOverlayType('label')
}

// 将十六进制颜色字符串（如 '#FF0000' / '#FF000033'）转为 UIColor
// 格式：AARRGGBB（与 Android Color.parseColor 一致，alpha 在前）
function parseColor(color: string): UIColor {
    let hex = color
    if (hex.hasPrefix('#')) { hex = hex.substringFromIndex(1) }
    let r: number = 0, g: number = 0, b: number = 0, a: number = 255
    if (hex.length == 8) {
        // AARRGGBB 格式：alpha 在前
        a = parseInt(hex.substring(0, 2), 16)
        r = parseInt(hex.substring(2, 4), 16)
        g = parseInt(hex.substring(4, 6), 16)
        b = parseInt(hex.substring(6, 8), 16)
    } else {
        r = parseInt(hex.substring(0, 2), 16)
        g = parseInt(hex.substring(2, 4), 16)
        b = parseInt(hex.substring(4, 6), 16)
    }
    return UIColor.colorWithRed(r / 255.0, g / 255.0, b / 255.0, a / 255.0)
}

export function addPolygon(points: Array<MapClickDetail>, color: string, fillColor: string): number {
    if (mapView == null || mapView.style == null) return 0
    const coordinates: Array<CLLocationCoordinate2D> = []
    for (let i = 0; i < points.length; i++) {
        coordinates.push(CLLocationCoordinate2DMake(points[i].lat, points[i].lng))
    }
    const polygonId = "tdt-polygon-" + polygons.length.toString()
    try {
        const polygon = MLNPolygon(coordinates, points.length)
        const source = new MLNShapeSource(polygonId, polygon, null)
        mapView.style?.addSource(source)
        const layer = new MLNFillStyleLayer(polygonId + "-layer", source)
        layer.fillColor = NSExpression(forConstantValue: parseColor(fillColor))
        layer.fillOutlineColor = NSExpression(forConstantValue: parseColor(color))
        mapView.style?.addLayer(layer)
        const entry = { source: source, layer: layer }
        polygons.push(entry)
        return allocateOverlayId('polygon', entry)
    } catch (e) {
        if (onErrorCallback != null) {
            onErrorCallback({ code: 4, message: "添加多边形失败: " + e.toString() })
        }
        return 0
    }
}

export function clearPolygons(): void {
    if (mapView == null) {
        clearOverlayType('polygon')
        polygons = []
        return
    }
    for (let i = 0; i < polygons.length; i++) {
        mapView.style?.removeLayer(polygons[i].layer)
        mapView.style?.removeSource(polygons[i].source)
    }
    clearOverlayType('polygon')
    polygons = []
}

// ==================== 覆盖物：折线 ====================

export function addPolyline(points: Array<MapClickDetail>, color: string, width: number): number {
    if (mapView == null || mapView.style == null || points.length < 2) return 0
    const coordinates: Array<CLLocationCoordinate2D> = []
    for (let i = 0; i < points.length; i++) {
        coordinates.push(CLLocationCoordinate2DMake(points[i].lat, points[i].lng))
    }
    const polylineId = "tdt-polyline-" + polylines.length.toString()
    try {
        const polyline = MLNPolyline(coordinates, points.length)
        const source = new MLNShapeSource(polylineId, polyline, null)
        mapView.style?.addSource(source)
        const layer = new MLNLineStyleLayer(polylineId + "-layer", source)
        layer.lineColor = NSExpression(forConstantValue: parseColor(color))
        layer.lineWidth = NSExpression(forConstantValue: width)
        mapView.style?.addLayer(layer)
        const entry = { source: source, layer: layer }
        polylines.push(entry)
        return allocateOverlayId('polyline', entry)
    } catch (e) {
        if (onErrorCallback != null) {
            onErrorCallback({ code: 4, message: "添加折线失败: " + e.toString() })
        }
        return 0
    }
}

// ══════════════════════════════════════════════
// v1.9.0 新增：E0.3a styled 折线（虚线/透明度）
// ══════════════════════════════════════════════
// 沿用 legacy addPolyline 的 MLNShapeSource+MLNLineStyleLayer 结构，仅追加
// lineDashpattern（ObjC 属性名小写 p）/ lineOpacity 两个 paint 属性，legacy 行为零变化；
// 存入 polylines 数组（clearOverlays 批量移除复用既有遍历）
export function addStyledPolyline(points: Array<MapClickDetail>, color: string, width: number, dash: Array<number> | null, opacity?: number): number {
    if (mapView == null || mapView.style == null || points.length < 2) return 0
    const coordinates: Array<CLLocationCoordinate2D> = []
    for (let i = 0; i < points.length; i++) {
        coordinates.push(CLLocationCoordinate2DMake(points[i].lat, points[i].lng))
    }
    const lineId = "tdt-styled-line-" + polylines.length.toString()
    try {
        const polyline = MLNPolyline(coordinates, points.length)
        const source = new MLNShapeSource(lineId, polyline, null)
        mapView.style?.addSource(source)
        const layer = new MLNLineStyleLayer(lineId + "-layer", source)
        layer.lineColor = NSExpression(forConstantValue: parseColor(color))
        layer.lineWidth = NSExpression(forConstantValue: width)
        layer.lineOpacity = NSExpression(forConstantValue: opacity ?? 1.0)
        if (dash != null && dash.length > 0) {
            // UTS Array<number> 桥接 NSArray<NSNumber>，MLN lineDashpattern 接受 NSNumber 数组（style spec: 单位为线宽倍数）
            layer.lineDashpattern = NSExpression(forConstantValue: dash)
        }
        mapView.style?.addLayer(layer)
        const entry = { source: source, layer: layer }
        polylines.push(entry)
        return allocateOverlayId('styledPolyline', entry)
    } catch (e) {
        if (onErrorCallback != null) {
            onErrorCallback({ code: 4, message: "添加 styled 折线失败: " + e.toString() })
        }
        return 0
    }
}

// v1.9.2: 批量 styled 折线——全部环进一个 MLNMultiPolyline，单 MLNShapeSource+单 MLNLineStyleLayer
// （样式参数与单线版一致；管理面复用 polylines 数组 {source,layer} 条目，零新增管理分支）
export function addStyledPolylineBatch(points: Array<MapClickDetail>, ringLengths: Array<number>, color: string, width: number, dash: Array<number> | null, opacity?: number): number {
    if (mapView == null || mapView.style == null || points.length == 0 || ringLengths.length == 0) return 0
    const lineId = "tdt-styled-line-" + polylines.length.toString()
    try {
        const polys: Array<MLNPolyline> = []
        let offset = 0
        for (let i = 0; i < ringLengths.length; i++) {
            const len = ringLengths[i].toInt()
            if (len < 2 || offset + len > points.length) {
                offset += len
                continue
            }
            const coordinates: Array<CLLocationCoordinate2D> = []
            for (let j = 0; j < len; j++) {
                coordinates.push(CLLocationCoordinate2DMake(points[offset + j].lat, points[offset + j].lng))
            }
            polys.push(MLNPolyline(coordinates, len))
            offset += len
        }
        if (polys.length == 0) return 0
        const multi = MLNMultiPolyline(polys)
        const source = new MLNShapeSource(lineId, multi, null)
        mapView.style?.addSource(source)
        const layer = new MLNLineStyleLayer(lineId + "-layer", source)
        layer.lineColor = NSExpression(forConstantValue: parseColor(color))
        layer.lineWidth = NSExpression(forConstantValue: width)
        layer.lineOpacity = NSExpression(forConstantValue: opacity ?? 1.0)
        if (dash != null && dash.length > 0) {
            layer.lineDashpattern = NSExpression(forConstantValue: dash)
        }
        mapView.style?.addLayer(layer)
        const entry = { source: source, layer: layer }
        polylines.push(entry)
        return allocateOverlayId('styledPolyline', entry)
    } catch (e) {
        if (onErrorCallback != null) {
            onErrorCallback({ code: 4, message: "添加批量 styled 折线失败: " + e.toString() })
        }
        return 0
    }
}

// ══════════════════════════════════════════════
// v1.9.0 新增：E0.3b styled 文本（基线=文字转位图 E0.3b-F）
// ══════════════════════════════════════════════
// CJK 供应链现状：三端 glyphs 指 demotiles（国内不可达），SymbolLayer text-field 大概率静默失败，
// 基线档位=UIGraphicsImageRenderer 绘制文字位图 → 既有图像叠加通路锚定 lat/lng。

// NSString 取 start 起 2 字符的十六进制值（NSString 无 (start,end) 双参子串，FromIndex+ToIndex 组合；
// substringFromIndex 参数为 Int，UTS number 需显式 toInt()）
function hexPair(hex: string, start: number): number {
    const rest = hex.substringFromIndex(start.toInt())
    return parseInt(rest.substringToIndex(2), 16)
}

// styled 颜色解析：支持 #rrggbb 与 #rrggbbaa（style spec 约定 alpha 在后；
// 注意与 parseColor 的 AARRGGBB（alpha 在前）约定不同）
function parseStyledColor(color: string): UIColor {
    let hex = color
    if (hex.hasPrefix('#')) {
        hex = hex.substringFromIndex(1)
    }
    if (hex.length == 8) {
        const r = hexPair(hex, 0)
        const g = hexPair(hex, 2)
        const b = hexPair(hex, 4)
        const a = hexPair(hex, 6)
        return UIColor.colorWithRed(r / 255.0, g / 255.0, b / 255.0, a / 255.0)
    }
    return parseColor(color)
}

export function addStyledText(lat: number, lng: number, text: string, options: StyledTextOptions): number {
    if (mapView == null || mapView.style == null || text.length == 0) return 0
    const mv = mapView
    // 位图按物理像素乘 screenScale 绘制（bounds 按逻辑尺寸换算，位图拉伸到 bounds 后保持锐利）
    const scale = UIScreen.mainScreen.scale
    const fontSizePx = options.fontSize * scale
    const haloPx = options.haloWidth * scale
    const font = UIFont.systemFontOfSize(fontSizePx)
    // attrs 用 NSMutableDictionary；key 直接传 NSAttributedString 原始常量字符串值（"NSFont"/"NSColor"），
    // 规避 NSAttributedString.Key 类型桥接（UTS 无该类型 import 路径）
    const attrs = new NSMutableDictionary()
    attrs.setObject(font, "NSFont")
    const nsText = text as NSString
    const textSize = nsText.sizeWithAttributes(attrs)
    const pad = (options.haloColor != null && haloPx > 0 ? haloPx : 0) + scale
    const totalW = textSize.width + pad * 2
    const totalH = textSize.height + pad * 2
    if (totalW <= 0 || totalH <= 0) return 0
    const renderer = UIGraphicsImageRenderer(CGSizeMake(totalW, totalH))
    const uiImage = renderer.imageWithActions((context) => {
        if (options.haloColor != null && haloPx > 0) {
            attrs.setObject(parseStyledColor(options.haloColor), "NSColor")
            // 八方向偏移绘制 halo（Android stroke 描边同视觉；跳过中心偏移留给填充）
            for (let dx = -1; dx <= 1; dx++) {
                for (let dy = -1; dy <= 1; dy++) {
                    if (dx == 0 && dy == 0) continue
                    nsText.drawAtPoint(CGPointMake(pad + dx * haloPx, pad + dy * haloPx), attrs)
                }
            }
        }
        attrs.setObject(parseStyledColor(options.color), "NSColor")
        nsText.drawAtPoint(CGPointMake(pad, pad), attrs)
    })
    // bounds 换算（当前 zoom 屏幕等尺寸）：256 tileSize 标准 worldPx 公式（组件层 latLngToScreen 同源）
    const zoom = mv.zoomLevel
    const worldPx = 256 * Math.pow(2, zoom)
    const halfLng = (totalW / 2) * 360 / worldPx
    const latRad = lat * Math.PI / 180
    const halfLat = (totalH / 2) * 360 / worldPx / Math.cos(latRad)
    if (!(halfLng > 0) || !(halfLat > 0)) return 0
    // 复用图像叠加通路（type=styledText；attach 回填 ext 供样式重建重放，uiImage 位图复用）
    overlayIdCounter++
    const id = overlayIdCounter
    const params: ImageOverlayOptions = {
        southwest: { lat: lat - halfLat, lng: lng - halfLng },
        northeast: { lat: lat + halfLat, lng: lng + halfLng },
        image: '',
        transparency: 0,
        bearing: 0,
        visible: true,
        clickable: false
    }
    overlayMap.set(id, { id: id, type: 'styledText', nativeRef: null, isVisible: true })
    if (!attachImageOverlayToStyle(id, params, uiImage)) {
        overlayMap.delete(id)
        return 0
    }
    return id
}

// ==================== 覆盖物：圆（多边形近似，36 边） ====================

const EARTH_RADIUS = 6378137.0

function circleToPolygonCoords(lat: number, lng: number, radius: number, segments: number): Array<CLLocationCoordinate2D> {
    let result: Array<CLLocationCoordinate2D> = []
    const dLat = radius / EARTH_RADIUS * (180.0 / Math.PI)
    const dLng = radius / (EARTH_RADIUS * Math.cos(lat * Math.PI / 180.0)) * (180.0 / Math.PI)
    for (let i = 0; i < segments; i++) {
        const angle = (2.0 * Math.PI * i) / segments
        result.push(CLLocationCoordinate2DMake(lat + dLat * Math.cos(angle), lng + dLng * Math.sin(angle)))
    }
    return result
}

export function addCircle(lat: number, lng: number, radius: number, color: string, fillColor: string): number {
    if (mapView == null || mapView.style == null) return 0
    const circleCoords = circleToPolygonCoords(lat, lng, radius, 36)
    const circleId = "tdt-circle-" + circles.length.toString()
    try {
        const polygon = MLNPolygon(circleCoords, circleCoords.length)
        const source = new MLNShapeSource(circleId, polygon, null)
        mapView.style?.addSource(source)
        const layer = new MLNFillStyleLayer(circleId + "-layer", source)
        layer.fillColor = NSExpression(forConstantValue: parseColor(fillColor))
        layer.fillOutlineColor = NSExpression(forConstantValue: parseColor(color))
        mapView.style?.addLayer(layer)
        const entry = { source: source, layer: layer }
        circles.push(entry)
        return allocateOverlayId('circle', entry)
    } catch (e) {
        if (onErrorCallback != null) {
            onErrorCallback({ code: 4, message: "添加圆失败: " + e.toString() })
        }
        return 0
    }
}

// ==================== 覆盖物：矩形 ====================

export function addRectangle(minLat: number, minLng: number, maxLat: number, maxLng: number, color: string, fillColor: string): number {
    if (mapView == null || mapView.style == null) return 0
    const coordinates: Array<CLLocationCoordinate2D> = [
        CLLocationCoordinate2DMake(minLat, minLng),
        CLLocationCoordinate2DMake(maxLat, minLng),
        CLLocationCoordinate2DMake(maxLat, maxLng),
        CLLocationCoordinate2DMake(minLat, maxLng)
    ]
    const rectId = "tdt-rect-" + rectangles.length.toString()
    try {
        const polygon = MLNPolygon(coordinates, 4)
        const source = new MLNShapeSource(rectId, polygon, null)
        mapView.style?.addSource(source)
        const layer = new MLNFillStyleLayer(rectId + "-layer", source)
        layer.fillColor = NSExpression(forConstantValue: parseColor(fillColor))
        layer.fillOutlineColor = NSExpression(forConstantValue: parseColor(color))
        mapView.style?.addLayer(layer)
        const entry = { source: source, layer: layer }
        rectangles.push(entry)
        return allocateOverlayId('rectangle', entry)
    } catch (e) {
        if (onErrorCallback != null) {
            onErrorCallback({ code: 4, message: "添加矩形失败: " + e.toString() })
        }
        return 0
    }
}

// ==================== 覆盖物：文字标注 ====================

export function addLabel(lat: number, lng: number, text: string): number {
    if (mapView != null) {
        const annotation = new MLNPointAnnotation()
        annotation.coordinate = CLLocationCoordinate2DMake(lat, lng)
        annotation.title = text
        mapView.addAnnotation(annotation)
        return allocateOverlayId('label', annotation)
    }
    return 0
}

// ==================== 覆盖物：批量标记 ====================

export function setMarkers(markers: Array<MapClickDetail>): Array<number> {
    clearMarkers()
    const ids: Array<number> = []
    if (mapView == null || markers.length == 0) return ids
    for (let i = 0; i < markers.length; i++) {
        const pt = markers[i]
        const annotation = new MLNPointAnnotation()
        annotation.coordinate = CLLocationCoordinate2DMake(pt.lat, pt.lng)
        mapView.addAnnotation(annotation)
        ids.push(allocateOverlayId('marker', annotation))
    }
    return ids
}

// ==================== 覆盖物：清除全部 ====================

export function clearOverlays(): void {
    clearMarkers()
    clearPolygons()
    // v1.9.0: 清除图片覆盖物（style 层系，须逐个 removeLayer/removeSource；mapView 为空时仅清状态）
    for (let i = 0; i < imageOverlayIds.length; i++) {
        const oid = imageOverlayIds[i]
        const extImgClear = imageOverlayExt.get(oid)
        if (extImgClear != null && mapView?.style != null) {
            try {
                mapView.style?.removeLayer(extImgClear.layer)
                mapView.style?.removeSource(extImgClear.source)
            } catch (e: any) {
                console.error("TDTMap: clearOverlays 图片层移除失败: " + (e.message ?? String(e)))
            }
        }
        overlayMap.delete(oid)
        imageOverlayExt.delete(oid)
    }
    imageOverlayIds = []
    if (mapView == null) {
        clearOverlayType('polyline')
        clearOverlayType('circle')
        clearOverlayType('rectangle')
        polylines = []
        circles = []
        rectangles = []
        return
    }
    for (let i = 0; i < polylines.length; i++) {
        mapView.style?.removeLayer(polylines[i].layer)
        mapView.style?.removeSource(polylines[i].source)
    }
    polylines = []
    clearOverlayType('polyline')
    for (let i = 0; i < circles.length; i++) {
        mapView.style?.removeLayer(circles[i].layer)
        mapView.style?.removeSource(circles[i].source)
    }
    circles = []
    clearOverlayType('circle')
    for (let i = 0; i < rectangles.length; i++) {
        mapView.style?.removeLayer(rectangles[i].layer)
        mapView.style?.removeSource(rectangles[i].source)
    }
    rectangles = []
    clearOverlayType('rectangle')
}

export function switchMapType(mapType: string): void {
    if (mapView == null) return
    const mv = mapView
    currentMapType = mapType
    // v1.9.0: blank——隐藏全部天地图层并显示白底层（复用预创建图层，零样式重建）
    if (mapType == 'blank') {
        const types0 = ["vec", "img", "ter"]
        for (let i = 0; i < types0.length; i++) {
            const type = types0[i]
            const baseLayer0 = mv.style?.layerWithIdentifier("tdt-base-" + type + "-layer")
            if (baseLayer0 != null) baseLayer0.isVisible = false
            const labelLayer0 = mv.style?.layerWithIdentifier("tdt-label-" + type + "-layer")
            if (labelLayer0 != null) labelLayer0.isVisible = false
        }
        ensureBlankBackgroundLayer(mv)
        return
    }
    const types = ["vec", "img", "ter"]
    for (let i = 0; i < types.length; i++) {
        const type = types[i]
        const isVisible = type === mapType
        const baseLayer = mv.style?.layerWithIdentifier("tdt-base-" + type + "-layer")
        if (baseLayer != null) baseLayer.isVisible = isVisible
        const labelLayer = mv.style?.layerWithIdentifier("tdt-label-" + type + "-layer")
        if (labelLayer != null) labelLayer.isVisible = isVisible
    }
    // blank 切回瓦片底图时隐藏白底层
    hideBlankBackgroundLayer(mv)
}

export function snapshot(callback: (data: ArrayBuffer) => void): void {
    if (mapView == null) {
        if (onErrorCallback != null) {
            onErrorCallback({ code: 4, message: "Map 未初始化" })
        }
        callback(new ArrayBuffer(0))
        return
    }
    try {
        const renderer = UIGraphicsImageRenderer(mapView.bounds.size)
        // context7 验证：UTS ObjC 互操作层使用 ObjC selector 名称桥接，
        // drawHierarchy 是 Swift 3+ 名称，ObjC selector 是 drawViewHierarchyInRect:afterScreenUpdates:
        const image = renderer.imageWithActions((context) => {
            mapView.drawViewHierarchyInRect(mapView.bounds, true)
        })
        // UIImagePNGRepresentation → NSData → ArrayBuffer（UTS 官方 API：ArrayBuffer.fromData）
        const data = UIImagePNGRepresentation(image)
        if (data != null) {
            callback(ArrayBuffer.fromData(data))
            return
        }
    } catch (e) {
        if (onErrorCallback != null) {
            onErrorCallback({ code: 4, message: "Snapshot 失败: " + e.toString() })
        }
    }
    callback(new ArrayBuffer(0))
}

export function onResume(): void {
    // iOS 端无需额外处理
}

export function onPause(): void {
    // iOS 端无需额外处理
}

export function destroyMap(): void {
    if (mapView != null) {
        mapView.removeFromSuperview()
        mapView = null
        // v1.7.0: 清理聚合/热力引用（mapView 已置空，函数内部走空值分支仅置空引用）
        removeMarkerCluster()
        removeHeatmap()
        const delegate = mapViewDelegate
        mapViewDelegate = null
        onClickCallback = null
        onReadyCallback = null
        onErrorCallback = null
        markerClickCallback = null
        mapLongClickCallback = null
        cameraChangeCallback = null
        polygons = []
        polylines = []
        circles = []
        rectangles = []
        overlayMap.clear()
        overlayIdCounter = 0
        currentApiKey = ''
        currentMapType = 'vec'
        didSelectMarkerFlag = false
        userLocationShown = false
        locationManager?.stopUpdatingLocation()
        locationManager = null
        locationCallback = null
        locationErrorCallback = null
        // 若定位轮询定时器仍在运行（destroyMap 早于 getUserLocation 回调），立即 invalidate 防止内存泄漏
        if (locationTimer != null) {
            locationTimer.invalidate()
            locationTimer = null
        }
        customTileSources.clear()
        customTileLayerIds = []
        customStyleActive = false
        styleRebuildMode = 0
        clusterDataRef = null
        clusterOptionsRef = null
        heatmapDataRef = null
        heatmapOptionsRef = null
        // v1.9.0: 图片覆盖物状态
        imageOverlayExt.clear()
        imageOverlayIds = []
        imageOverlayClickCallback = null
        if (delegate != null) {
            UTSiOS.destroyInstance(delegate)
        }
    }
}

// ==================== 缩放控制 ====================

export function zoomIn(): void {
    if (mapView != null) {
        const currentZoom = mapView.zoomLevel
        mapView.setZoomLevel(currentZoom + 1, true)
    }
}

export function zoomOut(): void {
    if (mapView != null) {
        const currentZoom = mapView.zoomLevel
        mapView.setZoomLevel(currentZoom - 1, true)
    }
}

export function setMinZoom(zoom: number): void {
    if (mapView != null) {
        mapView.minimumZoomLevel = zoom
    }
}

export function setMaxZoom(zoom: number): void {
    if (mapView != null) {
        mapView.maximumZoomLevel = zoom
    }
}

// ==================== 视野移动 ====================

export function panTo(lat: number, lng: number, zoom?: number): void {
    if (mapView == null) return
    const center = CLLocationCoordinate2DMake(lat, lng)
    if (zoom != null) {
        mapView.setCenterCoordinate(center, zoom, true)
    } else {
        mapView.setCenterCoordinate(center, true)
    }
}

export function centerAndZoom(lat: number, lng: number, zoom: number): void {
    if (mapView == null) return
    const center = CLLocationCoordinate2DMake(lat, lng)
    mapView.setCenterCoordinate(center, zoom, false)
}

// ==================== 手势控制 ====================

export function enableZoom(enabled: boolean): void {
    if (mapView != null) {
        mapView.zoomEnabled = enabled
    }
}

export function enableDrag(enabled: boolean): void {
    if (mapView != null) {
        mapView.scrollEnabled = enabled
    }
}

// ==================== 范围限制 ====================

export function setMaxBounds(minLat: number | null, minLng: number | null, maxLat: number | null, maxLng: number | null): void {
    if (mapView == null) return
    // v1.8.0: 可空签名。context7: MLN setVisibleCoordinateBounds 为一次性限制，无持久 cameraTargetBounds
    // 状态；null 清除请求无对应 API，显式 no-op（与 Android 端 setLatLngBoundsForCameraTarget(null) 语义差异
    // 在文档中说明，避免静默误用）
    if (minLat == null || minLng == null || maxLat == null || maxLng == null) {
        return
    }
    console.warn("TDTMap: iOS setMaxBounds 为一次性限制（MapLibre iOS 无永久 cameraTargetBounds API），用户可继续平移缩放超出边界")
    const sw = CLLocationCoordinate2DMake(minLat, minLng)
    const ne = CLLocationCoordinate2DMake(maxLat, maxLng)
    const bounds = MLNCoordinateBoundsMake(sw, ne)
    // MapLibre iOS 无永久 cameraTargetBounds 属性，用 visibleCoordinateBounds 实现一次性限制
    const edgePadding = new UIEdgeInsets(0, 0, 0, 0)
    mapView.setVisibleCoordinateBounds(bounds, edgePadding, false)
}

// ==================== 信息获取 ====================

export function getBounds(): MapBoundsDetail {
    if (mapView != null) {
        const bounds = mapView.visibleCoordinateBounds
        // visibleCoordinateBounds 返回 MGLCoordinateBounds，含 sw 和 ne 属性
        const sw = bounds.sw
        const ne = bounds.ne
        if (sw != null && ne != null) {
            return {
                minLat: sw.latitude,
                minLng: sw.longitude,
                maxLat: ne.latitude,
                maxLng: ne.longitude
            }
        }
    }
    return { minLat: 0, minLng: 0, maxLat: 0, maxLng: 0 }
}

// ==================== 坐标转换（纯数学，三端通用） ====================
// 算法来源：Wikipedia GCJ-02 article + eviltransform (GitHub)
// 注意：禁止在天地图插件中引入 WGS84→GCJ02 转换（会反向引入偏差），仅提供 GCJ02→WGS84

const GCJ_PI = 3.14159265358979323846
const GCJ_A = 6378245.0
const GCJ_EE = 0.00669342162296594323

function isOutOfChina(lat: number, lng: number): boolean {
    return lng < 72.004 || lng > 137.8347 || lat < 0.8293 || lat > 55.8271
}

function gcjTransformLat(x: number, y: number): number {
    let ret = -100.0 + 2.0 * x + 3.0 * y + 0.2 * y * y + 0.1 * x * y + 0.2 * Math.sqrt(Math.abs(x))
    ret += (20.0 * Math.sin(6.0 * x * GCJ_PI) + 20.0 * Math.sin(2.0 * x * GCJ_PI)) * 2.0 / 3.0
    ret += (20.0 * Math.sin(y * GCJ_PI) + 40.0 * Math.sin(y / 3.0 * GCJ_PI)) * 2.0 / 3.0
    ret += (160.0 * Math.sin(y / 12.0 * GCJ_PI) + 320.0 * Math.sin(y * GCJ_PI / 30.0)) * 2.0 / 3.0
    return ret
}

function gcjTransformLng(x: number, y: number): number {
    let ret = 300.0 + x + 2.0 * y + 0.1 * x * x + 0.1 * x * y + 0.1 * Math.sqrt(Math.abs(x))
    ret += (20.0 * Math.sin(6.0 * x * GCJ_PI) + 20.0 * Math.sin(2.0 * x * GCJ_PI)) * 2.0 / 3.0
    ret += (20.0 * Math.sin(x * GCJ_PI) + 40.0 * Math.sin(x / 3.0 * GCJ_PI)) * 2.0 / 3.0
    ret += (150.0 * Math.sin(x / 12.0 * GCJ_PI) + 300.0 * Math.sin(x / 30.0 * GCJ_PI)) * 2.0 / 3.0
    return ret
}

type Gcj02Delta = { dLat: number, dLng: number }
function wgs84ToGcj02Delta(lat: number, lng: number): Gcj02Delta {
    const dLat = gcjTransformLat(lng - 105.0, lat - 35.0)
    const dLng = gcjTransformLng(lng - 105.0, lat - 35.0)
    const radLat = lat / 180.0 * GCJ_PI
    let magic = Math.sin(radLat)
    magic = 1 - GCJ_EE * magic * magic
    const sqrtMagic = Math.sqrt(magic)
    const dLatFinal = (dLat * 180.0) / ((GCJ_A * (1 - GCJ_EE)) / (magic * sqrtMagic) * GCJ_PI)
    const dLngFinal = (dLng * 180.0) / (GCJ_A / sqrtMagic * Math.cos(radLat) * GCJ_PI)
    return { dLat: dLatFinal, dLng: dLngFinal }
}

export function gcj02ToWgs84(lat: number, lng: number): MapClickDetail {
    if (isOutOfChina(lat, lng)) {
        return { lat: lat, lng: lng }
    }
    let wgsLat = lat
    let wgsLng = lng
    for (let i = 0; i < 3; i++) {
        const delta = wgs84ToGcj02Delta(wgsLat, wgsLng)
        const gcjLat = wgsLat + delta.dLat
        const gcjLng = wgsLng + delta.dLng
        wgsLat -= (gcjLat - lat)
        wgsLng -= (gcjLng - lng)
    }
    return { lat: wgsLat, lng: wgsLng }
}

// ══════════════════════════════════════════════
// 覆盖物管理：单个操作
// ══════════════════════════════════════════════

// context7 验证：iOS 使用 style.removeLayer/removeSource 移除形状，removeAnnotation 移除标注
export function removeOverlay(id: number): void {
    const entry = overlayMap.get(id)
    if (entry == null || mapView == null) {
        overlayMap.delete(id)
        // v1.9.0: 图片覆盖物状态同步清理（非图片 ID 时为无害 no-op）
        imageOverlayExt.delete(id)
        imageOverlayIds = imageOverlayIds.filter(x => x != id)
        return
    }
    const ref = entry.nativeRef
    if (ref == null) {
        overlayMap.delete(id)
        return
    }
    if (entry.type == 'marker' || entry.type == 'label') {
        mapView.removeAnnotation(ref as MLNPointAnnotation)
    } else {
        // polygon, polyline, circle, rectangle — all use source+layer pattern
        mapView.style?.removeLayer(ref.layer)
        mapView.style?.removeSource(ref.source)
        // 同步清理类型数组
        if (entry.type == 'polygon') {
            polygons = polygons.filter(e => e !== ref)
        } else if (entry.type == 'polyline' || entry.type == 'styledPolyline') {
            // v1.9.0: styled 折线同样存于 polylines 数组（clearOverlays 批量移除复用既有遍历）
            polylines = polylines.filter(e => e !== ref)
        } else if (entry.type == 'circle') {
            circles = circles.filter(e => e !== ref)
        } else if (entry.type == 'rectangle') {
            rectangles = rectangles.filter(e => e !== ref)
        }
    }
    overlayMap.delete(id)
    // v1.9.0: 图片覆盖物状态同步清理（非图片 ID 时为无害 no-op）
    imageOverlayExt.delete(id)
    imageOverlayIds = imageOverlayIds.filter(x => x != id)
}

// context7 验证：iOS 形状通过 layer.isVisible 控制显隐，标注通过 addAnnotation/removeAnnotation 控制
export function showOverlay(id: number): void {
    const entry = overlayMap.get(id)
    if (entry == null) return
    const ref = entry.nativeRef
    if (ref == null || entry.isVisible) return
    if (entry.type == 'marker' || entry.type == 'label') {
        // 重新添加标注
        mapView?.addAnnotation(ref as MLNPointAnnotation)
    } else {
        ref.layer.isVisible = true
    }
    entry.isVisible = true
    // v1.9.0: 图片覆盖物可见性同步（重建重放读取 params.visible）
    const extShow = imageOverlayExt.get(id)
    if (extShow != null) extShow.params.visible = true
}

export function hideOverlay(id: number): void {
    const entry = overlayMap.get(id)
    if (entry == null) return
    const ref = entry.nativeRef
    if (ref == null || !entry.isVisible) return
    if (entry.type == 'marker' || entry.type == 'label') {
        // 从地图移除标注但保留引用
        mapView?.removeAnnotation(ref as MLNPointAnnotation)
    } else {
        ref.layer.isVisible = false
    }
    entry.isVisible = false
    // v1.9.0: 图片覆盖物可见性同步（重建重放读取 params.visible）
    const extHide = imageOverlayExt.get(id)
    if (extHide != null) extHide.params.visible = false
}

