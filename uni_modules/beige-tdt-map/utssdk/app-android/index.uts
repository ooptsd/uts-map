// ⚠️ 天地图 Key 类型说明（自新系统升级后严格区分，混用会导致瓦片不显示）:
//   - "浏览器端" key：校验 Referer 头 + 域名白名单 → 原生 App（OkHttp）不发送浏览器 Referer → 403 被拒 → 灰白背景
//   - "服务端" key：校验 IP 白名单（留空则不限制）→ 原生 App 推荐使用
//   - "Android平台" key：专用于移动端原生 API → 最佳选择
//   🔧 如果瓦片不显示：请到 https://console.tianditu.gov.cn 创建"服务端"或"Android平台"类型 key 替换当前 key
//
// 参考验证：ArcGIS Android 官方文档明确记载"把 referer 替换为 http://map.tianditu.gov.cn/ 即可正常显示"
// SuperMap 官方文档："浏览器端 key 在 Android 客户端无法使用，必须用 Android 平台 key"

let mapView: MapView | null = null
let mapLibreMap: MapLibreMap | null = null
let onClickCallback: MapClickCallback | null = null
let onReadyCallback: MapReadyCallback | null = null
let onErrorCallback: MapErrorCallback | null = null
let currentApiKey: string = ''
let currentMapType: string = 'vec'

// 标记和面列表 — 使用平台原生类型
let markerList: Array<Marker> = []
let polygonList: Array<Polygon> = []
let polylineList: Array<Polyline> = []
let circleList: Array<Polygon> = []
let rectangleList: Array<Polygon> = []

// ── 覆盖物 ID 追踪系统 ──
// 为每个添加的覆盖物分配唯一 ID，支持 removeOverlay/showOverlay/hideOverlay 单个操作
let overlayIdCounter: number = 0
let overlayMap = new Map<number, OverlayEntry>()

type OverlayEntry = {
    id: number
    type: string  // 'marker' | 'polygon' | 'polyline' | 'circle' | 'rectangle' | 'label' | 'image'
    nativeRef: any | null  // Marker | Polygon | Polyline | {source, layer}（image 为 source+layer 包装；styledText/image 加载中可为 null，attach 后回填）
    isVisible: boolean
}

// ── v1.9.0: 图片覆盖物状态 ──
// nativeRef 在 overlayMap 中为 {source, layer} 包装（对齐 iOS 形状类先例）；
// imageOverlayExt 额外持有 params 快照（update 合并/样式重建重放）与 bitmap（本机路径解码复用）
type ImageOverlayExt = { source: any, layer: any, params: ImageOverlayOptions, bitmap: any | null }
let imageOverlayExt = new Map<number, ImageOverlayExt>()
// 平行数组存添加顺序（zIndex 定位/重建重放，UTS Map 迭代限制规避，v1.8.0 同款）
let imageOverlayIds: Array<number> = []
let imageOverlayClickCallback: ImageOverlayClickCallback | null = null
// 大图钳制上限（GPU 纹理安全边界，两段解码 inSampleSize 下采样目标）
const IMAGE_OVERLAY_MAX_DIM: number = 4096

let markerClickCallback: MarkerClickCallback | null = null
let mapLongClickCallback: MapLongClickCallback | null = null
let cameraChangeCallback: CameraChangeCallback | null = null

// v1.5.7: 手势性能诊断统计（仅在相机停止时汇总输出一条日志，避免逐帧日志加剧卡顿）
let perfGestureActive = false
let perfStartAt = 0.0
let perfFrameCount = 0
let perfLastFrameAt = 0.0
let perfMaxGap = 0.0
// v1.5.7: 渲染帧统计（真实画面帧，与相机逻辑帧对比定位"逻辑快画面卡"）
let perfRenderFrameCount = 0
let perfRenderLastAt = 0.0
let perfRenderMaxGap = 0.0
let perfRenderMaxEncode = 0.0
let perfRenderMaxRender = 0.0

// 分配 overlay ID 并存入追踪表
function allocateOverlayId(type: string, nativeRef: any | null): number {
    overlayIdCounter++
    const id = overlayIdCounter
    overlayMap.set(id, { id: id, type: type, nativeRef: nativeRef, isVisible: true })
    return id
}

// ── 天地图瓦片 ──
// 单子域名浏览器限制 6 并发连接 → 瓦片串行加载卡顿
// 改用 t0-t7 共 8 个子域名并行加载，性能提升 6-8 倍
function getTileUrl(layerType: string): string {
    return 'https://t0.tianditu.gov.cn/DataServer?T=' + layerType + '_w&x={x}&y={y}&l={z}&tk='
}

// 生成 8 个子域名的瓦片 URL JSON 数组字符串
function buildTileUrlsJSON(layerType: string, apiKey: string): string {
    let urls = ''
    for (let s = 0; s < 8; s++) {
        if (s > 0) urls += ','
        urls += '"https://t' + s.toString() + '.tianditu.gov.cn/DataServer?T=' + layerType + '_w&x={x}&y={y}&l={z}&tk=' + apiKey + '"'
    }
    return urls
}

function getBaseLayerName(mt: string): string {
    if (mt == 'img') return 'img'
    if (mt == 'ter') return 'ter'
    return 'vec'
}

function getLabelLayerName(mt: string): string {
    if (mt == 'img') return 'cia'
    if (mt == 'ter') return 'cta'
    return 'cva'
}

// v1.9.0: glyphs 字体端点集中常量（当前为 demotiles 占位值；⚠️ demotiles 国内不可达，
// S0.5 端点选型（国内可达 PBF 服务 vs 本地字体资产）后在此一行替换，三端同款常量同步修改）
const GLYPHS_ENDPOINT = "https://demotiles.maplibre.org/font/{fontstack}/{range}.pbf"

// v1.9.0: mapType='blank' 白底样式（E0 配套）。空 layers 非白底（画布透明透出原生底色且三端不一致），
// 必须显式 background #ffffff；glyphs 必须显式存在——style spec 强制校验：缺 glyphs 的
// text-field 图层被静默拒绝（Task 10 浏览器实测发现，context7 验证）
function buildBlankStyleJson(): string {
    return '{"version":8,"glyphs":"' + GLYPHS_ENDPOINT + '","name":"tdt-blank","sources":{},"layers":[' +
        '{"id":"tdt-bg","type":"background","paint":{"background-color":"#ffffff"}}]}'
}

// 构建包含天地图 sources + layers 的完整 style JSON
// 性能优化：仅创建当前激活的图层类型（2 source + 2 layer），避免 6 个 RasterSource 同时驻留
function buildTiandituStyleJson(apiKey: string, activeMapType: string): string {
    // v1.9.0: blank 白底（无天地图瓦片，无需 apiKey，无诊断 URL）
    if (activeMapType == 'blank') {
        console.log("TDTMap: 构建白底样式（mapType=blank）")
        return buildBlankStyleJson()
    }
    console.log("TDTMap: 构建天地图样式, key_len=" + apiKey.length + " active=" + activeMapType)

    const base = getBaseLayerName(activeMapType)
    const label = getLabelLayerName(activeMapType)

    // 诊断日志
    const diagUrl = getTileUrl(base) + apiKey
    const resolved = diagUrl.replace("{x}", "537").replace("{y}", "389").replace("{z}", "10")
    console.log("TDTMap: 诊断URL(浏览器打开验证key)= " + resolved)

    // v1.7.0: glyphs 字体端点（style spec 强制校验：text-field 图层需 style 含 glyphs，
    // 否则符号图层被静默拒绝，聚合数字标签不渲染——Task 10 浏览器实测发现，context7 验证）
    let json = '{"version":8,"glyphs":"' + GLYPHS_ENDPOINT + '","name":"tdt-tianditu","sources":{'
    json += '"tdt-base":{"type":"raster","tiles":[' + buildTileUrlsJSON(base, apiKey) + '],"tileSize":256,"minzoom":1,"maxzoom":18}'
    json += ',"tdt-label":{"type":"raster","tiles":[' + buildTileUrlsJSON(label, apiKey) + '],"tileSize":256,"minzoom":1,"maxzoom":18}'
    json += '},"layers":['
    json += '{"id":"background","type":"background","paint":{"background-color":"#f5f5f5"}}'
    // v1.5.4: raster-fade-duration 0 —— MapLibre Style Spec 默认 300ms 淡入，快速滑动时新瓦片半透明过渡造成视觉卡糊；
    // 设为 0 瓦片即时显示（官方文档 maplibre.org/maplibre-style-spec/layers，Native Android 2.0.1+ 支持）
    json += ',{"id":"tdt-base-layer","type":"raster","source":"tdt-base","minzoom":1,"maxzoom":18,"paint":{"raster-fade-duration":0}}'
    json += ',{"id":"tdt-label-layer","type":"raster","source":"tdt-label","minzoom":1,"maxzoom":18,"paint":{"raster-fade-duration":0}}'
    json += ']}'
    console.log("TDTMap: 样式JSON长度=" + json.length)
    return json
}

@UTSJS.keepAlive
export function initMap(
    container: UniNativeViewElement,
    options: TDMapOptions,
    onClick: MapClickCallback,
    onReady: MapReadyCallback,
    onError: MapErrorCallback
): void {
    const context = container.getAndroidActivity() as Context
    if (context == null) {
        console.error("TDTMap: 获取 Android Context 失败")
        const errDetail: MapErrorDetail = { code: 4, message: "获取 Android Context 失败" }
        onError(errDetail)
        return
    }

    if (options.apiKey == null || options.apiKey.length == 0) {
        console.error("TDTMap: apiKey 为空")
        const errDetail: MapErrorDetail = { code: 1, message: "apiKey 为空" }
        onError(errDetail)
        return
    }

    onClickCallback = onClick
    onReadyCallback = onReady
    onErrorCallback = onError
    currentApiKey = options.apiKey
    currentMapType = options.mapType

    console.log("TDTMap: initMap key=" + (options.apiKey.length > 0 ? "***" : "空") + " type=" + options.mapType)

    // MapLibre 官方要求：必须先调用 getInstance 初始化原生库，否则 JNI 层未初始化会导致崩溃（GitHub Issue #117）
    // getInstance 是幂等的，多次调用安全
    MapLibre.getInstance(context)

    // v1.5.1: 模拟器/特殊层叠场景可启用 textureMode（MapLibre 官方 issue #3070 workaround）：
    // GLSurfaceView 在模拟器软件渲染下帧率极低，TextureView 走 Android 标准 View 绘制管线更流畅；
    // 真机保持默认 GLSurfaceView 硬件加速（MapLibre 官方：textureMode 有性能代价，非必要不用）。
    // v1.5.5: 双指缩放掉帧优化（context7 验证 MapLibre 官方源码 MapLibreMapOptions.java）：
    // pixelRatio 默认 = 设备屏幕密度（1080p 中端机约 2.75~3.0），双指缩放时整个 GL 表面每帧重采样，
    // 中端 GPU 光栅化负载过重导致掉帧；限制为 2.0 渲染像素量约减半，清晰度损失轻微
    // setPrefetchZoomDelta 预加载相邻缩放级别瓦片（缩放时新层级瓦片更快就绪）
    const density = context.getResources().getDisplayMetrics().density
    let perfRatio = density
    if (density > 2.0.toFloat()) {
        perfRatio = 2.0.toFloat()
    }
    const mapOpts = new MapLibreMapOptions()
        .pixelRatio(perfRatio.toFloat())
        .setPrefetchZoomDelta(2)
    const mv = options.textureMode == true
        ? new MapView(context, mapOpts.textureMode(true))
        : new MapView(context, mapOpts)
    mapView = mv
    container.bindAndroidView(mv)

    mv.onCreate(null)
    // context7 验证：onStart 必须在 getMapAsync 回调内调用（maplibreMap 赋值后），
    // 否则 MapView.onStart() 内部的 maplibreMap.onStart() 会被跳过（此时 maplibreMap 为 null）
    mv.getMapAsync((map: MapLibreMap) => {
        mapLibreMap = map
        console.log("TDTMap: [DIAG] getMapAsync 回调执行，maplibreMap 已就绪")

        // onStart 在此处调用确保 maplibreMap 已就绪，生命周期顺序：onCreate → getMapAsync → onStart
        mv.onStart()
        console.log("TDTMap: [DIAG] mv.onStart() 已调用")

        // v1.5.2: 显式启用全部手势（MapLibre 官方 UiSettings 各手势默认值均为 true，此处兜底防御意外禁用；
        // setAllGesturesEnabled 内部依次启用 rotate/tilt/zoom/scroll/doubleTap/quickZoom 六项手势）
        const uiSettings = map.getUiSettings()
        uiSettings?.setAllGesturesEnabled(true)
        // v1.6.0: 隐藏 MapLibre 原生 logo 与 attribution —— context7 验证：
        // Stadia Maps 官方文档 map.uiSettings.isLogoEnabled = false（Kotlin 属性对应
        // setLogoEnabled/isLogoEnabled 方法对）、Jawg Maps 官方文档 XML 属性 maplibre_uiLogo="false"。
        // MapLibre 默认 logo（左下）与 attribution ℹ 按钮（显示"© MapLibre"）会与 uvue 版权条
        // 重叠且版权信息对天地图场景是错误的；MapLibre BSD-3 许可不强制显示 logo，
        // 天地图瓦片不含 OSM 数据无 attribution 义务，版权统一由 uvue 版权条承担
        uiSettings?.setLogoEnabled(false)
        uiSettings?.setAttributionEnabled(false)
        console.log("TDTMap: 手势状态 zoom=" + (uiSettings?.isZoomGesturesEnabled() ?? false) + " scroll=" + (uiSettings?.isScrollGesturesEnabled() ?? false))

        // 初始化视角（不依赖 Style，可立即设置）
        const center = new LatLng(options.latitude.toDouble(), options.longitude.toDouble())
        map.setCameraPosition(
            new CameraPosition.Builder()
                .target(center)
                .zoom(options.zoom.toDouble())
                .build()
        )

        // 地图点击事件（不依赖 Style）
        // 优先检测标记点击，未命中再触发地图点击回调，二者互斥
        // 必须在此单一监听器中处理两种事件：若返回 true 则事件被消费，后续监听器不会再收到
        const clickCb = onClickCallback
        map.addOnMapClickListener((point: LatLng) => {
            console.log("TDTMap: [DIAG] 地图点击触发 lat=" + point.latitude + " lng=" + point.longitude)
            // v1.7.0: Priority 0: 聚合簇点击检测（context7: queryRenderedFeatures 按 layer 查询，
            // Feature.getBooleanProperty("cluster") 判断是否聚合簇，getClusterExpansionZoom 返回展开缩放级别）
            // 注意：不在聚合回调中调用 setGeoJson 更新数据（issue #3519 竞态崩溃），仅放大视图
            // queryRenderedFeatures(PointF, String...) 为 Java vararg，UTS→Kotlin 后直接传参合法；
            // 若编译报错改用 arrayOf("tdt-cluster-layer")（列入 Task 12 验证项）
            const clusterSrc = clusterSourceRef
            if (clusterSrc != null) {
                const screenPt = map.getProjection().toScreenLocation(point)
                // queryRenderedFeatures 返回 kotlin.collections.List<Feature>（平台专有数组类型），
                // UTS 直接 .length 会生成非法 Kotlin（云打包报 Unresolved reference 'length'）——
                // context7: UTS 官方文档 data-type.html，先 Array.fromNative 转 UTS Array 再操作
                const hitRaw = map.queryRenderedFeatures(screenPt, "tdt-cluster-layer")
                if (hitRaw != null) {
                    const hitFeatures = Array.fromNative(hitRaw)
                    if (hitFeatures.length > 0) {
                        const hit = hitFeatures[0] as Feature
                        if (hit.getBooleanProperty("cluster")) {
                            const zoom = clusterSrc.getClusterExpansionZoom(hit)
                            // 与 zoomIn/panTo 一致改用 moveCamera 瞬时放大：v1.5.5 实测 animateCamera
                            // 动画在 UTS 集成下不推进（500ms 零进展），点击聚合簇将无任何响应
                            map.moveCamera(CameraUpdateFactory.newLatLngZoom(point, zoom.toDouble()))
                            return true  // 聚合点击消费事件：放大展开，不触发 mapClick
                        }
                    }
                }
            }
            // Priority 1: 检查标记点击（markerClickCallback）
            const markerCb = markerClickCallback
            if (markerCb != null) {
                for (let i = 0; i < markerList.length; i++) {
                    const mk = markerList[i]
                    if (mk != null && mk.getPosition() != null) {
                        const mkPos = mk.getPosition()
                        const dist = Math.sqrt(
                            (point.latitude - mkPos.latitude) * (point.latitude - mkPos.latitude) +
                            (point.longitude - mkPos.longitude) * (point.longitude - mkPos.longitude)
                        )
                        // 容忍约 0.0001 度（约 11 米）的点击误差
                        if (dist < 0.0001) {
                            markerCb({ lat: mkPos.latitude, lng: mkPos.longitude })
                            return true  // 事件由标记点击消费，不再触发 mapClick
                        }
                    }
                }
            }
            // v1.9.0: Priority 1.5: 图片覆盖物几何命中检测（不用 queryRenderedFeatures——raster 图层无要素；
            // 档位高者优先，同档后添加优先），命中即消费事件不触发 mapClick，与 Web/iOS 三端同版算法
            const imgCb = imageOverlayClickCallback
            if (imgCb != null && imageOverlayIds.length > 0) {
                let hitId = 0
                let hitKey = -2000000
                let hitIdx = -1
                for (let i = 0; i < imageOverlayIds.length; i++) {
                    const oid = imageOverlayIds[i]
                    const entryImg = overlayMap.get(oid)
                    const extImg = imageOverlayExt.get(oid)
                    if (entryImg == null || extImg == null) continue
                    if (!entryImg.isVisible) continue
                    if (extImg.params.clickable == false) continue
                    if (!hitTestImageOverlay(point.latitude, point.longitude, extImg.params)) continue
                    const key = imageOverlayZKey(extImg.params.zIndex ?? null)
                    if (key > hitKey || (key == hitKey && i > hitIdx)) {
                        hitId = oid
                        hitKey = key
                        hitIdx = i
                    }
                }
                if (hitId > 0) {
                    imgCb({ id: hitId, lat: point.latitude, lng: point.longitude })
                    return true  // 图片点击消费事件，不触发 mapClick
                }
            }
            // Priority 2: 普通地图点击（仅当未命中标记时）
            if (clickCb != null) {
                const detail: MapClickDetail = { lat: point.latitude, lng: point.longitude }
                clickCb(detail)
            }
            return true
        })

        // v1.4.0: 长按事件 — context7 验证：addOnMapLongClickListener 回调参数为 LatLng
        map.addOnMapLongClickListener((point: LatLng) => {
            console.log("TDTMap: [DIAG] 地图长按触发 lat=" + point.latitude + " lng=" + point.longitude)
            const longCb = mapLongClickCallback
            if (longCb != null) {
                longCb({ lat: point.latitude, lng: point.longitude })
            }
            return true
        })

        // v1.5.7: 手势性能诊断 — context7 验证 maplibre-native 官方源码 MapLibreMap.java：
        // addOnCameraMoveStartedListener/addOnCameraMoveListener 均存在；CameraChangeReason：
        // REASON_API_GESTURE=1 / REASON_DEVELOPER_ANIMATION=2 / REASON_API_ANIMATION=3
        // onCameraMove 官方文档说明"每帧触发一次"，帧间隔统计可量化掉帧
        map.addOnCameraMoveStartedListener((reason: number) => {
            // v1.5.8: 统计所有相机移动（不再只统计手势）：reason 1=手势 / 2=开发者动画 / 3=API动画（含 fling 惯性）。
            // fling 惯性是动画驱动（与 animateCamera 同链路），需一并观察是否触发与推进
            perfGestureActive = true
            perfStartAt = Date.now()
            perfFrameCount = 0
            perfMaxGap = 0.0
            perfLastFrameAt = perfStartAt
            perfRenderFrameCount = 0
            perfRenderLastAt = 0.0
            perfRenderMaxGap = 0.0
            perfRenderMaxEncode = 0.0
            perfRenderMaxRender = 0.0
            const cp0 = map.getCameraPosition()
            console.log("TDTMap: [PERF] 相机移动开始 reason=" + reason + " zoom=" + (cp0 != null ? cp0.zoom : -1))
        })
        map.addOnCameraMoveListener(() => {
            if (!perfGestureActive) return
            const now = Date.now()
            perfFrameCount++
            const gap = now - perfLastFrameAt
            if (gap > perfMaxGap) perfMaxGap = gap
            perfLastFrameAt = now
        })

        // v1.5.7: 渲染帧统计 — context7 验证 maplibre-native 官方源码 MapView.java：
        // addOnDidFinishRenderingFrameListener 回调签名 (fully: boolean, frameEncodingTime: double, frameRenderingTime: double)
        // 每次真实渲染帧完成时触发（静止无重绘时不触发），统计真实画面帧率与 GPU 渲染耗时
        mv.addOnDidFinishRenderingFrameListener((fully: boolean, frameEncodingTime: number, frameRenderingTime: number) => {
            if (!perfGestureActive) return
            const now = Date.now()
            perfRenderFrameCount++
            if (perfRenderLastAt > 0) {
                const gap = now - perfRenderLastAt
                if (gap > perfRenderMaxGap) perfRenderMaxGap = gap
            }
            perfRenderLastAt = now
            if (frameEncodingTime > perfRenderMaxEncode) perfRenderMaxEncode = frameEncodingTime
            if (frameRenderingTime > perfRenderMaxRender) perfRenderMaxRender = frameRenderingTime
        })

        // v1.4.0: 相机空闲事件 — context7 验证：addOnCameraIdleListener 在相机停止移动后触发
        map.addOnCameraIdleListener(() => {
            // v1.5.7: 手势性能汇总输出（平均帧间隔 ~16.7ms=60fps / ~33ms=30fps / >50ms 明显卡）
            if (perfGestureActive) {
                perfGestureActive = false
                const dur = Date.now() - perfStartAt
                const avgGap = perfFrameCount > 0 ? dur / perfFrameCount : 0.0
                const rAvgGap = perfRenderFrameCount > 0 ? dur / perfRenderFrameCount : 0.0
                const cpE = map.getCameraPosition()
                console.log("TDTMap: [PERF] 相机移动结束 持续=" + Math.round(dur) + "ms 逻辑帧=" + perfFrameCount +
                    " 平均帧间隔=" + avgGap.toFixed(1) + "ms 最大帧间隔=" + Math.round(perfMaxGap) + "ms zoom=" + (cpE != null ? cpE.zoom : -1))
                console.log("TDTMap: [PERF] 渲染帧=" + perfRenderFrameCount +
                    " 平均帧间隔=" + rAvgGap.toFixed(1) + "ms 最大帧间隔=" + Math.round(perfRenderMaxGap) +
                    "ms 最大编码耗时=" + perfRenderMaxEncode.toFixed(1) + "ms 最大渲染耗时=" + perfRenderMaxRender.toFixed(1) + "ms")
            }
            const camCb = cameraChangeCallback
            if (camCb != null) {
                const cp = map.getCameraPosition()
                if (cp != null) {
                    const tgt = cp.target
                    if (tgt != null) {
                        camCb({ lat: tgt.latitude, lng: tgt.longitude })
                    }
                }
            }
        })

        // 构建包含天地图 sources + layers 的完整样式 JSON，一次性加载
        // CSDN 验证：MapLibre Android 加载天地图必须将 source/layer 嵌入 style JSON
        const styleJson = buildTiandituStyleJson(options.apiKey, options.mapType)
        console.log("TDTMap: 加载天地图样式...")
        map.setStyle(new Style.Builder().fromJson(styleJson), (style: Style) => {
            console.log("TDTMap: 天地图样式就绪")
            const readyCb = onReadyCallback
            if (readyCb != null) {
                readyCb()
            }
        })
    })
}

// 地图类型切换：重建 style JSON 仅包含新类型的 2 source + 2 layer
// 性能优化：避免 6 个 RasterSource 同时驻留（旧方案用 visibility 切换导致 GPU 负担）
export function switchMapType(mapType: string): void {
    const m = mapLibreMap
    if (m == null) return
    currentMapType = mapType

    const styleJson = buildTiandituStyleJson(currentApiKey, mapType)
    console.log("TDTMap: 切换地图类型 -> " + mapType)
    m.setStyle(new Style.Builder().fromJson(styleJson), (style: Style) => {
        console.log("TDTMap: 地图类型已切换为 " + mapType)
        // v1.9.0: 补齐样式重建链——switchMapType 同为整样式替换，此前未重放用户图层
        // （自定义瓦片/聚合/热力/图片覆盖物会静默丢失）；与 setStyle/removeStyle 对齐
        rebuildUserLayersAfterStyle()
    })
}

export function setCenter(lat: number, lng: number): void {
    const m = mapLibreMap
    console.log("TDTMap: [DIAG] setCenter 调用 lat=" + lat + " lng=" + lng + " map非空=" + (m != null))
    if (m != null) {
        let center = new LatLng(lat.toDouble(), lng.toDouble())
        // context7 验证：使用 CameraUpdateFactory.newLatLng 仅更新中心点，保留当前 zoom
        m.moveCamera(CameraUpdateFactory.newLatLng(center))
        console.log("TDTMap: [DIAG] setCenter moveCamera 已调用")
    }
}

export function setZoom(zoom: number): void {
    const m = mapLibreMap
    console.log("TDTMap: [DIAG] setZoom 调用 zoom=" + zoom + " map非空=" + (m != null))
    if (m != null) {
        // context7 验证：使用 CameraUpdateFactory.zoomTo 仅更新缩放级别，保留当前中心点
        m.moveCamera(CameraUpdateFactory.zoomTo(zoom.toDouble()))
        console.log("TDTMap: [DIAG] setZoom moveCamera 已调用")
    }
}

export function getCenter(): MapClickDetail {
    const m = mapLibreMap
    if (m != null) {
        const pos = m.getCameraPosition()
        if (pos != null) {
            // 缓存 target 到局部 const：Kotlin 无法对跨模块属性做 smart cast，必须用局部 val
            const target = pos.target
            if (target != null) {
                const detail: MapClickDetail = { lat: target.latitude, lng: target.longitude }
                return detail
            }
        }
    }
    const detail: MapClickDetail = { lat: 0, lng: 0 }
    return detail
}

export function getZoom(): number {
    const m = mapLibreMap
    if (m != null) {
        const zoom = m.getCameraPosition()?.zoom
        if (zoom != null) return zoom
    }
    return 0
}

export function fitBounds(minLat: number, minLng: number, maxLat: number, maxLng: number, padding: number): void {
    const m = mapLibreMap
    if (m == null) return
    const errorCb = onErrorCallback
    try {
        let southwest = new LatLng(minLat.toDouble(), minLng.toDouble())
        let northeast = new LatLng(maxLat.toDouble(), maxLng.toDouble())
        let bounds = new LatLngBounds.Builder()
            .include(southwest)
            .include(northeast)
            .build()
        let cameraUpdate = CameraUpdateFactory.newLatLngBounds(bounds, padding.toInt())
        m.moveCamera(cameraUpdate)
    } catch (e: any) {
        console.error("TDTMap: fitBounds 失败: " + e.message)
        if (errorCb != null) {
            const errDetail: MapErrorDetail = { code: 4, message: "fitBounds 失败: " + e.message }
            errorCb(errDetail)
        }
    }
}

export function addMarker(lat: number, lng: number, title: string, snippet?: string): number {
    const m = mapLibreMap
    console.log("TDTMap: [DIAG] addMarker 调用 lat=" + lat + " lng=" + lng + " title=" + title + " map非空=" + (m != null))
    if (m == null) return 0
    let opts = new MarkerOptions()
        .position(new LatLng(lat.toDouble(), lng.toDouble()))
        .title(title)
    // v1.3.0: 设置 snippet 以支持信息窗口
    if (snippet != null && snippet.length > 0) {
        opts.snippet(snippet)
    }
    let mk = m.addMarker(opts)
    markerList.push(mk)
    const id = allocateOverlayId('marker', mk)
    console.log("TDTMap: [DIAG] addMarker 成功 id=" + id)
    return id
}

export function clearMarkers(): void {
    const m = mapLibreMap
    if (m != null) {
        for (let i = 0; i < markerList.length; i++) {
            m.removeMarker(markerList[i])
        }
    }
    // 清理 overlayMap 中所有 marker/label 条目
    clearOverlayType('marker')
    clearOverlayType('label')
    markerList = []
}

export function addPolygon(points: Array<MapClickDetail>, color: string, fillColor: string): number {
    const m = mapLibreMap
    if (m == null) return 0
    const errorCb = onErrorCallback
    try {
        let opts = new PolygonOptions()
        for (let i = 0; i < points.length; i++) {
            let pt = points[i]
            opts.add(new LatLng(pt.lat.toDouble(), pt.lng.toDouble()))
        }
        let strokeColorInt = Color.parseColor(color)
        let fillColorInt = Color.parseColor(fillColor)
        opts.strokeColor(strokeColorInt)
        opts.fillColor(fillColorInt)
        let polygon = m.addPolygon(opts)
        polygonList.push(polygon)
        return allocateOverlayId('polygon', polygon)
    } catch (e: any) {
        console.error("TDTMap: 添加多边形失败: " + e.message)
        if (errorCb != null) {
            const errDetail: MapErrorDetail = { code: 4, message: "添加多边形失败: " + e.message }
            errorCb(errDetail)
        }
        return 0
    }
}

export function clearPolygons(): void {
    const m = mapLibreMap
    if (m == null) {
        clearOverlayType('polygon')
        polygonList = []
        return
    }
    for (let i = 0; i < polygonList.length; i++) {
        m.removePolygon(polygonList[i])
    }
    clearOverlayType('polygon')
    polygonList = []
}

// ==================== 覆盖物：折线 ====================

export function addPolyline(points: Array<MapClickDetail>, color: string, width: number): number {
    const m = mapLibreMap
    if (m == null || points.length < 2) return 0
    const errorCb = onErrorCallback
    try {
        let opts = new PolylineOptions()
        for (let i = 0; i < points.length; i++) {
            let pt = points[i]
            opts.add(new LatLng(pt.lat.toDouble(), pt.lng.toDouble()))
        }
        opts.color(Color.parseColor(color))
        opts.width(width.toFloat())
        let polyline = m.addPolyline(opts)
        polylineList.push(polyline)
        return allocateOverlayId('polyline', polyline)
    } catch (e: any) {
        console.error("TDTMap: 添加折线失败: " + e.message)
        if (errorCb != null) {
            const err: MapErrorDetail = { code: 4, message: "添加折线失败: " + e.message }
            errorCb(err)
        }
        return 0
    }
}

// ══════════════════════════════════════════════
// v1.9.0 新增：E0.3a styled 折线（LineLayer+GeoJsonSource，虚线/透明度）
// ══════════════════════════════════════════════
// legacy addPolyline 走 PolylineOptions 注记路径（无 dash 能力，保持不动）；
// styled 变体走 style 层系（source+layer），与 image 覆盖物同款 {source, layer} 包装与命名惯例
type StyledPolylineEntry = { source: GeoJsonSource, layer: LineLayer }
let styledPolylines: Array<StyledPolylineEntry> = []

export function addStyledPolyline(points: Array<MapClickDetail>, color: string, width: number, dash: Array<number> | null, opacity?: number): number {
    const m = mapLibreMap
    const style = m?.getStyle()
    if (m == null || style == null || points.length < 2) return 0
    const errorCb = onErrorCallback
    // 预分配 ID 再建层（source/layer ID 与 overlay ID 绑定，对齐 img-overlay 命名惯例）
    overlayIdCounter++
    const id = overlayIdCounter
    const sourceId = "styled-line-src-" + id
    const layerId = "styled-line-layer-" + id
    try {
        const coords: Array<Point> = []
        for (let i = 0; i < points.length; i++) {
            coords.push(Point.fromLngLat(points[i].lng.toDouble(), points[i].lat.toDouble()))
        }
        // UTS Array 非 kotlin List；maplibre LineString 工厂为 fromLngLats（复数，Point 才是 fromLngLat）
        const source = new GeoJsonSource(sourceId, LineString.fromLngLats(coords.toKotlinList()))
        style.addSource(source)
        const layer = new LineLayer(layerId, sourceId)
        layer.setProperties(
            PropertyFactory.lineColor(Color.parseColor(color)),
            PropertyFactory.lineWidth(width.toFloat()),
            PropertyFactory.lineOpacity((opacity ?? 1.0).toFloat())
        )
        // 虚线：Expression.literal(Number[]) 常量数组（UTS Array → toTypedArray() 转 kotlin.Array
        // 即 java.lang.Double[]，数组协变匹配 Number[]；textFont(String[]) 同款转换先例）。
        // 编译期验证项：若 SDK 版本无 lineDasharray(Expression) 重载，回退 Float[] 构造路径
        if (dash != null && dash.length > 0) {
            layer.setProperties(PropertyFactory.lineDasharray(Expression.literal(dash.toTypedArray())))
        }
        style.addLayer(layer)
        const entryObj: StyledPolylineEntry = { source: source, layer: layer }
        styledPolylines.push(entryObj)
        overlayMap.set(id, { id: id, type: 'styledPolyline', nativeRef: entryObj, isVisible: true })
        return id
    } catch (e: any) {
        console.error("TDTMap: 添加 styled 折线失败: " + e.message)
        overlayMap.delete(id)
        if (errorCb != null) {
            errorCb({ code: 4, message: "添加 styled 折线失败: " + e.message })
        }
        return 0
    }
}

// 清除全部 styled 折线（clearOverlays 调用；style 为空时仅清状态）
function clearStyledPolylinesInternal(): void {
    const style = mapLibreMap?.getStyle()
    for (let i = 0; i < styledPolylines.length; i++) {
        if (style != null) {
            try {
                style.removeLayer(styledPolylines[i].layer)
                style.removeSource(styledPolylines[i].source)
            } catch (e: any) {
                console.error("TDTMap: clearStyledPolylines 移除失败: " + e.message)
            }
        }
    }
    clearOverlayType('styledPolyline')
    styledPolylines = []
}

// ══════════════════════════════════════════════
// v1.9.0 新增：E0.3b styled 文本（基线=文字转位图 E0.3b-F）
// ══════════════════════════════════════════════
// CJK 供应链现状：三端 glyphs 指 demotiles（国内不可达），SymbolLayer text-field 大概率静默失败，
// 基线档位=Canvas 绘制文字位图 → 既有图像叠加通路（attachImageOverlayToStyle）锚定 lat/lng。
// 上行档位（SymbolLayer+glyphs）待 S0.5 端点就绪后另行接入，本函数即位图基线。

// styled 颜色解析：支持 #rrggbb 与 #rrggbbaa（style spec 约定 alpha 在后）。
// 注意与 Color.parseColor 的 #aarrggbb（alpha 在前）不同——8 位时换位后再解析，
// 避免位运算/Long 溢出问题（Color.parseColor 返回 32 位 Int 负值属正常）
function parseStyledColor(color: string): number {
    if (color.length == 9 && color.charAt(0) == '#') {
        const rgb = color.substring(1, 7)
        const a = color.substring(7, 9)
        return Color.parseColor('#' + a + rgb)
    }
    return Color.parseColor(color)
}

export function addStyledText(lat: number, lng: number, text: string, options: StyledTextOptions): number {
    const m = mapLibreMap
    const style = m?.getStyle()
    if (m == null || style == null || text.length == 0) return 0
    const errorCb = onErrorCallback
    // 位图外提声明：catch 路径可回收（v1.9.1 F7——native 内存不依赖 GC 兜底）
    let bmp: Bitmap | null = null
    try {
        // 位图按物理像素乘 density 绘制（bounds 按逻辑尺寸换算，位图拉伸到 bounds 后保持锐利）
        const ctx = mapView?.getContext()
        let density = 1.0
        if (ctx != null) {
            density = ctx.getResources().getDisplayMetrics().density.toDouble()
        }
        const fontSizePx = options.fontSize * density
        const haloWidthPx = options.haloWidth * density
        const pad = (options.haloColor != null && haloWidthPx > 0 ? haloWidthPx : 0) + density

        const paint = new Paint(Paint.ANTI_ALIAS_FLAG)
        paint.setTextSize(fontSizePx.toFloat())
        const textWidth = paint.measureText(text)
        const fm = paint.getFontMetrics()
        const textHeight = (fm.descent.toDouble() - fm.ascent.toDouble())
        const bmpW = Math.ceil(textWidth.toDouble() + pad * 2).toInt()
        const bmpH = Math.ceil(textHeight + pad * 2).toInt()
        if (bmpW <= 0 || bmpH <= 0) return 0
        bmp = Bitmap.createBitmap(bmpW, bmpH, Bitmap.Config.ARGB_8888)
        const canvas = new Canvas(bmp!)
        // 文字基线：ascent 为负值，baselineY = pad - ascent 使文本顶部落在 pad
        const baselineY = (pad - fm.ascent.toDouble())
        if (options.haloColor != null && haloWidthPx > 0) {
            // halo 描边：加宽 stroke（haloWidth*2 补偿双向各半）先画后填充（Web/iOS 八方向偏移同视觉）
            paint.setStyle(Paint.Style.STROKE)
            paint.setStrokeWidth((haloWidthPx * 2).toFloat())
            paint.setColor(parseStyledColor(options.haloColor).toInt())
            canvas.drawText(text, pad.toFloat(), baselineY.toFloat(), paint)
        }
        paint.setStyle(Paint.Style.FILL)
        paint.setColor(parseStyledColor(options.color).toInt())
        canvas.drawText(text, pad.toFloat(), baselineY.toFloat(), paint)

        // bounds 换算（当前 zoom 屏幕等尺寸）：256 tileSize 标准 worldPx 公式（组件层 latLngToScreen 同源）
        const camPos = m.getCameraPosition()
        const zoom = camPos != null ? camPos.zoom : 10.0
        const worldPx = 256 * Math.pow(2, zoom.toDouble())
        const logicalW = bmpW.toDouble() / density
        const logicalH = bmpH.toDouble() / density
        const halfLng = (logicalW / 2) * 360 / worldPx
        const latRad = lat * Math.PI / 180
        const halfLat = (logicalH / 2) * 360 / worldPx / Math.cos(latRad)
        if (!(halfLng > 0) || !(halfLat > 0)) {
            bmp!.recycle()
            return 0
        }

        // 复用图像叠加通路（type=styledText 与 image 同款 {source,layer} 管理；attach 回填 ext 供样式重建重放）
        // allocateOverlayId 对齐 image 通路（null 占位 + attachImageOverlayToStyle 内回填 nativeRef，
        // 避免 OverlayEntry.nativeRef 字面量直接传 null 触发非空 Any 编译错误）
        const id = allocateOverlayId('styledText', null)
        const params: ImageOverlayOptions = {
            southwest: { lat: lat - halfLat, lng: lng - halfLng },
            northeast: { lat: lat + halfLat, lng: lng + halfLng },
            image: '',
            transparency: 0,
            bearing: 0,
            visible: true,
            clickable: false
        }
        attachImageOverlayToStyle(id, params, style, bmp!)
        return id
    } catch (e: any) {
        console.error("TDTMap: 添加 styled 文本失败: " + e.message)
        // v1.9.1 F7：位图已创建但中途失败时立即回收，不依赖 GC 兜底
        if (bmp != null) {
            bmp!.recycle()
        }
        if (errorCb != null) {
            errorCb({ code: 4, message: "添加 styled 文本失败: " + e.message })
        }
        return 0
    }
}

// ==================== 覆盖物：圆（多边形近似，36 边） ====================

const EARTH_RADIUS = 6378137.0

function circleToPolygonPoints(lat: number, lng: number, radius: number, segments: number): Array<MapClickDetail> {
    let result: Array<MapClickDetail> = []
    const dLat = radius / EARTH_RADIUS * (180.0 / Math.PI)
    const dLng = radius / (EARTH_RADIUS * Math.cos(lat * Math.PI / 180.0)) * (180.0 / Math.PI)
    for (let i = 0; i < segments; i++) {
        const angle = (2.0 * Math.PI * i) / segments
        result.push({
            lat: lat + dLat * Math.cos(angle),
            lng: lng + dLng * Math.sin(angle)
        })
    }
    return result
}

export function addCircle(lat: number, lng: number, radius: number, color: string, fillColor: string): number {
    const m = mapLibreMap
    if (m == null) return 0
    const errorCb = onErrorCallback
    try {
        const circlePoints = circleToPolygonPoints(lat, lng, radius, 36)
        let opts = new PolygonOptions()
        for (let i = 0; i < circlePoints.length; i++) {
            let pt = circlePoints[i]
            opts.add(new LatLng(pt.lat.toDouble(), pt.lng.toDouble()))
        }
        opts.strokeColor(Color.parseColor(color))
        opts.fillColor(Color.parseColor(fillColor))
        let polygon = m.addPolygon(opts)
        circleList.push(polygon)
        return allocateOverlayId('circle', polygon)
    } catch (e: any) {
        console.error("TDTMap: 添加圆失败: " + e.message)
        if (errorCb != null) {
            const err: MapErrorDetail = { code: 4, message: "添加圆失败: " + e.message }
            errorCb(err)
        }
        return 0
    }
}

// ==================== 覆盖物：矩形 ====================

export function addRectangle(minLat: number, minLng: number, maxLat: number, maxLng: number, color: string, fillColor: string): number {
    const m = mapLibreMap
    if (m == null) return 0
    const errorCb = onErrorCallback
    try {
        let opts = new PolygonOptions()
        opts.add(new LatLng(minLat.toDouble(), minLng.toDouble()))
        opts.add(new LatLng(maxLat.toDouble(), minLng.toDouble()))
        opts.add(new LatLng(maxLat.toDouble(), maxLng.toDouble()))
        opts.add(new LatLng(minLat.toDouble(), maxLng.toDouble()))
        opts.strokeColor(Color.parseColor(color))
        opts.fillColor(Color.parseColor(fillColor))
        let polygon = m.addPolygon(opts)
        rectangleList.push(polygon)
        return allocateOverlayId('rectangle', polygon)
    } catch (e: any) {
        console.error("TDTMap: 添加矩形失败: " + e.message)
        if (errorCb != null) {
            const err: MapErrorDetail = { code: 4, message: "添加矩形失败: " + e.message }
            errorCb(err)
        }
        return 0
    }
}

// ==================== 覆盖物：文字标注 ====================

export function addLabel(lat: number, lng: number, text: string): number {
    const m = mapLibreMap
    if (m == null) return 0
    let opts = new MarkerOptions()
        .position(new LatLng(lat.toDouble(), lng.toDouble()))
        .title(text)
    let mk = m.addMarker(opts)
    markerList.push(mk)
    return allocateOverlayId('label', mk)
}

// ==================== 覆盖物：批量标记 ====================

export function setMarkers(markers: Array<MapClickDetail>): Array<number> {
    clearMarkers()
    const m = mapLibreMap
    const ids: Array<number> = []
    if (m == null || markers.length == 0) return ids
    for (let i = 0; i < markers.length; i++) {
        let pt = markers[i]
        let opts = new MarkerOptions()
            .position(new LatLng(pt.lat.toDouble(), pt.lng.toDouble()))
        let mk = m.addMarker(opts)
        markerList.push(mk)
        ids.push(allocateOverlayId('marker', mk))
    }
    return ids
}

// ==================== 覆盖物：清除全部 ====================

export function clearOverlays(): void {
    clearMarkers()
    clearPolygons()
    // v1.9.0: 清除图片覆盖物（style 层系，须逐个 removeLayer/removeSource；mapLibreMap 为空时仅清状态）
    clearImageOverlaysInternal()
    // v1.9.0: 清除 styled 折线（style 层系，同上）
    clearStyledPolylinesInternal()
    const m = mapLibreMap
    if (m == null) {
        clearOverlayType('polyline')
        clearOverlayType('circle')
        clearOverlayType('rectangle')
        polylineList = []
        circleList = []
        rectangleList = []
        return
    }
    for (let i = 0; i < polylineList.length; i++) {
        m.removePolyline(polylineList[i])
    }
    polylineList = []
    clearOverlayType('polyline')
    for (let i = 0; i < circleList.length; i++) {
        m.removePolygon(circleList[i])
    }
    circleList = []
    clearOverlayType('circle')
    for (let i = 0; i < rectangleList.length; i++) {
        m.removePolygon(rectangleList[i])
    }
    rectangleList = []
    clearOverlayType('rectangle')
}

// 地图截图（异步回调）
// context7 验证：uni-app x 平台 UTS 函数默认在 main 线程执行（DCloud 官方文档
// uts-for-android.html §2.4 线程环境差异），MapLibre snapshot 回调也在主线程执行
// （渲染线程截图完成后 post 回主线程）——主线程同步等待（CountDownLatch.await）
// 会阻塞消息循环导致回调永不执行（真机实测 5 秒超时死锁），
// 因此改为异步：发起请求后立即返回，回调在主线程消息循环中执行，无阻塞、无死锁
export function snapshot(callback: (data: ArrayBuffer) => void): void {
    const m = mapLibreMap
    const errorCb = onErrorCallback
    if (m == null) {
        if (errorCb != null) {
            const errDetail: MapErrorDetail = { code: 4, message: "Map 未初始化" }
            errorCb(errDetail)
        }
        callback(new ArrayBuffer(0))
        return
    }
    try {
        m.snapshot((bitmap: android.graphics.Bitmap) => {
            try {
                let stream = new java.io.ByteArrayOutputStream()
                bitmap.compress(android.graphics.Bitmap.CompressFormat.PNG, 100, stream)
                const resultBytes = stream.toByteArray()
                stream.close()
                // ByteArray → ByteBuffer → ArrayBuffer（UTS 官方 API：ArrayBuffer.fromByteBuffer）
                const byteBuffer = java.nio.ByteBuffer.wrap(resultBytes)
                callback(ArrayBuffer.fromByteBuffer(byteBuffer))
            } catch (e: any) {
                console.error("TDTMap: snapshot 压缩失败: " + e.message)
                if (errorCb != null) {
                    const err: MapErrorDetail = { code: 4, message: "Snapshot 压缩失败: " + e.message }
                    errorCb(err)
                }
                callback(new ArrayBuffer(0))
            }
        })
    } catch (e: any) {
        console.error("TDTMap: snapshot 失败: " + e.message)
        if (errorCb != null) {
            const errDetail: MapErrorDetail = { code: 4, message: "Snapshot 失败: " + e.message }
            errorCb(errDetail)
        }
        callback(new ArrayBuffer(0))
    }
}

export function onResume(): void {
    console.log("TDTMap: [DIAG] onResume 调用 mapView非空=" + (mapView != null))
    mapView?.onResume()
}

export function onPause(): void {
    console.log("TDTMap: [DIAG] onPause 调用 mapView非空=" + (mapView != null))
    mapView?.onPause()
}

export function destroyMap(): void {
    const mv = mapView
    if (mv != null) {
        // context7 验证：MapView 生命周期必须 onPause → onStop → onDestroy 顺序调用
        // 跳过 onPause 会导致 mapRenderer.onPause() 未执行，GL 资源无法正确释放
        mv.onPause()
        mv.onStop()
        // v1.7.0: 销毁前清理聚合/热力图层引用（在 onDestroy 前调用，style 仍可用；函数内部有 try/catch 兜底）
        removeMarkerCluster()
        removeHeatmap()
        mv.onDestroy()
    }
    mapView = null
    mapLibreMap = null
    onClickCallback = null
    onReadyCallback = null
    onErrorCallback = null
    markerClickCallback = null
    mapLongClickCallback = null
    cameraChangeCallback = null
    markerList = []
    polygonList = []
    polylineList = []
    circleList = []
    rectangleList = []
    overlayMap = new Map<number, OverlayEntry>()
    overlayIdCounter = 0
    currentApiKey = ''
    currentMapType = 'vec'
    locationComponentActivated = false
    customTileSources.clear()
    // v1.8.0: 清理图层重建状态（聚合/热力快照已由上方 removeMarkerCluster/removeHeatmap 清空）
    customTileLayerIds = []
    customStyleActive = false
    // v1.9.0: 图片覆盖物状态（bitmap 引用一并释放，交由 GC 回收）
    imageOverlayExt = new Map<number, ImageOverlayExt>()
    imageOverlayIds = []
    imageOverlayClickCallback = null
    // v1.9.0: styled 折线状态（source/layer 随 style 销毁，仅清引用）
    styledPolylines = []
}

// ==================== 缩放控制 ====================

export function zoomIn(): void {
    const m = mapLibreMap
    if (m != null) {
        // v1.6.0: 修复缩放按钮无响应——v1.5.5 实测 animateCamera 动画在 UTS 集成下
        // 不推进（500ms 零进展，目标 zoom 中间值从未出现），与 panTo/centerAndZoom
        // 一致改用 moveCamera 瞬时缩放
        m.moveCamera(CameraUpdateFactory.zoomIn())
    }
}

export function zoomOut(): void {
    const m = mapLibreMap
    if (m != null) {
        m.moveCamera(CameraUpdateFactory.zoomOut())
    }
}

export function setMinZoom(zoom: number): void {
    mapLibreMap?.setMinZoomPreference(zoom.toDouble())
}

export function setMaxZoom(zoom: number): void {
    mapLibreMap?.setMaxZoomPreference(zoom.toDouble())
}

// ==================== 视野移动 ====================

export function panTo(lat: number, lng: number, zoom?: number): void {
    const m = mapLibreMap
    console.log("TDTMap: [DIAG] panTo 调用 lat=" + lat + " lng=" + lng + " zoom=" + zoom + " map非空=" + (m != null))
    if (m != null) {
        const target = new LatLng(lat.toDouble(), lng.toDouble())
        // v1.5.5: 日志实测 animateCamera 动画在 UTS 集成下不推进（500ms 零进展，目标 zoom 中间值从未出现），
        // 手势改相机正常——moveCamera 与手势同管线，改用瞬移
        if (zoom != null) {
            m.moveCamera(CameraUpdateFactory.newLatLngZoom(target, zoom.toDouble()))
        } else {
            m.moveCamera(CameraUpdateFactory.newLatLng(target))
        }
        console.log("TDTMap: [DIAG] panTo moveCamera 已调用")
    }
}

export function centerAndZoom(lat: number, lng: number, zoom: number): void {
    const m = mapLibreMap
    console.log("TDTMap: [DIAG] centerAndZoom 调用 lat=" + lat + " lng=" + lng + " zoom=" + zoom + " map非空=" + (m != null))
    if (m != null) {
        const target = new LatLng(lat.toDouble(), lng.toDouble())
        // moveCamera：无动画，直接跳转（与 animateCamera 区分）
        m.moveCamera(CameraUpdateFactory.newLatLngZoom(target, zoom.toDouble()))
        console.log("TDTMap: [DIAG] centerAndZoom moveCamera 已调用")
    }
}

// ==================== 手势控制 ====================

export function enableZoom(enabled: boolean): void {
    const uiSettings = mapLibreMap?.getUiSettings()
    if (uiSettings != null) {
        uiSettings.setZoomGesturesEnabled(enabled)
    }
}

export function enableDrag(enabled: boolean): void {
    const uiSettings = mapLibreMap?.getUiSettings()
    if (uiSettings != null) {
        uiSettings.setScrollGesturesEnabled(enabled)
    }
}

// ==================== 范围限制 ====================

export function setMaxBounds(minLat: number | null, minLng: number | null, maxLat: number | null, maxLng: number | null): void {
    const m = mapLibreMap
    if (m == null) return
    // context7: MapLibre Android 官方 API 注释——传 null 清除当前边界限制
    if (minLat == null || minLng == null || maxLat == null || maxLng == null) {
        m.setLatLngBoundsForCameraTarget(null)
        return
    }
    const southwest = new LatLng(minLat.toDouble(), minLng.toDouble())
    const northeast = new LatLng(maxLat.toDouble(), maxLng.toDouble())
    const bounds = new LatLngBounds.Builder()
        .include(southwest)
        .include(northeast)
        .build()
    m.setLatLngBoundsForCameraTarget(bounds)
}

// ==================== 信息获取 ====================

export function getBounds(): MapBoundsDetail {
    const m = mapLibreMap
    if (m != null) {
        const projection = m.getProjection()
        if (projection != null) {
            const region = projection.getVisibleRegion()
            if (region != null) {
                // context7: UTS 无法解析 LatLngBounds.southwest/northeast 字段，
                // 使用 VisibleRegion 四角 LatLng 计算边界，加空安全检查与显式 Double 转换
                const fl = region.farLeft
                const fr = region.farRight
                const nl = region.nearLeft
                const nr = region.nearRight
                if (fl != null && fr != null && nl != null && nr != null) {
                    let minLat = fl.latitude.toDouble()
                    let maxLat = fl.latitude.toDouble()
                    let minLng = fl.longitude.toDouble()
                    let maxLng = fl.longitude.toDouble()
                    const corners = [fr, nl, nr]
                    for (let i = 0; i < 3; i++) {
                        const lat = corners[i].latitude.toDouble()
                        const lng = corners[i].longitude.toDouble()
                        if (lat < minLat) minLat = lat
                        if (lat > maxLat) maxLat = lat
                        if (lng < minLng) minLng = lng
                        if (lng > maxLng) maxLng = lng
                    }
                    return { minLat: minLat, minLng: minLng, maxLat: maxLat, maxLng: maxLng }
                }
            }
        }
    }
    return { minLat: 0, minLng: 0, maxLat: 0, maxLng: 0 }
}

// ==================== 坐标转换（纯数学，三端通用） ====================
// 算法来源：Wikipedia GCJ-02 article + eviltransform (GitHub)
// 迭代修正 3 次即可收敛到亚米级精度，中国境外坐标直接返回原值

const GCJ_PI = 3.14159265358979323846
const GCJ_A = 6378245.0
const GCJ_EE = 0.00669342162296594323

function isOutOfChina(lat: number, lng: number): boolean {
    return lng < 72.004 || lng > 137.8347 || lat < 0.8293 || lat > 55.8271
}

function gcjTransformLat(x: number, y: number): number {
    let ret = -100.0 + 2.0 * x + 3.0 * y + 0.2 * y * y + 0.1 * x * y + 0.2 * Math.sqrt(Math.abs(x))
    ret += (20.0 * Math.sin(6.0 * x * GCJ_PI) + 20.0 * Math.sin(2.0 * x * GCJ_PI)) * 2.0 / 3.0
    ret += (20.0 * Math.sin(y * GCJ_PI) + 40.0 * Math.sin(y / 3.0 * GCJ_PI)) * 2.0 / 3.0
    ret += (160.0 * Math.sin(y / 12.0 * GCJ_PI) + 320.0 * Math.sin(y * GCJ_PI / 30.0)) * 2.0 / 3.0
    return ret
}

function gcjTransformLng(x: number, y: number): number {
    let ret = 300.0 + x + 2.0 * y + 0.1 * x * x + 0.1 * x * y + 0.1 * Math.sqrt(Math.abs(x))
    ret += (20.0 * Math.sin(6.0 * x * GCJ_PI) + 20.0 * Math.sin(2.0 * x * GCJ_PI)) * 2.0 / 3.0
    ret += (20.0 * Math.sin(x * GCJ_PI) + 40.0 * Math.sin(x / 3.0 * GCJ_PI)) * 2.0 / 3.0
    ret += (150.0 * Math.sin(x / 12.0 * GCJ_PI) + 300.0 * Math.sin(x / 30.0 * GCJ_PI)) * 2.0 / 3.0
    return ret
}

// WGS84 → GCJ02 正向偏移量计算（内部辅助，不导出）
type Gcj02Delta = { dLat: number, dLng: number }
function wgs84ToGcj02Delta(lat: number, lng: number): Gcj02Delta {
    const dLat = gcjTransformLat(lng - 105.0, lat - 35.0)
    const dLng = gcjTransformLng(lng - 105.0, lat - 35.0)
    const radLat = lat / 180.0 * GCJ_PI
    let magic = Math.sin(radLat)
    magic = 1 - GCJ_EE * magic * magic
    const sqrtMagic = Math.sqrt(magic)
    const dLatFinal = (dLat * 180.0) / ((GCJ_A * (1 - GCJ_EE)) / (magic * sqrtMagic) * GCJ_PI)
    const dLngFinal = (dLng * 180.0) / (GCJ_A / sqrtMagic * Math.cos(radLat) * GCJ_PI)
    return { dLat: dLatFinal, dLng: dLngFinal }
}

export function gcj02ToWgs84(lat: number, lng: number): MapClickDetail {
    if (isOutOfChina(lat, lng)) {
        return { lat: lat, lng: lng }
    }
    let wgsLat = lat
    let wgsLng = lng
    // 迭代修正：每次用当前 WGS84 估算值计算正向偏移，减去残差逼近真值
    // Wikipedia 验证：2 次迭代可达厘米级精度，3 次有安全余量
    for (let i = 0; i < 3; i++) {
        const delta = wgs84ToGcj02Delta(wgsLat, wgsLng)
        const gcjLat = wgsLat + delta.dLat
        const gcjLng = wgsLng + delta.dLng
        wgsLat -= (gcjLat - lat)
        wgsLng -= (gcjLng - lng)
    }
    return { lat: wgsLat, lng: wgsLng }
}

// ══════════════════════════════════════════════
// 覆盖物管理：单个操作
// ══════════════════════════════════════════════

// 从 overlayMap 中清除指定类型的所有条目
function clearOverlayType(type: string): void {
    const keysToRemove: Array<number> = []
    overlayMap.forEach((entry: OverlayEntry, key: number) => {
        if (entry.type == type) {
            keysToRemove.push(key)
        }
    })
    for (let i = 0; i < keysToRemove.length; i++) {
        overlayMap.delete(keysToRemove[i])
    }
}

// context7 验证：removePolygon/removePolyline/removeMarker 均为 MapLibreMap 方法
export function removeOverlay(id: number): void {
    const entry = overlayMap.get(id)
    if (entry == null) return
    const ref = entry.nativeRef
    const m = mapLibreMap
    if (m == null || ref == null) {
        overlayMap.delete(id)
        // v1.9.0: 图片覆盖物加载中即被移除——同步清理扩展状态（解码回调将因 entry 缺失而丢弃）
        imageOverlayExt.delete(id)
        imageOverlayIds = imageOverlayIds.filter(x => x != id)
        return
    }
    try {
        if (entry.type == 'marker' || entry.type == 'label') {
            m.removeMarker(ref as Marker)
            markerList = markerList.filter(mk => mk !== ref)
        } else if (entry.type == 'polygon') {
            m.removePolygon(ref as Polygon)
            polygonList = polygonList.filter(p => p !== ref)
        } else if (entry.type == 'circle') {
            m.removePolygon(ref as Polygon)
            circleList = circleList.filter(c => c !== ref)
        } else if (entry.type == 'rectangle') {
            m.removePolygon(ref as Polygon)
            rectangleList = rectangleList.filter(r => r !== ref)
        } else if (entry.type == 'polyline') {
            m.removePolyline(ref as Polyline)
            polylineList = polylineList.filter(p => p !== ref)
        } else if (entry.type == 'styledPolyline') {
            // v1.9.0: styled 折线为 style 层系（source+layer），非 annotation 体系
            const style = m.getStyle()
            const spRef = ref as StyledPolylineEntry
            if (style != null) {
                try {
                    style.removeLayer(spRef.layer)
                    style.removeSource(spRef.source)
                } catch (e2: any) {
                    console.error("TDTMap: removeOverlay styled 折线移除失败: " + e2.message)
                }
            }
            styledPolylines = styledPolylines.filter(sp => sp !== spRef)
        } else if (entry.type == 'image' || entry.type == 'styledText') { // v1.9.0: styledText 同为 image 通路 {source,layer}
            // v1.9.0: 图片覆盖物为 style 层系（source+layer），非 annotation 体系
            // any 上直接点访问报"找不到名称"，as ImageOverlayExt 收窄后取成员（对齐上方 styledPolyline 先例）
            const style = m.getStyle()
            const imgRef = ref as ImageOverlayExt
            if (style != null) {
                try {
                    style.removeLayer(imgRef.layer as RasterLayer)
                    style.removeSource(imgRef.source as ImageSource)
                } catch (e2: any) {
                    console.error("TDTMap: removeOverlay 图片/styledText 移除失败: " + e2.message)
                }
            }
        }
    } catch (e: any) {
        console.error("TDTMap: removeOverlay 失败: " + e.message)
    }
    overlayMap.delete(id)
    // v1.9.0: 图片覆盖物状态同步清理（非图片 ID 时为无害 no-op）
    imageOverlayExt.delete(id)
    imageOverlayIds = imageOverlayIds.filter(x => x != id)
}

// context7 + Exa 验证（maplibre-android-sdk 11.8.1 源码/官方 API 文档）：
// - Polyline/Polygon 有 setAlpha(float)；Marker 无 setAlpha（Annotation 基类已移除 alpha/visible API）
// - Marker 显隐通过 removeMarker + addMarker 重建实现（移除后 Marker 对象仍保留 position/title/snippet）
export function showOverlay(id: number): void {
    const entry = overlayMap.get(id)
    if (entry == null) return
    try {
        const ref = entry.nativeRef
        if (ref != null) {
            if (entry.type == 'marker' || entry.type == 'label') {
                const mk = ref as Marker
                const m = mapLibreMap
                // 已从地图移除的标记需重建后重新添加
                if (m != null && markerList.indexOf(mk) < 0) {
                    const pos = mk.getPosition()
                    if (pos != null) {
                        let title = mk.getTitle()
                        if (title == null) {
                            title = ''
                        }
                        const opts = new MarkerOptions()
                            .position(pos)
                            .title(title)
                        const snip = mk.getSnippet()
                        if (snip != null && snip.length > 0) {
                            opts.snippet(snip)
                        }
                        const newMk = m.addMarker(opts)
                        entry.nativeRef = newMk
                        markerList.push(newMk)
                    }
                }
            } else if (entry.type == 'polyline') {
                (ref as Polyline).setAlpha(1.0.toFloat())
            } else if (entry.type == 'styledPolyline') {
                // v1.9.0: maplibre 11.x Layer 无 setVisible，可见性走 visibility layout property
                (ref as StyledPolylineEntry).layer.setProperties(PropertyFactory.visibility(Property.VISIBLE))
            } else if (entry.type == 'image' || entry.type == 'styledText') { // v1.9.0: styledText 同为 image 通路 {source,layer}
                // v1.9.0: RasterLayer 无 setAlpha，同走 visibility（必须显式拦截，否则落入末尾 Polygon 分支）
                ((ref as ImageOverlayExt).layer as RasterLayer).setProperties(PropertyFactory.visibility(Property.VISIBLE))
                const extShow = imageOverlayExt.get(id)
                if (extShow != null) extShow.params.visible = true
            } else {
                (ref as Polygon).setAlpha(1.0.toFloat())
            }
            entry.isVisible = true
        }
    } catch (e: any) {
        console.error("TDTMap: showOverlay 失败: " + e.message)
    }
}

export function hideOverlay(id: number): void {
    const entry = overlayMap.get(id)
    if (entry == null) return
    try {
        const ref = entry.nativeRef
        if (ref != null) {
            if (entry.type == 'marker' || entry.type == 'label') {
                const mk = ref as Marker
                const m = mapLibreMap
                // 从地图移除并移出 markerList，避免点击检测误命中已隐藏标记
                if (m != null && markerList.indexOf(mk) >= 0) {
                    m.removeMarker(mk)
                    markerList = markerList.filter(item => item !== mk)
                }
            } else if (entry.type == 'polyline') {
                (ref as Polyline).setAlpha(0.0.toFloat())
            } else if (entry.type == 'styledPolyline') {
                // v1.9.0: maplibre 11.x Layer 无 setVisible，可见性走 visibility layout property
                (ref as StyledPolylineEntry).layer.setProperties(PropertyFactory.visibility(Property.NONE))
            } else if (entry.type == 'image' || entry.type == 'styledText') { // v1.9.0: styledText 同为 image 通路 {source,layer}
                // v1.9.0: RasterLayer 无 setAlpha，同走 visibility（必须显式拦截，否则落入末尾 Polygon 分支）
                ((ref as ImageOverlayExt).layer as RasterLayer).setProperties(PropertyFactory.visibility(Property.NONE))
                const extHide = imageOverlayExt.get(id)
                if (extHide != null) extHide.params.visible = false
            } else {
                (ref as Polygon).setAlpha(0.0.toFloat())
            }
            entry.isVisible = false
        }
    } catch (e: any) {
        console.error("TDTMap: hideOverlay 失败: " + e.message)
    }
}

// ══════════════════════════════════════════════
// 标记点击事件
// ══════════════════════════════════════════════

// context7 验证：标记点击检测已内置于 initMap 的单一 OnMapClickListener 中（Priority 1 先检测标记，Priority 2 触发地图点击，二者互斥）
// 此处仅更新回调引用；不再注册额外监听器（重复注册会导致双重触发或事件被首个监听器拦截）
@UTSJS.keepAlive
export function setMarkerClickCallback(callback: MarkerClickCallback): void {
    markerClickCallback = callback
    // 标记点击检测逻辑已合并到 initMap 的 OnMapClickListener 中（见 initMap 中的 Priority 1 检查）。
    // 闭包通过模块级变量 markerClickCallback 和 markerList 访问最新引用，
    // 因此用户在不同时机调用 setMarkerClickCallback 均能生效。
}

// ══════════════════════════════════════════════
// 地图工具
// ══════════════════════════════════════════════

// context7 验证：Android MapView 自动响应布局变化，但容器变更时需主动触发重绘
export function checkResize(): void {
    const mv = mapView
    if (mv != null) {
        mv.requestLayout()
        mv.invalidate()
    }
}

// context7 + 官方 API 文档验证：MapLibreMap.scrollBy(x: Float, y: Float) 像素级平移
export function planBy(x: number, y: number): void {
    const m = mapLibreMap
    if (m != null) {
        m.scrollBy(x.toFloat(), y.toFloat())
    }
}

// context7 验证：LatLngBounds.Builder + newLatLngBounds 适应坐标点数组
export function setViewport(points: Array<MapClickDetail>): void {
    const m = mapLibreMap
    if (m == null || points.length == 0) return
    let builder = new LatLngBounds.Builder()
    for (let i = 0; i < points.length; i++) {
        builder.include(new LatLng(points[i].lat.toDouble(), points[i].lng.toDouble()))
    }
    const bounds = builder.build()
    // 50px padding 确保点不完全贴边
    m.animateCamera(CameraUpdateFactory.newLatLngBounds(bounds, 50))
}

// context7 验证：MapView.getWidth()/getHeight() 返回像素尺寸
export function getSize(): MapSizeDetail {
    const mv = mapView
    if (mv != null) {
        return { width: mv.getWidth(), height: mv.getHeight() }
    }
    return { width: 0, height: 0 }
}

// ══════════════════════════════════════════════
// 信息计算（纯数学，三端通用）
// ══════════════════════════════════════════════

// Haversine 公式计算两点间距离（米）
const HAV_EARTH_RADIUS = 6371000.0

function toRadians(deg: number): number {
    return deg * Math.PI / 180.0
}

export function getDistance(start: MapClickDetail, end: MapClickDetail): number {
    const dLat = toRadians(end.lat - start.lat)
    const dLng = toRadians(end.lng - start.lng)
    const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
        Math.cos(toRadians(start.lat)) * Math.cos(toRadians(end.lat)) *
        Math.sin(dLng / 2) * Math.sin(dLng / 2)
    const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a))
    return HAV_EARTH_RADIUS * c
}

// 计算最佳视野：根据坐标点数组返回 center 和 zoom
export function getViewport(points: Array<MapClickDetail>): MapViewportDetail {
    if (points.length == 0) {
        return { center: { lat: 0, lng: 0 }, zoom: 10 }
    }
    let minLat = points[0].lat, maxLat = points[0].lat
    let minLng = points[0].lng, maxLng = points[0].lng
    for (let i = 1; i < points.length; i++) {
        if (points[i].lat < minLat) minLat = points[i].lat
        if (points[i].lat > maxLat) maxLat = points[i].lat
        if (points[i].lng < minLng) minLng = points[i].lng
        if (points[i].lng > maxLng) maxLng = points[i].lng
    }
    const centerLat = (minLat + maxLat) / 2
    const centerLng = (minLng + maxLng) / 2
    const latSpan = maxLat - minLat
    const lngSpan = maxLng - minLng
    const maxSpan = Math.max(latSpan, lngSpan)
    let zoom = Math.log(360 / maxSpan) / Math.log(2)
    if (zoom < 1) zoom = 1
    if (zoom > 20) zoom = 20
    return { center: { lat: centerLat, lng: centerLng }, zoom: zoom }
}

// 天地图采用 CGCS2000 坐标系，约等于 WGS84
export function getCode(): string {
    return 'EPSG:4326'
}

// ══════════════════════════════════════════════
// 天地图 Web API（搜索/地理编码）
// ══════════════════════════════════════════════
// 上下文7 验证：天地图 geocoder API
// 地理编码：https://api.tianditu.gov.cn/geocoder?ds={"keyWord":"..."}&tk=KEY
// 逆地理编码：https://api.tianditu.gov.cn/geocoder?postStr={'lon':...,'lat':...,'ver':1}&type=geocode&tk=KEY
// 搜索 v2（地名搜索2.0）：https://api.tianditu.gov.cn/v2/search?postStr={...}&type=query&tk=KEY
// context7 验证：天地图官方声明同时支持 HTTP 和 HTTPS，Android 9+ 强制要求 HTTPS 明文拦截避免

const TDT_API_BASE = 'https://api.tianditu.gov.cn'

function tiandituHttpRequest(url: string, callback: GeocodeCallback): void {
    // v1.5.3: 原实现用 java.net.HttpURLConnection 同步请求，在 UTS 调用线程（主线程）执行，
    // Android 严格模式抛 NetworkOnMainThreadException（message 为 null），表现为"HTTP 请求失败: null"。
    // 改用 uni.request：官方 API 内部自动调度到网络线程执行，且支持 HTTPS（Android 9+ 明文限制无影响）。
    uni.request({
        url: url,
        method: 'GET',
        timeout: 10000,
        success: (res) => {
            console.log("TDTMap: [DIAG] HTTP 响应到达")
            try {
                // dataType 默认 'json'，框架已自动把 res.data 解析为 UTSJSONObject；
                // 若服务器返回非 JSON（如错误页 HTML）则为 string，JSON.parse 兜底
                // v1.5.4: 官方文档明确 res.data 是“可为空的 any 类型”（any | null），
                // 显式判空避免 "Initializer type mismatch: expected 'Any', actual 'Any?'" 编译错误
                const data = res.data
                if (data == null) {
                    callback(new UTSJSONObject('{"status":"404","msg":"Empty response"}'))
                    return
                }
                let json: UTSJSONObject
                if (typeof data == 'string') {
                    // v1.5.4: JSON.parse 对非法 JSON 返回 null（如接口返回 HTML 错误页），直接 as 会抛崩溃
                    const parsed = JSON.parse(data as string)
                    if (parsed == null) {
                        console.error("TDTMap: 响应非 JSON: " + (data as string).substring(0, 200))
                        callback(new UTSJSONObject('{"status":"404","msg":"Invalid JSON response"}'))
                        return
                    }
                    json = parsed as UTSJSONObject
                } else {
                    json = data as UTSJSONObject
                }
                callback(json)
            } catch (e: any) {
                console.error("TDTMap: 响应解析失败: " + e.message)
                callback(new UTSJSONObject('{"status":"404","msg":"Parse error"}'))
            }
        },
        fail: (err) => {
            console.error("TDTMap: HTTP 请求失败: " + err.errMsg)
            callback(new UTSJSONObject('{"status":"404","msg":"HTTP request failed"}'))
        }
    })
}

@UTSJS.keepAlive
export function geocode_getLocation(lnglat: MapClickDetail, callback: GeocodeCallback): void {
    const key = currentApiKey
    if (key.length == 0) {
        callback(new UTSJSONObject('{"status":"1","msg":"No API Key"}'))
        return
    }
    const postStr = "{'lon':" + lnglat.lng.toString() + ",'lat':" + lnglat.lat.toString() + ",'ver':1}"
    const url = TDT_API_BASE + '/geocoder?postStr=' + java.net.URLEncoder.encode(postStr, 'UTF-8') + '&type=geocode&tk=' + key
    tiandituHttpRequest(url, callback)
}

@UTSJS.keepAlive
export function geocode_getPoint(address: string, callback: GeocodeCallback): void {
    const key = currentApiKey
    if (key.length == 0) {
        callback(new UTSJSONObject('{"status":"1","msg":"No API Key"}'))
        return
    }
    const postStr = '{"keyWord":"' + address + '"}'
    const url = TDT_API_BASE + '/geocoder?ds=' + java.net.URLEncoder.encode(postStr, 'UTF-8') + '&tk=' + key
    tiandituHttpRequest(url, callback)
}

// v1.7.1: context7 实测（2026-08 服务器端 Key 直测）：v2/search 现支持多 queryType——
// 12=行政区划(specify 必填)、3=周边(pointLonlat+queryRadius，无需 level)、
// 2=视野内(mapBound+level 必填)、1=普通(level+mapBound 必填)。
// v1.5.4 "仅 queryType=12 可用"结论已过时，周边/视野搜索恢复为专用 queryType；
// 缺关键参数时回退 queryType=12 保持可用（向后兼容）
function buildSearchUrl(params: SearchOptions, mode: string): string {
    const key = currentApiKey
    let postJson: string
    if (mode === 'nearby' && params.pointLonlat != null && params.pointLonlat.length > 0) {
        postJson = '{"keyWord":"' + params.keyWord + '","queryType":"3","pointLonlat":"' + params.pointLonlat + '"'
        if (params.queryRadius != null && params.queryRadius.length > 0) {
            postJson += ',"queryRadius":"' + params.queryRadius + '"'
        }
    } else if (mode === 'bounds' && params.mapBound != null && params.mapBound.length > 0) {
        const level = params.level != null && params.level.length > 0 ? params.level : '12'
        postJson = '{"keyWord":"' + params.keyWord + '","queryType":"2","mapBound":"' + params.mapBound + '","level":"' + level + '"'
    } else {
        const specify = params.specifyAdminCode != null && params.specifyAdminCode.length > 0 ? params.specifyAdminCode : '156000000'
        postJson = '{"keyWord":"' + params.keyWord + '","queryType":"12","specify":"' + specify + '"'
    }
    if (params.start != null && params.start.length > 0) {
        postJson += ',"start":"' + params.start + '"'
    }
    if (params.count != null && params.count.length > 0) {
        postJson += ',"count":"' + params.count + '"'
    }
    postJson += '}'
    return TDT_API_BASE + '/v2/search?postStr=' + java.net.URLEncoder.encode(postJson, 'UTF-8') + '&type=query&tk=' + key
}

@UTSJS.keepAlive
export function search(params: SearchOptions, callback: GeocodeCallback): void {
    if (currentApiKey.length == 0) {
        callback(new UTSJSONObject('{"status":"1","msg":"No API Key"}'))
        return
    }
    tiandituHttpRequest(buildSearchUrl(params, 'search'), callback)
}

@UTSJS.keepAlive
export function searchInBounds(params: SearchOptions, callback: GeocodeCallback): void {
    if (currentApiKey.length == 0) {
        callback(new UTSJSONObject('{"status":"1","msg":"No API Key"}'))
        return
    }
    tiandituHttpRequest(buildSearchUrl(params, 'bounds'), callback)
}

@UTSJS.keepAlive
export function searchNearby(params: SearchOptions, callback: GeocodeCallback): void {
    if (currentApiKey.length == 0) {
        callback(new UTSJSONObject('{"status":"1","msg":"No API Key"}'))
        return
    }
    tiandituHttpRequest(buildSearchUrl(params, 'nearby'), callback)
}

// ══════════════════════════════════════════════
// v1.3.0 新增：定位
// ══════════════════════════════════════════════

// context7 验证：MapLibre LocationComponent 需通过 activateLocationComponent 激活
let locationComponentActivated: boolean = false

function activateLocationComponentIfNeeded(): void {
    if (locationComponentActivated) return
    const m = mapLibreMap
    if (m == null) return
    try {
        const lc = m.getLocationComponent()
        const style = m.getStyle()
        if (style == null) {
            console.warn("TDTMap: Style 未加载，跳过 LocationComponent 激活")
            return
        }
        const ctx = mapView?.getContext() as android.content.Context
        if (ctx == null) return

        // 程序化生成定位蓝点（Google Maps 风格：蓝色实心圆 + 白色边框 + 半透明精度圈）
        const density = ctx.getResources().getDisplayMetrics().density
        const dotRadiusPx = (10 * density).toInt()  // 10dp 半径 → 20dp 直径
        const dot = new GradientDrawable()
        dot.setShape(GradientDrawable.OVAL)
        dot.setColor(0xFF4285F4.toInt())           // 蓝色填充
        dot.setStroke((2 * density).toInt(), 0xFFFFFFFF.toInt())  // 白色边框 2dp
        dot.setSize(dotRadiusPx * 2, dotRadiusPx * 2)
        // context7: UTS 无法正确解析 foregroundDrawable(Drawable) 重载，
        // 使用 foregroundDrawable(Int) 加载 drawable 资源，此处改用 foregroundTintColor + 默认图标

        const locOpts = LocationComponentOptions.builder(ctx)
            .foregroundTintColor(0xFF4285F4.toInt())        // 蓝色着色（近似蓝点效果）
            .accuracyAlpha(0.15.toFloat())                   // 精度圈半透明
            .build()

        lc.activateLocationComponent(
            org.maplibre.android.location.LocationComponentActivationOptions
                .builder(ctx, style)
                .locationComponentOptions(locOpts)
                .build()
        )
        locationComponentActivated = true
        console.log("TDTMap: LocationComponent 已激活（含定位蓝点）")
    } catch (e: any) {
        console.error("TDTMap: LocationComponent 激活失败: " + e.message)
    }
}

// v1.5.4: 运行时权限检查 —— Android 6+ 需动态授权，原生 LocationManager 不会自动弹授权框
// （context7 验证：仅 uni.getLocation 等框架 API 会自动弹框，原生 API 必须自建权限流程）
function checkLocationPermission(ctx: Context): boolean {
    const fine = ctx.checkSelfPermission("android.permission.ACCESS_FINE_LOCATION")
    const coarse = ctx.checkSelfPermission("android.permission.ACCESS_COARSE_LOCATION")
    return fine == PackageManager.PERMISSION_GRANTED || coarse == PackageManager.PERMISSION_GRANTED
}

// v1.5.4: 权限申请 —— UTSAndroid.requestSystemPermission 官方 API
// （doc.dcloud.net.cn/uni-app-x/uts/utsandroid.html，Vapor UTS 插件 HBuilderX 5.21+ 支持）
// 签名: requestSystemPermission(activity, permissions, success(allRight, grantedList), fail(doNotAskAgain, grantedList))
function requestLocationPermission(onResult: (granted: boolean) => void): void {
    const act = UTSAndroid.getUniActivity()
    if (act == null) {
        onResult(false)
        return
    }
    let called = false
    const once = (g: boolean): void => {
        if (!called) {
            called = true
            onResult(g)
        }
    }
    UTSAndroid.requestSystemPermission(
        act,
        ["android.permission.ACCESS_FINE_LOCATION", "android.permission.ACCESS_COARSE_LOCATION"],
        (allRight: boolean, grantedList: Array<string>) => {
            // 部分授权时 success 与 fail 均会回调，once 防止重复触发
            once(allRight || grantedList.length > 0)
        },
        (_doNotAskAgain: boolean, grantedList: Array<string>) => {
            once(grantedList.length > 0)
        }
    )
}

export function showUserLocation(enabled: boolean): void {
    const m = mapLibreMap
    if (m == null) {
        const errCb = onErrorCallback
        if (errCb != null) {
            const err: MapErrorDetail = { code: 4, message: "地图未初始化，无法显示定位" }
            errCb(err)
        }
        return
    }
    if (enabled) {
        const ctx = mapView?.getContext()
        if (ctx != null && !checkLocationPermission(ctx)) {
            // v1.5.4: 蓝点激活前必须先获得运行时定位权限（MapLibre LocationComponent 不会自动弹授权框）
            requestLocationPermission((granted: boolean) => {
                if (granted) {
                    activateLocationComponentIfNeeded()
                    setLocationComponentEnabledSafe(m, enabled)
                } else {
                    const errCb2 = onErrorCallback
                    if (errCb2 != null) {
                        const err2: MapErrorDetail = { code: 4, message: "用户拒绝了定位权限，无法显示定位蓝点" }
                        errCb2(err2)
                    }
                }
            })
            return
        }
        activateLocationComponentIfNeeded()
    }
    setLocationComponentEnabledSafe(m, enabled)
}

function setLocationComponentEnabledSafe(m: MapLibreMap, enabled: boolean): void {
    try {
        const lc = m.getLocationComponent()
        lc.setLocationComponentEnabled(enabled)
    } catch (e: any) {
        console.error("TDTMap: showUserLocation 失败: " + e.message)
        const errCb2 = onErrorCallback
        if (errCb2 != null) {
            const err2: MapErrorDetail = { code: 4, message: "定位显示失败: " + e.message }
            errCb2(err2)
        }
    }
}

// context7 验证：Android LocationManager.getLastKnownLocation 同步获取缓存，requestSingleUpdate 异步单次定位
// 增加 10 秒超时机制，防止 GPS 关闭时回调永不触发
@UTSJS.keepAlive
export function getUserLocation(callback: (detail: MapClickDetail) => void, onError?: (err: MapErrorDetail) => void): void {
    const ctx = mapView?.getContext()
    if (ctx == null) {
        if (onError != null) {
            const err: MapErrorDetail = { code: 4, message: "获取 Context 失败" }
            onError(err)
        }
        return
    }
    // v1.5.4: 无权限先申请（授权成功回调中继续定位），修复“点击定位按钮无反应”——
    // 此前无权限时 LocationManager 静默失败/抛 SecurityException，仅 console.error 用户无感知
    if (!checkLocationPermission(ctx)) {
        requestLocationPermission((granted: boolean) => {
            if (granted) {
                doGetLocationInternal(ctx, callback, onError)
            } else {
                const err: MapErrorDetail = { code: 4, message: "用户拒绝了定位权限，请到系统设置中开启" }
                if (onError != null) {
                    onError(err)
                } else {
                    // v1.5.4: onErrorCallback 是可变全局属性，Kotlin 不允许 smart cast 后直接调用，先拷贝到局部变量
                    const errCb = onErrorCallback
                    if (errCb != null) {
                        errCb(err)
                    }
                }
            }
        })
        return
    }
    doGetLocationInternal(ctx, callback, onError)
}

// 实际定位执行：provider 状态检测 → 缓存位置 → GPS/网络双通道单次更新（先回先得）
function doGetLocationInternal(ctx: Context, callback: (detail: MapClickDetail) => void, onError?: (err: MapErrorDetail) => void): void {
    try {
        const lm = ctx.getSystemService(Context.LOCATION_SERVICE) as LocationManager
        // v1.5.4: 定位服务总开关检测，双 provider 均关闭时立即报错（不再干等 10 秒超时）
        const gpsOn = lm.isProviderEnabled(LocationManager.GPS_PROVIDER)
        const netOn = lm.isProviderEnabled(LocationManager.NETWORK_PROVIDER)
        if (!gpsOn && !netOn) {
            const err: MapErrorDetail = { code: 4, message: "系统定位服务未开启，请打开定位开关" }
            if (onError != null) {
                onError(err)
            } else {
                const errCb = onErrorCallback
                if (errCb != null) {
                    errCb(err)
                }
            }
            return
        }
        // 先尝试获取最后已知位置（同步、快速）
        let loc = lm.getLastKnownLocation(LocationManager.GPS_PROVIDER)
        if (loc == null) {
            loc = lm.getLastKnownLocation(LocationManager.NETWORK_PROVIDER)
        }
        if (loc != null) {
            const detail: MapClickDetail = { lat: loc.getLatitude(), lng: loc.getLongitude() }
            callback(detail)
            return
        }
        // 无缓存位置，请求单次更新（10 秒超时）
        // UTS 内置 setTimeout/clearTimeout 实现超时（避免 java.lang.Runnable 匿名类）
        let finished = false
        let listener: android.location.LocationListener | null = null
        const timerId = setTimeout(() => {
            if (!finished) {
                finished = true
                const captured = listener
                if (captured != null) {
                    lm.removeUpdates(captured)
                }
                // 避免 ?? 运算符在函数类型上导致 UTS 类型混淆，
                // 分别检查 onError 和 onErrorCallback
                if (onError != null) {
                    const toErr: MapErrorDetail = { code: 4, message: "获取定位超时（10s），请检查 GPS 是否开启" }
                    onError(toErr)
                } else {
                    const errCb = onErrorCallback
                    if (errCb != null) {
                        const toErr2: MapErrorDetail = { code: 4, message: "获取定位超时（10s），请检查 GPS 是否开启" }
                        errCb(toErr2)
                    }
                }
            }
        }, 10000)
        // context7 + UTS 官方文档验证：实现 Java 接口的匿名类语法为 new (class implements Xxx {...})，
        // 对象字面量方式（new Xxx({...})）会生成 UTSJSONObject 导致 Kotlin SAM 编译失败。
        // 实现全部 4 个方法，兼容 API 21-29（onProviderDisabled 等方法自 API 30 起才有默认实现）
        listener = new (class implements android.location.LocationListener {
            override onLocationChanged(loc: android.location.Location): void {
                if (finished) return
                finished = true
                clearTimeout(timerId)
                const captured = listener
                if (captured != null) {
                    lm.removeUpdates(captured)
                }
                const detail: MapClickDetail = { lat: loc.getLatitude(), lng: loc.getLongitude() }
                callback(detail)
            }
            override onProviderDisabled(provider: string): void {
                console.warn("TDTMap: provider disabled: " + provider)
            }
            override onProviderEnabled(provider: string): void {
            }
            // context7 + UTS 官方文档验证（uts-for-android.html）：实现 Java 接口时，
            // 当原生 API 明确要求特定类型（int），可直接使用原生 Int 类型保证签名匹配；
            // 使用 number 会生成 Kotlin Number 导致 override 失败（'overrides nothing'）。
            override onStatusChanged(provider: string, status: Int, extras: android.os.Bundle): void {
            }
        })
        // v1.5.4: GPS 与网络双通道并发单次更新（先回先得）——
        // 仅请求 GPS 时，室内/无星历环境下冷启动可能数分钟无回调，网络定位 1-3 秒内可返回
        if (gpsOn) {
            lm.requestSingleUpdate(LocationManager.GPS_PROVIDER, listener, null)
        }
        if (netOn) {
            lm.requestSingleUpdate(LocationManager.NETWORK_PROVIDER, listener, null)
        }
    } catch (e: any) {
        console.error("TDTMap: getUserLocation 失败: " + e.message)
        if (onError != null) {
            const err: MapErrorDetail = { code: 4, message: "获取定位失败: " + e.message }
            onError(err)
        }
    }
}

// ══════════════════════════════════════════════
// v1.3.0 新增：信息窗口
// ══════════════════════════════════════════════

// context7 验证：Android 废弃 Marker API 支持 showInfoWindow(MapLibreMap, MapView)
export function showMarkerInfo(id: number): void {
    const entry = overlayMap.get(id)
    if (entry == null) return
    if (entry.type == 'marker' || entry.type == 'label') {
        const mk = entry.nativeRef as Marker
        const mm = mapLibreMap
        const mv = mapView
        if (mm == null || mv == null) {
            console.warn("TDTMap: showMarkerInfo - 地图未就绪")
            return
        }
        try {
            mk.showInfoWindow(mm, mv)
        } catch (e: any) {
            console.error("TDTMap: showMarkerInfo 失败: " + e.message)
        }
    }
}

export function hideMarkerInfo(id: number): void {
    const entry = overlayMap.get(id)
    if (entry == null) return
    if (entry.type == 'marker' || entry.type == 'label') {
        const mk = entry.nativeRef as Marker
        try {
            mk.hideInfoWindow()
        } catch (e: any) {
            console.error("TDTMap: hideMarkerInfo 失败: " + e.message)
        }
    }
}

// ════════════════════════════════════════════
// v1.9.0 新增：图片覆盖物（ImageOverlay）
// ImageSource+RasterLayer（style 层系）｜URL 直载 / 本机路径 io 线程两段解码｜几何 hit-test 点击
// ════════════════════════════════════════════

// ── 图片覆盖物几何工具（Android/iOS/Web 三端同版纯函数，修改须三端同步；POC 浏览器实测验证） ──

// zIndex 档位键：未定义=置顶组(1e6) / 正整数=按值排序 / 0 及以下=贴底组(-1)（对齐 TileLayerOptions 三档约定）
function imageOverlayZKey(z: number | null): number {
    if (z == null) return 1000000
    if (z <= 0) return -1
    return z
}

// Web Mercator 正投影：x=经度，y=墨卡托 Y（避免高纬度经纬直接旋转形变）
function mercatorY(lat: number): number {
    const rad = lat * Math.PI / 180.0
    return Math.log(Math.tan(Math.PI / 4.0 + rad / 2.0))
}
function inverseMercatorY(y: number): number {
    return (2.0 * Math.atan(Math.exp(y)) - Math.PI / 2.0) * 180.0 / Math.PI
}

// 计算图片四角坐标（官方顺序：左上/右上/右下/左下，[lng,lat] 对）；bearing≠0 时在 Mercator 平面绕中心顺时针旋转
function computeImageQuad(sw: MapClickDetail, ne: MapClickDetail, bearing: number): Array<Array<number>> {
    const corners: Array<Array<number>> = [
        [sw.lng, ne.lat],
        [ne.lng, ne.lat],
        [ne.lng, sw.lat],
        [sw.lng, sw.lat]
    ]
    if (bearing == 0) return corners
    const rad = -bearing * Math.PI / 180.0
    const cx = (sw.lng + ne.lng) / 2.0
    const cyM = (mercatorY(sw.lat) + mercatorY(ne.lat)) / 2.0
    const out: Array<Array<number>> = []
    for (let i = 0; i < 4; i++) {
        const x = corners[i][0] - cx
        const y = mercatorY(corners[i][1]) - cyM
        const rx = x * Math.cos(rad) - y * Math.sin(rad)
        const ry = x * Math.sin(rad) + y * Math.cos(rad)
        out.push([cx + rx, inverseMercatorY(cyM + ry)])
    }
    return out
}

// 点击命中检测：点击点正向旋转回未旋转 bounds 坐标系后与轴对齐半宽半高比较（与 computeImageQuad 互逆）
function hitTestImageOverlay(lat: number, lng: number, params: ImageOverlayOptions): boolean {
    const sw = params.southwest
    const ne = params.northeast
    const bearing = params.bearing ?? 0
    if (bearing == 0) {
        return lat >= sw.lat && lat <= ne.lat && lng >= sw.lng && lng <= ne.lng
    }
    const rad = bearing * Math.PI / 180.0
    const cx = (sw.lng + ne.lng) / 2.0
    const cyM = (mercatorY(sw.lat) + mercatorY(ne.lat)) / 2.0
    const x = lng - cx
    const y = mercatorY(lat) - cyM
    const rx = x * Math.cos(rad) - y * Math.sin(rad)
    const ry = x * Math.sin(rad) + y * Math.cos(rad)
    const halfW = (ne.lng - sw.lng) / 2.0
    const halfH = (mercatorY(ne.lat) - mercatorY(sw.lat)) / 2.0
    return Math.abs(rx) <= halfW && Math.abs(ry) <= halfH
}

// 四角数组 → MapLibre LatLngQuad（构造参数为 4 个 LatLng，顺序同 GL JS image source：nw/ne/se/sw。
// 编译期验证项：LatLngQuad(LatLng...) vararg 在 UTS→Kotlin 下 4 参调用；若编译失败改 arrayOf 传参）
function buildLatLngQuad(quad: Array<Array<number>>): LatLngQuad {
    return new LatLngQuad(
        new LatLng(quad[0][1].toDouble(), quad[0][0].toDouble()),
        new LatLng(quad[1][1].toDouble(), quad[1][0].toDouble()),
        new LatLng(quad[2][1].toDouble(), quad[2][0].toDouble()),
        new LatLng(quad[3][1].toDouble(), quad[3][0].toDouble())
    )
}

// 两段解码：先 inJustDecodeBounds 取尺寸，最长边超限时 inSampleSize 下采样（防大图 OOM；
// 官方算法：https://developer.android.com/topic/performance/graphics/load-bitmap）
function decodeSampledBitmapFromFile(path: string, maxDim: number): any | null {
    try {
        const bounds = new BitmapFactory.Options()
        bounds.inJustDecodeBounds = true
        BitmapFactory.decodeFile(path, bounds)
        let sample = 1
        let w = bounds.outWidth * 1.0
        let h = bounds.outHeight * 1.0
        while (h / (2.0 * sample) >= maxDim || w / (2.0 * sample) >= maxDim) {
            sample = sample * 2
        }
        const opts = new BitmapFactory.Options()
        opts.inSampleSize = sample.toInt()
        return BitmapFactory.decodeFile(path, opts)
    } catch (e: any) {
        console.error("TDTMap: 图片解码失败: " + e.message)
        return null
    }
}

// 在现有图片层中找渲染序在 newKey 之上的第一个层（beforeId 语义）；空串表示追加置顶。
// Android Style.getLayers() 返回 java List，需 Array.fromNative 转换（与 queryRenderedFeatures 同坑）
function imageOverlayBeforeLayerIdAndroid(style: Style, newKey: number, excludeId: number): string {
    const layersRaw = style.getLayers()
    if (layersRaw == null) return ''
    const layers = Array.fromNative(layersRaw)
    for (let j = 0; j < layers.length; j++) {
        const lid = (layers[j] as Layer).getId() as string
        for (let i = 0; i < imageOverlayIds.length; i++) {
            const oid = imageOverlayIds[i]
            if (oid == excludeId) continue
            const info = imageOverlayExt.get(oid)
            if (info == null) continue
            if ((info.layer as Layer).getId() == lid) {
                if (imageOverlayZKey(info.params.zIndex ?? null) > newKey) return lid
                break
            }
        }
    }
    return ''
}

// 返回渲染序最靠前（最下方）的其他图片层 layerId；空串表示无（zIndex=0 无注记层时的降级锚点，与 Web 端一致）
function lowestImageLayerIdAndroid(style: Style, excludeId: number): string {
    const layersRaw = style.getLayers()
    if (layersRaw == null) return ''
    const layers = Array.fromNative(layersRaw)
    for (let j = 0; j < layers.length; j++) {
        const lid = (layers[j] as Layer).getId() as string
        for (let i = 0; i < imageOverlayIds.length; i++) {
            const oid = imageOverlayIds[i]
            if (oid == excludeId) continue
            const info = imageOverlayExt.get(oid)
            if (info == null) continue
            if ((info.layer as Layer).getId() == lid) return lid
        }
    }
    return ''
}

// zIndex 三档插入：0 及以下=注记层之下（缺失降级图片层最下）/ 未定义=置顶 / 正整数=按档位插入
function placeImageLayerByZIndex(style: Style, layer: RasterLayer, z: number | null, excludeId: number): void {
    if (z != null && z <= 0) {
        if (style.getLayer("tdt-label-layer") != null) {
            style.addLayerBelow(layer, "tdt-label-layer")
        } else if (currentMapType == 'blank') {
            // v1.9.1: blank 白底无注记层——插到首个非背景层之下（用户矢量层之底）；
            // 无用户层时置顶（后续用户层 append 仍会盖其上），保证 zIndex<=0 图层恒在矢量层之下
            const layersAll = style.getLayers()
            if (layersAll != null) {
                const all = Array.fromNative(layersAll)
                for (let j = 0; j < all.length; j++) {
                    const lid = (all[j] as Layer).getId() as string
                    if (lid == 'tdt-bg') continue
                    style.addLayerBelow(layer, lid)
                    return
                }
            }
            style.addLayer(layer)
        } else {
            const lowestId = lowestImageLayerIdAndroid(style, excludeId)
            if (lowestId.length > 0) {
                style.addLayerBelow(layer, lowestId)
            } else {
                style.addLayer(layer)
            }
            console.warn("TDTMap: 图片覆盖物 zIndex=0 但当前样式无注记层，已按图片层最下处理")
        }
        return
    }
    const beforeId = imageOverlayBeforeLayerIdAndroid(style, imageOverlayZKey(z), excludeId)
    if (beforeId.length > 0) {
        style.addLayerBelow(layer, beforeId)
    } else {
        style.addLayer(layer)
    }
}

// 创建 source+layer 挂载到 style 并回填状态；bitmap=null 且为 http(s) 时由 MapLibre 内部异步加载（不自行下载）
// 挂载前置条件：overlayMap 已有该 ID 的 entry（预分配或重放时重建）；失败由调用方上报
function attachImageOverlayToStyle(id: number, params: ImageOverlayOptions, style: Style, bitmap: any | null): boolean {
    const sourceId = "img-overlay-src-" + id
    const layerId = "img-overlay-layer-" + id
    const quad = buildLatLngQuad(computeImageQuad(params.southwest, params.northeast, params.bearing ?? 0))
    let source: ImageSource
    if (bitmap != null) {
        source = new ImageSource(sourceId, quad, bitmap as Bitmap)
    } else {
        // URL 直载：new URL(String) 对非法地址抛 MalformedURLException，由外层调用方 catch 上报
        source = new ImageSource(sourceId, quad, new URL(params.image))
    }
    style.addSource(source)
    const layer = new RasterLayer(layerId, sourceId)
    layer.setProperties(PropertyFactory.rasterOpacity((1.0 - (params.transparency ?? 0)).toFloat()))
    const visible = params.visible ?? true
    if (!visible) {
        layer.setProperties(PropertyFactory.visibility(Property.NONE))
    }
    placeImageLayerByZIndex(style, layer, params.zIndex, id)
    imageOverlayExt.set(id, { source: source, layer: layer, params: params, bitmap: bitmap })
    const entry = overlayMap.get(id)
    if (entry != null) {
        entry.nativeRef = { source: source, layer: layer }
        entry.isVisible = visible
    }
    if (imageOverlayIds.indexOf(id) < 0) {
        imageOverlayIds.push(id)
    }
    return true
}

// 本机路径解码管线：io 线程两段解码 → 主线程回填（UTSAndroid.getDispatcher 官方线程调度，
// uts-for-android.md §2.4）。updateMode=true 时仅 setBitmap 换图不重建图层。
// 竞态防护：回调时校验 entry 仍在 overlayMap（clear/destroy/remove 后丢弃）
function decodeLocalBitmapForOverlay(id: number, params: ImageOverlayOptions, updateMode: boolean): void {
    // dispatcher.async 回调签名为 (Any?) -> Unit：参数须可空 any|null，且第二参数（同步回调）传 null（官方 utsandroid.md 示例）
    UTSAndroid.getDispatcher("io").async(function(_: any | null) {
        const bmp = decodeSampledBitmapFromFile(params.image, IMAGE_OVERLAY_MAX_DIM)
        UTSAndroid.getDispatcher("main").async(function(_: any | null) {
            const entry = overlayMap.get(id)
            if (entry == null) {
                if (bmp != null) (bmp as Bitmap).recycle()
                return
            }
            if (bmp == null) {
                const errCb = onErrorCallback
                if (errCb != null) {
                    errCb({ code: 4, message: "图片解码失败（路径不存在或非图片）: " + params.image })
                }
                if (!updateMode) overlayMap.delete(id)
                return
            }
            if (updateMode) {
                const ext = imageOverlayExt.get(id)
                if (ext != null && entry.nativeRef != null) {
                    // maplibre 11.x ImageSource 无 setBitmap，换图 API 为 setImage(Bitmap)
                    ((entry.nativeRef as ImageOverlayExt).source as ImageSource).setImage(bmp as Bitmap)
                    ext.bitmap = bmp
                } else {
                    (bmp as Bitmap).recycle()
                }
                return
            }
            const m = mapLibreMap
            const style = m?.getStyle()
            if (style == null) {
                const errCb2 = onErrorCallback
                if (errCb2 != null) {
                    errCb2({ code: 4, message: "样式未加载，无法添加图片覆盖物" })
                }
                if (!updateMode) {
                    overlayMap.delete(id)
                }
                if (bmp != null) {
                    (bmp as Bitmap).recycle()
                }
                return
            }
            attachImageOverlayToStyle(id, params, style!, bmp)
        }, null)
    }, null)
}

// v1.9.0: 清除全部图片覆盖物（供 clearOverlays/样式重建调用；style 为空时仅清状态）
function clearImageOverlaysInternal(): void {
    const style = mapLibreMap?.getStyle()
    for (let i = 0; i < imageOverlayIds.length; i++) {
        const id = imageOverlayIds[i]
        const ext = imageOverlayExt.get(id)
        if (ext != null && style != null) {
            try {
                style.removeLayer(ext.layer as RasterLayer)
                style.removeSource(ext.source as ImageSource)
            } catch (e: any) {
                console.error("TDTMap: clearImageOverlays 移除失败: " + e.message)
            }
        }
        overlayMap.delete(id)
        imageOverlayExt.delete(id)
    }
    imageOverlayIds = []
}

export function addImageOverlay(params: ImageOverlayOptions): number {
    const m = mapLibreMap
    const style = m?.getStyle()
    if (style == null) {
        const errCb = onErrorCallback
        if (errCb != null) {
            errCb({ code: 4, message: "样式未加载，无法添加图片覆盖物" })
        }
        return 0
    }
    // 预分配 ID（本机路径场景 nativeRef 先置空，解码完成后回填——对齐鸿蒙 addMarker 先例）
    const id = allocateOverlayId('image', null)
    const isHttp = params.image.indexOf("http://") == 0 || params.image.indexOf("https://") == 0
    try {
        if (isHttp) {
            attachImageOverlayToStyle(id, params, style, null)
        } else {
            // 本机路径：io 线程解码，回调时校验 entry 仍在（remove/clear 竞态防护）
            decodeLocalBitmapForOverlay(id, params, false)
        }
    } catch (e: any) {
        console.error("TDTMap: addImageOverlay 失败: " + e.message)
        overlayMap.delete(id)
        const errCb2 = onErrorCallback
        if (errCb2 != null) {
            errCb2({ code: 2, message: "添加图片覆盖物失败: " + e.message })
        }
        return 0
    }
    return id
}

export function updateImageOverlay(id: number, changes: ImageOverlayUpdateOptions): void {
    const entry = overlayMap.get(id)
    const ext = imageOverlayExt.get(id)
    const m = mapLibreMap
    if (entry == null || ext == null || m == null) return
    if (entry.nativeRef == null) {
        console.warn("TDTMap: updateImageOverlay - 图片加载中，本次更新已忽略")
        return
    }
    const p = ext.params
    const oldZ = p.zIndex ?? null
    // 合并变更（未传字段保持不变）
    if (changes.southwest != null) p.southwest = changes.southwest
    if (changes.northeast != null) p.northeast = changes.northeast
    if (changes.image != null) p.image = changes.image
    if (changes.transparency != null) p.transparency = changes.transparency
    if (changes.zIndex != null) p.zIndex = changes.zIndex
    if (changes.bearing != null) p.bearing = changes.bearing
    if (changes.visible != null) p.visible = changes.visible
    if (changes.clickable != null) p.clickable = changes.clickable
    try {
        const nRef = entry.nativeRef as ImageOverlayExt
        const src = nRef.source as ImageSource
        const layer = nRef.layer as RasterLayer
        // 范围/旋转变化：setCoordinates 官方 API；换图：URL 直设或本机路径重新解码后 setBitmap
        if (changes.southwest != null || changes.northeast != null || changes.bearing != null || changes.image != null) {
            if (changes.image != null
                && !(p.image.indexOf("http://") == 0 || p.image.indexOf("https://") == 0)) {
                decodeLocalBitmapForOverlay(id, p, true)
            } else {
                src.setCoordinates(buildLatLngQuad(computeImageQuad(p.southwest, p.northeast, p.bearing ?? 0)))
                if (changes.image != null) {
                    src.setUrl(new URL(p.image))
                }
            }
        }
        if (changes.transparency != null) {
            layer.setProperties(PropertyFactory.rasterOpacity((1.0 - (p.transparency ?? 0)).toFloat()))
        }
        if (changes.visible != null) {
            const visible = p.visible != false
            layer.setProperties(PropertyFactory.visibility(visible ? Property.VISIBLE : Property.NONE))
            entry.isVisible = visible
        }
        // zIndex 档位变化：Android Style 无 moveLayer，removeLayer 后按新档位重插（同一 layer 对象可复用）
        if (changes.zIndex != null && imageOverlayZKey(p.zIndex ?? null) != imageOverlayZKey(oldZ)) {
            const style = m.getStyle()
            if (style != null) {
                try { style.removeLayer(layer) } catch (e3: any) { /* 新样式无该层时容忍 */ }
                placeImageLayerByZIndex(style, layer, p.zIndex, id)
            }
        }
    } catch (e: any) {
        console.error("TDTMap: updateImageOverlay 失败: " + e.message)
        const errCb = onErrorCallback
        if (errCb != null) {
            errCb({ code: 4, message: "更新图片覆盖物失败: " + e.message })
        }
    }
}

export function setImageOverlayClickCallback(callback: ImageOverlayClickCallback | null): void {
    // 仅更新回调引用；命中检测在 initMap 注册的单一 OnMapClickListener Priority 链内执行（不重复注册监听器）
    imageOverlayClickCallback = callback
}

// ══════════════════════════════════════════════
// v1.9.0 新增：E0 GeoJSON 层重放通知
// ══════════════════════════════════════════════

// GeoJSON 层快照与编排逻辑在组件层（tdt-map.uvue）；原生层在 rebuildUserLayersAfterStyle
// 末尾触发本回调，通知组件层按快照重放已注册的 GeoJSON 层（仿图片覆盖物"快照→样式就绪→重建"模式）
let geoJsonReplayCallback: GeoJsonReplayCallback | null = null

@UTSJS.keepAlive
export function setGeoJsonReplayCallback(callback: GeoJsonReplayCallback | null): void {
    geoJsonReplayCallback = callback
}

// ══════════════════════════════════════════════
// v1.3.0 新增：自定义瓦片图层
// ══════════════════════════════════════════════

// context7 验证：MapLibre RasterSource + RasterLayer 支持外部 XYZ 瓦片
type CustomTileEntry = { source: any, layer: any, tileUrl: string, options: TileLayerOptions }
let customTileSources = new Map<string, CustomTileEntry>()
// 样式重建重放快照（any 元素上点访问会报"找不到名称"，用显式 type 承接）
type SavedCustomTile = { id: string, entry: CustomTileEntry }
// 图片覆盖物样式重建重放快照（同上，显式 type 承接）
type SavedImageOverlay = { id: number, params: ImageOverlayOptions, bitmap: any | null, visible: boolean }
// v1.8.0: 平行数组存 key 顺序（重建按添加顺序重放）
let customTileLayerIds: Array<string> = []
// v1.8.0: 聚合/热力数据快照 + 自定义样式激活标记
let clusterDataRef: Array<MapClickDetail> | null = null
let clusterOptionsRef: ClusterOptions | null = null
let heatmapDataRef: Array<HeatmapItem> | null = null
let heatmapOptionsRef: HeatmapOptions | null = null
let customStyleActive = false

export function addCustomTileLayer(id: string, tileUrl: string, options?: TileLayerOptions): void {
    const style = mapLibreMap?.getStyle()
    if (style == null) {
        const errCb = onErrorCallback
        if (errCb != null) {
            errCb({ code: 4, message: "样式未加载，无法添加瓦片图层" })
        }
        return
    }
    // 若已存在同 ID 图层，先移除旧层
    removeCustomTileLayer(id)
    try {
        // context7 验证：RasterSource(String, String, int) 第二个参数是 URI（URL 模板），非 inline JSON
        const source = new RasterSource(id, tileUrl, 256)
        style.addSource(source)
        const layer = new RasterLayer(id + "-layer", id)
        // v1.8.0: options 应用。PropertyFactory.rasterOpacity(Float) / Layer.setMinZoom(float) /
        // Layer.setMaxZoom(float) 签名均为 float（maplibre-native 官方 Layer.java / PropertyFactory.java），
        // 与现有 circleRadius/heatmapRadius 一致用 toFloat() 转换
        if (options != null) {
            if (options.opacity != null) {
                layer.setProperties(PropertyFactory.rasterOpacity(options.opacity.toFloat()))
            }
            if (options.minZoom != null) {
                layer.setMinZoom(options.minZoom.toFloat())
            }
            if (options.maxZoom != null) {
                layer.setMaxZoom(options.maxZoom.toFloat())
            }
        }
        if (options != null && options.zIndex == 0) {
            // zIndex=0: 插到天地图注记层之下（底图之上）。Style.addLayerBelow(Layer, String) 官方 API
            // v1.8.0 审查修复：自定义样式可能无注记层，addLayerBelow 对缺失引用层抛异常导致静默丢层，
            // 先判存在再插入，否则回退默认置顶（与 Web 端 getLayer 回退逻辑一致）
            if (style.getLayer("tdt-label-layer") != null) {
                style.addLayerBelow(layer, "tdt-label-layer")
            } else {
                style.addLayer(layer)
                console.warn("TDTMap: zIndex=0 但当前样式无注记层，已按默认置顶处理")
            }
        } else {
            style.addLayer(layer)
            if (options != null && options.zIndex != null && options.zIndex != 0) {
                console.warn("TDTMap: zIndex 仅支持 0（贴底）与 undefined（置顶），当前值已忽略")
            }
        }
        customTileSources.set(id, { source: source, layer: layer, tileUrl: tileUrl, options: options ?? {} })
        customTileLayerIds.push(id)
    } catch (e: any) {
        console.error("TDTMap: addCustomTileLayer 失败: " + e.message)
        const errCb2 = onErrorCallback
        if (errCb2 != null) {
            errCb2({ code: 4, message: "添加瓦片图层失败: " + e.message })
        }
    }
}

export function removeCustomTileLayer(id: string): void {
    const entry = customTileSources.get(id)
    if (entry == null) return
    const style = mapLibreMap?.getStyle()
    if (style != null) {
        try {
            style.removeLayer(entry.layer as RasterLayer)
            style.removeSource(entry.source as RasterSource)
        } catch (e: any) {
            console.error("TDTMap: removeCustomTileLayer 失败: " + e.message)
        }
    }
    customTileSources.delete(id)
    // v1.8.0: 同步清理平行数组（重建顺序依据）
    const newIds: Array<string> = []
    for (let i = 0; i < customTileLayerIds.length; i++) {
        if (customTileLayerIds[i] != id) newIds.push(customTileLayerIds[i])
    }
    customTileLayerIds = newIds
}

// ══════════════════════════════════════════════
// v1.8.0 新增：WMS / 样式切换 / canvas 探测（图层增强）
// ══════════════════════════════════════════════

// context7 验证：{bbox-epsg-3857} 为 MapLibre style spec 标准占位符（style spec 官方 + 天地图官方文档确认）
function buildWmsTileUrl(wmsUrl: string, layers: string): string {
    const sep = wmsUrl.indexOf('?') >= 0 ? '&' : '?'
    return wmsUrl + sep + 'SERVICE=WMS&REQUEST=GetMap&VERSION=1.1.1&LAYERS=' + layers +
        '&STYLES=&FORMAT=image/png&TRANSPARENT=true&SRS=EPSG:3857&BBOX={bbox-epsg-3857}&WIDTH=256&HEIGHT=256'
}

export function addWMSTileLayer(id: string, wmsUrl: string, layers: string, options?: TileLayerOptions): void {
    addCustomTileLayer(id, buildWmsTileUrl(wmsUrl, layers), options)
}

// v1.8.0: 样式切换后重建用户数据图层（按添加顺序重放）
function rebuildUserLayersAfterStyle(): void {
    const ids = customTileLayerIds.slice()
    customTileLayerIds = []
    const saved: Array<SavedCustomTile> = []
    for (let i = 0; i < ids.length; i++) {
        const e = customTileSources.get(ids[i])
        if (e != null) saved.push({ id: ids[i], entry: e })
    }
    customTileSources.clear()
    for (let i = 0; i < saved.length; i++) {
        addCustomTileLayer(saved[i].id, saved[i].entry.tileUrl, saved[i].entry.options)
    }
    if (clusterDataRef != null) {
        const pts = clusterDataRef!
        const opts = clusterOptionsRef
        clusterDataRef = null
        clusterOptionsRef = null
        addMarkerCluster(pts, opts)
    }
    if (heatmapDataRef != null) {
        const pts = heatmapDataRef!
        const opts = heatmapOptionsRef
        heatmapDataRef = null
        heatmapOptionsRef = null
        addHeatmap(pts, opts)
    }
    // v1.9.0: 图片覆盖物重放（本机解码的复用持有位图不重新解码；URL 的交给 MapLibre 内部重新加载）
    if (imageOverlayIds.length > 0) {
        const savedImgs: Array<SavedImageOverlay> = []
        for (let i = 0; i < imageOverlayIds.length; i++) {
            const oid = imageOverlayIds[i]
            const ext = imageOverlayExt.get(oid)
            const entry0 = overlayMap.get(oid)
            if (ext != null) {
                savedImgs.push({ id: oid, params: ext.params, bitmap: ext.bitmap, visible: entry0 != null ? entry0.isVisible : true })
            }
        }
        imageOverlayExt.clear()
        imageOverlayIds = []
        const st2 = mapLibreMap?.getStyle()
        if (st2 != null) {
            for (let i = 0; i < savedImgs.length; i++) {
                const oid = savedImgs[i].id
                // 重建 entry（保持原 ID 与添加顺序；nativeRef 由 attach 回填）
                overlayMap.set(oid, { id: oid, type: 'image', nativeRef: null, isVisible: true })
                try {
                    attachImageOverlayToStyle(oid, savedImgs[i].params, st2, savedImgs[i].bitmap)
                    // 恢复重建前的可见性（hide 过的不能因重建而复现）
                    const snapVisible = savedImgs[i].visible
                    const entry2 = overlayMap.get(oid)
                    if (!snapVisible && entry2 != null && entry2.nativeRef != null) {
                        ((entry2.nativeRef as ImageOverlayExt).layer as RasterLayer).setProperties(PropertyFactory.visibility(Property.NONE))
                        entry2.isVisible = false
                    }
                } catch (e: any) {
                    console.error("TDTMap: 图片覆盖物重建失败 id=" + oid + ": " + e.message)
                    overlayMap.delete(oid)
                }
            }
        }
    }
    // v1.9.0: E0 GeoJSON 层重放通知（组件层持有 geojson/options 快照与编排逻辑，原生层只负责通知时机）
    const replayCb = geoJsonReplayCallback
    if (replayCb != null) {
        replayCb()
    }
}

export function setStyle(styleJson: string): void {
    const m = mapLibreMap
    if (m == null) return
    // 前置校验：必须含 version 字段，防止解析失败导致地图空白
    if (styleJson.indexOf('"version"') < 0) {
        console.error("TDTMap: setStyle 拒绝：JSON 缺少 version 字段")
        const errCb = onErrorCallback
        if (errCb != null) {
            errCb({ code: 4, message: "setStyle 需为含 version 字段的 MapLibre Style Spec JSON" })
        }
        return
    }
    customStyleActive = true
    // context7: 与 switchMapType 同款重建模式（现有代码已验证）；Style.Builder.fromJson 官方 API
    // v1.8.0 审查修复：fromJson 同步解析非法 JSON 会抛异常（含 "version" 子串不能保证合法），
    // try/catch 防御并回滚 customStyleActive（与 Web 端 JSON.parse 防御对称）
    try {
        m.setStyle(new Style.Builder().fromJson(styleJson), (style: Style) => {
            rebuildUserLayersAfterStyle()
        })
    } catch (e: any) {
        customStyleActive = false
        console.error("TDTMap: setStyle 解析失败: " + e.message)
        const errCb2 = onErrorCallback
        if (errCb2 != null) {
            errCb2({ code: 4, message: "setStyle 解析失败: " + e.message })
        }
    }
}

export function removeStyle(): void {
    const m = mapLibreMap
    if (m == null) return
    if (!customStyleActive) return
    customStyleActive = false
    m.setStyle(new Style.Builder().fromJson(buildTiandituStyleJson(currentApiKey, currentMapType)), (style: Style) => {
        rebuildUserLayersAfterStyle()
    })
}

export function isSupportCanvas(): boolean {
    return false
}

// ══════════════════════════════════════════════
// v1.4.0 新增：地图交互增强
// ══════════════════════════════════════════════

// context7 验证：setMapLongClickCallback 存储回调（实际监听在 initMap 中注册）
@UTSJS.keepAlive
export function setMapLongClickCallback(callback: MapLongClickCallback): void {
    console.log("TDTMap: [DIAG] 长按回调注册（组件→UTS 桥接正常）")
    mapLongClickCallback = callback
}

// context7 验证：CameraPosition.Builder().bearing() 设置旋转角度（0=正北，顺时针）
export function setBearing(bearing: number): void {
    const m = mapLibreMap
    if (m != null) {
        const pos = m.getCameraPosition()
        if (pos != null) {
            const target = pos.target
            if (target != null) {
                m.moveCamera(CameraUpdateFactory.newCameraPosition(
                    new CameraPosition.Builder()
                        .target(target)
                        .zoom(pos.zoom)
                        .bearing(bearing.toDouble())
                        .tilt(pos.tilt)
                        .build()
                ))
            }
        }
    }
}

// context7 验证：CameraPosition.Builder().tilt() 设置倾斜角度（0=垂直俯瞰）
export function setTilt(tilt: number): void {
    const m = mapLibreMap
    if (m != null) {
        const pos = m.getCameraPosition()
        if (pos != null) {
            const target = pos.target
            if (target != null) {
                m.moveCamera(CameraUpdateFactory.newCameraPosition(
                    new CameraPosition.Builder()
                        .target(target)
                        .zoom(pos.zoom)
                        .bearing(pos.bearing)
                        .tilt(tilt.toDouble())
                        .build()
                ))
            }
        }
    }
}

export function getBearing(): number {
    const m = mapLibreMap
    if (m != null) {
        const pos = m.getCameraPosition()
        if (pos != null) return pos.bearing
    }
    return 0
}

export function getTilt(): number {
    const m = mapLibreMap
    if (m != null) {
        const pos = m.getCameraPosition()
        if (pos != null) return pos.tilt
    }
    return 0
}

// context7 验证：uiSettings.setRotateGesturesEnabled 控制双指旋转手势
export function enableRotate(enabled: boolean): void {
    const uiSettings = mapLibreMap?.getUiSettings()
    if (uiSettings != null) {
        uiSettings.setRotateGesturesEnabled(enabled)
    }
}

// context7 验证：MapLibre Android UiSettings 无 setTiltGesturesEnabled 方法
// 替代方案：通过 setMaxPitchPreference 限制倾斜范围来禁用/启用倾斜
// enabled=true → 恢复默认 60°, enabled=false → 最大倾斜角设为 0°（视觉上禁止倾斜）
export function enableTilt(enabled: boolean): void {
    const m = mapLibreMap
    if (m != null) {
        if (enabled) {
            m.setMaxPitchPreference(60.0)
        } else {
            m.setMaxPitchPreference(0.0)
        }
    }
}

// context7 验证：setCameraChangeCallback 存储回调（实际监听在 initMap 中注册）
@UTSJS.keepAlive
export function setCameraChangeCallback(callback: CameraChangeCallback): void {
    cameraChangeCallback = callback
}

// ══════════════════════════════════════════════
// v1.7.0 新增：标记聚合 + 热力图（数据可视化）
// context7: maplibre-native issue #3519 真实代码（Android 11.9.0）验证 GeoJsonSource cluster
// API 家族；已知竞态 bug（setGeoJson 更新后立即 getClusterExpansionZoom 崩溃）→
// 本实现重复调用 addMarkerCluster 时先 remove 再重建，规避该 bug
// ══════════════════════════════════════════════
let clusterSourceRef: GeoJsonSource | null = null
let clusterLayerRefs: Array<CircleLayer | SymbolLayer> = []
let heatmapLayerRef: HeatmapLayer | null = null

function buildPointFeatures(points: Array<MapClickDetail>): FeatureCollection {
    const features: Array<Feature> = []
    for (let i = 0; i < points.length; i++) {
        features.push(Feature.fromGeometry(Point.fromLngLat(points[i].lng.toDouble(), points[i].lat.toDouble())))
    }
    return FeatureCollection.fromFeatures(features)
}

// removeSource 统一传字符串 ID（Style.removeSource(String) 与 removeSource(Source) 重载均存在，
// 传 ID 最简且规避 UTS 重载解析歧义；removeLayer 同理，且图层 ID 固定，无需引用联合类型对象）
function removeClusterInternal(): void {
    clusterDataRef = null
    clusterOptionsRef = null
    const style = mapLibreMap?.getStyle()
    if (style != null) {
        const ids: Array<string> = ["tdt-cluster-layer", "tdt-cluster-count", "tdt-cluster-unclustered"]
        for (let i = 0; i < ids.length; i++) {
            if (style.getLayer(ids[i]) != null) {
                try { style.removeLayer(ids[i]) } catch (e: any) { /* ignore */ }
            }
        }
        try { style.removeSource("tdt-cluster-source") } catch (e: any) { /* ignore */ }
    }
    clusterLayerRefs = []
    clusterSourceRef = null
}

export function addMarkerCluster(points: Array<MapClickDetail>, options?: ClusterOptions): void {
    const style = mapLibreMap?.getStyle()
    const errorCb = onErrorCallback
    if (style == null) {
        if (errorCb != null) errorCb({ code: 4, message: "样式未加载，无法添加聚合图层" })
        return
    }
    removeClusterInternal()
    if (points.length == 0) return
    try {
        const radius = options?.clusterRadius ?? 50
        const maxZoom = options?.clusterMaxZoom ?? 14
        const geoOpts = new GeoJsonOptions()
            .withCluster(true)
            .withClusterRadius(radius.toInt())
            .withClusterMaxZoom(maxZoom.toInt())
        const source = new GeoJsonSource("tdt-cluster-source", buildPointFeatures(points), geoOpts)
        style.addSource(source)
        clusterSourceRef = source

        // 聚合簇圆点（filter has("point_count") 区分聚合簇与原始点）
        const clusterLayer = new CircleLayer("tdt-cluster-layer", "tdt-cluster-source")
        clusterLayer.setProperties(
            PropertyFactory.circleColor(Color.parseColor("#51BBD6")),
            PropertyFactory.circleRadius(20.0.toFloat()),
            PropertyFactory.circleStrokeColor(Color.parseColor("#FFFFFF")),
            PropertyFactory.circleStrokeWidth(1.0.toFloat())
        )
        clusterLayer.setFilter(Expression.has("point_count"))
        style.addLayer(clusterLayer)
        clusterLayerRefs.push(clusterLayer)

        // 聚合簇数量文字（point_count_abbreviated 为引擎自动生成的缩写计数）
        // text-font 必须为数组（style spec：Optional array；否则符号图层可能被静默拒绝，
        // 与 Web 端 glyphs 缺陷同类——context7: maplibre.org/maplibre-style-spec/layers/）。
        // PropertyFactory 仅有 textFont(String[]) 与 textFont(Expression) 两个重载（无 vararg）
        // ——context7: maplibre-native PropertyFactory.java 源码；UTS Array 对应 ArrayList，
        // 须 toTypedArray() 转 kotlin.Array 匹配 Java String[] 参数
        // （context7: UTS 官方文档 data-type.html "Array 转换 kotlin.Array"）
        const fontStack: Array<string> = ["Open Sans Semibold"]
        const countLayer = new SymbolLayer("tdt-cluster-count", "tdt-cluster-source")
        countLayer.setProperties(
            PropertyFactory.textField(Expression.get("point_count_abbreviated")),
            PropertyFactory.textFont(fontStack.toTypedArray()),
            PropertyFactory.textSize(12.0.toFloat())
            // 文字颜色用默认黑色（官方 cluster 示例同款）：黄色簇 #F1F075 上白字对比度差，
            // 且 Web/iOS 端均默认黑，三端统一（Task 10 浏览器实测发现）
        )
        countLayer.setFilter(Expression.has("point_count"))
        style.addLayer(countLayer)
        clusterLayerRefs.push(countLayer)

        // 未聚合原始点（filter 非 has("point_count")）
        const unclusterLayer = new CircleLayer("tdt-cluster-unclustered", "tdt-cluster-source")
        unclusterLayer.setProperties(
            PropertyFactory.circleColor(Color.parseColor("#11B4DA")),
            PropertyFactory.circleRadius(5.0.toFloat()),
            PropertyFactory.circleStrokeColor(Color.parseColor("#FFFFFF")),
            PropertyFactory.circleStrokeWidth(1.0.toFloat())
        )
        unclusterLayer.setFilter(Expression.not(Expression.has("point_count")))
        style.addLayer(unclusterLayer)
        clusterLayerRefs.push(unclusterLayer)
        // v1.8.0: 快照数据供样式切换后重建
        clusterDataRef = points
        clusterOptionsRef = options ?? null
    } catch (e: any) {
        console.error("TDTMap: 添加聚合图层失败: " + e.message)
        if (errorCb != null) errorCb({ code: 4, message: "添加聚合图层失败: " + e.message })
        removeClusterInternal()
    }
}

export function removeMarkerCluster(): void {
    removeClusterInternal()
}

export function addHeatmap(points: Array<HeatmapItem>, options?: HeatmapOptions): void {
    const style = mapLibreMap?.getStyle()
    const errorCb = onErrorCallback
    if (style == null) {
        if (errorCb != null) errorCb({ code: 4, message: "样式未加载，无法添加热力图层" })
        return
    }
    removeHeatmap()
    if (points.length == 0) return
    try {
        // 构建带 weight 属性的点要素（heatmap-weight 取该属性；无权重统一 1.0）
        const features: Array<Feature> = []
        for (let i = 0; i < points.length; i++) {
            const props = new JsonObject()
            props.addProperty("weight", (points[i].weight ?? 1).toDouble())
            features.push(Feature.fromGeometry(
                Point.fromLngLat(points[i].lng.toDouble(), points[i].lat.toDouble()),
                props
            ))
        }
        const source = new GeoJsonSource("tdt-heatmap-source", FeatureCollection.fromFeatures(features))
        style.addSource(source)

        const layer = new HeatmapLayer("tdt-heatmap-layer", "tdt-heatmap-source")
        layer.setProperties(
            PropertyFactory.heatmapWeight(Expression.get("weight")),
            PropertyFactory.heatmapRadius((options?.radius ?? 30).toFloat()),
            PropertyFactory.heatmapOpacity((options?.opacity ?? 0.6).toFloat())
        )
        style.addLayer(layer)
        heatmapLayerRef = layer
        // v1.8.0: 快照数据供样式切换后重建
        heatmapDataRef = points
        heatmapOptionsRef = options ?? null
    } catch (e: any) {
        console.error("TDTMap: 添加热力图层失败: " + e.message)
        if (errorCb != null) errorCb({ code: 4, message: "添加热力图层失败: " + e.message })
        removeHeatmap()
    }
}

export function removeHeatmap(): void {
    heatmapDataRef = null
    heatmapOptionsRef = null
    const style = mapLibreMap?.getStyle()
    if (style != null) {
        // 局部变量承接：heatmapLayerRef 为模块级可变属性，直接传参触发 Kotlin smart cast 编译错误
        const hl = heatmapLayerRef
        if (hl != null) {
            try { style.removeLayer(hl) } catch (e: any) { /* ignore */ }
        }
        try { style.removeSource("tdt-heatmap-source") } catch (e: any) { /* ignore */ }
    }
    heatmapLayerRef = null
}
