// ═══════════════════════════════════════════════════════════
// tdt-map Web 平台实现 — 基于 MapLibre GL JS
// 天地图 UTS 原生插件（uni-app x 蒸汽模式）
// ═══════════════════════════════════════════════════════════

// ── 类型别名（Web 平台对应） ──
type TDMapOptions = {
    apiKey: string
    latitude: number
    longitude: number
    zoom: number
    mapType: string
    // v1.6.0: 控件显隐（与 interface.uts TDMapOptions 保持一致）
    showZoomControl?: boolean
    showScaleControl?: boolean
}

type MapClickDetail = {
    lat: number
    lng: number
}

type MapErrorDetail = {
    code: number
    message: string
}

// v1.9.0: E0 GeoJSON 层重放通知回调（与 interface.uts 声明对齐；Web 端自建类型别名惯例）
type GeoJsonReplayCallback = () => void

type MapBoundsDetail = {
    minLat: number
    minLng: number
    maxLat: number
    maxLng: number
}

type MapSizeDetail = {
    width: number
    height: number
}

type MapViewportDetail = {
    center: MapClickDetail
    zoom: number
}

type MapClickCallback = (detail: MapClickDetail) => void
type MapReadyCallback = () => void
type MapErrorCallback = (detail: MapErrorDetail) => void
type MarkerClickCallback = (detail: MapClickDetail) => void
type MapLongClickCallback = (detail: MapClickDetail) => void
type CameraChangeCallback = (detail: MapClickDetail) => void
type GeocodeCallback = (data: UTSJSONObject) => void

// v1.7.0: 数据可视化类型（与 interface.uts 保持一致）
type ClusterOptions = {
    clusterRadius?: number
    clusterMaxZoom?: number
}
type HeatmapItem = {
    lat: number
    lng: number
    weight?: number
}
type HeatmapOptions = {
    radius?: number
    opacity?: number
}

// v1.8.0: 瓦片图层选项（与 interface.uts 保持一致）
type TileLayerOptions = {
    zIndex?: number
    opacity?: number
    minZoom?: number
    maxZoom?: number
}

// v1.9.0: 图片覆盖物类型（与 interface.uts 保持一致）
type ImageOverlayOptions = {
    southwest: MapClickDetail
    northeast: MapClickDetail
    image: string
    transparency?: number
    zIndex?: number
    bearing?: number
    visible?: boolean
    clickable?: boolean
}
type ImageOverlayUpdateOptions = {
    southwest?: MapClickDetail
    northeast?: MapClickDetail
    image?: string
    transparency?: number
    zIndex?: number
    bearing?: number
    visible?: boolean
    clickable?: boolean
}
type ImageOverlayClickDetail = {
    id: number
    lat: number
    lng: number
}
type ImageOverlayClickCallback = (detail: ImageOverlayClickDetail) => void

type SearchOptions = {
    keyWord: string
    mapBound?: string
    level?: string
    queryType?: string
    queryRadius?: string
    pointLonlat?: string
    start?: string
    count?: string
    specifyAdminCode?: string
}

// ── 模块级状态 ──
let mapInstance: any = null
let currentApiKey: string = ''
let currentMapType: string = 'vec'
let currentLat: number = 39.9042
let currentLng: number = 116.4075
let currentZoom: number = 10

// 覆盖物管理
let nextOverlayId: number = 0
let overlayMap: Map<number, OverlayEntry> = new Map()
let markerMap: Map<number, any> = new Map()  // id → Marker 实例
type MarkerInfo = { title: string, snippet: string }
let markerInfoMap: Map<number, MarkerInfo> = new Map()
let polygonList: Array<number> = []
let polylineList: Array<number> = []
let circleList: Array<number> = []
let rectangleList: Array<number> = []
let labelList: Array<number> = []
type TileLayerInfo = { sourceId: string, layerId: string, tileUrl: string, options: TileLayerOptions }
let customTileLayers: Map<string, TileLayerInfo> = new Map()
// v1.8.0: 平行数组存 key 顺序（UTS Map 迭代 API 受限，重建时按添加顺序重放）
let customTileLayerIds: Array<string> = []
// v1.8.0: 聚合/热力数据快照（样式切换后重建用）
let clusterDataRef: Array<MapClickDetail> | null = null
let clusterOptionsRef: ClusterOptions | null = null
let heatmapDataRef: Array<HeatmapItem> | null = null
let heatmapOptionsRef: HeatmapOptions | null = null
// v1.9.0: 图片覆盖物状态（params 快照兼作样式切换重建依据）
type ImageOverlayInfo = { params: ImageOverlayOptions, sourceId: string, layerId: string, visible: boolean }
let imageOverlays: Map<number, ImageOverlayInfo> = new Map()
// 平行数组存添加顺序（UTS Map 迭代 API 受限，zIndex 定位/重建重放依赖，v1.8.0 同款规避）
let imageOverlayIds: Array<number> = []
let imageOverlayClickCallback: ImageOverlayClickCallback | null = null
// v1.9.0: E0 GeoJSON 层重放通知（快照与编排在组件层，原生层仅负责时机通知）
let geoJsonReplayCallback: GeoJsonReplayCallback | null = null

type OverlayEntry = {
    type: string          // 'marker' | 'polygon' | 'polyline' | 'circle' | 'rectangle' | 'label' | 'image'
    sourceId?: string
    layerId?: string
    visible: boolean
}

// 回调存储
let mapClickCallback: MapClickCallback | null = null
let mapReadyCallback: MapReadyCallback | null = null
let mapErrorCallback: MapErrorCallback | null = null
let markerClickCallback: MarkerClickCallback | null = null
let mapLongClickCallback: MapLongClickCallback | null = null
let cameraChangeCallback: CameraChangeCallback | null = null

// MapLibre GL JS 加载状态
let maplibreLoaded: boolean = false
let maplibreLoadPromise: Promise<void> | null = null

// ── 天地图瓦片配置 ──
const SUBDOMAINS: Array<string> = ['0', '1', '2', '3', '4', '5', '6', '7']
type TdtLayerConfig = { map: string, anno: string }
const LAYER_CONFIG: Map<string, TdtLayerConfig> = new Map([
    ['vec', { map: 'vec_w', anno: 'cva_w' }],
    ['img', { map: 'img_w', anno: 'cia_w' }],
    ['ter', { map: 'ter_w', anno: 'cta_w' }]
])

const TDT_API_BASE: string = 'https://api.tianditu.gov.cn'

// v1.9.0: glyphs 字体端点集中常量（当前为 demotiles 占位值；⚠️ demotiles 国内不可达，
// S0.5 端点选型后在此一行替换，三端同款常量同步修改）
const GLYPHS_ENDPOINT: string = 'https://demotiles.maplibre.org/font/{fontstack}/{range}.pbf'

// v1.9.0: mapType='blank' 白底层定义（E0 配套）。空 layers 非白底（画布透明），
// 必须显式 background #ffffff；glyphs 必须显式存在（缺 glyphs 的 text-field 图层被静默拒绝）
function blankBackgroundLayer(): any {
    return { id: 'tdt-bg', type: 'background', paint: { 'background-color': '#ffffff' } }
}

// 幂等确保白底层存在且可见（init blank / switchMapType 到 blank / removeStyle 恢复 blank 共用）
function ensureBlankBgLayer(): void {
    if (mapInstance == null) return
    if (mapInstance.getLayer('tdt-bg') != null) {
        try { mapInstance.setLayoutProperty('tdt-bg', 'visibility', 'visible') } catch (e: any) { /* ignore */ }
    } else {
        try { mapInstance.addLayer(blankBackgroundLayer()) } catch (e: any) { /* ignore */ }
    }
}

// 隐藏白底层（blank 切回瓦片底图时；不存在时 no-op）
function hideBlankBgLayer(): void {
    if (mapInstance == null) return
    if (mapInstance.getLayer('tdt-bg') != null) {
        try { mapInstance.setLayoutProperty('tdt-bg', 'visibility', 'none') } catch (e: any) { /* ignore */ }
    }
}

// ═══════════════════════════════════════════════════════════
// MapLibre GL JS 动态加载
// ═══════════════════════════════════════════════════════════

function loadMapLibreGL(): Promise<void> {
    if (maplibreLoaded) return Promise.resolve()
    if (maplibreLoadPromise != null) return maplibreLoadPromise

    maplibreLoadPromise = new Promise<void>((resolve, reject) => {
        // 检查是否已加载
        if (typeof (window as any).maplibregl !== 'undefined') {
            maplibreLoaded = true
            resolve()
            return
        }

        // 加载 CSS
        const link = document.createElement('link')
        link.rel = 'stylesheet'
        link.href = 'https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css'
        document.head.appendChild(link)

        // 加载 JS
        const script = document.createElement('script')
        script.src = 'https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js'
        script.onload = () => {
            maplibreLoaded = true
            resolve()
        }
        script.onerror = () => {
            maplibreLoadPromise = null
            reject(new Error('MapLibre GL JS 加载失败，请检查网络连接'))
        }
        document.head.appendChild(script)
    })

    return maplibreLoadPromise
}

function getMapLibre(): any {
    if (!maplibreLoaded) return null
    return (window as any).maplibregl
}

// ── 瓦片 URL 构建 ──

function buildTileUrl(layerType: string, key: string): string {
    const s = SUBDOMAINS[Math.floor(Math.random() * 8)]
    return `https://t${s}.tianditu.gov.cn/DataServer?T=${layerType}&x={x}&y={y}&l={z}&tk=${key}`
}

// ── 生成唯一 overlay ID ──
function genOverlayId(): number {
    nextOverlayId++
    return nextOverlayId
}

// ═══════════════════════════════════════════════════════════
// 核心地图函数
// ═══════════════════════════════════════════════════════════

// v1.8.0: 抽取天地图底图（base+anno）添加逻辑，供 initMap / removeStyle 复用（与 v1.7.x 代码完全一致，仅位置移动）
function addTdtBaseLayers(map: any, layerCfg: any): void {
    map.addSource('tdt-base', {
        type: 'raster',
        tiles: [buildTileUrl(layerCfg.map, currentApiKey)],
        tileSize: 256,
        maxzoom: 18,
        minzoom: 1
    })
    map.addLayer({
        id: 'tdt-base-layer',
        type: 'raster',
        source: 'tdt-base'
    })
    map.addSource('tdt-anno', {
        type: 'raster',
        tiles: [buildTileUrl(layerCfg.anno, currentApiKey)],
        tileSize: 256,
        maxzoom: 18,
        minzoom: 1
    })
    map.addLayer({
        id: 'tdt-anno-layer',
        type: 'raster',
        source: 'tdt-anno'
    })
}

@UTSJS.keepAlive
export function initMap(
    container: any,  // Web: DOM 元素
    options: TDMapOptions,
    onClick: MapClickCallback,
    onReady: MapReadyCallback,
    onError: MapErrorCallback
): void {
    currentApiKey = options.apiKey
    currentMapType = options.mapType ?? 'vec'
    currentLat = options.latitude
    currentLng = options.longitude
    currentZoom = options.zoom

    mapClickCallback = onClick
    mapReadyCallback = onReady
    mapErrorCallback = onError

    loadMapLibreGL().then(() => {
        // v1.6.0: 防御重复初始化（组件重建场景）——旧 map 先销毁，避免双地图叠加
        // （控件实例挂在 map 对象上，map.remove() 会一并清理，无需单独 removeControl）
        if (mapInstance != null) {
            try { mapInstance.remove() } catch (e: any) { /* ignore */ }
            mapInstance = null
        }

        const mlg = getMapLibre()
        if (mlg == null) {
            if (mapErrorCallback != null) {
                mapErrorCallback({ code: 4, message: 'MapLibre GL JS 未加载' })
            }
            return
        }

        // v1.9.0: blank 白底——无天地图瓦片（无 layerCfg），初始样式直接带白底层
        const isBlank = currentMapType == 'blank'
        const layerCfg = isBlank ? null : LAYER_CONFIG.get(currentMapType)
        if (!isBlank && layerCfg == null) {
            if (mapErrorCallback != null) {
                mapErrorCallback({ code: 4, message: '未知地图类型: ' + currentMapType })
            }
            return
        }

        try {
            const map = new mlg.Map({
                container: container,
                // v1.7.0: glyphs 字体端点（style spec 强制校验：text-field 图层需 style 含 glyphs，
                // 否则图层被静默拒绝，聚合数字标签不渲染——Task 10 浏览器实测发现，context7 验证）
                // v1.9.0: glyphs 抽取为 GLYPHS_ENDPOINT 集中常量；blank 时 layers 直接带白底层
                style: { version: 8, glyphs: GLYPHS_ENDPOINT, sources: {}, layers: isBlank ? [blankBackgroundLayer()] : [] },
                center: [currentLng, currentLat],
                zoom: currentZoom,
                maxZoom: 18,
                minZoom: 1,
                attributionControl: false
            })

            map.on('load', () => {
                if (!isBlank) {
                    addTdtBaseLayers(map, layerCfg)
                }

                if (mapReadyCallback != null) {
                    mapReadyCallback()
                }
            })

            // 点击事件
            map.on('click', (e: any) => {
                // v1.7.0: 聚合簇点击由 onClusterClick 处理（放大展开），通用 click 不重复触发（与 Android/iOS 消费事件语义一致）
                const clusterHits = map.queryRenderedFeatures(e.point, { layers: ['tdt-cluster-layer'] })
                if (clusterHits != null && clusterHits.length > 0) return
                // v1.9.0: 图片覆盖物几何命中检测（顶→底：未定义 zIndex 置顶组 → 正 zIndex 降序 → 0 档；
                // 同档后添加者优先）。不用 queryRenderedFeatures（raster 图层无要素），命中即互斥消费 mapClick
                if (imageOverlayClickCallback != null && imageOverlayIds.length > 0) {
                    let hitId = 0
                    let hitKey = -2000000
                    let hitIdx = -1
                    for (let i = 0; i < imageOverlayIds.length; i++) {
                        const oid = imageOverlayIds[i]
                        const info = imageOverlays.get(oid)
                        if (info == null) continue
                        if (!info.visible) continue
                        if (info.params.clickable == false) continue
                        if (!hitTestImageOverlay(e.lngLat.lat, e.lngLat.lng, info.params)) continue
                        const key = imageOverlayZKey(info.params.zIndex ?? null)
                        if (key > hitKey || (key == hitKey && i > hitIdx)) {
                            hitId = oid
                            hitKey = key
                            hitIdx = i
                        }
                    }
                    if (hitId > 0) {
                        imageOverlayClickCallback({ id: hitId, lat: e.lngLat.lat, lng: e.lngLat.lng })
                        return
                    }
                }
                if (mapClickCallback != null) {
                    mapClickCallback({ lat: e.lngLat.lat, lng: e.lngLat.lng })
                }
            })

            // 相机移动完成
            map.on('moveend', () => {
                const c = map.getCenter()
                currentLat = c.lat
                currentLng = c.lng
                currentZoom = map.getZoom()
                if (cameraChangeCallback != null) {
                    cameraChangeCallback({ lat: c.lat, lng: c.lng })
                }
            })

            // 长按：mousedown 800ms
            let longPressTimer: any = null
            map.on('mousedown', (e: any) => {
                longPressTimer = setTimeout(() => {
                    if (mapLongClickCallback != null) {
                        mapLongClickCallback({ lat: e.lngLat.lat, lng: e.lngLat.lng })
                    }
                }, 800)
            })
            map.on('mouseup', () => { if (longPressTimer != null) { clearTimeout(longPressTimer); longPressTimer = null } })
            map.on('mousemove', () => { if (longPressTimer != null) { clearTimeout(longPressTimer); longPressTimer = null } })

            // 瓦片加载错误
            map.on('error', (e: any) => {
                console.error('TDTMap Web: 瓦片加载错误', e)
            })

            // v1.6.0: 隐藏 MapLibre 原生 logo —— GL JS 无官方 logoEnabled 选项（仅有 logoPosition 移位），
            // logo 默认左下角会与 uvue 版权条重叠；MapLibre BSD-3 许可不强制显示。
            // CSS 注入隐藏（幂等：按 id 查重）
            if (document.getElementById('tdt-hide-logo-style') == null) {
                const hideLogoStyle = document.createElement('style')
                hideLogoStyle.id = 'tdt-hide-logo-style'
                hideLogoStyle.textContent = '.maplibregl-ctrl-logo { display: none !important; }'
                document.head.appendChild(hideLogoStyle)
            }

            // v1.6.0: 缩放按钮与比例尺 —— context7 验证：同位置 bottom-right 多控件由
            // MapLibre GL JS 自动堆叠排列，不重叠。控件实例挂在 map 对象上
            // （非模块级变量），多地图实例场景无污染。
            if (options.showZoomControl !== false) {
                const navControl = new mlg.NavigationControl({ showCompass: false })
                map.addControl(navControl, 'bottom-right')
                map.tdtNavControl = navControl
            }
            if (options.showScaleControl !== false) {
                const scaleControl = new mlg.ScaleControl({ maxWidth: 100 })
                map.addControl(scaleControl, 'bottom-right')
                map.tdtScaleControl = scaleControl
            }

            mapInstance = map
        } catch (err: any) {
            console.error('TDTMap Web: initMap 失败', err)
            if (mapErrorCallback != null) {
                mapErrorCallback({ code: 4, message: '地图初始化失败: ' + (err.message ?? String(err)) })
            }
        }
    }).catch((err) => {
        console.error('TDTMap Web: MapLibre GL JS 加载失败', err)
        if (mapErrorCallback != null) {
            mapErrorCallback({ code: 2, message: 'MapLibre GL JS 加载失败' })
        }
    })
}

export function setCenter(lat: number, lng: number): void {
    if (mapInstance == null) return
    currentLat = lat
    currentLng = lng
    mapInstance.setCenter([lng, lat])
}

export function setZoom(zoom: number): void {
    if (mapInstance == null) return
    currentZoom = zoom
    mapInstance.setZoom(zoom)
}

export function getCenter(): MapClickDetail {
    if (mapInstance == null) return { lat: currentLat, lng: currentLng }
    const c = mapInstance.getCenter()
    return { lat: c.lat, lng: c.lng }
}

export function getZoom(): number {
    if (mapInstance == null) return currentZoom
    return mapInstance.getZoom()
}

export function fitBounds(minLat: number, minLng: number, maxLat: number, maxLng: number, padding: number): void {
    if (mapInstance == null) return
    mapInstance.fitBounds(
        [[minLng, minLat], [maxLng, maxLat]],
        { padding: padding, maxZoom: 18 }
    )
}

export function switchMapType(mapType: string): void {
    if (mapInstance == null) return
    // v1.9.0: blank——隐藏天地图瓦片层并显示白底层（无样式重建，层引用保留）
    if (mapType == 'blank') {
        currentMapType = 'blank'
        try {
            if (mapInstance.getLayer('tdt-base-layer') != null) {
                mapInstance.setLayoutProperty('tdt-base-layer', 'visibility', 'none')
            }
            if (mapInstance.getLayer('tdt-anno-layer') != null) {
                mapInstance.setLayoutProperty('tdt-anno-layer', 'visibility', 'none')
            }
        } catch (e: any) {
            console.error('TDTMap Web: switchMapType blank 失败', e)
        }
        ensureBlankBgLayer()
        return
    }
    const cfg = LAYER_CONFIG.get(mapType)
    if (cfg == null) return
    currentMapType = mapType
    hideBlankBgLayer()
    try {
        // blank 起底时瓦片 source 未创建，需补建（含注记层）；常规切换仅换 tiles 并确保可见
        if (mapInstance.getSource('tdt-base') == null) {
            addTdtBaseLayers(mapInstance, cfg)
            return
        }
        const baseSrc = mapInstance.getSource('tdt-base')
        if (baseSrc != null) {
            baseSrc.setTiles([buildTileUrl(cfg.map, currentApiKey)])
        }
        const annoSrc = mapInstance.getSource('tdt-anno')
        if (annoSrc != null) {
            annoSrc.setTiles([buildTileUrl(cfg.anno, currentApiKey)])
        }
        if (mapInstance.getLayer('tdt-base-layer') != null) {
            mapInstance.setLayoutProperty('tdt-base-layer', 'visibility', 'visible')
        }
        if (mapInstance.getLayer('tdt-anno-layer') != null) {
            mapInstance.setLayoutProperty('tdt-anno-layer', 'visibility', 'visible')
        }
    } catch (e: any) {
        console.error('TDTMap Web: switchMapType 失败', e)
    }
}

export function snapshot(callback: (data: ArrayBuffer) => void): void {
    if (mapInstance == null) {
        if (mapErrorCallback != null) {
            mapErrorCallback({ code: 4, message: '地图未初始化' })
        }
        callback(new ArrayBuffer(0))
        return
    }
    try {
        const canvas = mapInstance.getCanvas()
        const dataUrl = canvas.toDataURL('image/png')
        // dataUrl 转 ArrayBuffer — 简化处理：返回 base64 前缀后的字节
        const base64 = dataUrl.split(',')[1]
        const binaryStr = atob(base64)
        const bytes = new Uint8Array(binaryStr.length)
        for (let i = 0; i < binaryStr.length; i++) {
            bytes[i] = binaryStr.charCodeAt(i)
        }
        callback(bytes.buffer as ArrayBuffer)
    } catch (e: any) {
        console.error('TDTMap Web: snapshot 失败', e)
        callback(new ArrayBuffer(0))
    }
}

export function onResume(): void { /* Web 无需原生生命周期 */ }
export function onPause(): void { /* Web 无需原生生命周期 */ }

export function destroyMap(): void {
    if (mapInstance != null) {
        // v1.7.0: 先清理聚合/热力图层（依赖 mapInstance，须在 remove 之前；内部幂等）
        removeMarkerCluster()
        removeHeatmap()
        try { mapInstance.remove() } catch (e) { /* ignore */ }
        mapInstance = null
    }
    // 清理状态
    overlayMap.clear()
    markerMap.clear()
    markerInfoMap.clear()
    customTileLayers.clear()
    polygonList = []
    polylineList = []
    circleList = []
    rectangleList = []
    labelList = []
    // v1.9.0: 图片覆盖物状态
    imageOverlays.clear()
    imageOverlayIds = []
    nextOverlayId = 0
    mapClickCallback = null
    mapReadyCallback = null
    mapErrorCallback = null
    markerClickCallback = null
    mapLongClickCallback = null
    cameraChangeCallback = null
}

// ── 缩放控制 ──
export function zoomIn(): void { if (mapInstance != null) mapInstance.zoomIn() }
export function zoomOut(): void { if (mapInstance != null) mapInstance.zoomOut() }
export function setMinZoom(zoom: number): void { if (mapInstance != null) mapInstance.setMinZoom(zoom) }
export function setMaxZoom(zoom: number): void { if (mapInstance != null) mapInstance.setMaxZoom(zoom) }

// ── 视野移动 ──
export function panTo(lat: number, lng: number, zoom?: number): void {
    if (mapInstance == null) return
    const opts: any = { center: [lng, lat] }
    if (zoom != null) opts.zoom = zoom
    mapInstance.flyTo(opts)
}
export function centerAndZoom(lat: number, lng: number, zoom: number): void {
    if (mapInstance == null) return
    currentLat = lat; currentLng = lng; currentZoom = zoom
    mapInstance.setCenter([lng, lat])
    mapInstance.setZoom(zoom)
}

// ── 手势控制 ──
export function enableZoom(enabled: boolean): void {
    if (mapInstance == null) return
    if (enabled) { mapInstance.scrollZoom.enable() } else { mapInstance.scrollZoom.disable() }
}
export function enableDrag(enabled: boolean): void {
    if (mapInstance == null) return
    if (enabled) { mapInstance.dragPan.enable() } else { mapInstance.dragPan.disable() }
}

// ── 范围限制 ──
export function setMaxBounds(minLat: number | null, minLng: number | null, maxLat: number | null, maxLng: number | null): void {
    if (mapInstance == null) return
    // context7 验证：MapLibre GL JS 官方文档——setMaxBounds(null) 清除限制
    if (minLat == null || minLng == null || maxLat == null || maxLng == null) {
        mapInstance.setMaxBounds(null)
        return
    }
    mapInstance.setMaxBounds([[minLng, minLat], [maxLng, maxLat]])
}

export function getBounds(): MapBoundsDetail {
    if (mapInstance == null) return { minLat: 0, minLng: 0, maxLat: 0, maxLng: 0 }
    const b = mapInstance.getBounds()
    return {
        minLat: b.getSouth(),
        minLng: b.getWest(),
        maxLat: b.getNorth(),
        maxLng: b.getEast()
    }
}

// ═══════════════════════════════════════════════════════════
// 坐标转换：GCJ02 → WGS84（纯算法，三端一致）
// ═══════════════════════════════════════════════════════════

const PI: number = 3.141592653589793
const A: number = 6378245.0
const EE: number = 0.006693421622965943

function isOutOfChina(lat: number, lng: number): boolean {
    return lng < 72.004 || lng > 137.8347 || lat < 0.8293 || lat > 55.8271
}

function transformLat(x: number, y: number): number {
    let ret = -100.0 + 2.0 * x + 3.0 * y + 0.2 * y * y + 0.1 * x * y + 0.2 * Math.sqrt(Math.abs(x))
    ret += (20.0 * Math.sin(6.0 * x * PI) + 20.0 * Math.sin(2.0 * x * PI)) * 2.0 / 3.0
    ret += (20.0 * Math.sin(y * PI) + 40.0 * Math.sin(y / 3.0 * PI)) * 2.0 / 3.0
    ret += (160.0 * Math.sin(y / 12.0 * PI) + 320.0 * Math.sin(y * PI / 30.0)) * 2.0 / 3.0
    return ret
}

function transformLng(x: number, y: number): number {
    let ret = 300.0 + x + 2.0 * y + 0.1 * x * x + 0.1 * x * y + 0.1 * Math.sqrt(Math.abs(x))
    ret += (20.0 * Math.sin(6.0 * x * PI) + 20.0 * Math.sin(2.0 * x * PI)) * 2.0 / 3.0
    ret += (20.0 * Math.sin(x * PI) + 40.0 * Math.sin(x / 3.0 * PI)) * 2.0 / 3.0
    ret += (150.0 * Math.sin(x / 12.0 * PI) + 300.0 * Math.sin(x / 30.0 * PI)) * 2.0 / 3.0
    return ret
}

export function gcj02ToWgs84(lat: number, lng: number): MapClickDetail {
    if (isOutOfChina(lat, lng)) return { lat: lat, lng: lng }
    let dLat = transformLat(lng - 105.0, lat - 35.0)
    let dLng = transformLng(lng - 105.0, lat - 35.0)
    const radLat = lat / 180.0 * PI
    let magic = Math.sin(radLat)
    magic = 1 - EE * magic * magic
    const sqrtMagic = Math.sqrt(magic)
    dLat = (dLat * 180.0) / ((A * (1 - EE)) / (magic * sqrtMagic) * PI)
    dLng = (dLng * 180.0) / (A / sqrtMagic * Math.cos(radLat) * PI)
    return { lat: lat - dLat, lng: lng - dLng }
}

// ═══════════════════════════════════════════════════════════
// 覆盖物 — 标记点
// ═══════════════════════════════════════════════════════════

export function addMarker(lat: number, lng: number, title: string, snippet?: string): number {
    if (mapInstance == null) return 0
    const mlg = getMapLibre()
    if (mlg == null) return 0

    const id = genOverlayId()
    try {
        const popup = new mlg.Popup({ offset: 25 })
            .setHTML('<b>' + title + '</b>' + (snippet != null && snippet.length > 0 ? '<br/>' + snippet : ''))

        const marker = new mlg.Marker({ color: '#FF4444' })
            .setLngLat([lng, lat])
            .setPopup(popup)
            .addTo(mapInstance)

        // v1.7.1: 标记点击回调绑定——marker 为独立 DOM，click 不会冒泡到 canvas，
        // 天然不触发 mapClick（与 Android 互斥消费语义一致）；闭包读模块级回调，
        // 任意时机 setMarkerClickCallback 均对全部 marker 生效（含先添加的）
        marker.getElement().addEventListener('click', () => {
            if (markerClickCallback != null) {
                const ll = marker.getLngLat()
                markerClickCallback({ lat: ll.lat, lng: ll.lng })
            }
        })

        markerMap.set(id, marker)
        const entry: OverlayEntry = { type: 'marker', visible: true }
        overlayMap.set(id, entry)

        if (snippet != null && snippet.length > 0) {
            markerInfoMap.set(id, { title: title, snippet: snippet })
        }
    } catch (e: any) {
        console.error('TDTMap Web: addMarker 失败', e)
        return 0
    }
    return id
}

export function clearMarkers(): void {
    if (mapInstance == null) return
    markerMap.forEach((marker, id) => {
        try { marker.remove() } catch (e) { /* ignore */ }
        overlayMap.delete(id)
        markerInfoMap.delete(id)
    })
    markerMap.clear()
    polygonList = polygonList.filter(id => overlayMap.get(id)?.type !== 'marker')
}

export function setMarkers(markers: Array<MapClickDetail>): Array<number> {
    const ids: Array<number> = []
    for (let i = 0; i < markers.length; i++) {
        const id = addMarker(markers[i].lat, markers[i].lng, '', undefined)
        if (id > 0) ids.push(id)
    }
    return ids
}

// ═══════════════════════════════════════════════════════════
// 覆盖物 — 几何图形（通过 GeoJSON source + layer）
// ═══════════════════════════════════════════════════════════

function addGeoJSONOverlay(
    type: string, geojson: any, layerPaint: any, layerLayout?: any
): number {
    if (mapInstance == null) return 0
    const id = genOverlayId()
    const sourceId = 'overlay-src-' + id
    const layerId = 'overlay-layer-' + id

    try {
        mapInstance.addSource(sourceId, {
            type: 'geojson',
            data: geojson
        })
        const layerDef: any = { id: layerId, type: type, source: sourceId, paint: layerPaint }
        if (layerLayout != null) layerDef.layout = layerLayout
        mapInstance.addLayer(layerDef)
        overlayMap.set(id, { type: type, sourceId: sourceId, layerId: layerId, visible: true })
    } catch (e: any) {
        console.error('TDTMap Web: addGeoJSONOverlay 失败', e)
        return 0
    }
    return id
}

export function addPolygon(points: Array<MapClickDetail>, color: string, fillColor: string): number {
    const coords: Array<Array<number>> = []
    for (let i = 0; i < points.length; i++) {
        coords.push([points[i].lng, points[i].lat])
    }
    // 闭合多边形
    if (coords.length > 0) {
        const first = coords[0]
        const last = coords[coords.length - 1]
        if (first[0] !== last[0] || first[1] !== last[1]) {
            coords.push([first[0], first[1]])
        }
    }
    const geojson: any = { type: 'Feature', geometry: { type: 'Polygon', coordinates: [coords] } }
    const id = addGeoJSONOverlay('fill', geojson, {
        'fill-color': fillColor,
        'fill-outline-color': color,
        'fill-opacity': 0.5
    })
    if (id > 0) polygonList.push(id)
    return id
}

export function clearPolygons(): void {
    if (mapInstance == null) return
    polygonList.forEach(id => { removeOverlayInternal(id) })
    polygonList = []
}

export function addPolyline(points: Array<MapClickDetail>, color: string, width: number): number {
    const coords: Array<Array<number>> = []
    for (let i = 0; i < points.length; i++) {
        coords.push([points[i].lng, points[i].lat])
    }
    const geojson: any = { type: 'Feature', geometry: { type: 'LineString', coordinates: coords } }
    const id = addGeoJSONOverlay('line', geojson, {
        'line-color': color,
        'line-width': width,
        'line-opacity': 0.8
    })
    if (id > 0) polylineList.push(id)
    return id
}

// v1.9.0: E0.3a styled 折线——line-dasharray/line-opacity 参数化；
// legacy addPolyline 硬编码 line-opacity 0.8 保持零变化（缺省 opacity=1 仅属新原语）
export function addStyledPolyline(points: Array<MapClickDetail>, color: string, width: number, dash: Array<number> | null, opacity?: number): number {
    if (mapInstance == null || points.length < 2) return 0
    const coords: Array<Array<number>> = []
    for (let i = 0; i < points.length; i++) {
        coords.push([points[i].lng, points[i].lat])
    }
    const paint: any = {
        'line-color': color,
        'line-width': width,
        'line-opacity': opacity ?? 1
    }
    if (dash != null && dash.length > 0) {
        paint['line-dasharray'] = dash
    }
    const geojson: any = { type: 'Feature', geometry: { type: 'LineString', coordinates: coords } }
    const id = addGeoJSONOverlay('line', geojson, paint)
    if (id > 0) polylineList.push(id)
    return id
}

export function addCircle(lat: number, lng: number, radius: number, color: string, fillColor: string): number {
    // 用 GeoJSON circle 近似：多个点模拟圆
    const coords: Array<Array<number>> = []
    const segments = 64
    const radiusDeg = radius / 111320.0  // 米→度（粗略近似）
    for (let i = 0; i <= segments; i++) {
        const angle = (i / segments) * 2.0 * Math.PI
        coords.push([lng + radiusDeg * Math.cos(angle), lat + radiusDeg * Math.sin(angle)])
    }
    const geojson: any = { type: 'Feature', geometry: { type: 'Polygon', coordinates: [coords] } }
    const id = addGeoJSONOverlay('fill', geojson, {
        'fill-color': fillColor,
        'fill-outline-color': color,
        'fill-opacity': 0.5
    })
    if (id > 0) circleList.push(id)
    return id
}

export function addRectangle(minLat: number, minLng: number, maxLat: number, maxLng: number, color: string, fillColor: string): number {
    const coords: Array<Array<number>> = [
        [minLng, minLat], [maxLng, minLat], [maxLng, maxLat], [minLng, maxLat], [minLng, minLat]
    ]
    const geojson: any = { type: 'Feature', geometry: { type: 'Polygon', coordinates: [coords] } }
    const id = addGeoJSONOverlay('fill', geojson, {
        'fill-color': fillColor,
        'fill-outline-color': color,
        'fill-opacity': 0.5
    })
    if (id > 0) rectangleList.push(id)
    return id
}

export function addLabel(lat: number, lng: number, text: string): number {
    if (mapInstance == null) return 0
    const mlg = getMapLibre()
    if (mlg == null) return 0

    const id = genOverlayId()
    try {
        const marker = new mlg.Marker({ color: '#3366FF' })
            .setLngLat([lng, lat])
            .setPopup(new mlg.Popup().setText(text))
            .addTo(mapInstance)
        // v1.7.1: 立即打开 popup 显示文字——原生端 addLabel 为直接可见的文字标注，
        // popup 默认关闭时文字不可见，与 Android/iOS 语义不一致（context7: MapLibre Marker popup 默认关闭）
        marker.togglePopup()
        markerMap.set(id, marker)
        overlayMap.set(id, { type: 'label', visible: true })
    } catch (e: any) {
        console.error('TDTMap Web: addLabel 失败', e)
        return 0
    }
    if (id > 0) labelList.push(id)
    return id
}

// ═══════════════════════════════════════════════════════════
// 覆盖物管理
// ═══════════════════════════════════════════════════════════

function removeOverlayInternal(id: number): void {
    const entry = overlayMap.get(id)
    if (entry == null) return

    if (entry.type === 'marker' || entry.type === 'label') {
        const marker = markerMap.get(id)
        if (marker != null) {
            try { marker.remove() } catch (e) { /* ignore */ }
            markerMap.delete(id)
        }
        markerInfoMap.delete(id)
    } else {
        const layerId = entry.layerId
        const sourceId = entry.sourceId
        if (layerId != null && mapInstance != null) {
            try { if (mapInstance.getLayer(layerId) != null) mapInstance.removeLayer(layerId) } catch (e) { /* ignore */ }
        }
        if (sourceId != null && mapInstance != null) {
            try { if (mapInstance.getSource(sourceId) != null) mapInstance.removeSource(sourceId) } catch (e) { /* ignore */ }
        }
    }
    overlayMap.delete(id)
}

export function removeOverlay(id: number): void {
    removeOverlayInternal(id)
    // 清理类型列表
    polygonList = polygonList.filter(x => x !== id)
    polylineList = polylineList.filter(x => x !== id)
    circleList = circleList.filter(x => x !== id)
    rectangleList = rectangleList.filter(x => x !== id)
    labelList = labelList.filter(x => x !== id)
    // v1.9.0: 图片覆盖物状态同步清理（非图片 ID 时为无害 no-op）
    imageOverlays.delete(id)
    imageOverlayIds = imageOverlayIds.filter(x => x !== id)
}

export function showOverlay(id: number): void {
    const entry = overlayMap.get(id)
    if (entry == null || mapInstance == null) return

    if (entry.type === 'marker' || entry.type === 'label') {
        const marker = markerMap.get(id)
        if (marker != null) marker.addTo(mapInstance)
    } else if (entry.layerId != null) {
        try {
            mapInstance.setLayoutProperty(entry.layerId, 'visibility', 'visible')
        } catch (e) { /* ignore */ }
    }
    entry.visible = true
    // v1.9.0: 图片覆盖物可见性状态同步（hit-test 与样式重建均读取该状态）
    const imgShow = imageOverlays.get(id)
    if (imgShow != null) {
        imgShow.visible = true
        imgShow.params.visible = true
    }
}

export function hideOverlay(id: number): void {
    const entry = overlayMap.get(id)
    if (entry == null || mapInstance == null) return

    if (entry.type === 'marker' || entry.type === 'label') {
        const marker = markerMap.get(id)
        if (marker != null) {
            try { marker.remove() } catch (e) { /* ignore */ }
        }
    } else if (entry.layerId != null) {
        try {
            mapInstance.setLayoutProperty(entry.layerId, 'visibility', 'none')
        } catch (e) { /* ignore */ }
    }
    entry.visible = false
    // v1.9.0: 图片覆盖物可见性状态同步（hit-test 与样式重建均读取该状态）
    const imgHide = imageOverlays.get(id)
    if (imgHide != null) {
        imgHide.visible = false
        imgHide.params.visible = false
    }
}

export function clearOverlays(): void {
    if (mapInstance == null) return
    overlayMap.forEach((entry, id) => {
        removeOverlayInternal(id)
    })
    overlayMap.clear()
    markerMap.clear()
    markerInfoMap.clear()
    polygonList = []
    polylineList = []
    circleList = []
    rectangleList = []
    labelList = []
    // v1.9.0: 清理图片覆盖物
    imageOverlays.clear()
    imageOverlayIds = []
    // 清理自定义瓦片
    customTileLayers.forEach((v, k) => { removeCustomTileLayerInternal(k) })
    customTileLayers.clear()
}

// ── 标记点击事件 ──
@UTSJS.keepAlive
export function setMarkerClickCallback(callback: MarkerClickCallback): void {
    markerClickCallback = callback
    // v1.7.1: 仅更新回调引用，不再遍历绑定——addMarker 已为每个 marker 绑定
    // 内部 listener（闭包读模块级回调），重复绑定会双重触发
}

// ═══════════════════════════════════════════════════════════
// 地图工具
// ═══════════════════════════════════════════════════════════

export function checkResize(): void {
    if (mapInstance != null) mapInstance.resize()
}

export function planBy(x: number, y: number): void {
    if (mapInstance != null) mapInstance.panBy([x, y])
}

export function setViewport(points: Array<MapClickDetail>): void {
    if (mapInstance == null || points.length === 0) return
    const bounds = new ((window as any).maplibregl).LngLatBounds()
    for (let i = 0; i < points.length; i++) {
        bounds.extend([points[i].lng, points[i].lat])
    }
    mapInstance.fitBounds(bounds, { padding: 40, maxZoom: 18 })
}

export function getSize(): MapSizeDetail {
    if (mapInstance == null) return { width: 0, height: 0 }
    const canvas = mapInstance.getCanvas()
    return { width: canvas.clientWidth, height: canvas.clientHeight }
}

export function getDistance(start: MapClickDetail, end: MapClickDetail): number {
    // Haversine formula
    const R = 6371000.0
    const dLat = (end.lat - start.lat) * PI / 180.0
    const dLng = (end.lng - start.lng) * PI / 180.0
    const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
        Math.cos(start.lat * PI / 180.0) * Math.cos(end.lat * PI / 180.0) *
        Math.sin(dLng / 2) * Math.sin(dLng / 2)
    const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a))
    return R * c
}

export function getViewport(points: Array<MapClickDetail>): MapViewportDetail {
    if (points.length === 0) return { center: { lat: 0, lng: 0 }, zoom: 0 }
    if (points.length === 1) return { center: points[0], zoom: 15 }

    let minLat = points[0].lat; let maxLat = points[0].lat
    let minLng = points[0].lng; let maxLng = points[0].lng
    for (let i = 1; i < points.length; i++) {
        if (points[i].lat < minLat) minLat = points[i].lat
        if (points[i].lat > maxLat) maxLat = points[i].lat
        if (points[i].lng < minLng) minLng = points[i].lng
        if (points[i].lng > maxLng) maxLng = points[i].lng
    }
    const centerLat = (minLat + maxLat) / 2.0
    const centerLng = (minLng + maxLng) / 2.0
    const spanLat = Math.abs(maxLat - minLat)
    const spanLng = Math.abs(maxLng - minLng)
    const maxSpan = spanLat > spanLng ? spanLat : spanLng
    let zoom = 15
    if (maxSpan > 0.0001) zoom = Math.floor(Math.log2(360.0 / maxSpan)) + 1
    if (zoom > 18) zoom = 18
    if (zoom < 3) zoom = 3
    return { center: { lat: centerLat, lng: centerLng }, zoom: zoom }
}

export function getCode(): string {
    return 'EPSG:4326'
}

// ═══════════════════════════════════════════════════════════
// 天地图 Web API
// ═══════════════════════════════════════════════════════════

function buildTdtApiUrl(endpoint: string, params: Map<string, string>): string {
    let url = TDT_API_BASE + endpoint + '?'
    params.set('tk', currentApiKey)
    let first = true
    params.forEach((value, key) => {
        if (!first) url += '&'
        url += encodeURIComponent(key) + '=' + encodeURIComponent(value)
        first = false
    })
    return url
}

function tdtHttpRequest(endpoint: string, params: Map<string, string>, callback: GeocodeCallback): void {
    const url = buildTdtApiUrl(endpoint, params)
    fetch(url)
        .then(response => response.json())
        .then(json => {
            if (callback != null) {
                // 将 JS object 包装为 UTSJSONObject
                const utsObj = new UTSJSONObject(JSON.stringify(json))
                callback(utsObj)
            }
        })
        .catch(err => {
            console.error('TDTMap Web: API 请求失败', endpoint, err)
            if (callback != null) {
                const utsObj = new UTSJSONObject(JSON.stringify({ status: '0', msg: '网络请求失败' }))
                callback(utsObj)
            }
        })
}

@UTSJS.keepAlive
export function geocode_getLocation(lnglat: MapClickDetail, callback: GeocodeCallback): void {
    const params = new Map<string, string>()
    // v1.7.1: 实测平铺参数（lon=&lat=&ver=1）返回 400 参数格式错误；
    // 官方格式为 postStr JSON + type=geocode（context7: lbs.tianditu.gov.cn geocoder 文档，与 Android/iOS 一致）
    const postStr = "{'lon':" + lnglat.lng.toString() + ",'lat':" + lnglat.lat.toString() + ",'ver':1}"
    params.set('postStr', postStr)
    params.set('type', 'geocode')
    tdtHttpRequest('/geocoder', params, callback)
}

@UTSJS.keepAlive
export function geocode_getPoint(address: string, callback: GeocodeCallback): void {
    const params = new Map<string, string>()
    // v1.7.1: 实测 address 平铺参数返回 400 参数格式错误；
    // 官方格式为 ds={"keyWord":...}（context7 实测，与 Android/iOS 一致）
    const ds = '{"keyWord":"' + address + '"}'
    params.set('ds', ds)
    tdtHttpRequest('/geocoder', params, callback)
}

// v1.7.1: context7 实测（2026-08 服务器端 Key 直测）：v2/search 现支持多 queryType——
// 12=行政区划(specify 必填)、3=周边(pointLonlat+queryRadius，无需 level)、
// 2=视野内(mapBound+level 必填)、1=普通(level+mapBound 必填)。
// v1.5.4 "仅 queryType=12 可用"结论已过时，周边/视野搜索恢复为专用 queryType；
// 缺关键参数时回退 queryType=12 保持可用（向后兼容）
function buildSearchParams(opt: SearchOptions, mode: string): Map<string, string> {
    const params = new Map<string, string>()
    let postJson: string
    if (mode === 'nearby' && opt.pointLonlat != null && opt.pointLonlat.length > 0) {
        postJson = '{"keyWord":"' + opt.keyWord + '","queryType":"3","pointLonlat":"' + opt.pointLonlat + '"'
        if (opt.queryRadius != null && opt.queryRadius.length > 0) {
            postJson += ',"queryRadius":"' + opt.queryRadius + '"'
        }
    } else if (mode === 'bounds' && opt.mapBound != null && opt.mapBound.length > 0) {
        const level = opt.level != null && opt.level.length > 0 ? opt.level : '12'
        postJson = '{"keyWord":"' + opt.keyWord + '","queryType":"2","mapBound":"' + opt.mapBound + '","level":"' + level + '"'
    } else {
        const specify = opt.specifyAdminCode != null && opt.specifyAdminCode.length > 0 ? opt.specifyAdminCode : '156000000'
        postJson = '{"keyWord":"' + opt.keyWord + '","queryType":"12","specify":"' + specify + '"'
    }
    if (opt.start != null) postJson += ',"start":"' + opt.start + '"'
    if (opt.count != null) postJson += ',"count":"' + opt.count + '"'
    postJson += '}'
    params.set('postStr', postJson)
    params.set('type', 'query')
    return params
}

@UTSJS.keepAlive
export function search(params: SearchOptions, callback: GeocodeCallback): void {
    tdtHttpRequest('/v2/search', buildSearchParams(params, 'search'), callback)
}

@UTSJS.keepAlive
export function searchInBounds(params: SearchOptions, callback: GeocodeCallback): void {
    tdtHttpRequest('/v2/search', buildSearchParams(params, 'bounds'), callback)
}

@UTSJS.keepAlive
export function searchNearby(params: SearchOptions, callback: GeocodeCallback): void {
    tdtHttpRequest('/v2/search', buildSearchParams(params, 'nearby'), callback)
}

// ═══════════════════════════════════════════════════════════
// v1.3.0: 定位
// ═══════════════════════════════════════════════════════════

let userLocationMarker: any = null
let userLocationShown: boolean = false

export function showUserLocation(enabled: boolean): void {
    if (mapInstance == null) return
    userLocationShown = enabled
    if (enabled && userLocationMarker == null) {
        // 使用浏览器 Geolocation API
        if (navigator.geolocation != null) {
            navigator.geolocation.getCurrentPosition(
                (pos) => {
                    const mlg = getMapLibre()
                    if (mlg == null) return
                    userLocationMarker = new mlg.Marker({ color: '#4285F4' })
                        .setLngLat([pos.coords.longitude, pos.coords.latitude])
                        .addTo(mapInstance)
                },
                (err) => {
                    console.error('TDTMap Web: 定位失败', err.message)
                }
            )
        }
    }
    if (!enabled && userLocationMarker != null) {
        userLocationMarker.remove()
        userLocationMarker = null
    }
}

@UTSJS.keepAlive
export function getUserLocation(
    callback: (detail: MapClickDetail) => void,
    onError?: (err: MapErrorDetail) => void
): void {
    if (navigator.geolocation == null) {
        if (onError != null) onError({ code: 4, message: '浏览器不支持定位' })
        return
    }
    navigator.geolocation.getCurrentPosition(
        (pos) => {
            callback({ lat: pos.coords.latitude, lng: pos.coords.longitude })
        },
        (err) => {
            if (onError != null) onError({ code: 2, message: '定位失败: ' + err.message })
        },
        { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 }
    )
}

// ═══════════════════════════════════════════════════════════
// v1.3.0: 信息窗口
// ═══════════════════════════════════════════════════════════

export function showMarkerInfo(id: number): void {
    const marker = markerMap.get(id)
    if (marker != null) {
        try { marker.togglePopup() } catch (e) { /* ignore */ }
    }
}

export function hideMarkerInfo(id: number): void {
    const marker = markerMap.get(id)
    if (marker != null) {
        try {
            // v1.7.1: togglePopup 是状态切换——popup 已关闭时调用会反而打开；
            // 关闭语义必须用 popup.remove()（context7: MapLibre GL JS Marker API）
            const popup = marker.getPopup()
            if (popup != null) popup.remove()
        } catch (e) { /* ignore */ }
    }
}

// ═══════════════════════════════════════════════════════════
// v1.3.0: 自定义瓦片图层
// ═══════════════════════════════════════════════════════════

function removeCustomTileLayerInternal(layerId: string): void {
    const entry = customTileLayers.get(layerId)
    if (entry == null || mapInstance == null) return
    try {
        if (mapInstance.getLayer(entry.layerId) != null) mapInstance.removeLayer(entry.layerId)
    } catch (e) { /* ignore */ }
    try {
        if (mapInstance.getSource(entry.sourceId) != null) mapInstance.removeSource(entry.sourceId)
    } catch (e) { /* ignore */ }
}

export function addCustomTileLayer(id: string, tileUrl: string, options?: TileLayerOptions): void {
    if (mapInstance == null) return
    const sourceId = 'custom-tile-src-' + id
    const layerId = 'custom-tile-layer-' + id

    try {
        mapInstance.addSource(sourceId, {
            type: 'raster',
            tiles: [tileUrl],
            tileSize: 256,
            minzoom: options?.minZoom ?? 1,
            maxzoom: options?.maxZoom ?? 18
        })
        const layerObj: any = {
            id: layerId,
            type: 'raster',
            source: sourceId,
            minzoom: options?.minZoom ?? 1,
            maxzoom: options?.maxZoom ?? 18,
            paint: { 'raster-opacity': options?.opacity ?? 1 }
        }
        if (options != null && options.zIndex == 0) {
            // zIndex=0: 插到天地图注记层之下（底图之上）；自定义样式无注记层时回退置顶防静默丢层
            if (mapInstance.getLayer('tdt-anno-layer') != null) {
                mapInstance.addLayer(layerObj, 'tdt-anno-layer')
            } else {
                mapInstance.addLayer(layerObj)
                console.warn('TDTMap Web: zIndex=0 但当前样式无注记层，已按默认置顶处理')
            }
        } else {
            mapInstance.addLayer(layerObj)
            if (options != null && options.zIndex != null && options.zIndex != 0) {
                console.warn('TDTMap Web: zIndex 仅支持 0（贴底）与 undefined（置顶），当前值已忽略')
            }
        }
        customTileLayers.set(id, { sourceId: sourceId, layerId: layerId, tileUrl: tileUrl, options: options ?? {} })
        customTileLayerIds.push(id)
    } catch (e: any) {
        console.error('TDTMap Web: addCustomTileLayer 失败', e)
    }
}

// v1.8.0: WMS GetMap 模板拼装。
// context7 验证：{bbox-epsg-3857} 为 MapLibre style spec 标准占位符（style spec 官方 + 天地图官方文档确认）
function buildWmsTileUrl(wmsUrl: string, layers: string): string {
    const sep = wmsUrl.indexOf('?') >= 0 ? '&' : '?'
    return wmsUrl + sep + 'SERVICE=WMS&REQUEST=GetMap&VERSION=1.1.1&LAYERS=' + layers +
        '&STYLES=&FORMAT=image/png&TRANSPARENT=true&SRS=EPSG:3857&BBOX={bbox-epsg-3857}&WIDTH=256&HEIGHT=256'
}

export function addWMSTileLayer(id: string, wmsUrl: string, layers: string, options?: TileLayerOptions): void {
    addCustomTileLayer(id, buildWmsTileUrl(wmsUrl, layers), options)
}

// v1.8.0: 样式切换后重建用户数据图层（按添加顺序重放）
function rebuildUserLayersAfterStyle(): void {
    const ids = customTileLayerIds.slice()
    customTileLayerIds = []
    const saved: Array<any> = []
    for (let i = 0; i < ids.length; i++) {
        const info = customTileLayers.get(ids[i])
        if (info != null) saved.push({ id: ids[i], info: info })
    }
    customTileLayers.clear()
    for (let i = 0; i < saved.length; i++) {
        addCustomTileLayer(saved[i].id, saved[i].info.tileUrl, saved[i].info.options)
    }
    if (clusterDataRef != null) {
        const pts = clusterDataRef
        const opts = clusterOptionsRef
        clusterDataRef = null
        clusterOptionsRef = null
        addMarkerCluster(pts, opts)
    }
    if (heatmapDataRef != null) {
        const pts = heatmapDataRef
        const opts = heatmapOptionsRef
        heatmapDataRef = null
        heatmapOptionsRef = null
        addHeatmap(pts, opts)
    }
    // v1.9.0: 图片覆盖物重放（快照 params → 清状态 → 按原 ID 与添加顺序重建；URL 由浏览器 HTTP 缓存自然去重）
    if (imageOverlayIds.length > 0) {
        const savedImgs: Array<any> = []
        for (let i = 0; i < imageOverlayIds.length; i++) {
            const oid = imageOverlayIds[i]
            const info = imageOverlays.get(oid)
            if (info != null) savedImgs.push({ id: oid, params: info.params })
        }
        imageOverlays.clear()
        imageOverlayIds = []
        for (let i = 0; i < savedImgs.length; i++) {
            addImageOverlayInternal(savedImgs[i].params, savedImgs[i].id)
        }
    }
    // v1.9.0: E0 GeoJSON 层重放通知（组件层持有 geojson/options 快照与编排逻辑，原生层只负责通知时机）
    const replayCb = geoJsonReplayCallback
    if (replayCb != null) {
        replayCb()
    }
}

// v1.8.0: 样式完成监听注册（保证任意时刻只有一个待触发监听，
// 防止快速连续 setStyle/removeStyle 时多个 once 监听同时触发导致重复重建、状态与地图脱节）
// context7 修正：MapLibre GL JS 的 map 事件列表不存在 'style.load'（那是 Style 对象私有事件），
// setStyle 换样式完成后触发的是 'styledata'（官方文档：Fired whenever the map's style changes）。
// 浏览器实测：setStyle 后事件序列仅 styledata（POC v1.8.0 实测发现 'style.load' 永不触发）
let styleLoadHandler: (() => void) | null = null

function registerStyleLoadHandler(fn: () => void): void {
    if (mapInstance == null) return
    if (styleLoadHandler != null) {
        mapInstance.off('styledata', styleLoadHandler)
    }
    styleLoadHandler = fn
    mapInstance.once('styledata', styleLoadHandler)
}

export function setStyle(styleJson: string): void {
    if (mapInstance == null) return
    let parsed: any = null
    try {
        parsed = JSON.parse(styleJson)
    } catch (e: any) {
        console.error('TDTMap Web: setStyle JSON 解析失败', e)
        if (mapErrorCallback != null) {
            mapErrorCallback({ code: 4, message: 'setStyle JSON 解析失败' })
        }
        return
    }
    if (parsed == null || parsed.version == null) {
        if (mapErrorCallback != null) {
            mapErrorCallback({ code: 4, message: 'setStyle 需为含 version 字段的 MapLibre Style Spec JSON' })
        }
        return
    }
    mapInstance.setStyle(parsed)
    registerStyleLoadHandler((): void => {
        rebuildUserLayersAfterStyle()
    })
}

export function removeStyle(): void {
    if (mapInstance == null) return
    // v1.9.0: blank 底图恢复时初始样式直接带白底层；瓦片底图恢复空 layers 后重建天地图层
    const isBlankRestore = currentMapType == 'blank'
    const cfg = isBlankRestore ? null : LAYER_CONFIG.get(currentMapType)
    if (!isBlankRestore && cfg == null) return
    mapInstance.setStyle({
        version: 8,
        glyphs: GLYPHS_ENDPOINT,
        sources: {},
        layers: isBlankRestore ? [blankBackgroundLayer()] : []
    })
    registerStyleLoadHandler((): void => {
        if (mapInstance == null) return
        if (!isBlankRestore && cfg != null) {
            addTdtBaseLayers(mapInstance, cfg)
        }
        rebuildUserLayersAfterStyle()
    })
}

export function isSupportCanvas(): boolean {
    // Web 的 MapLibre GL JS 支持 HTML/canvas Marker
    return true
}

export function removeCustomTileLayer(id: string): void {
    removeCustomTileLayerInternal(id)
    customTileLayers.delete(id)
    // v1.8.0: 同步清理平行数组
    const newIds: Array<string> = []
    for (let i = 0; i < customTileLayerIds.length; i++) {
        if (customTileLayerIds[i] != id) newIds.push(customTileLayerIds[i])
    }
    customTileLayerIds = newIds
}

// ═══════════════════════════════════════════════════════════
// v1.4.0: 地图交互增强
// ═══════════════════════════════════════════════════════════

@UTSJS.keepAlive
export function setMapLongClickCallback(callback: MapLongClickCallback): void {
    mapLongClickCallback = callback
}

export function setBearing(bearing: number): void {
    if (mapInstance != null) {
        mapInstance.setBearing(bearing)
    }
}

export function setTilt(tilt: number): void {
    if (mapInstance != null) {
        mapInstance.setPitch(tilt)
    }
}

export function getBearing(): number {
    if (mapInstance == null) return 0
    return mapInstance.getBearing()
}

export function getTilt(): number {
    if (mapInstance == null) return 0
    return mapInstance.getPitch()
}

export function enableRotate(enabled: boolean): void {
    if (mapInstance == null) return
    if (enabled) {
        mapInstance.touchZoomRotate.enableRotation()
    } else {
        mapInstance.touchZoomRotate.disableRotation()
    }
}

export function enableTilt(enabled: boolean): void {
    if (mapInstance == null) return
    if (enabled) {
        mapInstance.setPitch(60)  // 恢复最大倾斜
        mapInstance.touchPitch.enable()
    } else {
        mapInstance.setPitch(0)
        mapInstance.touchPitch.disable()
    }
}

@UTSJS.keepAlive
export function setCameraChangeCallback(callback: CameraChangeCallback): void {
    cameraChangeCallback = callback
}

// ═══════════════════════════════════════════════════════════
// v1.7.0: 标记聚合（context7: MapLibre 官方 create-and-style-clusters 示例）
// cluster:true 后引擎自动生成 point_count / cluster_id 属性；
// 三个图层：聚合簇圆点 / 聚合簇数量文字 / 未聚合原始点
// ═══════════════════════════════════════════════════════════
let clusterLayerIds: Array<string> = []

function removeClusterInternal(): void {
    if (mapInstance == null) return
    // v1.8.0: 清理数据快照
    clusterDataRef = null
    clusterOptionsRef = null
    // 移除 click 监听（幂等：off 未注册的监听不报错）
    mapInstance.off('click', 'tdt-cluster-layer', onClusterClick)
    for (let i = 0; i < clusterLayerIds.length; i++) {
        try { mapInstance.removeLayer(clusterLayerIds[i]) } catch (e) { /* ignore */ }
    }
    clusterLayerIds = []
    try { mapInstance.removeSource('tdt-cluster-source') } catch (e) { /* ignore */ }
}

function onClusterClick(e: any): void {
    try {
        const features = mapInstance?.queryRenderedFeatures(e.point, { layers: ['tdt-cluster-layer'] })
        if (features == null || features.length == 0) return
        const clusterId = features[0].properties.cluster_id
        if (clusterId == null) return
        const src = mapInstance?.getSource('tdt-cluster-source') as any
        if (src == null) return
        src.getClusterExpansionZoom(clusterId).then((zoom: number) => {
            const coords = features[0].geometry.coordinates
            mapInstance?.easeTo({ center: [coords[0], coords[1]], zoom: zoom })
        }).catch((err: any) => {
            console.error('TDTMap Web: getClusterExpansionZoom 失败', err)
        })
    } catch (err: any) {
        console.error('TDTMap Web: 聚合点击处理失败', err)
    }
}

export function addMarkerCluster(points: Array<MapClickDetail>, options?: ClusterOptions): void {
    if (mapInstance == null) return
    removeClusterInternal()
    if (points.length == 0) return
    try {
        const features: Array<any> = []
        for (let i = 0; i < points.length; i++) {
            features.push({
                type: 'Feature',
                geometry: { type: 'Point', coordinates: [points[i].lng, points[i].lat] },
                properties: {}
            })
        }
        mapInstance.addSource('tdt-cluster-source', {
            type: 'geojson',
            data: { type: 'FeatureCollection', features: features },
            cluster: true,
            clusterRadius: options?.clusterRadius ?? 50,
            clusterMaxZoom: options?.clusterMaxZoom ?? 14
        })
        // 聚合簇圆点（step 表达式按数量分级着色/分级半径）
        mapInstance.addLayer({
            id: 'tdt-cluster-layer',
            type: 'circle',
            source: 'tdt-cluster-source',
            filter: ['has', 'point_count'],
            paint: {
                'circle-color': ['step', ['get', 'point_count'], '#51BBD6', 100, '#F1F075', 750, '#F28CB1'],
                'circle-radius': ['step', ['get', 'point_count'], 20, 100, 30, 750, 40],
                'circle-stroke-width': 1,
                'circle-stroke-color': '#FFFFFF'
            }
        })
        clusterLayerIds.push('tdt-cluster-layer')
        // 聚合簇数量文字
        mapInstance.addLayer({
            id: 'tdt-cluster-count',
            type: 'symbol',
            source: 'tdt-cluster-source',
            filter: ['has', 'point_count'],
            layout: {
                'text-field': '{point_count_abbreviated}',
                'text-font': ['Open Sans Semibold'],
                'text-size': 12
            }
        })
        clusterLayerIds.push('tdt-cluster-count')
        // 未聚合的原始点
        mapInstance.addLayer({
            id: 'tdt-cluster-unclustered',
            type: 'circle',
            source: 'tdt-cluster-source',
            filter: ['!', ['has', 'point_count']],
            paint: {
                'circle-color': '#11B4DA',
                'circle-radius': 5,
                'circle-stroke-width': 1,
                'circle-stroke-color': '#FFFFFF'
            }
        })
        clusterLayerIds.push('tdt-cluster-unclustered')
        mapInstance.on('click', 'tdt-cluster-layer', onClusterClick)
        // v1.8.0: 保存数据快照（样式切换后重建）
        clusterDataRef = points
        clusterOptionsRef = options ?? null
    } catch (e: any) {
        console.error('TDTMap Web: addMarkerCluster 失败', e)
    }
}

export function removeMarkerCluster(): void {
    removeClusterInternal()
}

// ═══════════════════════════════════════════════════════════
// v1.7.0: 热力图（context7: MapLibre 官方 heatmap 图层示例）
// heatmap-weight 取数据 weight 属性，radius/opacity 可配
// ═══════════════════════════════════════════════════════════
export function addHeatmap(points: Array<HeatmapItem>, options?: HeatmapOptions): void {
    if (mapInstance == null) return
    removeHeatmap()
    if (points.length == 0) return
    try {
        const features: Array<any> = []
        for (let i = 0; i < points.length; i++) {
            features.push({
                type: 'Feature',
                geometry: { type: 'Point', coordinates: [points[i].lng, points[i].lat] },
                properties: { weight: points[i].weight ?? 1 }
            })
        }
        mapInstance.addSource('tdt-heatmap-source', {
            type: 'geojson',
            data: { type: 'FeatureCollection', features: features }
        })
        mapInstance.addLayer({
            id: 'tdt-heatmap-layer',
            type: 'heatmap',
            source: 'tdt-heatmap-source',
            paint: {
                'heatmap-weight': ['get', 'weight'],
                'heatmap-radius': options?.radius ?? 30,
                'heatmap-opacity': options?.opacity ?? 0.6,
                'heatmap-color': [
                    'interpolate', ['linear'], ['heatmap-density'],
                    0, 'rgba(0, 0, 255, 0)',
                    0.2, 'rgb(0, 0, 255)',
                    0.4, 'rgb(0, 255, 0)',
                    0.6, 'rgb(255, 255, 0)',
                    0.8, 'rgb(255, 165, 0)',
                    1, 'rgb(255, 0, 0)'
                ]
            }
        })
        // v1.8.0: 保存数据快照（样式切换后重建）
        heatmapDataRef = points
        heatmapOptionsRef = options ?? null
    } catch (e: any) {
        console.error('TDTMap Web: addHeatmap 失败', e)
    }
}

export function removeHeatmap(): void {
    if (mapInstance == null) return
    // v1.8.0: 清理数据快照
    heatmapDataRef = null
    heatmapOptionsRef = null
    try { mapInstance.removeLayer('tdt-heatmap-layer') } catch (e) { /* ignore */ }
    try { mapInstance.removeSource('tdt-heatmap-source') } catch (e) { /* ignore */ }
}

// ═════════════════════════════════════════════════════════
// v1.9.0: 图片覆盖物（image source + raster layer）
// 点击检测用几何 hit-test（raster 图层无要素，queryRenderedFeatures 不可用）
// ═════════════════════════════════════════════════════════

// zIndex 档位键：未定义=置顶组(1e6) / 正整数=按值排序 / 0 及以下=贴底组(-1)
// （与 TileLayerOptions.zIndex 三档约定一致，负值统一按 0 档处理）
function imageOverlayZKey(z: number | null): number {
    if (z == null) return 1000000
    if (z <= 0) return -1
    return z
}

// 在现有图片层中找第一个档位键更大的层，返回其 layerId 作为插入位置（beforeId）；
// 空串表示追加置顶。excludeId 用于自身重插时排除自己
function imageOverlayBeforeLayerId(newKey: number, excludeId: number): string {
    for (let i = 0; i < imageOverlayIds.length; i++) {
        const oid = imageOverlayIds[i]
        if (oid == excludeId) continue
        const info = imageOverlays.get(oid)
        if (info == null) continue
        const key = imageOverlayZKey(info.params.zIndex ?? null)
        if (key > newKey) return info.layerId
    }
    return ''
}

// 图片层渲染序定位：返回 excludeId 之外渲染序最靠前（最下方）的图片层 layerId；空串表示无
// （zIndex=0 档无注记层时的降级锚点，保证 add/update 两分支行为一致；图片层数量少，双层遍历可接受）
function lowestImageLayerId(excludeId: number): string {
    const map = mapInstance
    if (map == null) return ''
    const layers = map.getStyle()?.layers
    if (layers == null) return ''
    let lowestId = ''
    let lowestIdx = 2147483647
    for (let i = 0; i < imageOverlayIds.length; i++) {
        const oid = imageOverlayIds[i]
        if (oid == excludeId) continue
        const info = imageOverlays.get(oid)
        if (info == null) continue
        if (map.getLayer(info.layerId) == null) continue
        for (let j = 0; j < layers.length; j++) {
            if (layers[j].id == info.layerId && j < lowestIdx) {
                lowestIdx = j
                lowestId = info.layerId
                break
            }
        }
    }
    return lowestId
}

// ── 图片覆盖物几何工具（Android/iOS/Web 三端同版纯函数，修改须三端同步） ──

// Web Mercator 正投影：x=经度，y=墨卡托 Y（避免高纬度经纬直接旋转形变）
function mercatorY(lat: number): number {
    const rad = lat * Math.PI / 180.0
    return Math.log(Math.tan(Math.PI / 4.0 + rad / 2.0))
}
function inverseMercatorY(y: number): number {
    return (2.0 * Math.atan(Math.exp(y)) - Math.PI / 2.0) * 180.0 / Math.PI
}

// 计算图片四角坐标（image source 官方顺序：左上/右上/右下/左下，顺时针，[lng,lat] 对）
// bearing≠0 时四角在 Web Mercator 平面绕中心旋转后反投影（顺时针=数学负角）
function computeImageQuad(sw: MapClickDetail, ne: MapClickDetail, bearing: number): Array<Array<number>> {
    const corners: Array<Array<number>> = [
        [sw.lng, ne.lat],
        [ne.lng, ne.lat],
        [ne.lng, sw.lat],
        [sw.lng, sw.lat]
    ]
    if (bearing == 0) return corners
    const rad = -bearing * Math.PI / 180.0
    const cx = (sw.lng + ne.lng) / 2.0
    const cyM = (mercatorY(sw.lat) + mercatorY(ne.lat)) / 2.0
    const out: Array<Array<number>> = []
    for (let i = 0; i < 4; i++) {
        const x = corners[i][0] - cx
        const y = mercatorY(corners[i][1]) - cyM
        const rx = x * Math.cos(rad) - y * Math.sin(rad)
        const ry = x * Math.sin(rad) + y * Math.cos(rad)
        out.push([cx + rx, inverseMercatorY(cyM + ry)])
    }
    return out
}

// 点击命中检测：点击点正向旋转回未旋转 bounds 坐标系后与轴对齐半宽半高比较（与 computeImageQuad 互逆）
function hitTestImageOverlay(lat: number, lng: number, params: ImageOverlayOptions): boolean {
    const sw = params.southwest
    const ne = params.northeast
    const bearing = params.bearing ?? 0
    if (bearing == 0) {
        return lat >= sw.lat && lat <= ne.lat && lng >= sw.lng && lng <= ne.lng
    }
    const rad = bearing * Math.PI / 180.0
    const cx = (sw.lng + ne.lng) / 2.0
    const cyM = (mercatorY(sw.lat) + mercatorY(ne.lat)) / 2.0
    const x = lng - cx
    const y = mercatorY(lat) - cyM
    const rx = x * Math.cos(rad) - y * Math.sin(rad)
    const ry = x * Math.sin(rad) + y * Math.cos(rad)
    const halfW = (ne.lng - sw.lng) / 2.0
    const halfH = (mercatorY(ne.lat) - mercatorY(sw.lat)) / 2.0
    return Math.abs(rx) <= halfW && Math.abs(ry) <= halfH
}

// Web 端图片地址校验：仅支持 http(s)/data: URL（浏览器无法读本机路径）
function isValidWebImageUrl(url: string): boolean {
    return url.indexOf('http://') == 0 || url.indexOf('https://') == 0 || url.indexOf('data:') == 0
}

// 内部添加（addImageOverlay 与样式重建重放共用；replayId>0 时沿用原 ID 不重取号）
function addImageOverlayInternal(params: ImageOverlayOptions, replayId: number): number {
    const map = mapInstance
    if (map == null) return 0
    if (!isValidWebImageUrl(params.image)) {
        if (mapErrorCallback != null) {
            mapErrorCallback({ code: 4, message: 'Web 端图片覆盖物仅支持 http(s)/data: URL，收到: ' + params.image.substring(0, 64) })
        }
        return 0
    }
    const id = replayId > 0 ? replayId : genOverlayId()
    const sourceId = 'img-overlay-src-' + id
    const layerId = 'img-overlay-layer-' + id
    try {
        map.addSource(sourceId, {
            type: 'image',
            url: params.image,
            coordinates: computeImageQuad(params.southwest, params.northeast, params.bearing ?? 0)
        })
        const layerDef: any = {
            id: layerId,
            type: 'raster',
            source: sourceId,
            paint: { 'raster-opacity': 1.0 - (params.transparency ?? 0) }
        }
        if (params.visible == false) {
            layerDef.layout = { visibility: 'none' }
        }
        const z = params.zIndex
        if (z != null && z <= 0) {
            // 0 档：插到天地图注记层之下（底图之上）；自定义样式无注记层时降级到其余图片层最下方
            //（无其他图片层则置顶，防止静默丢层——与瓦片层回退初衷一致）
            if (map.getLayer('tdt-anno-layer') != null) {
                map.addLayer(layerDef, 'tdt-anno-layer')
            } else {
                const lowestId = lowestImageLayerId(replayId)
                if (lowestId.length > 0) {
                    map.addLayer(layerDef, lowestId)
                } else {
                    map.addLayer(layerDef)
                }
                console.warn('TDTMap Web: 图片覆盖物 zIndex=0 但当前样式无注记层，已按图片层最下处理')
            }
        } else {
            const beforeId = imageOverlayBeforeLayerId(imageOverlayZKey(z), replayId)
            if (beforeId.length > 0) {
                map.addLayer(layerDef, beforeId)
            } else {
                map.addLayer(layerDef)
            }
        }
        const visible = params.visible ?? true
        imageOverlays.set(id, { params: params, sourceId: sourceId, layerId: layerId, visible: visible })
        overlayMap.set(id, { type: 'image', sourceId: sourceId, layerId: layerId, visible: visible })
        imageOverlayIds.push(id)
        return id
    } catch (e: any) {
        console.error('TDTMap Web: addImageOverlay 失败', e)
        try { if (map.getLayer(layerId) != null) map.removeLayer(layerId) } catch (e2) { /* ignore */ }
        try { if (map.getSource(sourceId) != null) map.removeSource(sourceId) } catch (e3) { /* ignore */ }
        if (mapErrorCallback != null) {
            mapErrorCallback({ code: 4, message: '添加图片覆盖物失败: ' + (e.message ?? String(e)) })
        }
        return 0
    }
}

export function addImageOverlay(params: ImageOverlayOptions): number {
    return addImageOverlayInternal(params, 0)
}

export function updateImageOverlay(id: number, changes: ImageOverlayUpdateOptions): void {
    const info = imageOverlays.get(id)
    const map = mapInstance
    if (info == null || map == null) return
    const p = info.params
    const oldZ = p.zIndex ?? null
    // 合并变更（未传字段保持不变）；换图先校验 URL 合法性，非法则整体拒绝上报 code=4
    if (changes.image != null) {
        if (!isValidWebImageUrl(changes.image)) {
            if (mapErrorCallback != null) {
                mapErrorCallback({ code: 4, message: 'Web 端图片覆盖物仅支持 http(s)/data: URL' })
            }
            return
        }
    }
    if (changes.southwest != null) p.southwest = changes.southwest
    if (changes.northeast != null) p.northeast = changes.northeast
    if (changes.image != null) p.image = changes.image
    if (changes.transparency != null) p.transparency = changes.transparency
    if (changes.zIndex != null) p.zIndex = changes.zIndex
    if (changes.bearing != null) p.bearing = changes.bearing
    if (changes.visible != null) p.visible = changes.visible
    if (changes.clickable != null) p.clickable = changes.clickable
    try {
        // 图片/范围/旋转变化：updateImage 同时换 URL 与坐标（image source 官方 API）
        if (changes.image != null || changes.southwest != null || changes.northeast != null || changes.bearing != null) {
            const src = map.getSource(info.sourceId) as any
            if (src != null && src.updateImage != null) {
                src.updateImage({
                    url: p.image,
                    coordinates: computeImageQuad(p.southwest, p.northeast, p.bearing ?? 0)
                })
            } else {
                if (mapErrorCallback != null) {
                    mapErrorCallback({ code: 4, message: '图片覆盖物更新失败: image source 不支持 updateImage' })
                }
            }
        }
        if (changes.transparency != null) {
            map.setPaintProperty(info.layerId, 'raster-opacity', 1.0 - (p.transparency ?? 0))
        }
        if (changes.visible != null) {
            const visible = p.visible != false
            map.setLayoutProperty(info.layerId, 'visibility', visible ? 'visible' : 'none')
            info.visible = visible
            const entry = overlayMap.get(id)
            if (entry != null) entry.visible = visible
        }
        // zIndex 档位变化：moveLayer 重定位（source 不动）；无注记层时降级到其余图片层最下方（与 add 分支一致）
        if (changes.zIndex != null && imageOverlayZKey(p.zIndex ?? null) != imageOverlayZKey(oldZ)
            && map.getLayer(info.layerId) != null) {
            const z = p.zIndex
            if (z != null && z <= 0) {
                if (map.getLayer('tdt-anno-layer') != null) {
                    map.moveLayer(info.layerId, 'tdt-anno-layer')
                } else {
                    const lowestId = lowestImageLayerId(id)
                    if (lowestId.length > 0) {
                        map.moveLayer(info.layerId, lowestId)
                    }
                }
            } else {
                const beforeId = imageOverlayBeforeLayerId(imageOverlayZKey(z), id)
                if (beforeId.length > 0) {
                    map.moveLayer(info.layerId, beforeId)
                } else {
                    map.moveLayer(info.layerId)
                }
            }
        }
    } catch (e: any) {
        console.error('TDTMap Web: updateImageOverlay 失败', e)
        if (mapErrorCallback != null) {
            mapErrorCallback({ code: 4, message: '更新图片覆盖物失败: ' + (e.message ?? String(e)) })
        }
    }
}

@UTSJS.keepAlive
export function setImageOverlayClickCallback(callback: ImageOverlayClickCallback | null): void {
    // 仅更新回调引用；命中检测在 initMap 注册的单一 click 监听内执行（与 Android Priority 链同源）
    imageOverlayClickCallback = callback
}

// v1.9.0: E0 GeoJSON 层重放通知注册（触发点：rebuildUserLayersAfterStyle 末尾）
export function setGeoJsonReplayCallback(callback: GeoJsonReplayCallback | null): void {
    geoJsonReplayCallback = callback
}
