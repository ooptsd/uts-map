<template>
  <view class="page">
    <!-- 地图组件 -->
    <tdt-map
      ref="mapRef"
      class="map"
      :latitude="39.9042"
      :longitude="116.4075"
      :zoom="12"
      map-type="vec"
      @mapReady="onMapReady"
      @mapClick="onMapClick"
      @mapError="onMapError"
      @markertap="onMarkerTap"
      @mapLongClick="onMapLongClick"
      @cameraChange="onCameraChange"
      @imageOverlayClick="onImageOverlayClick"
    />

    <!-- 控制面板 -->
    <view class="panel">
      <scroll-view scroll-y="true" class="panel-scroll">
        <text class="section-title">🗺️ 地图类型</text>
        <view class="btn-row">
          <button class="btn" @tap="changeMapType('vec')">矢量</button>
          <button class="btn" @tap="changeMapType('img')">影像</button>
          <button class="btn" @tap="changeMapType('ter')">地形</button>
          <button class="btn" @tap="changeMapType('blank')">白底</button>
        </view>

        <text class="section-title">🔍 视野控制</text>
        <view class="btn-row">
          <button class="btn" @tap="zoomInOne">放大</button>
          <button class="btn" @tap="zoomOutOne">缩小</button>
          <button class="btn" @tap="fitBoundsDemo">适应范围</button>
          <button class="btn" @tap="doPlanBy">平移(50,50)</button>
          <button class="btn" @tap="doSetViewport">多点视野</button>
          <button class="btn" @tap="doCheckResize">刷新布局</button>
        </view>

        <text class="section-title">✋ 手势开关</text>
        <view class="btn-row">
          <button class="btn" @tap="setZoomEnabled(true)">允许缩放</button>
          <button class="btn" @tap="setZoomEnabled(false)">禁止缩放</button>
          <button class="btn" @tap="setDragEnabled(true)">允许拖拽</button>
          <button class="btn" @tap="setDragEnabled(false)">禁止拖拽</button>
        </view>

        <text class="section-title">📍 标记点</text>
        <view class="btn-row">
          <button class="btn" @tap="addSingleMarker">添加标记</button>
          <button class="btn" @tap="batchMarkers">批量标记</button>
          <button class="btn" @tap="clearAllMarkers">清除标记</button>
        </view>

        <text class="section-title">📐 覆盖物</text>
        <view class="btn-row">
          <button class="btn" @tap="drawPolyline">折线</button>
          <button class="btn" @tap="drawCircle">圆</button>
          <button class="btn" @tap="drawRectangle">矩形</button>
          <button class="btn" @tap="drawPolygon">多边形</button>
          <button class="btn" @tap="drawLabel">文字标注</button>
          <button class="btn btn-danger" @tap="clearAllOverlays">清除全部</button>
        </view>

        <text class="section-title">🎯 覆盖物管理（新增）</text>
        <view class="btn-row">
          <button class="btn" @tap="hideLastOverlay">隐藏最后</button>
          <button class="btn" @tap="showLastOverlay">显示最后</button>
          <button class="btn btn-danger" @tap="removeLastOverlay">移除最后</button>
        </view>

        <text class="section-title">🧮 信息计算（新增）</text>
        <view class="btn-row">
          <button class="btn" @tap="calcDistance">测距</button>
          <button class="btn" @tap="calcViewport">最佳视野</button>
          <button class="btn" @tap="doGetCode">坐标系</button>
          <button class="btn" @tap="doGetSize">容器尺寸</button>
        </view>

        <text class="section-title">🌐 天地图搜索（新增）</text>
        <view class="btn-row">
          <button class="btn" @tap="doReverseGeocode">逆地理编码</button>
          <button class="btn" @tap="doForwardGeocode">地理编码</button>
          <button class="btn" @tap="doSearch">关键字搜索</button>
          <button class="btn" @tap="doSearchNearby">周边搜索</button>
        </view>

        <text class="section-title">📍 定位（v1.3.0 新增）</text>
        <view class="btn-row">
          <button class="btn" @tap="showUserLoc">显示定位蓝点</button>
          <button class="btn" @tap="hideUserLoc">隐藏定位蓝点</button>
          <button class="btn" @tap="getUserLoc">获取当前位置</button>
        </view>

        <text class="section-title">💬 信息窗口（v1.3.0 新增）</text>
        <view class="btn-row">
          <button class="btn" @tap="showMarkerInfoDemo">显示信息窗</button>
          <button class="btn" @tap="hideMarkerInfoDemo">隐藏信息窗</button>
        </view>

        <text class="section-title">🖼️ 自定义瓦片（v1.3.0 新增）</text>
        <view class="btn-row">
          <button class="btn" @tap="addCustomTile">添加瓦片图层</button>
          <button class="btn btn-danger" @tap="removeCustomTile">移除瓦片图层</button>
        </view>

        <text class="section-title">🧭 坐标转换</text>
        <view class="btn-row">
          <button class="btn" @tap="convertCoord">GCJ02→WGS84</button>
        </view>
        <text v-if="coordResult.length > 0" class="result-text">{{ coordResult }}</text>

        <text class="section-title">🔄 地图旋转（v1.4.0 新增）</text>
        <view class="btn-row">
          <button class="btn" @tap="setBearing0">正北(0°)</button>
          <button class="btn" @tap="setBearing90">东(90°)</button>
          <button class="btn" @tap="setBearing180">南(180°)</button>
          <button class="btn" @tap="setBearing270">西(270°)</button>
          <button class="btn" @tap="showBearing">查询旋转</button>
        </view>

        <text class="section-title">⛰️ 地图倾斜（v1.4.0 新增）</text>
        <view class="btn-row">
          <button class="btn" @tap="setTilt30">倾斜30°</button>
          <button class="btn" @tap="setTilt60">倾斜60°</button>
          <button class="btn" @tap="setTilt0">回正(0°)</button>
          <button class="btn" @tap="showTilt">查询倾斜</button>
        </view>

        <text class="section-title">✋ 手势进阶（v1.4.0 新增）</text>
        <view class="btn-row">
          <button class="btn" @tap="setRotateEnabled(true)">允许旋转</button>
          <button class="btn" @tap="setRotateEnabled(false)">禁止旋转</button>
          <button class="btn" @tap="setTiltEnabledD(true)">允许倾斜</button>
          <button class="btn" @tap="setTiltEnabledD(false)">禁止倾斜</button>
        </view>

        <text class="section-title">📸 截图 & 信息</text>
        <view class="btn-row">
          <button class="btn" @tap="takeSnapshot">截图</button>
          <button class="btn" @tap="showCenter">中心坐标</button>
          <button class="btn" @tap="showZoom">缩放级别</button>
          <button class="btn" @tap="showBounds">视野范围</button>
        </view>
        <text v-if="infoText.length > 0" class="result-text">{{ infoText }}</text>

        <text class="section-title">📊 数据可视化（v1.7.0 新增）</text>
        <view class="btn-row">
          <button class="btn" @tap="demoCluster">300点聚合</button>
          <button class="btn" @tap="clearCluster">清除聚合</button>
          <button class="btn" @tap="demoHeatmap">热力图</button>
          <button class="btn" @tap="clearHeatmap">清除热力</button>
        </view>

        <text class="section-title">🎨 图层增强（v1.8.0 新增）</text>
        <view class="btn-row">
          <button class="btn" @tap="demoSetStyle">setStyle</button>
          <button class="btn" @tap="demoRemoveStyle">removeStyle</button>
          <button class="btn" @tap="demoWms">WMS 叠加</button>
          <button class="btn" @tap="demoCanvas">canvas 探测</button>
          <button class="btn" @tap="demoClearBounds">清除边界</button>
        </view>

        <text class="section-title">🖼️ 图片覆盖物（v1.9.0 新增）</text>
        <view class="btn-row">
          <button class="btn" @tap="demoAddImage">添加网络图</button>
          <button class="btn" @tap="demoImageTransparency">半透明</button>
          <button class="btn" @tap="demoImageBearing">旋转45°</button>
          <button class="btn" @tap="demoImageSwap">换图</button>
          <button class="btn" @tap="demoImageUpdateBounds">移位回正</button>
          <button class="btn btn-danger" @tap="demoRemoveImage">移除</button>
        </view>

        <text class="section-title">🧩 GeoJSON 图层（v1.9.0 新增）</text>
        <view class="btn-row">
          <button class="btn" @tap="demoAddGeoPolygon">基本多边形</button>
          <button class="btn" @tap="demoAddGeoMultiHole">多面带洞</button>
          <button class="btn" @tap="demoAddGeoDashLine">邻省虚线</button>
          <button class="btn" @tap="demoAddGeoLabels">粤界标注</button>
          <button class="btn" @tap="demoHideGeoLayer">隐藏整层</button>
          <button class="btn" @tap="demoShowGeoLayer">显示整层</button>
          <button class="btn btn-danger" @tap="demoRemoveGeoLayer">移除整层</button>
        </view>

        <text class="section-title">🗺️ 地图事件日志</text>
        <text v-if="clickLog.length > 0" class="result-text">{{ clickLog }}</text>
      </scroll-view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import type { MapClickDetail, MapErrorDetail, MapBoundsDetail, GeocodeCallback, SearchOptions, ClusterOptions, HeatmapItem, ImageOverlayClickDetail, GeoJsonLayerOptions, GeoJsonLabelStyle } from '@/uni_modules/beige-tdt-map'

const mapRef = ref(null as any | null)
const coordResult = ref('')
const infoText = ref('')
const clickLog = ref('')
const isReady = ref(false)

// 追踪最后添加的 overlay ID（用于单个管理演示）
let lastOverlayId: number = 0

// ── 事件回调 ──

function onMapReady(): void {
  isReady.value = true
  console.log('TDTMap Demo: 地图就绪')
}

function onMapClick(detail: MapClickDetail): void {
  clickLog.value = '点击位置: ' + detail.lat.toFixed(6) + ', ' + detail.lng.toFixed(6)
  console.log('TDTMap Demo: 点击', detail.lat, detail.lng)
}

function onMarkerTap(detail: MapClickDetail): void {
  infoText.value = '标记点击: ' + detail.lat.toFixed(6) + ', ' + detail.lng.toFixed(6)
  console.log('TDTMap Demo: 标记点击', detail.lat, detail.lng)
}

function onMapError(err: MapErrorDetail): void {
  console.error('TDTMap Demo: 错误 [' + err.code + ']', err.message)
  // v1.8.0: 平台不支持（code=5）回显到面板，避免"已叠加"等成功文案误导
  if (err.code == 5) infoText.value = '当前平台不支持: ' + err.message
}

// ── v1.4.0 新增：长按事件 ──
function onMapLongClick(detail: MapClickDetail): void {
  // 长按位置添加标记，方便演示
  const id = mapRef.value?.placeMarker(detail.lat, detail.lng, '长按标记') ?? 0
  lastOverlayId = id
  infoText.value = '长按位置: ' + detail.lat.toFixed(6) + ', ' + detail.lng.toFixed(6) + ' (已添加标记 #' + id + ')'
  console.log('TDTMap Demo: 长按', detail.lat, detail.lng)
}

// ── v1.4.0 新增：相机变化事件 ──
function onCameraChange(detail: MapClickDetail): void {
  clickLog.value = '相机移动: ' + detail.lat.toFixed(6) + ', ' + detail.lng.toFixed(6)
}

// ── v1.9.0 新增：图片覆盖物点击事件 ──
function onImageOverlayClick(detail: ImageOverlayClickDetail): void {
  infoText.value = '图片覆盖物点击 #' + detail.id + ' @ ' + detail.lat.toFixed(4) + ', ' + detail.lng.toFixed(4)
  console.log('TDTMap Demo: 图片覆盖物点击', detail.id, detail.lat, detail.lng)
}

// ── 地图类型 ──

function changeMapType(type: string): void {
  mapRef.value?.changeMapType(type)
}

// ── 视野 ──

function zoomInOne(): void { mapRef.value?.zoomInOne() }
function zoomOutOne(): void { mapRef.value?.zoomOutOne() }

function fitBoundsDemo(): void {
  mapRef.value?.fitToBounds(39.88, 116.38, 39.93, 116.43, 20)
}

// ── 手势 ──

function setZoomEnabled(e: boolean): void { mapRef.value?.setZoomEnabled(e) }
function setDragEnabled(e: boolean): void { mapRef.value?.setDragEnabled(e) }

// ── 标记 ──

function addSingleMarker(): void {
  lastOverlayId = mapRef.value?.placeMarker(39.9142, 116.4074, '北京') ?? 0
}

function batchMarkers(): void {
  const ids = mapRef.value?.batchMarkers([
    { latitude: 39.9142, longitude: 116.4074 },
    { latitude: 39.9242, longitude: 116.3974 },
    { latitude: 39.9042, longitude: 116.4174 }
  ])
  if (ids != null && ids.length > 0) {
    lastOverlayId = ids[ids.length - 1]
  }
}

function clearAllMarkers(): void { mapRef.value?.clearAllMarkers() }

// ── 覆盖物 ──

function drawPolyline(): void {
  lastOverlayId = mapRef.value?.drawPolyline([
    { latitude: 39.9100, longitude: 116.3900 },
    { latitude: 39.9200, longitude: 116.4000 },
    { latitude: 39.9100, longitude: 116.4100 }
  ], '#FF4444', 6) ?? 0
}

function drawCircle(): void {
  lastOverlayId = mapRef.value?.drawCircle(39.9142, 116.4074, 800, '#FF6600', '#FF660044') ?? 0
}

function drawRectangle(): void {
  lastOverlayId = mapRef.value?.drawRectangle(39.910, 116.395, 39.920, 116.415, '#3366FF', '#3366FF22') ?? 0
}

function drawPolygon(): void {
  lastOverlayId = mapRef.value?.drawPolygon([
    { latitude: 39.9050, longitude: 116.3850 },
    { latitude: 39.9150, longitude: 116.3950 },
    { latitude: 39.9100, longitude: 116.4050 },
    { latitude: 39.9000, longitude: 116.3900 }
  ], '#00CC66', '#00CC6633') ?? 0
}

function drawLabel(): void {
  lastOverlayId = mapRef.value?.drawLabel(39.9142, 116.4074, '天安门') ?? 0
}

function clearAllOverlays(): void { mapRef.value?.clearAllOverlays() }

// ── 新增：覆盖物单个管理 ──

function hideLastOverlay(): void {
  if (lastOverlayId > 0) {
    mapRef.value?.hideOverlayById(lastOverlayId)
    infoText.value = '已隐藏 overlay #' + lastOverlayId
  }
}

function showLastOverlay(): void {
  if (lastOverlayId > 0) {
    mapRef.value?.showOverlayById(lastOverlayId)
    infoText.value = '已显示 overlay #' + lastOverlayId
  }
}

function removeLastOverlay(): void {
  if (lastOverlayId > 0) {
    mapRef.value?.removeOverlayById(lastOverlayId)
    infoText.value = '已移除 overlay #' + lastOverlayId
    lastOverlayId = 0
  }
}

// ── 新增：地图工具 ──

function doPlanBy(): void {
  mapRef.value?.doPlanBy(50, 50)
}

function doSetViewport(): void {
  mapRef.value?.setViewportPoints([
    { latitude: 39.8950, longitude: 116.3950 },
    { latitude: 39.9200, longitude: 116.4200 },
    { latitude: 39.9050, longitude: 116.3900 }
  ])
}

function doCheckResize(): void {
  mapRef.value?.doCheckResize()
  infoText.value = '已触发布局刷新'
}

// ── 新增：信息计算 ──

function calcDistance(): void {
  const start: MapClickDetail = { lat: 39.9042, lng: 116.4075 }
  const end: MapClickDetail = { lat: 39.9142, lng: 116.4175 }
  const dist = mapRef.value?.calculateDistance(start, end)
  if (dist != null) {
    infoText.value = '距离: ' + dist.toFixed(0) + ' 米'
  }
}

function calcViewport(): void {
  const points: Array<MapClickDetail> = [
    { lat: 39.8900, lng: 116.3800 },
    { lat: 39.9200, lng: 116.4200 },
    { lat: 39.9000, lng: 116.4000 }
  ]
  const result = mapRef.value?.calculateViewport(points)
  if (result != null) {
    infoText.value = '最佳视野: center(' + result.center.lat.toFixed(4) + ',' + result.center.lng.toFixed(4) + ') zoom=' + result.zoom.toFixed(1)
  }
}

function doGetCode(): void {
  const code = mapRef.value?.getMapCode()
  if (code != null) {
    infoText.value = '坐标系: ' + code
  }
}

function doGetSize(): void {
  const size = mapRef.value?.getMapSize()
  if (size != null) {
    infoText.value = '容器尺寸: ' + size.width + ' x ' + size.height
  }
}

// ── 新增：天地图搜索 ──

function doReverseGeocode(): void {
  const lnglat: MapClickDetail = { lat: 39.9088, lng: 116.3975 }
  mapRef.value?.reverseGeocode(lnglat, (data: UTSJSONObject) => {
    const raw = JSON.stringify(data)
    console.log('逆地理编码结果:', raw)
    // 跨运行时对象方法集不完整，官方 JSON 文档：JSON.parse 重建 + [] 下标访问
    const obj = JSON.parse(raw) as UTSJSONObject
    const result = obj["result"] as UTSJSONObject
    let addr = ''
    if (result != null) {
      const fa = result["formatted_address"]
      addr = fa != null ? (fa as string) : ''
    }
    infoText.value = '逆地理: ' + (addr.length > 0 ? addr : raw)
  })
}

function doForwardGeocode(): void {
  mapRef.value?.forwardGeocode('北京市东城区天安门', (data: UTSJSONObject) => {
    console.log('地理编码结果:', JSON.stringify(data))
    infoText.value = '地理编码: ' + JSON.stringify(data)
  })
}

function doSearch(): void {
  const params: SearchOptions = { keyWord: '酒店', start: '0', count: '5' }
  mapRef.value?.keywordSearch(params, (data: UTSJSONObject) => {
    const raw = JSON.stringify(data)
    console.log('搜索完成:', raw)
    // v1.5.4: v2 响应无 msg 字段，status 为对象 {infocode:1000}，结果总数在顶层 count
    // 跨运行时对象方法集不完整，官方 JSON 文档：JSON.parse 重建 + [] 下标访问
    const obj = JSON.parse(raw) as UTSJSONObject
    const statusObj = obj["status"] as UTSJSONObject
    let infocode = -1
    if (statusObj != null) {
      const ic = statusObj["infocode"]
      infocode = ic != null ? (ic as number) : -1
    }
    const cnt = obj["count"]
    const total = cnt != null ? (cnt as number) : 0
    infoText.value = '搜索: infocode=' + infocode + ', 共 ' + total + ' 条'
  })
}

function doSearchNearby(): void {
  const params: SearchOptions = {
    keyWord: '餐厅',
    pointLonlat: '116.3975,39.9088',
    queryRadius: '1000',
    start: '0',
    count: '5'
  }
  mapRef.value?.nearbySearch(params, (data: UTSJSONObject) => {
    const raw = JSON.stringify(data)
    console.log('周边搜索完成:', raw)
    // v1.5.4: v2 响应无 msg 字段，status 为对象 {infocode:1000}
    // 跨运行时对象方法集不完整，官方 JSON 文档：JSON.parse 重建 + [] 下标访问
    const obj = JSON.parse(raw) as UTSJSONObject
    const statusObj = obj["status"] as UTSJSONObject
    let infocode = -1
    if (statusObj != null) {
      const ic = statusObj["infocode"]
      infocode = ic != null ? (ic as number) : -1
    }
    const cnt = obj["count"]
    const total = cnt != null ? (cnt as number) : 0
    infoText.value = '周边搜索: infocode=' + infocode + ', 共 ' + total + ' 条'
  })
}

// ── 坐标转换 ──

// ── v1.3.0 新增：定位 ──

function showUserLoc(): void {
  // v1.5.4: uni-app x 无 uni.authorize API；定位权限由原生层 getUserLocation 自动申请（弹系统授权框）
  mapRef.value?.getCurrentLocation((detail: MapClickDetail) => {
    mapRef.value?.setShowUserLocation(true)
    infoText.value = '定位蓝点已显示: ' + detail.lat.toFixed(4) + ', ' + detail.lng.toFixed(4)
  }, (err: MapErrorDetail) => {
    infoText.value = '定位失败: ' + err.message
  })
}

function hideUserLoc(): void {
  mapRef.value?.setShowUserLocation(false)
  infoText.value = '定位蓝点已隐藏'
}

function getUserLoc(): void {
  // v1.5.4: 原生层已内置权限申请，直接调用即可
  doGetLocation()
}

function doGetLocation(): void {
  mapRef.value?.getCurrentLocation((detail: MapClickDetail) => {
    infoText.value = '当前位置: ' + detail.lat.toFixed(6) + ', ' + detail.lng.toFixed(6)
    console.log('TDTMap Demo: 定位成功', detail.lat, detail.lng)
  }, (err: MapErrorDetail) => {
    infoText.value = '定位失败: ' + err.message
    console.error('TDTMap Demo: 定位失败', err.message)
  })
}

// ── v1.3.0 新增：信息窗口 ──

let infoMarkerId: number = 0

function showMarkerInfoDemo(): void {
  // 先创建一个带 snippet 的标记
  infoMarkerId = mapRef.value?.placeMarker(39.9142, 116.4074, '天安门广场', '北京市中心，著名景点') ?? 0
  // 由于鸿蒙 addMarker 是异步的，需要延迟显示信息窗口
  setTimeout(() => {
    mapRef.value?.showMarkerInfoById(infoMarkerId)
    infoText.value = '信息窗口已显示（标记 #' + infoMarkerId + '）'
  }, 500)
}

function hideMarkerInfoDemo(): void {
  if (infoMarkerId > 0) {
    mapRef.value?.hideMarkerInfoById(infoMarkerId)
    infoText.value = '信息窗口已隐藏（标记 #' + infoMarkerId + '）'
  }
}

// ── v1.3.0 新增：自定义瓦片图层 ──

let customTileAdded: boolean = false

function addCustomTile(): void {
  // 添加 OpenStreetMap 瓦片作为示例（注意：生产环境请替换为自己的瓦片服务）
  mapRef.value?.addTileLayer('osm-demo', 'https://tile.openstreetmap.org/{z}/{x}/{y}.png')
  customTileAdded = true
  infoText.value = '已添加 OSM 瓦片图层（叠加在天地图上方）'
}

function removeCustomTile(): void {
  mapRef.value?.removeTileLayer('osm-demo')
  customTileAdded = false
  infoText.value = '已移除自定义瓦片图层'
}

// ── 坐标转换 ──

function convertCoord(): void {
  // 高德坐标（GCJ02）天安门 → WGS84
  const result = mapRef.value?.convertGcj02ToWgs84(39.9088, 116.3975)
  if (result != null) {
    coordResult.value = 'GCJ02 天安门 → WGS84: ' + result.lat.toFixed(6) + ', ' + result.lng.toFixed(6)
  }
}

// ── v1.4.0 新增：地图旋转/倾斜 ──

function setBearing0(): void { mapRef.value?.setMapBearing(0); infoText.value = '旋转: 0° (正北)' }
function setBearing90(): void { mapRef.value?.setMapBearing(90); infoText.value = '旋转: 90° (东)' }
function setBearing180(): void { mapRef.value?.setMapBearing(180); infoText.value = '旋转: 180° (南)' }
function setBearing270(): void { mapRef.value?.setMapBearing(270); infoText.value = '旋转: 270° (西)' }
function showBearing(): void {
  const bearing = mapRef.value?.getMapBearing()
  if (bearing != null) infoText.value = '当前旋转: ' + bearing.toFixed(1) + '°'
}

function setTilt0(): void { mapRef.value?.setMapTilt(0); infoText.value = '倾斜: 0° (垂直俯瞰)' }
function setTilt30(): void { mapRef.value?.setMapTilt(30); infoText.value = '倾斜: 30°' }
function setTilt60(): void { mapRef.value?.setMapTilt(60); infoText.value = '倾斜: 60°' }
function showTilt(): void {
  const tilt = mapRef.value?.getMapTilt()
  if (tilt != null) infoText.value = '当前倾斜: ' + tilt.toFixed(1) + '°'
}

function setRotateEnabled(enabled: boolean): void { mapRef.value?.setRotateEnabled(enabled) }
function setTiltEnabledD(enabled: boolean): void { mapRef.value?.setTiltEnabled(enabled) }

// ── 截图 & 信息 ──

function takeSnapshot(): void {
  // v1.7.1: snapshot 已异步化（同步等待在 uni-app x 主线程模式下死锁），回调式接收结果
  mapRef.value?.takeSnapshot((data: ArrayBuffer) => {
    if (data != null && data.byteLength > 0) {
      infoText.value = '截图大小: ' + data.byteLength + ' bytes'
    } else {
      infoText.value = '截图失败（鸿蒙不支持）'
    }
  })
}

function showCenter(): void {
  const c = mapRef.value?.getCurrentCenter()
  if (c != null) infoText.value = '中心: ' + c.lat.toFixed(4) + ', ' + c.lng.toFixed(4)
}

// ── 数据可视化 v1.7.0 ──

function demoCluster(): void {
  // 演示点在上海外滩附近，先把视野移过去再添加，否则点落在初始北京视野之外
  mapRef.value?.moveToCenter(31.2304, 121.4737)
  mapRef.value?.zoomTo(13)
  const pts: Array<MapClickDetail> = []
  for (let i = 0; i < 300; i++) {
    pts.push({
      lat: 31.2304 + (Math.random() - 0.5) * 0.5,
      lng: 121.4737 + (Math.random() - 0.5) * 0.5
    })
  }
  const opts: ClusterOptions = { clusterRadius: 50, clusterMaxZoom: 14 }
  mapRef.value?.addMarkerCluster(pts, opts)
  infoText.value = '已添加 300 个聚合点（点击聚合簇自动放大）'
}

function clearCluster(): void {
  mapRef.value?.removeMarkerCluster()
  infoText.value = '聚合层已清除'
}

function demoHeatmap(): void {
  // 同上：先把视野移到热力点分布区
  mapRef.value?.moveToCenter(31.2304, 121.4737)
  mapRef.value?.zoomTo(13)
  const pts: Array<HeatmapItem> = []
  for (let i = 0; i < 500; i++) {
    pts.push({
      lat: 31.2304 + (Math.random() - 0.5) * 0.4,
      lng: 121.4737 + (Math.random() - 0.5) * 0.4,
      weight: Math.floor(Math.random() * 10) + 1
    })
  }
  mapRef.value?.addHeatmap(pts, { radius: 30, opacity: 0.6 })
  infoText.value = '已添加 500 点热力图'
}

function clearHeatmap(): void {
  mapRef.value?.removeHeatmap()
  infoText.value = '热力层已清除'
}

// ── 图层增强 v1.8.0 ──

function demoSetStyle(): void {
  const custom = JSON.stringify({
    version: 8,
    glyphs: 'https://demotiles.maplibre.org/font/{fontstack}/{range}.pbf',
    sources: {
      osm: { type: 'raster', tiles: ['https://tile.openstreetmap.org/{z}/{x}/{y}.png'], tileSize: 256 }
    },
    layers: [{ id: 'osm-layer', type: 'raster', source: 'osm' }]
  })
  mapRef.value?.setStyle(custom)
  infoText.value = 'setStyle 已调用（OSM 样式）'
}

function demoRemoveStyle(): void {
  mapRef.value?.removeStyle()
  infoText.value = 'removeStyle 已调用（恢复天地图）'
}

function demoWms(): void {
  // Terrestris 公共 OSM WMS（无需 Key，EPSG:3857，实测可用）
  mapRef.value?.addWMSTileLayer('wms-demo', 'https://ows.terrestris.de/osm/service', 'OSM-WMS', { opacity: 0.8, zIndex: 0 })
  infoText.value = 'WMS 图层已叠加（opacity=0.8, 贴底）'
}

function demoCanvas(): void {
  if (mapRef.value == null) { infoText.value = '地图尚未就绪'; return }
  infoText.value = 'isSupportCanvas = ' + (mapRef.value.isSupportCanvas() ? 'true' : 'false') + '（当前平台）'
}

function demoClearBounds(): void {
  mapRef.value?.setMapMaxBounds(null, null, null, null)
  infoText.value = '边界限制已清除'
}

function showZoom(): void {
  const z = mapRef.value?.getCurrentZoom()
  if (z != null) infoText.value = '缩放级别: ' + z
}

function showBounds(): void {
  const b: MapBoundsDetail = mapRef.value?.getCurrentBounds()
  if (b != null) {
    infoText.value = '范围: [' + b.minLat.toFixed(4) + ',' + b.minLng.toFixed(4) + '] → [' + b.maxLat.toFixed(4) + ',' + b.maxLng.toFixed(4) + ']'
  }
}

// ── 图片覆盖物 v1.9.0 ──
// 演示图用 Mapbox/MapLibre image source 官方示例素材（CORS 开放）；
// 国内网络不佳时可替换为任意 http(s) 图片或本机缓存路径（缓存由调用方维护，插件仅按地址加载）
const DEMO_IMAGE_URL = 'https://docs.mapbox.com/mapbox-gl-js/assets/radar.gif'
const DEMO_IMAGE_URL_2 = 'https://docs.mapbox.com/mapbox-gl-js/assets/cat.png'
let lastImageOverlayId: number = 0

function demoAddImage(): void {
  mapRef.value?.moveToCenter(39.91, 116.40)
  mapRef.value?.zoomTo(11)
  const id = mapRef.value?.addImageOverlay({
    southwest: { lat: 39.88, lng: 116.36 },
    northeast: { lat: 39.94, lng: 116.44 },
    image: DEMO_IMAGE_URL,
    transparency: 0,
    zIndex: 1,
    bearing: 0
  }) ?? 0
  lastImageOverlayId = id
  lastOverlayId = id
  if (id > 0) {
    infoText.value = '图片覆盖物 #' + id + ' 已添加（点击图片试试）'
  } else {
    infoText.value = '添加失败（样式未加载或地址非法；Web 端仅支持 http(s)/data: URL）'
  }
}

function demoImageTransparency(): void {
  if (lastImageOverlayId <= 0) { infoText.value = '请先添加图片覆盖物'; return }
  mapRef.value?.updateImageOverlay(lastImageOverlayId, { transparency: 0.5 })
  infoText.value = '透明度已改为 0.5（transparency=0.5 → 显示 50% 透明）'
}

function demoImageBearing(): void {
  if (lastImageOverlayId <= 0) { infoText.value = '请先添加图片覆盖物'; return }
  mapRef.value?.updateImageOverlay(lastImageOverlayId, { bearing: 45 })
  infoText.value = 'bearing=45°（绕 bounds 中心顺时针旋转）'
}

function demoImageSwap(): void {
  if (lastImageOverlayId <= 0) { infoText.value = '请先添加图片覆盖物'; return }
  mapRef.value?.updateImageOverlay(lastImageOverlayId, { image: DEMO_IMAGE_URL_2 })
  infoText.value = '已换图（同 ID 重建加载）'
}

function demoImageUpdateBounds(): void {
  if (lastImageOverlayId <= 0) { infoText.value = '请先添加图片覆盖物'; return }
  mapRef.value?.updateImageOverlay(lastImageOverlayId, {
    southwest: { lat: 39.90, lng: 116.38 },
    northeast: { lat: 39.93, lng: 116.42 },
    bearing: 0
  })
  infoText.value = '范围已缩小并回正'
}

function demoRemoveImage(): void {
  if (lastImageOverlayId <= 0) { infoText.value = '请先添加图片覆盖物'; return }
  mapRef.value?.removeOverlayById(lastImageOverlayId)
  infoText.value = '图片覆盖物 #' + lastImageOverlayId + ' 已移除'
  lastImageOverlayId = 0
}

// ── GeoJSON 图层 v1.9.0（E0）──
// fixture 1：基本 Polygon + 标注属性（name/centroid 锚点）
const GEOJSON_FIXTURE_POLYGON: string = '{"type":"FeatureCollection","features":[{"type":"Feature","properties":{"name":"示例区域","centroid":[116.39,39.91]},"geometry":{"type":"Polygon","coordinates":[[[116.375,39.895],[116.405,39.895],[116.41,39.925],[116.382,39.923],[116.375,39.895]]]}}]}'
// fixture 2：MultiPolygon（含带洞多边形）+ 属性缺失用例（第二个 feature 无 name/centroid →
// 标注文本缺失跳过、锚点缺失回退外环质心，均为解析器设计内兜底，不抛异常）
const GEOJSON_FIXTURE_MULTI_HOLE: string = '{"type":"FeatureCollection","features":[{"type":"Feature","properties":{"name":"多面带洞"},"geometry":{"type":"MultiPolygon","coordinates":[[[[116.30,39.93],[116.34,39.93],[116.34,39.96],[116.30,39.96],[116.30,39.93]]],[[[116.36,39.93],[116.42,39.93],[116.42,39.965],[116.36,39.965],[116.36,39.93]],[[116.375,39.94],[116.385,39.94],[116.385,39.95],[116.375,39.95],[116.375,39.94]]]]}},{"type":"Feature","properties":{},"geometry":{"type":"Polygon","coordinates":[[[116.43,39.90],[116.46,39.90],[116.455,39.92],[116.43,39.918],[116.43,39.90]]]}}]}'
let lastGeoLayerId: number = 0

function demoAddGeoPolygon(): void {
  // 市界样式用例：实线 #4475E4 宽 1 + 半透明填充 + 中文标注（name 文本 / centroid 锚点，白字黑描边 12px）
  const label: GeoJsonLabelStyle = {
    field: 'name',
    fontSize: 12,
    color: '#ffffff',
    haloColor: '#000000',
    haloWidth: 2,
    positionField: 'centroid'
  }
  const opts: GeoJsonLayerOptions = {
    lineColor: '#4475E4',
    lineWidth: 1,
    lineDash: null,
    fillColor: '#4475E422',
    label: label
  }
  const id = mapRef.value?.addGeoJsonLayer(GEOJSON_FIXTURE_POLYGON, opts) ?? 0
  lastGeoLayerId = id
  infoText.value = id > 0 ? 'GeoJSON 层 #' + id + ' 已加载（logcat 查看解析计数）' : 'GeoJSON 层加载失败（解析为空或地图未就绪）'
}

function demoAddGeoMultiHole(): void {
  // 多面带洞 + 属性缺失：外环/内环（洞边）均描边；填充仅外环
  const opts: GeoJsonLayerOptions = {
    lineColor: '#009966',
    lineWidth: 2,
    lineDash: null,
    fillColor: '#00996618',
    label: null
  }
  const id = mapRef.value?.addGeoJsonLayer(GEOJSON_FIXTURE_MULTI_HOLE, opts) ?? 0
  lastGeoLayerId = id
  infoText.value = id > 0 ? 'GeoJSON 层 #' + id + ' 已加载（多面带洞 + 属性缺失兜底用例）' : 'GeoJSON 层加载失败'
}

// 邻省虚线用例（E0.3a）：LineString 灰色虚线 [4,4] 宽 0.8 无填充，对齐 chatbot 邻省界样式；
// 鸿蒙端 MapKit 无虚线参数自动降级实线（console 警告）
const GEOJSON_FIXTURE_DASH_LINE: string = '{"type":"FeatureCollection","features":[{"type":"Feature","properties":{"name":"邻省界示例"},"geometry":{"type":"LineString","coordinates":[[116.34,39.86],[116.38,39.87],[116.42,39.855],[116.47,39.865]]}}]}'

function demoAddGeoDashLine(): void {
  const opts: GeoJsonLayerOptions = {
    lineColor: '#aaaaaa',
    lineWidth: 1,
    lineDash: [4, 4],
    fillColor: null,
    label: null
  }
  const id = mapRef.value?.addGeoJsonLayer(GEOJSON_FIXTURE_DASH_LINE, opts) ?? 0
  lastGeoLayerId = id
  infoText.value = id > 0 ? 'GeoJSON 层 #' + id + ' 已加载（灰虚线 [4,4]，lineWidth=1）' : 'GeoJSON 层加载失败'
}

// 中文标注用例（E0.3b）：两层叠加对齐 chatbot 视觉——邻省层先建（虚线灰界 + 邻省名 11px #aaa
// 白半透明描边 rgba(255,255,255,0.6)=#ffffff99），城市层后建（#4475E4 市界 + 市名 12px 白字黑描边）。
// 鸿蒙端 label 降级跳过（mapError code=5，无地名降级档）
const GEOJSON_GD_NEIGHBOR: string = '{"type":"FeatureCollection","features":[{"type":"Feature","properties":{"name":"湖南省","centroid":[112.98,24.6]},"geometry":{"type":"LineString","coordinates":[[111.4,24.2],[112.2,24.0],[112.9,23.6],[113.6,23.9],[114.2,24.3]]}}]}'
const GEOJSON_GD_CITIES: string = '{"type":"FeatureCollection","features":[{"type":"Feature","properties":{"name":"广州市","centroid":[113.35,23.15]},"geometry":{"type":"Polygon","coordinates":[[[112.95,22.95],[113.55,22.9],[113.62,23.35],[113.15,23.4],[112.95,22.95]]]}},{"type":"Feature","properties":{"name":"深圳市","centroid":[114.1,22.58]},"geometry":{"type":"Polygon","coordinates":[[[113.75,22.45],[114.3,22.42],[114.32,22.75],[113.78,22.72],[113.75,22.45]]]}}]}'
let gdNeighborLayerId: number = 0
let gdCityLayerId: number = 0

function demoAddGeoLabels(): void {
  // 视野移到广东
  mapRef.value?.moveToCenter(23.1, 113.7)
  mapRef.value?.zoomTo(7)
  const neighborLabel: GeoJsonLabelStyle = {
    field: 'name',
    fontSize: 11,
    color: '#aaaaaa',
    haloColor: '#ffffff99',
    haloWidth: 2,
    positionField: 'centroid'
  }
  const neighborOpts: GeoJsonLayerOptions = {
    lineColor: '#aaaaaa',
    lineWidth: 1,
    lineDash: [4, 4],
    fillColor: null,
    label: neighborLabel
  }
  const cityLabel: GeoJsonLabelStyle = {
    field: 'name',
    fontSize: 12,
    color: '#ffffff',
    haloColor: '#000000',
    haloWidth: 2,
    positionField: 'centroid'
  }
  const cityOpts: GeoJsonLayerOptions = {
    lineColor: '#4475E4',
    lineWidth: 1,
    lineDash: null,
    fillColor: null,
    label: cityLabel
  }
  gdNeighborLayerId = mapRef.value?.addGeoJsonLayer(GEOJSON_GD_NEIGHBOR, neighborOpts) ?? 0
  gdCityLayerId = mapRef.value?.addGeoJsonLayer(GEOJSON_GD_CITIES, cityOpts) ?? 0
  lastGeoLayerId = gdCityLayerId
  infoText.value = '邻省层 #' + gdNeighborLayerId + ' + 城市层 #' + gdCityLayerId + ' 已加载（断言：市名白字黑边 12px、邻省名灰 11px 白半透明边；logcat 查看 label 计数）'
}

function demoHideGeoLayer(): void {
  if (lastGeoLayerId <= 0) { infoText.value = '请先加载 GeoJSON 图层'; return }
  mapRef.value?.hideGeoJsonLayer(lastGeoLayerId)
  infoText.value = 'GeoJSON 层 #' + lastGeoLayerId + ' 已隐藏'
}

function demoShowGeoLayer(): void {
  if (lastGeoLayerId <= 0) { infoText.value = '请先加载 GeoJSON 图层'; return }
  mapRef.value?.showGeoJsonLayer(lastGeoLayerId)
  infoText.value = 'GeoJSON 层 #' + lastGeoLayerId + ' 已显示'
}

function demoRemoveGeoLayer(): void {
  if (lastGeoLayerId <= 0) { infoText.value = '请先加载 GeoJSON 图层'; return }
  mapRef.value?.removeGeoJsonLayer(lastGeoLayerId)
  infoText.value = 'GeoJSON 层 #' + lastGeoLayerId + ' 已移除'
  lastGeoLayerId = 0
}
</script>

