  background-color: #ffffff;
  border-top: 1px solid #e0e0e0;
}

.panel-scroll {
  flex: 1;
  padding: 10px;
}

.section-title {
  font-size: 14px;
  font-weight: bold;
  color: #333;
  margin-top: 8px;
  margin-bottom: 4px;
}

.btn-row {
  flex-direction: row;
  flex-wrap: wrap;
}

.btn {
  margin: 3px 4px;
  padding: 4px 10px;
  font-size: 12px;
  background-color: #4A90D9;
  color: #ffffff;
  border-radius: 4px;
  border: none;
}

.btn-danger {
  background-color: #E74C3C;
}

.result-text {
  font-size: 11px;
  color: #666;
  margin: 4px 0;
  padding: 4px 8px;
  background-color: #f5f5f5;
  border-radius: 4px;
}
</style>
